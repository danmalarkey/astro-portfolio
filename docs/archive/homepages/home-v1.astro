---
import Header from '../layouts/Header.astro';
import Layout from '../layouts/Layout.astro';
import MediaPanel from '../components/MediaPanel.astro';
import HomeFooter from '../components/HomeFooter.astro';
import ButtonLink from '../components/ButtonLink.astro';

const baseUrl = Astro.url.pathname.startsWith('/astro-portfolio') ? '/astro-portfolio/' : '/';
const withBase = (path: string) => `${baseUrl}${path.startsWith('/') ? path.slice(1) : path}`;
const createActorMailto = (actor: string, prompt: string) => {
  const params = new URLSearchParams();
  params.set('subject', `[${actor}] Advisory inquiry`);
  params.set('body', `Hi Dan,\n\nI'm reaching out as ${prompt} and would like to talk about design leadership support.\n\nContext:\n- Team/company:\n- What we're navigating:\n- What kind of support we need:\n\nThanks,`);
  return `mailto:hello@danmalarkey.com?${params.toString()}`;
};

const leverageCards = [
  {
    title: 'Executives and product drivers',
    descriptionLines: [
      'Clarifying product direction, aligning',
      'investment priorities, and making design',
      'a driver of business outcomes.'
    ],
    image: 'images/dan-right.png',
    imageAlt: 'Executive product design leadership and strategy collaboration',
    actorSlug: '/executives-and-product-drivers',
    actorLabel: 'an executive or product leader'
  },
  {
    title: 'Product and engineering teams',
    descriptionLines: [
      'Reducing delivery friction, improving',
      'collaboration, and creating repeatable',
      'patterns teams can ship with confidence.'
    ],
    image: 'images/img.png',
    imageAlt: 'Cross-functional product and engineering collaboration',
    actorSlug: '/product-and-engineering-teams',
    actorLabel: 'a product or engineering leader'
  },
  {
    title: 'Designers and design leaders',
    descriptionLines: [
      'Raising craft maturity, establishing standards,',
      'and strengthening design influence in strategic',
      'product and organizational decisions.'
    ],
    image: 'images/dan.png',
    imageAlt: 'Design leadership and team development',
    actorSlug: '/designers-and-design-leaders',
    actorLabel: 'a design leader'
  }
];

const practiceStats = [
  { labelLines: ['Chief Product Designer', 'at feature[23]'], text: 'Built and scaled a design practice focused on repeatable client outcomes, team quality, and delivery partnership' },
  { labelLines: ['17+ years across', 'product and design'], text: 'Hands-on leadership across startups and enterprise environments, from direction setting through implementation' },
  { labelLines: ['Systems-led, people-first', 'operating model'], text: 'Clarifies priorities, aligns teams, and builds standards that preserve momentum without creating chaos' }
];

const caseStudies = [
  {
    image: 'images/case-studies/home/insurance.png',
    imageAlt: 'Insurance platform workflow and operations context',
    logo: 'Home insurance platform',
    logoImage: '',
    logoAlt: 'Home insurance platform',
    stacked: true,
    role: 'Design leadership through feature[23]',
    tags: ['Platform', 'Mission critical', 'AI acceleration'],
    outcome: 'Helped lead a mission-critical digital transformation across internal operations and member-facing experiences.',
    text: 'At feature[23], I contributed to rebuilding core insurance workflows and member platform experiences to support regulatory demands, operational stability, and future member growth.'
  },
  {
    image: 'images/case-studies/home/beaver-operations.svg',
    imageAlt: 'Global seafood supply chain operations platform',
    logo: 'Beaver Street Fisheries',
    logoImage: '',
    logoAlt: 'Beaver Street Fisheries',
    stacked: false,
    role: 'Design leadership through feature[23]',
    tags: ['Platform', 'Supply chain', 'Enterprise operations'],
    outcome: 'Unified a global seafood supply chain with a custom operations platform across compliance, logistics, and production.',
    text: 'At feature[23], I helped design and build an operations layer that replaced spreadsheet-driven workflows and improved coordination across sourcing, inbound logistics, and kitchen production.'
  },
  {
    image: 'images/case-studies/home/insurance.png',
    imageAlt: 'Enterprise logistics shipment workflow planning interface',
    logo: 'Enterprise logistics platform',
    logoImage: '',
    logoAlt: 'Enterprise logistics platform',
    stacked: true,
    role: 'Design leadership through feature[23]',
    tags: ['Systems', 'Migration', 'Operational efficiency'],
    outcome: 'Re-architected shipment workflows to save an estimated ~6,000 hours per year.',
    text: 'Reshaped migration decisions around role-based workflows and operational efficiency instead of preserving legacy bloat.'
  },
  {
    image: 'images/img.png',
    imageAlt: 'Reporting architecture and KPI dashboard strategy',
    logo: 'Field operations reporting platform',
    logoImage: '',
    logoAlt: 'Field operations reporting platform',
    role: 'Design leadership through feature[23]',
    tags: ['Hybrid', 'Reporting', 'KPI clarity'],
    outcome: 'Reframed reporting architecture around commercial growth and financial clarity.',
    text: 'Restructured navigation, KPI prioritization, and drill-down patterns to support better operational decisions at scale.'
  },
  {
    image: 'images/case-studies/home/vystar-bg-img.png',
    imageAlt: 'Member platform sign-up experience for a regional bank',
    logo: 'Regional bank membership platform',
    logoImage: '',
    logoAlt: 'Regional bank membership platform',
    role: 'Product design through feature[23]',
    tags: ['Visual', 'Member onboarding', 'Conversion'],
    outcome: 'Designed a member sign-up experience focused on clarity, confidence, and completion.',
    text: 'Used visual hierarchy and onboarding flow design to reduce friction in a high-intent account and membership enrollment experience.'
  }
];

const engagementItems = [
  {
    title: 'Fractional design leadership',
    text: 'Embedded leadership support for product direction, organizational alignment, and critical design decisions across teams.',
    fit: 'Best for sustained leadership'
  },
  {
    title: 'Advisory and consulting engagements',
    text: 'Targeted support for high-stakes decisions, product direction, and delivery friction where senior design leadership is needed quickly.',
    fit: 'Best for high-stakes inflection points'
  },
  {
    title: 'Transformation and reset work',
    text: 'Focused engagements to diagnose operational friction, realign teams, and establish stronger product and design foundations.',
    fit: 'Best for change, scale, or recovery'
  }
];

const heroNeeds = [
  'Clearer direction and alignment leaders can trust',
  'Product vision translated from goals, constraints, and real team needs',
  'Senior design leadership that stays strategic and can move into execution'
];

const faqItems = [
  {
    question: 'Are you looking for a full-time role?',
    answer: 'No. I am happy in my current role at feature[23]. This site is for select advisory, consulting, and fractional leadership engagements.'
  },
  {
    question: 'Do you only do leadership and strategy work?',
    answer: 'No. I work across leadership and execution. I enjoy hands-on individual contributor work and building just as much as direction-setting and whiteboard work.'
  },
  {
    question: 'Can you work with internal product and engineering teams?',
    answer: 'Yes. That is a core part of how I work. I am most effective when design, product, and engineering leadership are aligned around the same decisions.'
  },
  {
    question: 'What kinds of work are not a fit?',
    answer: 'I am not the right fit for quick-turn logo design, postcards, or low-leverage marketing collateral work. I am a better fit for product direction, systems, UX, design leadership, and implementation-focused product work.'
  }
];
---

<Layout title="Dan Malarkey | Fractional Chief Product Designer">
  <div class="site-sky" aria-hidden="true">
    <canvas id="site-stars"></canvas>
  </div>

  <Header />

  <main>
    <section class="intro-mh" id="top" data-star-density="1" data-star-brightness="1">
      <div class="sky-burst" aria-hidden="true"></div>

      <div class="dm-grid-l dm-grid-l--grid-sys">
      <div class="hero-shell gc-start-2 gc-span-24">
        <div class="dm-grid-l dm-grid-l--grid-sys">
          <div class="intro-sub-list intro-sub-list--top">
            <span class="pill">
              <span class="pill-text-desktop">Chief Product Designer at feature[23] <span class="separator">•</span> 17+ years <span class="separator">•</span> Startup to enterprise</span>
              <span class="pill-text-mobile">Chief Product Designer at feature[23]</span>
            </span>
          </div>
        </div>

        <div class="dm-grid-l dm-grid-l--grid-sys">
          <h1 class="intro-title text-white">Design leadership for organizations navigating growth, complexity, and change.</h1>
        </div>

        <div class="dm-grid-l dm-grid-l--grid-sys">
          <p class="intro-text">
            I help executives, product leaders, and cross-functional teams bring clarity to complex product decisions, align execution, and build design capability that scales.
          </p>
        </div>
        <div class="dm-grid-l dm-grid-l--grid-sys">
          <p class="intro-text text-accent">Available for select advisory and fractional engagements.</p>
        </div>
        <div class="dm-grid-l dm-grid-l--grid-sys">
          <div class="gc-start-4 gc-span-16 home-v2-needs">
            <p class="home-v2-needs--label">What teams usually need</p>
            <ul class="home-v2-needs--list">
              {heroNeeds.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </div>
      </div>
      </div>
    </section>

    <section class="section leverage section-panel section-surface--dark section-panel--hero-bridge" data-star-density="0.9" data-star-brightness="0.88">
      <div class="dm-grid-l dm-grid-l--grid-sys leadership-intro">
        <h2 class="section-title text-white gc-start-2 gc-span-22">Design leadership across the organization.</h2>
        <p class="gc-start-2 gc-span-18">I support the people setting direction, the teams building product, and the design leaders scaling capability.</p>
      </div>

      <div class="intro-cards col-layout col-layout--3x8 dm-grid-l dm-grid-l--grid-sys">
        {leverageCards.map((item) => (
          <MediaPanel className="card leverage-card" image={item.image} imageAlt={item.imageAlt}>
            <div class="card-content">
              <div class="head-group">
                <h3>{item.title}</h3>
              </div>
              <p>
                {item.descriptionLines.map((line) => <span class="leverage-card-description-line">{line}</span>)}
              </p>
              <div class="leverage-card-cta-row">
                <ButtonLink variant="primary" className="leverage-card-cta-email" href={createActorMailto(item.title, item.actorLabel)}>Work with me</ButtonLink>
                <ButtonLink variant="ghost" className="leverage-card-cta-link" href={withBase(item.actorSlug)}>See how I help</ButtonLink>
              </div>
            </div>
          </MediaPanel>
        ))}
      </div>
    </section>

    <section class="section about-panel-wrap section-panel section-surface--warm" data-star-density="0.7" data-star-brightness="0.68">
      <div class="about-feature dm-grid-l dm-grid-l--grid-sys">
        <div class="about-feature--body gc-start-2 gc-span-13">
          <p class="about-feature--eyebrow">Design leadership in practice</p>
          <h2 class="section-title">Clarity and direction when <br class="about-title-break" />your stakes are on the line.</h2>
          <p>
            Across 17+ years in product and design leadership, including my current role at feature[23], I have led work across product, program, and portfolio levels, helping organizations make better decisions earlier and execute with more confidence.
          </p>
          <p>
            I work with executives, product leaders, and teams when the path forward is real but the organization needs sharper direction, stronger alignment, and better operating rhythm to get there.
          </p>
          <p>
            My approach is strategic and tactical: define direction, build the systems and standards that support execution, and stay close enough to the work that teams can move faster without losing quality.
          </p>
        </div>

        <div class="about-highlights gc-start-16 gc-span-10" aria-label="Design leadership proof points">
          {practiceStats.map((item) => (
            <article class="about-highlights--item">
              <p class="about-highlights--value">
                {item.labelLines.map((line) => <span class="about-highlights--value-line">{line}</span>)}
              </p>
              <p class="about-highlights--text">{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section case-studies section-panel section-surface--dark section-transition-impact" data-star-density="0.82" data-star-brightness="0.82">
      <div class="dm-grid-l dm-grid-l--grid-sys case-intro case-intro--with-controls">
        <p class="section-intro-eyebrow gc-start-2 gc-span-22">Proof</p>
        <h2 class="section-title case-title text-white gc-start-2 gc-span-16">Real business outcomes</h2>
        <p class="gc-start-2 gc-span-18">Selected outcomes from client engagements delivered through feature[23] and prior leadership work, focused on growth, operating efficiency, and experience quality. Some examples are anonymized.</p>
        <div class="case-rail-controls gc-start-19 gc-span-7" aria-label="Case studies navigation">
          <div class="case-rail-progress" aria-live="polite">
            <p class="case-rail-count"><span data-case-current>1</span><span class="case-rail-sep">/</span><span data-case-total>{caseStudies.length}</span></p>
            <div class="case-rail-track" aria-hidden="true"><span data-case-progress></span></div>
          </div>
          <button type="button" class="case-rail-btn case-rail-btn--icon" data-case-prev aria-controls="case-rail" aria-label="Scroll to previous case study">
            <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
              <path d="M10.75 2.75 5.5 8l5.25 5.25" />
            </svg>
          </button>
          <button type="button" class="case-rail-btn case-rail-btn--icon" data-case-next aria-controls="case-rail" aria-label="Scroll to next case study">
            <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
              <path d="M5.25 2.75 10.5 8l-5.25 5.25" />
            </svg>
          </button>
        </div>
      </div>

      <div class="case-rail-wrap dm-grid-l dm-grid-l--grid-sys">
        <div class="case-rail gc-start-2 gc-span-24" id="case-rail" tabindex="0" aria-label="Featured case studies">
        {caseStudies.map((item) => (
          <MediaPanel className="case-card" image={item.image} imageAlt={item.imageAlt} stacked={item.stacked ?? false}>
            <div class="case-overlay">
              <div class="case-meta">
                {item.logoImage ? (
                  <img class="case-logo-image" src={item.logoImage} alt={item.logoAlt ?? `${item.logo} logo`} />
                ) : (
                  <p class="case-logo">{item.logo}</p>
                )}
                <p class="case-role">{item.tags.join(' • ')}</p>
              </div>
              <h3 class="case-outcome">{item.outcome}</h3>
              <p class="case-summary">{item.text}</p>
            </div>
          </MediaPanel>
        ))}
        </div>
      </div>
    </section>

    <section class="section ways-to-engage section-panel section-surface--engage" data-star-density="0.82" data-star-brightness="0.82">
      <div class="engagement-layout dm-grid-l dm-grid-l--grid-sys">
        <div class="engagement-layout--intro gc-start-2 gc-span-8">
          <h2 class="section-title">Ways to engage</h2>
          <p>Available for select advisory, consulting, and fractional leadership engagements based on the stage, scope, and urgency of the work.</p>
          <div class="engagement-orbit-mark" aria-hidden="true">
            <svg viewBox="0 0 220 220" role="presentation" focusable="false">
              <defs>
                <radialGradient id="orbitSunFill" cx="50%" cy="50%" r="60%">
                  <stop offset="0%" stop-color="#fff4b1" />
                  <stop offset="55%" stop-color="#ffd067" />
                  <stop offset="100%" stop-color="#ff9f3f" />
                </radialGradient>
              </defs>

              <circle class="orbit-sun-halo" cx="110" cy="110" r="26"></circle>
              <circle class="orbit-sun-glow" cx="110" cy="110" r="18"></circle>
              <circle class="orbit-sun-ring" cx="110" cy="110" r="14.5"></circle>
              <circle class="orbit-core" cx="110" cy="110" r="11.5"></circle>

              <circle class="orbit-ring orbit-ring--one" cx="110" cy="110" r="30"></circle>
              <circle class="orbit-ring orbit-ring--two" cx="110" cy="110" r="50"></circle>
              <circle class="orbit-ring orbit-ring--three" cx="110" cy="110" r="72"></circle>
              <circle class="orbit-ring orbit-ring--four" cx="110" cy="110" r="94"></circle>

              <g class="orbit-track orbit-track--one">
                <circle class="orbit-planet orbit-planet--one" cx="110" cy="60" r="4"></circle>
              </g>
              <g class="orbit-track orbit-track--two">
                <circle class="orbit-planet orbit-planet--two" cx="110" cy="38" r="4.5"></circle>
              </g>
              <g class="orbit-track orbit-track--three">
                <circle class="orbit-planet orbit-planet--three" cx="110" cy="16" r="3.5"></circle>
              </g>

              <circle class="orbit-accent" cx="110" cy="110" r="117"></circle>
            </svg>
          </div>
        </div>

        <div class="engagement-model gc-start-10 gc-span-16">
        {engagementItems.map((item) => (
          <article class="engagement-model--item">
            <h3>{item.title}</h3>
            <p class="engagement-model--fit">{item.fit}</p>
            <p class="engagement-model--body">{item.text}</p>
          </article>
        ))}
        </div>
      </div>
    </section>

    <section class="section section-panel section-surface--warm home-v2-faq">
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <div class="gc-start-2 gc-span-8 section-intro section-intro--compact">
          <p class="section-intro-eyebrow">Fit / FAQ</p>
          <h2 class="section-title">A quick filter for whether this is the right fit.</h2>
          <p class="section-intro-body">
            Clear answers to the questions that usually determine whether someone should reach out.
          </p>
        </div>
        <div class="gc-start-10 gc-span-16 about-a-rows home-v2-rows" role="list">
          {faqItems.map((item) => (
            <article class="home-v2-faq-row" role="listitem">
              <h3>{item.question}</h3>
              <p>{item.answer}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

  </main>

  <HomeFooter />
</Layout>

<script is:inline>
  (() => {
    const canvas = document.getElementById('site-stars');
    if (!canvas || !(canvas instanceof HTMLCanvasElement)) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isTouchLikeDevice =
      window.matchMedia('(pointer: coarse)').matches ||
      navigator.maxTouchPoints > 0 ||
      'ontouchstart' in window;
    const allowPointerParallax = !prefersReducedMotion && !isTouchLikeDevice;
    const allowScrollParallax = !isTouchLikeDevice;
    const stars = [];
    const nebulaClouds = [];
    const starPalette = [
      [255, 255, 255],
      [214, 232, 255],
      [255, 228, 177],
      [198, 220, 255],
      [255, 245, 223]
    ];
    const nebulaPalette = [
      [88, 111, 255],
      [58, 180, 255],
      [186, 88, 255],
      [242, 125, 199]
    ];
    const STAR_COUNT = 420;
    let width = 0;
    let height = 0;
    let pointerX = 0;
    let pointerY = 0;
    let scrollY = 0;
    let currentDensity = 1;
    let currentBrightness = 1;
    let targetDensity = 1;
    let targetBrightness = 1;
    let sectionProfiles = [];
    const shootingStars = [];
    let nextShootingStarAt = 0;
    const getSafeScrollY = () => Math.max(window.scrollY || window.pageYOffset || 0, 0);

    const resize = () => {
      const previousWidth = width;
      const previousHeight = height;
      width = window.innerWidth;
      height = window.innerHeight;
      const ratio = Math.max(window.devicePixelRatio || 1, 1);
      canvas.width = Math.floor(width * ratio);
      canvas.height = Math.floor(height * ratio);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      ctx.setTransform(ratio, 0, 0, ratio, 0, 0);

      sectionProfiles = Array.from(document.querySelectorAll('[data-star-density]')).map((section) => {
        const rect = section.getBoundingClientRect();
        const start = rect.top + getSafeScrollY();
        const end = start + rect.height;
        const density = Number(section.getAttribute('data-star-density') || 1);
        const brightness = Number(section.getAttribute('data-star-brightness') || 1);
        return { start, end, density, brightness };
      });

      return {
        widthChanged: Math.abs(width - previousWidth) > 1,
        heightChanged: Math.abs(height - previousHeight) > 1
      };
    };

    const seedStars = () => {
      stars.length = 0;
      for (let i = 0; i < STAR_COUNT; i += 1) {
        const color = starPalette[Math.floor(Math.random() * starPalette.length)];
        const radius = Math.pow(Math.random(), 1.3) * 1.8 + 0.25;
        stars.push({
          x: Math.random() * width,
          y: Math.random() * height,
          r: radius,
          a: Math.random() * 0.8 + 0.15,
          twinkle: Math.random() * 0.022 + 0.002,
          visibilitySeed: Math.random(),
          color
        });
      }
    };

    const seedNebula = () => {
      nebulaClouds.length = 0;
      const cloudCount = Math.max(3, Math.round(width / 430));
      for (let i = 0; i < cloudCount; i += 1) {
        const color = nebulaPalette[Math.floor(Math.random() * nebulaPalette.length)];
        const baseX = width * (0.15 + Math.random() * 0.7);
        const baseY = height * (0.06 + Math.random() * 0.42);
        nebulaClouds.push({
          x: baseX,
          y: baseY,
          radius: 180 + Math.random() * 280,
          alpha: 0.12 + Math.random() * 0.1,
          drift: 8 + Math.random() * 10,
          phase: Math.random() * Math.PI * 2,
          color,
          targetX: baseX,
          targetY: baseY,
          retargetAt: performance.now() + 8000 + Math.random() * 9000
        });
      }
    };

    const updateTargetsFromScroll = () => {
      const probeY = scrollY + height * 0.42;
      const profile = sectionProfiles.find((item) => probeY >= item.start && probeY <= item.end);
      targetDensity = profile ? profile.density : 1;
      targetBrightness = profile ? profile.brightness : 1;
    };

    const draw = () => {
      ctx.clearRect(0, 0, width, height);

      const pointerOffsetX = allowPointerParallax ? (pointerX - width / 2) * 0.008 : 0;
      const pointerOffsetY = allowPointerParallax ? (pointerY - height / 2) * 0.01 : 0;
      const scrollOffset = allowScrollParallax ? -(scrollY * 0.045) : 0;
      const now = performance.now();

      currentDensity += (targetDensity - currentDensity) * 0.055;
      currentBrightness += (targetBrightness - currentBrightness) * 0.055;

      ctx.save();
      ctx.globalCompositeOperation = 'screen';
      for (const cloud of nebulaClouds) {
        if (now >= cloud.retargetAt) {
          cloud.targetX = width * (0.14 + Math.random() * 0.72);
          cloud.targetY = height * (0.04 + Math.random() * 0.46);
          cloud.retargetAt = now + 12000 + Math.random() * 18000;
        }

        cloud.x += (cloud.targetX - cloud.x) * 0.0014;
        cloud.y += (cloud.targetY - cloud.y) * 0.0014;

        const cx = cloud.x + Math.sin(now * 0.00006 + cloud.phase) * cloud.drift;
        const cy = cloud.y + Math.cos(now * 0.00005 + cloud.phase) * cloud.drift * 0.5 + pointerOffsetY * 0.05;
        const gradient = ctx.createRadialGradient(cx, cy, 0, cx, cy, cloud.radius);
        gradient.addColorStop(0, `rgba(${cloud.color[0]}, ${cloud.color[1]}, ${cloud.color[2]}, ${cloud.alpha * currentBrightness})`);
        gradient.addColorStop(0.45, `rgba(${cloud.color[0]}, ${cloud.color[1]}, ${cloud.color[2]}, ${cloud.alpha * 0.36})`);
        gradient.addColorStop(1, `rgba(${cloud.color[0]}, ${cloud.color[1]}, ${cloud.color[2]}, 0)`);
        ctx.fillStyle = gradient;
        ctx.beginPath();
        ctx.arc(cx, cy, cloud.radius, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.restore();

      const effectiveDensity = Math.max(0.85, currentDensity);

      for (const star of stars) {
        if (star.visibilitySeed > effectiveDensity) continue;

        if (!prefersReducedMotion) {
          star.a += (Math.random() - 0.5) * star.twinkle;
          star.a = Math.min(1, Math.max(0.08, star.a));
        }

        const y = ((star.y + pointerOffsetY + scrollOffset) % height + height) % height;

        ctx.fillStyle = `rgb(${star.color[0]} ${star.color[1]} ${star.color[2]})`;
        ctx.globalAlpha = Math.min(1, star.a * currentBrightness);
        ctx.beginPath();
        ctx.arc(star.x + pointerOffsetX, y, star.r, 0, Math.PI * 2);
        ctx.fill();
      }

      // Frequent but controlled shooting stars for atmospheric motion.
      if (!prefersReducedMotion) {
        if (now >= nextShootingStarAt && shootingStars.length < 2) {
          const fromLeft = Math.random() > 0.5;
          const startX = fromLeft ? -120 : width + 120;
          const startY = Math.random() * (height * 0.45) + 20;
          const speed = 2.8 + Math.random() * 1.6;
          const angle = fromLeft ? 0.35 + Math.random() * 0.25 : Math.PI - (0.35 + Math.random() * 0.25);
          shootingStars.push({
            x: startX,
            y: startY,
            vx: Math.cos(angle) * speed,
            vy: Math.sin(angle) * speed,
            life: 0,
            maxLife: 90 + Math.random() * 45
          });
          nextShootingStarAt = now + 1700 + Math.random() * 2600;
        }

        for (let i = shootingStars.length - 1; i >= 0; i -= 1) {
          const shootingStar = shootingStars[i];
          shootingStar.x += shootingStar.vx;
          shootingStar.y += shootingStar.vy;
          shootingStar.life += 1;

          const t = shootingStar.life / shootingStar.maxLife;
          const alpha = Math.max(0, 0.9 * (1 - t));
          const tailX = shootingStar.x - shootingStar.vx * 7;
          const tailY = shootingStar.y - shootingStar.vy * 7;

          const gradient = ctx.createLinearGradient(shootingStar.x, shootingStar.y, tailX, tailY);
          gradient.addColorStop(0, `rgba(255, 255, 255, ${alpha})`);
          gradient.addColorStop(1, 'rgba(255, 255, 255, 0)');

          ctx.strokeStyle = gradient;
          ctx.lineWidth = 2;
          ctx.beginPath();
          ctx.moveTo(shootingStar.x, shootingStar.y);
          ctx.lineTo(tailX, tailY);
          ctx.stroke();

          if (
            shootingStar.life >= shootingStar.maxLife ||
            shootingStar.x < -240 ||
            shootingStar.x > width + 240 ||
            shootingStar.y > height + 120
          ) {
            shootingStars.splice(i, 1);
          }
        }
      }

      ctx.globalAlpha = 1;
      if (!prefersReducedMotion) requestAnimationFrame(draw);
    };

    if (allowPointerParallax) {
      window.addEventListener('pointermove', (event) => {
        pointerX = event.clientX;
        pointerY = event.clientY;
      }, { passive: true });
    }

    window.addEventListener('scroll', () => {
      scrollY = getSafeScrollY();
      updateTargetsFromScroll();
      if (prefersReducedMotion) draw();
    }, { passive: true });

    window.addEventListener('resize', () => {
      const { widthChanged } = resize();
      // Mobile pull-to-refresh and browser UI chrome changes can trigger noisy height-only resizes.
      // Avoid reseeding the sky on those transient events so the background stays stable.
      if (!isTouchLikeDevice || widthChanged) {
        seedStars();
        seedNebula();
      }
      updateTargetsFromScroll();
      if (prefersReducedMotion) draw();
    });

    resize();
    seedStars();
    seedNebula();
    pointerX = width / 2;
    pointerY = height / 2;
    scrollY = getSafeScrollY();
    nextShootingStarAt = performance.now() + 1800;
    updateTargetsFromScroll();
    draw();
  })();

  (() => {
    const rail = document.getElementById('case-rail');
    const prevButton = document.querySelector('[data-case-prev]');
    const nextButton = document.querySelector('[data-case-next]');
    const currentNode = document.querySelector('[data-case-current]');
    const progressNode = document.querySelector('[data-case-progress]');

    if (!rail || !(rail instanceof HTMLElement) || !prevButton || !nextButton) return;

    const cards = Array.from(rail.querySelectorAll('.case-card'));
    const totalCards = cards.length;
    let activeIndex = 0;
    const EDGE_EPSILON = 4;

    const syncRailTailSpace = () => {
      const firstCard = cards[0];
      if (!(firstCard instanceof HTMLElement)) return;
      const trailingSpace = Math.max(0, rail.clientWidth - firstCard.offsetWidth);
      rail.style.setProperty('--size-case-rail-tail-space', `${trailingSpace}px`);
    };

    const updateProgress = () => {
      if (currentNode) currentNode.textContent = `${activeIndex + 1}`;
      if (progressNode instanceof HTMLElement) {
        const progress = totalCards <= 1 ? 1 : (activeIndex + 1) / totalCards;
        progressNode.style.transform = `scaleX(${progress.toFixed(4)})`;
      }
    };

    const updateActiveIndex = () => {
      if (rail.scrollLeft <= EDGE_EPSILON) {
        activeIndex = 0;
        updateProgress();
        return;
      }

      const maxScroll = Math.max(0, rail.scrollWidth - rail.clientWidth);
      if (rail.scrollLeft >= maxScroll - EDGE_EPSILON) {
        activeIndex = Math.max(0, totalCards - 1);
        updateProgress();
        return;
      }

      const railStart = rail.scrollLeft;
      let closestIndex = 0;
      let closestDistance = Number.POSITIVE_INFINITY;

      cards.forEach((card, index) => {
        if (!(card instanceof HTMLElement)) return;
        const distance = Math.abs(card.offsetLeft - railStart);
        if (distance < closestDistance) {
          closestDistance = distance;
          closestIndex = index;
        }
      });

      activeIndex = closestIndex;
      updateProgress();
    };

    const updateButtons = () => {
      prevButton.removeAttribute('disabled');
      nextButton.removeAttribute('disabled');
      updateActiveIndex();
    };

    const scrollToIndex = (index) => {
      const nextIndex = Math.max(0, Math.min(index, totalCards - 1));
      const targetCard = cards[nextIndex];
      if (!(targetCard instanceof HTMLElement)) return;
      rail.scrollTo({ left: targetCard.offsetLeft, behavior: 'smooth' });
    };

    prevButton.addEventListener('click', () => {
      updateActiveIndex();
      const nextIndex = activeIndex <= 0 ? totalCards - 1 : activeIndex - 1;
      scrollToIndex(nextIndex);
    });
    nextButton.addEventListener('click', () => {
      updateActiveIndex();
      const nextIndex = activeIndex >= totalCards - 1 ? 0 : activeIndex + 1;
      scrollToIndex(nextIndex);
    });
    rail.addEventListener('scroll', updateButtons, { passive: true });
    window.addEventListener('resize', () => {
      syncRailTailSpace();
      updateButtons();
    });

    syncRailTailSpace();
    updateProgress();
    updateButtons();
  })();
</script>

---
import Layout from "../../layouts/Layout.astro";
import Header from "../../layouts/Header.astro";
import HomeFooter from "../../components/HomeFooter.astro";
import CaseStudyPage from "../../components/CaseStudyPage.astro";
---

<Layout title="Insurance Platform Transformation | Work | Dan Malarkey">
  <Header />
  <main>
    <CaseStudyPage
      eyebrow="Proof / Case study"
      title="Stabilizing an insurance platform through internal operations and member experience transformation."
      dek="An exec-first case study shell for a mission-critical platform transformation: what was at stake, what changed, how design leadership helped create alignment, and what outcomes the business gained."
      clientLabel="Anonymized insurance platform (engagement delivered through feature[23])"
      roleLabel="Design leadership and execution across internal and member-facing experiences"
      statusLabel="Shell page / public-safe content in progress"
      facts={[
        { label: "Industry", value: "Insurance / regulated operations" },
        { label: "Engagement shape", value: "Platform transformation and workflow redesign" },
        { label: "Scope", value: "Internal operations + member-facing experience" },
        { label: "Role", value: "Direction-setting, systems, and hands-on design execution" }
      ]}
      stakes={[
        "Core workflows and data quality directly affected operational confidence and future growth capacity.",
        "The business needed stronger alignment between internal operations, product direction, and member experience priorities.",
        "Leadership needed clarity quickly without creating additional delivery chaos."
      ]}
      beforeRows={[
        "Workflow decisions were fragmented across internal and member-facing experiences.",
        "Operational and experience priorities competed instead of reinforcing each other.",
        "Teams needed clearer decision criteria to move faster with confidence."
      ]}
      afterRows={[
        "Internal operations and member experience work were aligned under a clearer platform direction.",
        "Design work supported execution decisions and system patterns, not just screens.",
        "The team had a stronger foundation for future member growth."
      ]}
      howRows={[
        "Established clearer priorities and decision framing across internal and member-facing work.",
        "Used systems-led design patterns to support reuse, consistency, and implementation speed.",
        "Stayed close to the work so strategic direction translated into shippable decisions.",
        "Aligned leadership, product, and delivery conversations around the same tradeoffs."
      ]}
      approach={[
        {
          title: "Direction and scope framing",
          body: "Clarified what needed to change first, what could wait, and how internal operations and member-facing work needed to support each other instead of moving as separate initiatives."
        },
        {
          title: "Systems and workflow design",
          body: "Focused on reusable patterns, decision clarity, and workflow structure to improve execution quality without increasing process overhead."
        },
        {
          title: "Execution partnership",
          body: "Worked across leadership and delivery conversations so design decisions remained connected to implementation realities and business constraints."
        }
      ]}
      outcomes={[
        { label: "Transformation scope", value: "Mission-critical platform work across internal operations and member experience" },
        { label: "Leadership contribution", value: "Direction-setting plus hands-on design execution through feature[23]" },
        { label: "Business impact theme", value: "Operational stability, decision clarity, and stronger foundation for future member growth" }
      ]}
      evidenceNotes={[
        "Add internal workflow artifact or system diagram crop (public-safe).",
        "Add member-facing experience UI crop tied to the same platform story.",
        "Add outcome evidence snapshot (metrics or directional indicators) when approved.",
        "Add attribution note once client naming permissions are clarified."
      ]}
    />
  </main>
  <HomeFooter
    eyebrow="Work with me"
    title="If you need this level of design leadership in a high-stakes environment, reach out."
    body="I work across leadership and execution, including advisory, fractional leadership, and targeted transformation support for teams navigating complexity and change."
  />
</Layout>


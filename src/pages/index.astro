  .home-pillars-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .home-pillar {
    position: relative;
    display: flex;
    min-height: 23.5rem;
    flex-direction: column;
    justify-content: flex-start;
    gap: 0;
    padding: 3rem 2.2rem 2.4rem;
    overflow: hidden;
    background:
      radial-gradient(ellipse at 100% 0%, rgba(121, 154, 255, 0.1), transparent 18rem),
      linear-gradient(180deg, rgba(137, 169, 226, 0.055), rgba(137, 169, 226, 0.02)),
      rgba(var(--ds-surface-panel-rgb), 0.82);
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      transform 180ms ease;

    width: var(--home-brand-width-scrolled);
  }

  .home-header-availability {
    display: inline-flex;
    grid-column: 2;
    align-items: center;
    gap: 0.46rem;
    justify-self: start;
    align-self: center;
    width: fit-content;
    max-width: 100%;
    padding: 0.38rem 0.62rem;
    border: 1px solid rgba(231, 235, 242, 0.1);
    border-radius: 999rem;
    background: rgba(255, 255, 255, 0.035);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.045),
      0 0.45rem 1.2rem rgba(0, 0, 0, 0.1);
    color: rgba(231, 235, 242, 0.72);
    font-size: var(--home-type-label-compact);
    font-weight: var(--font-weight-medium);
    line-height: var(--home-line-section-title-compact);
    letter-spacing: 0;
    white-space: nowrap;
    opacity: 0;
    transform: translateX(-0.28rem);
    pointer-events: none;
    transition:
      opacity 420ms ease,
      transform 420ms ease,
      border-color 420ms ease,
      background 420ms ease;
  }

  .home-header.is-scrolled .home-header-availability {
    opacity: 1;
    transform: translateX(0);
    pointer-events: auto;
  }

  .home-header-availability-dot {
    position: relative;
    flex: 0 0 auto;
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 999rem;
    background: rgba(165, 238, 194, 0.9);
    box-shadow:
      0 0 0 0.16rem rgba(105, 220, 150, 0.09),
      0 0 0.95rem rgba(105, 220, 150, 0.28);
  }

  .home-header-availability-dot::after {
    content: '';

---
import Header from '../layouts/Header.astro';
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
---

<Layout title="Dan Malarkey title here">
    <div class="tri-lay" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; overflow: hidden;">
        <img class="" src="/images/blur-tri.png" alt="blurred triangle" style="position: absolute; left: 0; z-index: -1; top: -75%; opacity: 0.45;"></img>
    </div>

	<Header  title="Home"/>
	<main>
        <div class="intro-mh">
            <div class="dm-grid-l dm-grid-l--grid-sys">
                <h1 class="intro-title">Design leadership for organizations navigating growth, complexity, and change.</h1>
            </div>
            <div class="dm-grid-l dm-grid-l--grid-sys">
                <p class="intro-text">
                    <!--<strong class="black-font" style="margin-bottom: 0; font-size: 1.75rem; font-weight: 900;">What do you expect from this.</strong><br>-->
                    I help businesses scale design capability, align teams, and build systems that support what's next—whether that's incremental improvement or radical transformational change.
                </p>
                <div style="grid-column: 4/26;">
                    <span style="background-color: #171717; border: 1px solid #232323; padding: 0.25rem 1rem; border-radius: 24rem; color: white;">
                        <span>Chief Product Designer at featurep[23] since 2012</span>
                    </span>
                </div>
                <div style="grid-column: 4/26;">
                    <span style="display: flex; gap: 1rem; color: rgba(255, 255, 255, 0.5); font-size: 0.875rem;">
                         <span>17 years across startups to Fortune 100</span> •
                        <span>Strategy, Systems, and Execution</span>
                    </span>
                </div>
            </div>
        </div>

        <div class="intro-cards card-grid dm-grid-l dm-grid-l--grid-sys">
            <div class="card">
                <h2>Executives & <br>Founders</h2>
                <small>For leaders navigating uncertainty</small>
                <ul>
                    <li> Scaling without breaking culture or quality</li>
                    <li> Turning design into a business capability</li>
                    <li> Making smart, and safe, bets in ambiguous markets</li>
                </ul>
            </div>
            <div class="card">
                <h2>Product & <br>Engineering Teams</h2>
                <small>For teams shipping complex products</small>
                <ul>
                    <li> Clarifying direction and priorities</li>
                    <li> Building systems instead of one-off solutions</li>
                    <li> Improving collaboration between product, design, and engineering</li>
                </ul>
            </div>
            <div class="card">
                <h2>Designers & <br>Design Leaders</h2>
                <small>For growing design teams and orgs</small>
                <ul>
                    <li> Maturing design practices</li>
                    <li>Establishing standards and systems</li>
                    <li>Elevating design's role beyond execution</li>
                </ul>
            </div>

        </div>



	</main>
</Layout>

<style>
	.intro-mh {
        margin-top: 5rem;
    }

	main {
		margin: auto;
		padding: 1rem;
		//width: clamp(45rem, 65rem, 65rem);
		max-width: calc(100% - 2rem);
		font-size: 20px;
		line-height: 1.6;
		//font-family: "Helvetica Neue";
		//color: #444;
	}
	.astro-a {
		position: absolute;
		top: -32px;
		left: 50%;
		transform: translatex(-50%);
		width: 220px;
		height: auto;
		z-index: -1;
	}


	p {
		color: #7a7a7a;
		font-size: 1.25rem;
		font-weight: 400;
	}
	.text-gradient {
		background-image: var(--accent-gradient);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-size: 400%;
		background-position: 0%;
	}
	.instructions {
		margin-bottom: 2rem;
		border: 1px solid rgba(var(--accent-light), 25%);
		background: linear-gradient(rgba(var(--accent-dark), 66%), rgba(var(--accent-dark), 33%));
		padding: 1.5rem;
		border-radius: 8px;
	}
	.instructions code {
		font-size: 0.8em;
		font-weight: bold;
		background: rgba(var(--accent-light), 12%);
		color: rgb(var(--accent-light));
		border-radius: 4px;
		padding: 0.3em 0.4em;
	}
	.instructions strong {
		color: rgb(var(--accent-light));
	}
	.link-card-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(24ch, 1fr));
		gap: 2rem;
		padding: 0;
	}
</style>

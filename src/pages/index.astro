  }

  .home-practice-stars {
    top: 50%;
    left: 50%;
    width: 128%;
    height: 88%;
    transform: translate(-50%, -50%) scale(0.96);
    background:
      radial-gradient(circle at 16% 38%, rgba(232, 241, 255, 0.83) 0 0.8px, transparent 1.55px),
      radial-gradient(circle at 21% 52%, rgba(214, 232, 255, 0.58) 0 0.75px, transparent 1.45px),
      radial-gradient(circle at 28% 68%, rgba(195, 223, 255, 0.63) 0 0.8px, transparent 1.5px),
      radial-gradient(circle at 33% 34%, rgba(214, 232, 255, 0.54) 0 0.75px, transparent 1.45px),
      radial-gradient(circle at 41% 24%, rgba(232, 241, 255, 0.74) 0 0.88px, transparent 1.6px),
      radial-gradient(circle at 48% 62%, rgba(214, 232, 255, 0.52) 0 0.74px, transparent 1.42px),
      radial-gradient(circle at 56% 38%, rgba(232, 241, 255, 0.65) 0 0.8px, transparent 1.5px),
      radial-gradient(circle at 63% 18%, rgba(232, 241, 255, 0.77) 0 0.82px, transparent 1.55px),
      radial-gradient(circle at 68% 72%, rgba(214, 232, 255, 0.5) 0 0.74px, transparent 1.42px),
      radial-gradient(circle at 72% 58%, rgba(195, 223, 255, 0.67) 0 0.8px, transparent 1.5px),
      radial-gradient(circle at 77% 24%, rgba(214, 232, 255, 0.58) 0 0.78px, transparent 1.45px),
      radial-gradient(circle at 86% 32%, rgba(232, 241, 255, 0.79) 0 0.88px, transparent 1.6px),
      radial-gradient(circle at 82% 72%, rgba(195, 223, 255, 0.61) 0 0.8px, transparent 1.5px),
      radial-gradient(circle at 91% 54%, rgba(214, 232, 255, 0.54) 0 0.75px, transparent 1.45px);
    filter: blur(0.1px);
    z-index: 0;
  }

  .home-practice-nebula {
    top: 48%;
    left: 50%;
    width: 128%;
    height: 78%;
    transform: translate(-50%, -50%) scale(0.95);
    z-index: 0;
  }

  .home-practice-nebula::before,
  .home-practice-nebula::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 999px;
    filter: blur(38px);
  }

  .home-practice-nebula::before {
    background:
      radial-gradient(ellipse at 35% 45%,
        rgba(117, 170, 255, 0.2) 0%,
        rgba(117, 170, 255, 0.09) 24%,
        rgba(117, 170, 255, 0) 62%);
    transform: rotate(-10deg);
  }

  .home-practice-nebula::after {
    background:
      radial-gradient(ellipse at 68% 58%,
        rgba(189, 225, 255, 0.12) 0%,
        rgba(189, 225, 255, 0.05) 20%,
        rgba(189, 225, 255, 0) 60%);
    transform: rotate(14deg);

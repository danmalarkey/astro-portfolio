---
import Header from '../layouts/Header.astro';
import Layout from '../layouts/Layout.astro';

const leverageCards = [
  {
    title: 'Executives, founders, and product owners',
    description: 'Clarifying product direction, aligning priorities, and ensuring design meaningfully supports business outcomes.',
    bgClass: 'exec-bg'
  },
  {
    title: 'Product and engineering teams',
    description: 'Strengthening collaboration, reducing delivery friction, and building shared patterns that scale.',
    bgClass: 'prod-bg'
  },
  {
    title: 'Designers and design leaders',
    description: 'Elevating practice maturity, establishing standards, and increasing design’s strategic voice.',
    bgClass: 'design-bg'
  }
];

const practiceStats = [
  { label: '17+', text: 'Years in product and design leadership' },
  { label: 'Startup to enterprise', text: 'Experience across organizational scale' },
  { label: 'Built for scale', text: 'Products, teams, and standards designed for durability' }
];

const proofMetrics = [
  { label: 'Conversion impact', value: '+250%', detail: 'Membership growth in first 6 months' },
  { label: 'Workflow efficiency', value: '-46%', detail: 'Design-to-dev rework reduction' },
  { label: 'Onboarding friction', value: '-38%', detail: 'Lower activation drop-off across key journeys' }
];

const caseStudies = [
  {
    image: '/images/img.png',
    imageAlt: 'Banking customer using laptop at home',
    logo: 'VyStar',
    logoImage: '/images/case-logos/vystar.svg',
    logoAlt: 'VyStar logo',
    role: 'Chief Product Designer',
    tags: ['Transformation', 'User Experience', 'Product'],
    outcome: 'Increasing bank memberships by 250% in the first six months.',
    text: 'Aligned competing bets into one roadmap and a shared decision framework.'
  },
  {
    image: '/images/dan-right.png',
    imageAlt: 'Product leader in office environment',
    logo: 'Northline',
    logoImage: '/images/case-logos/northline.svg',
    logoAlt: 'Northline logo',
    role: 'Fractional product design lead',
    tags: ['Service Design', 'Operations', 'Growth'],
    outcome: 'Cut onboarding friction by 38% while improving activation quality.',
    text: 'Defined reusable design and engineering patterns that improved consistency at speed.'
  },
  {
    image: '/images/dan.png',
    imageAlt: 'Team leader at desk',
    logo: 'HarborTech',
    logoImage: '/images/case-logos/harbortech.svg',
    logoAlt: 'HarborTech logo',
    role: 'Product and design advisor',
    tags: ['Platform', 'Business to business', 'Design systems'],
    outcome: 'Shipped a unified platform experience across three enterprise products.',
    text: 'Introduced leadership rhythms and standards that shifted design earlier in decision-making.'
  },
  {
    image: '/images/img.png',
    imageAlt: 'Professional working remotely on strategic planning',
    logo: 'Astera Health',
    logoImage: '/images/case-logos/astera.svg',
    logoAlt: 'Astera Health logo',
    role: 'Interim head of product design',
    tags: ['Healthcare', 'Customer experience', 'Workflow'],
    outcome: 'Reduced patient intake completion time by 41% across core service flows.',
    text: 'Reframed intake journey architecture and aligned product-engineering decisions around high-friction touchpoints.'
  }
];

const engagementItems = [
  {
    title: 'Fractional design leadership',
    text: 'Ongoing senior partnership for strategy, organizational alignment, and high-leverage product decisions.',
    icon: 'orbit'
  },
  {
    title: 'Transformation program',
    text: 'Focused 4–8 week engagement to diagnose friction, align teams, and establish a practical operating model.',
    icon: 'pulse'
  },
  {
    title: 'Advisory for leaders',
    text: 'Targeted support for founders and product leaders navigating growth, change, or organization scaling.',
    icon: 'signal'
  }
];
---

<Layout title="Dan Malarkey | Fractional Chief Product Designer">
  <div class="site-sky" aria-hidden="true">
    <canvas id="site-stars"></canvas>
  </div>

  <Header />

  <main>
    <section class="intro-mh" id="top" data-star-density="1" data-star-brightness="1">
      <div class="sky-burst" aria-hidden="true"></div>

      <div class="dm-grid-l dm-grid-l--grid-sys">
      <div class="hero-shell gc-start-2 gc-span-24">
        <div class="dm-grid-l dm-grid-l--grid-sys">
          <div class="intro-sub-list intro-sub-list--top">
            <span class="pill">
              <span>Fractional chief product designer <span class="separator">•</span> 17+ years <span class="separator">•</span> Startup to enterprise</span>
            </span>
          </div>
        </div>

        <div class="dm-grid-l dm-grid-l--grid-sys">
          <h1 class="intro-title text-white">Design leadership for organizations navigating growth, complexity, & change.</h1>
        </div>

        <div class="dm-grid-l dm-grid-l--grid-sys">
          <p class="intro-text">
            I help businesses scale design capability, align teams, and build the foundations that support what’s next, whether that’s incremental improvement or meaningful transformation.
          </p>
        </div>
      </div>
      </div>
    </section>

    <section class="section leverage section-panel section-surface--dark section-panel--hero-bridge" data-star-density="0.9" data-star-brightness="0.88">
      <div class="dm-grid-l dm-grid-l--grid-sys leadership-intro">
        <h2 class="section-title text-white gc-start-2 gc-span-22">Leadership across the organization.</h2>
        <p class="gc-start-2 gc-span-18">Design is most effective when vision, execution, and the people responsible for both are aligned.</p>
      </div>

      <div class="intro-cards col-layout col-layout--3x8 dm-grid-l dm-grid-l--grid-sys">
        {leverageCards.map((item) => (
          <article class={`card leverage-card ${item.bgClass}`}>
            <div class="card-content">
              <div class="head-group">
                <h3>{item.title}</h3>
              </div>
              <p>{item.description}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section about-panel-wrap section-panel section-surface--warm" data-star-density="0.7" data-star-brightness="0.68">
      <div class="about-feature dm-grid-l dm-grid-l--grid-sys">
        <div class="about-feature--body gc-start-2 gc-span-12">
          <h2 class="section-title">Business success grounded in practice.</h2>
          <p>
            I’m a product and design leader who helps organizations bring clarity to complex problems and build design capability that scales, working closely with executives, product, and engineering teams to support what’s next.
          </p>
          <p>
            I’ve led through early-stage growth, enterprise complexity, and moments of significant organizational change.
          </p>
        </div>

        <div class="about-feature--media gc-start-14 gc-span-12">
          <img src="/images/dan-right.png" alt="Dan Malarkey" class="round-radi-1" />
        </div>

        <div class="about-highlights gc-start-2 gc-span-24">
          {practiceStats.map((item) => (
            <article class="about-highlights--item">
              <p class="about-highlights--value">{item.label}</p>
              <p class="about-highlights--text">{item.text}</p>
            </article>
          ))}
        </div>
        <div class="proof-intro gc-start-2 gc-span-24">
          <h3>Outcomes tied to business movement.</h3>
          <p>Measurable impact across growth-stage and enterprise contexts.</p>
        </div>
        <div class="proof-metrics gc-start-2 gc-span-24">
          {proofMetrics.map((item) => (
            <article class="proof-metric">
              <p class="proof-metric--value">{item.value}</p>
              <p>{item.label}</p>
              <p class="proof-metric--detail">{item.detail}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section case-studies section-panel section-surface--dark section-transition-impact" data-star-density="0.82" data-star-brightness="0.82">
      <div class="dm-grid-l dm-grid-l--grid-sys case-intro case-intro--with-controls">
        <h2 class="section-title case-title text-white gc-start-2 gc-span-16">Selected impact</h2>
        <p class="gc-start-2 gc-span-18">Case-study style snapshots you can expand later with full story pages.</p>
        <div class="case-rail-controls gc-start-19 gc-span-7" aria-label="Case studies navigation">
          <div class="case-rail-progress" aria-live="polite">
            <p class="case-rail-count"><span data-case-current>1</span><span class="case-rail-sep">/</span><span data-case-total>{caseStudies.length}</span></p>
            <div class="case-rail-track" aria-hidden="true"><span data-case-progress></span></div>
          </div>
          <button type="button" class="case-rail-btn" data-case-prev aria-controls="case-rail" aria-label="Scroll to previous case study">Previous</button>
          <button type="button" class="case-rail-btn" data-case-next aria-controls="case-rail" aria-label="Scroll to next case study">Next</button>
        </div>
      </div>

      <div class="case-rail-wrap dm-grid-l dm-grid-l--grid-sys">
        <div class="case-rail gc-start-2 gc-span-24" id="case-rail" tabindex="0" aria-label="Featured case studies">
        {caseStudies.map((item) => (
          <article class="case-card">
            <img src={item.image} alt={item.imageAlt} />
            <div class="case-overlay">
              <div class="case-meta">
                {item.logoImage ? (
                  <img class="case-logo-image" src={item.logoImage} alt={item.logoAlt ?? `${item.logo} logo`} />
                ) : (
                  <p class="case-logo">{item.logo}</p>
                )}
                <ul class="case-tags">
                  {item.tags.map((tag) => <li>{tag}</li>)}
                </ul>
              </div>
              <p class="case-role">{item.role}</p>
              <h3 class="case-outcome">{item.outcome}</h3>
              <p class="case-summary">{item.text}</p>
            </div>
          </article>
        ))}
        </div>
      </div>
    </section>

    <section class="section ways-to-engage section-panel section-surface--light" data-star-density="0.82" data-star-brightness="0.82">
      <div class="dm-grid-l dm-grid-l--grid-sys section-head">
        <h2 class="section-title gc-start-2 gc-span-16">Ways to engage</h2>
        <p class="gc-start-2 gc-span-18">Here’s how support is structured in practice, from embedded leadership to focused change work.</p>
      </div>
      <div class="engagement-model dm-grid-l dm-grid-l--grid-sys">
        {engagementItems.map((item) => (
          <article class="engagement-model--item">
            <div class="engagement-model--head">
              <div class={`engagement-model--icon icon-${item.icon}`} aria-hidden="true">
                <span></span>
              </div>
            </div>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section close-cta section-panel section-surface--dark" data-star-density="0.88" data-star-brightness="0.88">
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <div class="cta-panel gc-start-4 gc-span-20">
          <p>
            If you’re navigating growth, complexity, or change, and want design leadership that strengthens your product and your teams, I’d welcome a conversation.
          </p>
          <a href="mailto:hello@example.com" class="cta-link">Start a Conversation</a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script is:inline>
  (() => {
    const canvas = document.getElementById('site-stars');
    if (!canvas || !(canvas instanceof HTMLCanvasElement)) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const stars = [];
    const nebulaClouds = [];
    const starPalette = [
      [255, 255, 255],
      [214, 232, 255],
      [255, 228, 177],
      [198, 220, 255],
      [255, 245, 223]
    ];
    const nebulaPalette = [
      [88, 111, 255],
      [58, 180, 255],
      [186, 88, 255],
      [242, 125, 199]
    ];
    const STAR_COUNT = 420;
    let width = 0;
    let height = 0;
    let pointerX = 0;
    let pointerY = 0;
    let scrollY = 0;
    let currentDensity = 1;
    let currentBrightness = 1;
    let targetDensity = 1;
    let targetBrightness = 1;
    let sectionProfiles = [];
    let shootingStar = null;
    let nextShootingStarAt = 0;

    const resize = () => {
      width = window.innerWidth;
      height = window.innerHeight;
      const ratio = Math.max(window.devicePixelRatio || 1, 1);
      canvas.width = Math.floor(width * ratio);
      canvas.height = Math.floor(height * ratio);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      ctx.setTransform(ratio, 0, 0, ratio, 0, 0);

      sectionProfiles = Array.from(document.querySelectorAll('[data-star-density]')).map((section) => {
        const rect = section.getBoundingClientRect();
        const start = rect.top + window.scrollY;
        const end = start + rect.height;
        const density = Number(section.getAttribute('data-star-density') || 1);
        const brightness = Number(section.getAttribute('data-star-brightness') || 1);
        return { start, end, density, brightness };
      });
    };

    const seedStars = () => {
      stars.length = 0;
      for (let i = 0; i < STAR_COUNT; i += 1) {
        const color = starPalette[Math.floor(Math.random() * starPalette.length)];
        const radius = Math.pow(Math.random(), 1.3) * 1.8 + 0.25;
        stars.push({
          x: Math.random() * width,
          y: Math.random() * height,
          r: radius,
          a: Math.random() * 0.8 + 0.15,
          twinkle: Math.random() * 0.022 + 0.002,
          visibilitySeed: Math.random(),
          color
        });
      }
    };

    const seedNebula = () => {
      nebulaClouds.length = 0;
      const cloudCount = Math.max(3, Math.round(width / 430));
      for (let i = 0; i < cloudCount; i += 1) {
        const color = nebulaPalette[Math.floor(Math.random() * nebulaPalette.length)];
        nebulaClouds.push({
          x: width * (0.15 + Math.random() * 0.7),
          y: height * (0.06 + Math.random() * 0.42),
          radius: 180 + Math.random() * 280,
          alpha: 0.12 + Math.random() * 0.1,
          drift: 8 + Math.random() * 10,
          phase: Math.random() * Math.PI * 2,
          color
        });
      }
    };

    const updateTargetsFromScroll = () => {
      const probeY = scrollY + height * 0.42;
      const profile = sectionProfiles.find((item) => probeY >= item.start && probeY <= item.end);
      targetDensity = profile ? profile.density : 1;
      targetBrightness = profile ? profile.brightness : 1;
    };

    const draw = () => {
      ctx.clearRect(0, 0, width, height);

      const pointerOffsetX = (pointerX - width / 2) * 0.008;
      const pointerOffsetY = (pointerY - height / 2) * 0.01;
      const scrollOffset = -(scrollY * 0.045);
      const now = performance.now();

      currentDensity += (targetDensity - currentDensity) * 0.055;
      currentBrightness += (targetBrightness - currentBrightness) * 0.055;

      ctx.save();
      ctx.globalCompositeOperation = 'screen';
      for (const cloud of nebulaClouds) {
        const cx = cloud.x + Math.sin(now * 0.00006 + cloud.phase) * cloud.drift;
        const cy = cloud.y + Math.cos(now * 0.00005 + cloud.phase) * cloud.drift * 0.5 + pointerOffsetY * 0.05;
        const gradient = ctx.createRadialGradient(cx, cy, 0, cx, cy, cloud.radius);
        gradient.addColorStop(0, `rgba(${cloud.color[0]}, ${cloud.color[1]}, ${cloud.color[2]}, ${cloud.alpha * currentBrightness})`);
        gradient.addColorStop(0.45, `rgba(${cloud.color[0]}, ${cloud.color[1]}, ${cloud.color[2]}, ${cloud.alpha * 0.36})`);
        gradient.addColorStop(1, `rgba(${cloud.color[0]}, ${cloud.color[1]}, ${cloud.color[2]}, 0)`);
        ctx.fillStyle = gradient;
        ctx.beginPath();
        ctx.arc(cx, cy, cloud.radius, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.restore();

      const effectiveDensity = Math.max(0.85, currentDensity);

      for (const star of stars) {
        if (star.visibilitySeed > effectiveDensity) continue;

        if (!prefersReducedMotion) {
          star.a += (Math.random() - 0.5) * star.twinkle;
          star.a = Math.min(1, Math.max(0.08, star.a));
        }

        const y = ((star.y + pointerOffsetY + scrollOffset) % height + height) % height;

        ctx.fillStyle = `rgb(${star.color[0]} ${star.color[1]} ${star.color[2]})`;
        ctx.globalAlpha = Math.min(1, star.a * currentBrightness);
        ctx.beginPath();
        ctx.arc(star.x + pointerOffsetX, y, star.r, 0, Math.PI * 2);
        ctx.fill();
      }

      // Occasional shooting star for atmospheric motion.
      if (!prefersReducedMotion) {
        if (!shootingStar && now >= nextShootingStarAt) {
          const fromLeft = Math.random() > 0.5;
          const startX = fromLeft ? -120 : width + 120;
          const startY = Math.random() * (height * 0.45) + 20;
          const speed = 4.5 + Math.random() * 2.5;
          const angle = fromLeft ? 0.35 + Math.random() * 0.25 : Math.PI - (0.35 + Math.random() * 0.25);
          shootingStar = {
            x: startX,
            y: startY,
            vx: Math.cos(angle) * speed,
            vy: Math.sin(angle) * speed,
            life: 0,
            maxLife: 90 + Math.random() * 45
          };
        }

        if (shootingStar) {
          shootingStar.x += shootingStar.vx;
          shootingStar.y += shootingStar.vy;
          shootingStar.life += 1;

          const t = shootingStar.life / shootingStar.maxLife;
          const alpha = Math.max(0, 0.9 * (1 - t));
          const tailX = shootingStar.x - shootingStar.vx * 7;
          const tailY = shootingStar.y - shootingStar.vy * 7;

          const gradient = ctx.createLinearGradient(shootingStar.x, shootingStar.y, tailX, tailY);
          gradient.addColorStop(0, `rgba(255, 255, 255, ${alpha})`);
          gradient.addColorStop(1, 'rgba(255, 255, 255, 0)');

          ctx.strokeStyle = gradient;
          ctx.lineWidth = 2;
          ctx.beginPath();
          ctx.moveTo(shootingStar.x, shootingStar.y);
          ctx.lineTo(tailX, tailY);
          ctx.stroke();

          if (
            shootingStar.life >= shootingStar.maxLife ||
            shootingStar.x < -240 ||
            shootingStar.x > width + 240 ||
            shootingStar.y > height + 120
          ) {
            shootingStar = null;
            nextShootingStarAt = now + 5000 + Math.random() * 6000;
          }
        }
      }

      ctx.globalAlpha = 1;
      if (!prefersReducedMotion) requestAnimationFrame(draw);
    };

    window.addEventListener('pointermove', (event) => {
      pointerX = event.clientX;
      pointerY = event.clientY;
    });

    window.addEventListener('scroll', () => {
      scrollY = window.scrollY;
      updateTargetsFromScroll();
      if (prefersReducedMotion) draw();
    }, { passive: true });

    window.addEventListener('resize', () => {
      resize();
      seedStars();
      seedNebula();
      updateTargetsFromScroll();
      if (prefersReducedMotion) draw();
    });

    resize();
    seedStars();
    seedNebula();
    pointerX = width / 2;
    pointerY = height / 2;
    scrollY = window.scrollY;
    nextShootingStarAt = performance.now() + 2600;
    updateTargetsFromScroll();
    draw();
  })();

  (() => {
    const rail = document.getElementById('case-rail');
    const prevButton = document.querySelector('[data-case-prev]');
    const nextButton = document.querySelector('[data-case-next]');
    const currentNode = document.querySelector('[data-case-current]');
    const progressNode = document.querySelector('[data-case-progress]');

    if (!rail || !(rail instanceof HTMLElement) || !prevButton || !nextButton) return;

    const cards = Array.from(rail.querySelectorAll('.case-card'));
    const totalCards = cards.length;
    let activeIndex = 0;

    const updateProgress = () => {
      if (currentNode) currentNode.textContent = `${activeIndex + 1}`;
      if (progressNode instanceof HTMLElement) {
        const progress = totalCards <= 1 ? 1 : (activeIndex + 1) / totalCards;
        progressNode.style.transform = `scaleX(${progress.toFixed(4)})`;
      }
    };

    const updateActiveIndex = () => {
      const railCenter = rail.scrollLeft + rail.clientWidth / 2;
      let closestIndex = 0;
      let closestDistance = Number.POSITIVE_INFINITY;

      cards.forEach((card, index) => {
        if (!(card instanceof HTMLElement)) return;
        const center = card.offsetLeft + card.offsetWidth / 2;
        const distance = Math.abs(center - railCenter);
        if (distance < closestDistance) {
          closestDistance = distance;
          closestIndex = index;
        }
      });

      activeIndex = closestIndex;
      updateProgress();
    };

    const updateButtons = () => {
      const maxScroll = rail.scrollWidth - rail.clientWidth;
      prevButton.toggleAttribute('disabled', rail.scrollLeft <= 4);
      nextButton.toggleAttribute('disabled', rail.scrollLeft >= maxScroll - 4);
      updateActiveIndex();
    };

    const scrollByCard = (direction) => {
      const firstCard = rail.querySelector('.case-card');
      if (!(firstCard instanceof HTMLElement)) return;
      const cardWidth = firstCard.getBoundingClientRect().width;
      const gap = 24;
      rail.scrollBy({ left: direction * (cardWidth + gap), behavior: 'smooth' });
    };

    prevButton.addEventListener('click', () => scrollByCard(-1));
    nextButton.addEventListener('click', () => scrollByCard(1));
    rail.addEventListener('scroll', updateButtons, { passive: true });
    window.addEventListener('resize', updateButtons);

    updateProgress();
    updateButtons();
  })();
</script>

    transform: scale(0.72);
    animation: home-header-availability-pulse 2.4s ease-in-out infinite;
  }

  .home-nav-links {
    display: flex;
    align-items: center;
    gap: 0.72rem;
    color: var(--home-text-muted);
    font-size: var(--home-type-body-xs);

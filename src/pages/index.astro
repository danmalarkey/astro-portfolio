  .home-pillar--strategy::before {
    background:
      radial-gradient(ellipse 88% 72% at 38% 34%, rgba(148, 108, 255, 0.16) 0%, rgba(148, 108, 255, 0.06) 28%, rgba(148, 108, 255, 0) 62%);
  }

  .home-pillar--systems::before {
    background:
      radial-gradient(ellipse 88% 72% at 52% 42%, rgba(102, 128, 255, 0.18) 0%, rgba(102, 128, 255, 0.07) 28%, rgba(102, 128, 255, 0) 62%);
  }

  .home-pillar-index,
  .home-pillar-main,
  .home-pillar-title,
  .home-pillar-headline,

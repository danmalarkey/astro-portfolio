  :global(body:has(.home)) {
    background-color: var(--ds-background);
  }

  .home {
    --home-bg: var(--ds-background);
    --home-surface: var(--ds-surface);
    --home-surface-strong: var(--ds-surface-strong);
    --home-surface-deep: var(--color-background-surface);
    --home-surface-elevated: var(--color-background-surface-alt);
    --home-surface-panel-rgb: var(--ds-surface-panel-rgb);
    --home-bg-rgb: var(--ds-background-rgb);
    --home-shadow: 0 1.25rem 3rem rgba(0, 5, 14, 0.34);
    --color-surface-dark-base: rgba(5, 12, 22, 0.92);
    --color-surface-dark-elevated: var(--home-surface-elevated);

    position: relative;
    isolation: isolate;
    overflow-x: clip;
    overflow-y: visible;
    background:
      radial-gradient(circle at top left, rgba(92, 126, 190, 0.12), transparent 24rem),
      radial-gradient(circle at bottom right, rgba(40, 79, 138, 0.14), transparent 30rem),
      var(--home-bg);
    color: var(--home-text);
    min-height: 100vh;
    min-height: 100dvh;
    padding: 0;
  }

  [data-home-reveal] {
    opacity: 0;
    transform: translateY(2rem);
    transition:
      opacity 1.05s ease,
      transform 1.15s ease;
    will-change: opacity, transform;
  }

  [data-home-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .home-intro {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    height: 100vh;
    height: 100dvh;
    min-height: 100vh;
    min-height: 100dvh;
    padding-top: 0;
    padding-bottom: 0;
    box-sizing: border-box;
  }

  .home::before,
  .home::after {
    content: '';
    position: absolute;
    left: -10rem;
    pointer-events: none;
    transform: rotate(-22deg);
    transform-origin: top left;
    z-index: 0;
  }

  .home::before {
    top: -4rem;
    left: -7rem;
    width: 78rem;
    height: 24rem;
    background:
      linear-gradient(90deg, transparent 8%, rgba(255, 255, 255, 0.2) 13%, rgba(255, 255, 255, 0.055) 16%, transparent 22%),
      linear-gradient(90deg, transparent 18%, rgba(255, 255, 255, 0.12) 23%, rgba(255, 255, 255, 0.03) 26%, transparent 32%),
      linear-gradient(90deg, transparent 30%, rgba(255, 255, 255, 0.085) 35%, rgba(255, 255, 255, 0.022) 39%, transparent 46%);
    filter: blur(9px);
    opacity: 0.04;
    -webkit-mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.92), rgba(0, 0, 0, 0.42) 48%, rgba(0, 0, 0, 0.08) 76%, transparent 100%);
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.92), rgba(0, 0, 0, 0.42) 48%, rgba(0, 0, 0, 0.08) 76%, transparent 100%);
  }

  .home::after {
    top: 0.25rem;
    left: -2rem;
    width: 72rem;
    height: 18rem;
    background:
      linear-gradient(90deg, transparent 11%, rgba(255, 255, 255, 0.11) 15%, rgba(255, 255, 255, 0.022) 18%, transparent 23%),
      linear-gradient(90deg, transparent 24%, rgba(255, 255, 255, 0.075) 28%, rgba(255, 255, 255, 0.016) 31%, transparent 36%);
    filter: blur(16px);
    opacity: 0;
    -webkit-mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.84), rgba(0, 0, 0, 0.34) 54%, rgba(0, 0, 0, 0.06) 78%, transparent 100%);
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.84), rgba(0, 0, 0, 0.34) 54%, rgba(0, 0, 0, 0.06) 78%, transparent 100%);
  }

  .home a {
    color: inherit;
    text-decoration: none;
  }

  .home-header {
    position: fixed;
    top: var(--home-header-top);
    left: 0;
    z-index: 24;
    width: 100%;
    margin: 0;
    padding: 0;
    pointer-events: none;
    padding-inline: var(--home-header-inline);
  }

  .home-header-shell {
    margin: 0 auto;
  }

  .home-trust,
  .home-client-trust,
  .home-pillars,
  .home-shift,
  .home-operating-shift {
    margin: 0 auto;
  }

  .home-hero {
    position: relative;
    z-index: 1;
    align-self: stretch;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    min-height: 100vh;
    min-height: 100dvh;
    margin-inline: calc(50% - 50vw);
    padding-inline: 0;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .home-client-trust {
    position: relative;
    z-index: 2;
    padding: clamp(2.3rem, 4.6vw, 4.6rem) 0 clamp(2.8rem, 5.2vw, 5.4rem);
  }

  .home-client-trust-shell {
    display: grid;
    gap: clamp(1rem, 2vw, 1.45rem);
    justify-items: center;
    overflow: hidden;
  }

  .home-client-trust-label {
    margin: 0;
    color: rgba(231, 235, 242, 0.82);
    font-size: var(--home-type-body-xs);
    font-weight: var(--font-weight-medium);
    line-height: var(--home-line-body-compact);
    letter-spacing: var(--home-tracking-text);
    opacity: 0;
    transform: translateY(0.42rem);
    transition:
      opacity 720ms ease,
      transform 760ms ease;
  }

  .home-client-marquee {
    position: relative;
    width: min(100%, 54rem);
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 14%, #000 86%, transparent);
    opacity: 0;
    transform: translateY(0.5rem);
    transition:
      opacity 820ms ease 120ms,
      transform 860ms ease 120ms;
  }

  .home-client-trust.is-visible .home-client-trust-label,
  .home-client-trust.is-visible .home-client-marquee {
    opacity: 1;
    transform: translateY(0);
  }

  .home-client-marquee-track {
    display: flex;
    width: max-content;
    align-items: center;
    gap: clamp(2.2rem, 5vw, 5.2rem);
    animation: home-client-marquee 72s linear infinite;
  }

  .home-client-marquee:hover .home-client-marquee-track {
    animation-play-state: paused;
  }

  .home-client-logo {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: calc(clamp(7.5rem, 12vw, 11.5rem) * var(--logo-width-scale, 1));
    opacity: 1;
    overflow: visible;
  }

  .home-client-logo img {
    display: block;
    width: auto;
    max-width: calc(clamp(7.5rem, 12vw, 11.5rem) * var(--logo-width-scale, 1));
    height: calc(clamp(1.45rem, 2.4vw, 2.25rem) * var(--logo-height-scale, 1));
    object-fit: contain;
    filter: brightness(0) invert(1);
  }

  @keyframes home-client-marquee {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(calc(-50% - (clamp(2.2rem, 5vw, 5.2rem) / 2)));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-client-trust-label,
    .home-client-marquee {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .home-client-marquee-track {
      animation: none;
      transform: translateX(0);
    }
  }

  .home-actors-intro {
    padding-inline: 0;
  }

  .home-focus-areas {
    position: relative;
    width: 100%;
  }

  .home-focus-areas-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--spacing-sm);
  }

  .home-focus-card {
    position: relative;
    isolation: isolate;
    display: grid;
    align-content: end;
    min-height: clamp(19rem, 28vw, 28rem);
    padding: clamp(var(--spacing-md), 3vw, var(--spacing-xl));
    overflow: hidden;
    border: var(--size-border-thin) solid rgba(121, 154, 255, 0.12);
    border-radius: var(--radius-card);
    background:
      radial-gradient(ellipse 58% 46% at 0% 0%, rgba(121, 154, 255, 0.18), rgba(121, 154, 255, 0.055) 38%, transparent 74%),
      radial-gradient(ellipse 46% 34% at 10% 4%, rgba(231, 235, 242, 0.08), rgba(231, 235, 242, 0.024) 42%, transparent 72%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.035), rgba(255, 255, 255, 0.01)),
      rgba(var(--home-surface-panel-rgb), 0.9);
    color: var(--home-text);
    text-decoration: none;
    box-shadow:
      inset 0 0 0 var(--size-border-thin) rgba(255, 255, 255, 0.025),
      0 1.4rem 3rem rgba(0, 0, 0, 0.18);
    transition:
      border-color 360ms ease,
      transform 360ms ease,
      box-shadow 360ms ease;
  }

  .home-focus-card--large {
    grid-column: span 3;
  }

  .home-focus-card--small {
    grid-column: span 1;
  }

  .home-focus-card::before,
  .home-focus-card::after,
  .home-focus-card-visual {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .home-focus-card::before {
    z-index: -2;
    background:
      linear-gradient(180deg, transparent 0 38%, rgba(3, 5, 9, 0.82) 100%),
      linear-gradient(90deg, rgba(3, 5, 9, 0.5), rgba(3, 5, 9, 0.1));
  }

  .home-focus-card::after {
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(231, 239, 255, 0.88), rgba(184, 207, 255, 0.52) 34%, rgba(121, 154, 255, 0.22) 68%, transparent),
      linear-gradient(180deg, rgba(231, 239, 255, 0.58), rgba(121, 154, 255, 0.24) 42%, transparent),
      linear-gradient(90deg, rgba(255, 255, 255, 0.025) 0 var(--size-border-thin), transparent var(--size-border-thin) 100%),
      radial-gradient(ellipse at 0% 0%, rgba(184, 207, 255, 0.24), rgba(121, 154, 255, 0.08) 32%, transparent 68%);
    background-position: top left, top left, top left, top left;
    background-size: min(18rem, 72%) var(--size-border-thin), var(--size-border-thin) min(10rem, 54%), 33.333% 100%, 100% 100%;
    background-repeat: no-repeat, no-repeat, repeat, no-repeat;
    opacity: 0.62;
    mask-image: linear-gradient(180deg, #000, transparent 72%);
    box-shadow:
      0 0.05rem 1.25rem rgba(121, 154, 255, 0.24),
      0 0 2.15rem rgba(105, 133, 255, 0.16);
    transition: opacity 360ms ease;
  }

  .home-focus-card--image .home-focus-card-visual {
    z-index: 0;
    background-image: var(--home-focus-card-image);
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    opacity: 0.7;
    transform: scale(1.02);
    transition:
      opacity 420ms ease,
      transform 520ms ease;
  }

  .home-focus-card--image::before {
    z-index: 1;
  }

  .home-focus-card--image::after {
    z-index: 2;
  }

  .home-focus-card--image .home-focus-card-content {
    z-index: 3;
  }

  .home-focus-card--operating .home-focus-card-visual {
    background-position: center right;
  }

  .home-focus-card--ai .home-focus-card-visual {
    background-position: center;
  }

  .home-focus-card--direction:not(.home-focus-card--image) .home-focus-card-visual,
  .home-focus-card--standards:not(.home-focus-card--image) .home-focus-card-visual {
    z-index: -3;
    opacity: 0.66;
    background:
      radial-gradient(circle at 72% 28%, rgba(176, 204, 255, 0.12), transparent 8rem),
      linear-gradient(135deg, transparent 0 44%, rgba(176, 204, 255, 0.08) 44% 44.6%, transparent 44.6%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.028), transparent);
  }

  .home-focus-card--direction.home-focus-card--image .home-focus-card-visual {
    background-position: right;
    background-size: cover;
    opacity: 0.74;
  }

  .home-focus-card--standards:not(.home-focus-card--image) .home-focus-card-visual {
    background:
      radial-gradient(circle at 74% 26%, rgba(176, 204, 255, 0.1), transparent 8rem),
      radial-gradient(circle at center, rgba(231, 235, 242, 0.1) 0 0.055rem, transparent 0.075rem) 0 0 / 1rem 1rem,
      linear-gradient(180deg, rgba(255, 255, 255, 0.024), transparent);
  }

  .home-focus-card--standards.home-focus-card--image .home-focus-card-visual {
    background-position: center right;
    background-size: cover;
    opacity: 0.76;
  }

  .home-focus-card-content {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--spacing-md);
    justify-items: start;
  }

  .home-focus-card-title {
    color: rgba(244, 247, 255, 0.94);
    font-family: var(--home-display);
    font-size: var(--home-type-card-title);
    font-weight: var(--font-weight-medium);
    line-height: var(--home-line-title);
    letter-spacing: var(--home-tracking-title);
  }

  .home-focus-card--small .home-focus-card-title {
    font-size: var(--home-type-card-title);
  }

  .home-focus-card-description {
    max-width: 40ch;
    color: rgba(231, 235, 242, 0.68);
    font-size: var(--home-type-body-sm);
    line-height: var(--home-line-body);
    letter-spacing: var(--home-tracking-text);
    text-wrap: pretty;
  }

  .home-focus-card--small .home-focus-card-description {
    font-size: var(--home-type-body-xs);
    line-height: var(--home-line-body-compact);
  }

  .home-focus-card-action {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    color: rgba(231, 235, 242, 0.72);
    font-size: var(--home-type-body-xs);
    font-weight: var(--font-weight-regular);
    line-height: var(--home-line-label);
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .home-focus-card-action::after {
    content: '→';
    color: rgba(176, 204, 255, 0.82);
    opacity: 0;
    transform: translateX(-0.25rem);
    transition:
      opacity 260ms ease,
      transform 260ms ease;
  }

  .home-focus-card:hover,
  .home-focus-card:focus-visible {
    border-color: rgba(184, 207, 255, 0.38);
    box-shadow:
      inset 0 0 0 var(--size-border-thin) rgba(255, 255, 255, 0.035),
      0 0 1.75rem rgba(121, 154, 255, 0.08),
      0 1.7rem 3.4rem rgba(0, 0, 0, 0.24);
    transform: none;
    outline: none;
  }

  .home-focus-card:hover::after,
  .home-focus-card:focus-visible::after {
    opacity: 0.82;
  }

  .home-focus-card:hover .home-focus-card-visual,
  .home-focus-card:focus-visible .home-focus-card-visual {
    opacity: 0.84;
    transform: scale(1.045);
  }

  .home-focus-card:hover .home-focus-card-action::after,
  .home-focus-card:focus-visible .home-focus-card-action::after {
    opacity: 1;
    transform: translateX(0.18rem);
  }

  @media (max-width: 68rem) {
    .home-focus-areas-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .home-focus-card--large {
      grid-column: span 2;
    }

    .home-focus-card--small {
      min-height: clamp(17rem, 38vw, 22rem);
    }
  }

  @media (max-width: 48rem) {
    .home-focus-areas {
      padding: clamp(4rem, 16vw, 6rem) 0;
    }

    .home-focus-areas-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--spacing-sm);
    }

    .home-focus-card,
    .home-focus-card--large,
    .home-focus-card--small {
      grid-column: 1 / -1;
      min-height: clamp(15rem, 56vw, 19rem);
      padding: var(--spacing-md);
    }

    .home-focus-card-title,
    .home-focus-card--small .home-focus-card-title {
      font-size: var(--home-mobile-type-title-sm);
    }
  }

  .home-pillars {
    position: relative;
    width: 100%;
  }

  .home-pillars-shell {
    position: relative;
  }

  .home-pillars-head {
    display: grid;
    gap: var(--home-section-eyebrow-gap);
    justify-items: center;
    max-width: 51rem;
    margin: 0 auto var(--home-section-content-gap);
    text-align: center;
  }

  .home-pillars-head .home-section-label {
    margin-bottom: 0;
  }

  .home-pillars-head h2 {
    margin: 0;
    color: rgba(244, 247, 255, 0.92);
    font-family: var(--home-display);
    font-size: var(--home-type-title-lg);
    font-weight: var(--font-weight-medium);
    line-height: var(--home-line-title);
    letter-spacing: var(--home-tracking-title);
    text-wrap: balance;
  }

  .home-pillars-head .home-section-label,
  .home-pillars-head h2,
  .home-pillars-surface {
    opacity: 0;
    transform: translateY(1.4rem);
    transition:
      opacity 1.04s ease,
      transform 1.18s ease;
    will-change: opacity, transform;
  }

  .home-pillars.is-visible .home-pillars-head .home-section-label,
  .home-pillars.is-visible .home-pillars-head h2,
  .home-pillars-surface.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .home-pillars-head h2 {
    transition-delay: 0.08s;
  }

  .home-pillars-surface {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-panel);
    border: 1px solid rgba(231, 235, 242, 0.08);
    background:
      radial-gradient(ellipse at 50% 0%, rgba(121, 154, 255, 0.08), transparent 30rem),
      linear-gradient(180deg, rgba(137, 169, 226, 0.045), rgba(137, 169, 226, 0.018)),
      rgba(var(--ds-surface-panel-rgb), 0.86);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.025),
      0 1.2rem 2.8rem rgba(0, 0, 0, 0.18);
  }

  .home-pillars-surface::before,
  .home-pillars-surface::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .home-pillars-surface::before {
    background:
      radial-gradient(ellipse 78% 84% at 50% 50%, rgba(78, 96, 168, 0.12) 0%, rgba(78, 96, 168, 0.04) 34%, rgba(78, 96, 168, 0) 66%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.018), rgba(255, 255, 255, 0) 20%, rgba(255, 255, 255, 0.01) 68%, rgba(255, 255, 255, 0) 100%);
  }

  .home-pillars-surface::after {
    background:
      radial-gradient(circle at 10% 18%, rgba(236, 242, 255, 0.2) 0 0.08rem, transparent 0.14rem),
      radial-gradient(circle at 22% 62%, rgba(214, 232, 255, 0.14) 0 0.08rem, transparent 0.14rem),
      radial-gradient(circle at 37% 28%, rgba(236, 242, 255, 0.18) 0 0.08rem, transparent 0.14rem),
      radial-gradient(circle at 52% 54%, rgba(214, 232, 255, 0.12) 0 0.08rem, transparent 0.14rem),
      radial-gradient(circle at 68% 20%, rgba(236, 242, 255, 0.16) 0 0.08rem, transparent 0.14rem),
      radial-gradient(circle at 82% 44%, rgba(214, 232, 255, 0.14) 0 0.08rem, transparent 0.14rem),
      radial-gradient(circle at 92% 72%, rgba(236, 242, 255, 0.12) 0 0.08rem, transparent 0.14rem);

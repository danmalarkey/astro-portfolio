    box-shadow: 0 1.25rem 3rem rgba(0, 0, 0, 0.12);
    transform-origin: center;
    animation: home-window-frame-enter 980ms cubic-bezier(0.16, 1, 0.3, 1) 60ms both;
  }

  .home-nav {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 0.88rem;

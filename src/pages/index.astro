    animation: home-window-light-enter 1300ms ease 360ms both;
  }

  .home-window-core {
    top: 28%;
    right: 10%;
    width: 18%;
    height: 32%;
    border-radius: 50%;
    background:
      radial-gradient(ellipse at 18% 54%, rgba(231, 235, 242, 0.12), rgba(231, 235, 242, 0.045) 14%, rgba(231, 235, 242, 0.01) 28%, rgba(231, 235, 242, 0) 52%);
    filter: blur(14px);
    opacity: 0.24;
    transform-origin: center;
    animation: home-window-core-enter 1450ms ease 520ms both;
  }

  .home-window-glow {
    inset: 0;
    background:
      linear-gradient(114deg, rgba(231, 235, 242, 0) 62%, rgba(176, 204, 255, 0.02) 70%, rgba(176, 204, 255, 0.007) 76%, rgba(231, 235, 242, 0) 82%),
      radial-gradient(ellipse at 88% 44%, rgba(176, 204, 255, 0.016), transparent 16rem),
      radial-gradient(circle at 22% 80%, rgba(231, 235, 242, 0.018), transparent 18rem);
    opacity: 0.4;
    animation: home-window-glow-enter 1500ms ease 460ms both;
  }

  .home-window-haze {
    inset: auto 0 0 0;
    height: 24%;
    background: linear-gradient(180deg, rgba(var(--home-bg-rgb), 0), rgba(var(--home-bg-rgb), 0.22) 38%, rgba(var(--home-bg-rgb), 0.58));
  }

  .home-window-orbit {
    top: -12%;
    right: -23%;
    width: 78%;
    height: 132%;
    border-radius: 50%;
    background:
      radial-gradient(ellipse at 24% 58%, rgba(255, 255, 255, 0.035), rgba(255, 255, 255, 0.01) 14%, rgba(0, 0, 0, 0) 24%),
      radial-gradient(ellipse at 18% 58%, rgba(12, 13, 16, 0.08), rgba(12, 13, 16, 0.4) 30%, rgba(var(--home-bg-rgb), 0.82) 58%, rgba(var(--home-bg-rgb), 0.99) 80%);
    box-shadow: inset 0 0 4rem rgba(255, 255, 255, 0.012);
    opacity: 0.96;
    transform-origin: center;
    animation: home-window-orbit-enter 1500ms cubic-bezier(0.16, 1, 0.3, 1) 300ms both;
  }

  .home-window-orbit::before,
  .home-window-orbit::after {
    content: '';
    position: absolute;
    inset: -3% 1% 1% -8%;
    border-radius: 50%;
    border: 1px solid rgba(231, 235, 242, 0.06);
    transform: rotate(10deg);
  }

  .home-window-orbit::after {
    inset: 8% 6% 8% 0%;

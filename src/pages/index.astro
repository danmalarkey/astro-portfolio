    padding: var(--home-nav-padding);
    border-radius: 1rem;
    border: 1px solid transparent;
    background: transparent;
    pointer-events: auto;
    transition:
      background 520ms ease,
      border-color 520ms ease,
      box-shadow 520ms ease,
      backdrop-filter 520ms ease;
    animation: home-masthead-enter 760ms ease 120ms both;
  }

  .home-header.is-scrolled .home-nav {
    background: rgba(var(--home-surface-panel-rgb), 0.72);
    border-color: rgba(231, 235, 242, 0.08);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.025),
      0 0.75rem 2rem rgba(0, 0, 0, 0.16);
    backdrop-filter: blur(16px) saturate(1.06);
    -webkit-backdrop-filter: blur(16px) saturate(1.06);
  }

  .home-brand {
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;

      radial-gradient(circle,
        rgba(113, 177, 255, 0.3) 0%,
        rgba(113, 177, 255, 0.16) 28%,
        rgba(113, 177, 255, 0.06) 52%,
        rgba(113, 177, 255, 0) 72%);

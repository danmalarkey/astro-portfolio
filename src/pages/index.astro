    justify-self: end;
    align-self: center;
  }

  .home-nav-links a:hover {
    color: var(--home-text);
  }

  .home-nav-links a {
    animation: home-masthead-item-enter 620ms ease both;
  }

  .home-nav-links a:nth-child(1) {

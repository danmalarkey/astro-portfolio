<script is:inline>
  (() => {
    const initStarfield = (id, options = {}) => {
      const canvas = document.getElementById(id);
      if (!(canvas instanceof HTMLCanvasElement)) return;

      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const stars = [];
      let width = 0;
      let height = 0;
      const count = options.count ?? 120;
      const drift = options.drift ?? 0.02;
      const shootingStars = [];
      let nextShootingStarAt = 0;

      const getBounds = () => {
        const frame = canvas.closest('.home-v3-window') ?? canvas.parentElement;
        const rect = frame?.getBoundingClientRect();

        return {
          width: Math.max(1, rect?.width || window.innerWidth),
          height: Math.max(1, rect?.height || window.innerHeight)
        };
      };

      const resize = () => {
        const previousWidth = width;
        const previousHeight = height;
        const bounds = getBounds();
        width = bounds.width;
        height = bounds.height;
        const ratio = Math.max(window.devicePixelRatio || 1, 1);
        canvas.width = Math.floor(width * ratio);
        canvas.height = Math.floor(height * ratio);
        canvas.style.width = `${width}px`;
        canvas.style.height = `${height}px`;
        ctx.setTransform(ratio, 0, 0, ratio, 0, 0);

        if (previousWidth > 0 && previousHeight > 0 && stars.length) {
          const scaleX = width / previousWidth;
          const scaleY = height / previousHeight;
          stars.forEach((star) => {
            star.x *= scaleX;
            star.y *= scaleY;
          });
        }
      };

      const seed = () => {
        stars.length = 0;
        for (let i = 0; i < count; i += 1) {
          stars.push({
            x: Math.random() * width,
            y: Math.random() * height,
            radius: Math.random() * 1.8 + 0.3,
            alpha: Math.random() * 0.8 + 0.12,
            vx: (Math.random() - 0.5) * drift,
            vy: (Math.random() - 0.5) * drift
          });
        }
      };

      const draw = () => {
        ctx.clearRect(0, 0, width, height);
        for (const star of stars) {
          if (!prefersReducedMotion) {
            star.x += star.vx;
            star.y += star.vy;

            if (star.x < 0) star.x = width;
            if (star.x > width) star.x = 0;
            if (star.y < 0) star.y = height;
            if (star.y > height) star.y = 0;
          }

          ctx.fillStyle = `rgba(231, 235, 242, ${star.alpha})`;
          ctx.beginPath();
          ctx.arc(star.x, star.y, star.radius, 0, Math.PI * 2);
          ctx.fill();
        }

        if (!prefersReducedMotion) {
          const now = performance.now();

          // Keep shooting stars occasional so the hero stays calm.
          if (now >= nextShootingStarAt && shootingStars.length < 1) {
            const fromLeft = Math.random() > 0.5;
            const startX = fromLeft ? -120 : width + 120;
            const startY = Math.random() * (height * 0.45) + 20;
            const speed = 2.2 + Math.random() * 1.1;
            const angle = fromLeft ? 0.35 + Math.random() * 0.25 : Math.PI - (0.35 + Math.random() * 0.25);
            shootingStars.push({
              x: startX,
              y: startY,
              vx: Math.cos(angle) * speed,
              vy: Math.sin(angle) * speed,
              life: 0,
              maxLife: 150 + Math.random() * 60
            });
            nextShootingStarAt = now + 2400 + Math.random() * 2600;
          }

          for (let i = shootingStars.length - 1; i >= 0; i -= 1) {
            const shootingStar = shootingStars[i];
            shootingStar.x += shootingStar.vx;
            shootingStar.y += shootingStar.vy;
            shootingStar.life += 1;

            const t = shootingStar.life / shootingStar.maxLife;
            const alpha = Math.max(0, 0.92 * (1 - t));
            const tailX = shootingStar.x - shootingStar.vx * 9;
            const tailY = shootingStar.y - shootingStar.vy * 9;

            const gradient = ctx.createLinearGradient(shootingStar.x, shootingStar.y, tailX, tailY);
            gradient.addColorStop(0, `rgba(255, 255, 255, ${alpha})`);
            gradient.addColorStop(1, 'rgba(255, 255, 255, 0)');

            ctx.strokeStyle = gradient;
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.moveTo(shootingStar.x, shootingStar.y);
            ctx.lineTo(tailX, tailY);
            ctx.stroke();

            if (
              shootingStar.life >= shootingStar.maxLife ||
              shootingStar.x < -240 ||
              shootingStar.x > width + 240 ||
              shootingStar.y > height + 120
            ) {
              shootingStars.splice(i, 1);
            }
          }
        }

        if (!prefersReducedMotion) requestAnimationFrame(draw);
      };

      resize();
      seed();
      draw();
      nextShootingStarAt = performance.now() + 2600;
      window.addEventListener('resize', resize);
    };

    initStarfield('home-v3-stars', { count: 96, drift: 0.01 });
  })();

  (() => {
    const rails = Array.from(document.querySelectorAll('[data-home-v3-edge-rail]'));
    if (!rails.length) return;

    const syncEdgeRailWidths = () => {
      rails.forEach((rail) => {
        if (!(rail instanceof HTMLElement)) return;
        const left = Math.max(0, rail.getBoundingClientRect().left);
        rail.style.setProperty('--home-v3-rail-viewport-width', `${Math.max(0, window.innerWidth - left)}px`);
      });
    };

    syncEdgeRailWidths();
    window.addEventListener('resize', syncEdgeRailWidths);
  })();

  (() => {
    const bridge = document.querySelector('[data-home-v3-bridge]');
    const bridgeShell = bridge?.querySelector('.home-v3-bridge-shell');
    const bridgeScenes = Array.from(document.querySelectorAll('[data-home-v3-bridge-scene]'));
    const bridgeWords = Array.from(document.querySelectorAll('[data-home-v3-bridge-word]'));
    if (!(bridge instanceof HTMLElement) || !(bridgeShell instanceof HTMLElement) || bridgeScenes.length !== 3 || bridgeWords.length !== 3) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      bridge.style.setProperty('--bridge-strategy', '0');
      bridge.style.setProperty('--bridge-systems', '1');
      bridge.style.setProperty('--bridge-clarity', '0');
      bridge.style.setProperty('--bridge-field', '1');
      bridgeScenes.forEach((scene) => {
        const key = scene.getAttribute('data-home-v3-bridge-scene');
        scene.style.opacity = key === 'systems' ? '1' : '0';
      });
      bridgeWords.forEach((word) => {
        const key = word.getAttribute('data-home-v3-bridge-word');
        const isActive = key === 'systems';
        word.style.opacity = isActive ? '1' : '0';
        word.style.filter = isActive ? 'blur(0px)' : 'blur(12px)';
        word.style.setProperty('--bridge-shift-y', isActive ? '0px' : '24px');
        word.style.setProperty('--bridge-scale', isActive ? '1' : '0.985');
      });
      return;
    }

    let frame = 0;
    let bridgeStart = 0;
    let totalScrollable = 1;
    let targetProgress = 0;
    let currentProgress = 0;
    const usesCoarsePointer = window.matchMedia('(pointer: coarse)').matches;

    const clamp = (value, min, max) => Math.max(min, Math.min(max, value));

    const mapRange = (value, inMin, inMax, outMin, outMax) => {
      const progress = (value - inMin) / (inMax - inMin);
      const clamped = clamp(progress, 0, 1);
      return outMin + (outMax - outMin) * clamped;
    };

    const getWordState = (
      localProgress,
      {
        enterEnd = 0.22,
        holdEnd = 0.74,
        enterBlur = 6,
        exitBlur = 6,
        enterY = 24,
        exitY = -18,
        enterScale = 0.985,
        exitScale = 1.01
      } = {}
    ) => {
      let opacity = 0;
      let blur = enterBlur;
      let y = enterY;
      let scale = enterScale;

      if (localProgress < enterEnd) {
        opacity = mapRange(localProgress, 0, enterEnd, 0, 1);
        blur = mapRange(localProgress, 0, enterEnd, enterBlur, 0);
        y = mapRange(localProgress, 0, enterEnd, enterY, 0);
        scale = mapRange(localProgress, 0, enterEnd, enterScale, 1);
      } else if (localProgress < holdEnd) {
        opacity = 1;
        blur = 0;
        y = 0;
        scale = 1;
      } else {
        opacity = mapRange(localProgress, holdEnd, 1, 1, 0);
        blur = mapRange(localProgress, holdEnd, 1, 0, exitBlur);
        y = mapRange(localProgress, holdEnd, 1, 0, exitY);
        scale = mapRange(localProgress, holdEnd, 1, 1, exitScale);
      }

      return { opacity, blur, y, scale };
    };

    const renderBridge = (bridgeProgress) => {
      const wordWindows = [
        { key: 'strategy', start: 0, end: 0.31 },
        { key: 'systems', start: 0.22, end: 0.56 },
        { key: 'clarity', start: 0.44, end: 1 }
      ];

      const wordStates = wordWindows.map(({ key, start, end }) => {
        const localProgress = clamp((bridgeProgress - start) / (end - start), 0, 1);
        const options =
          key === 'clarity'
            ? {
                enterEnd: 0.16,
                holdEnd: 0.96,
                exitBlur: 2,
                exitY: -4,
                exitScale: 1.002
              }
            : undefined;
        return { key, ...getWordState(localProgress, options) };
      });

      const stateByKey = Object.fromEntries(wordStates.map((state) => [state.key, state]));
      const fieldPresence = Math.max(...wordStates.map((state) => state.opacity));

      bridge.style.setProperty('--bridge-strategy', stateByKey.strategy.opacity.toFixed(4));
      bridge.style.setProperty('--bridge-systems', stateByKey.systems.opacity.toFixed(4));
      bridge.style.setProperty('--bridge-clarity', stateByKey.clarity.opacity.toFixed(4));
      bridge.style.setProperty('--bridge-field', fieldPresence.toFixed(4));

      wordStates.forEach((state, index) => {
        bridgeScenes[index].style.opacity = state.opacity.toFixed(3);
      });

      wordStates.forEach((state, index) => {
        const word = bridgeWords[index];
        word.style.opacity = state.opacity.toFixed(3);
        word.style.filter = `blur(${state.blur.toFixed(2)}px)`;
        word.style.setProperty('--bridge-shift-y', `${state.y.toFixed(2)}px`);
        word.style.setProperty('--bridge-scale', state.scale.toFixed(4));
      });
    };

    const measureBridge = () => {
      const rect = bridge.getBoundingClientRect();
      bridgeStart = rect.top + window.scrollY;
      totalScrollable = Math.max(bridge.offsetHeight - bridgeShell.getBoundingClientRect().height, 1);
    };

    const readBridgeProgress = () => {
      const scrolled = clamp(window.scrollY - bridgeStart, 0, totalScrollable);
      return totalScrollable > 0 ? scrolled / totalScrollable : 0;
    };

    const updateBridge = () => {
      frame = 0;
      targetProgress = readBridgeProgress();

      const delta = targetProgress - currentProgress;
      const shouldSnap = Math.abs(delta) < 0.0008;
      const smoothing = usesCoarsePointer ? 0.18 : 0.24;

      currentProgress = shouldSnap ? targetProgress : currentProgress + (delta * smoothing);
      renderBridge(currentProgress);

      if (!shouldSnap) {
        frame = window.requestAnimationFrame(updateBridge);
      }
    };

    const handleBridgeResize = () => {
      measureBridge();
      targetProgress = readBridgeProgress();
      if (frame) return;
      frame = window.requestAnimationFrame(updateBridge);
    };

    const scheduleBridgeUpdate = () => {
      if (frame) return;
      frame = window.requestAnimationFrame(updateBridge);
    };

    measureBridge();
    targetProgress = readBridgeProgress();
    currentProgress = targetProgress;
    renderBridge(currentProgress);
    window.addEventListener('scroll', scheduleBridgeUpdate, { passive: true });
    window.addEventListener('resize', handleBridgeResize);
    window.addEventListener('orientationchange', handleBridgeResize);
    window.visualViewport?.addEventListener('resize', handleBridgeResize);
  })();

  (() => {
    const bridge = document.querySelector('[data-home-v3-bridge-lite]');
    const bridgeShell = bridge?.querySelector('.home-v3-bridge-lite-shell');
    const cards = Array.from(document.querySelectorAll('[data-home-v3-bridge-lite-card]'));
    if (!(bridge instanceof HTMLElement) || !(bridgeShell instanceof HTMLElement) || cards.length !== 3) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const useStaticMobileBridge = window.matchMedia('(max-width: 48rem)').matches;
    if (useStaticMobileBridge) {
      bridge.classList.add('is-mobile-static');
      return;
    }

    if (prefersReducedMotion) {
      cards.forEach((card, index) => {
        card.style.setProperty('--bridge-lite-opacity', index === 0 ? '1' : '0');
        card.style.setProperty('--bridge-lite-shift-y', index === 0 ? '0px' : '24px');
        card.style.setProperty('--bridge-lite-scale', index === 0 ? '1' : '0.985');
      });
      bridge.style.setProperty('--bridge-lite-field', '1');
      return;
    }

    let frame = 0;
    let bridgeStart = 0;
    let totalScrollable = 1;
    let targetProgress = 0;
    let currentProgress = 0;

    const clamp = (value, min, max) => Math.max(min, Math.min(max, value));

    const mapRange = (value, inMin, inMax, outMin, outMax) => {
      const progress = (value - inMin) / (inMax - inMin);
      const clamped = clamp(progress, 0, 1);
      return outMin + (outMax - outMin) * clamped;
    };

    const getCardState = (
      localProgress,
      { enterEnd = 0.2, holdEnd = 0.76, enterY = 36, exitY = -24, enterScale = 0.97, exitScale = 1.01, exitOpacity = 0 } = {}
    ) => {
      let opacity = 0;
      let y = enterY;
      let scale = enterScale;

      if (localProgress < enterEnd) {
        opacity = mapRange(localProgress, 0, enterEnd, 0, 1);
        y = mapRange(localProgress, 0, enterEnd, enterY, 0);
        scale = mapRange(localProgress, 0, enterEnd, enterScale, 1);
      } else if (localProgress < holdEnd) {
        opacity = 1;
        y = 0;
        scale = 1;
      } else {
        opacity = mapRange(localProgress, holdEnd, 1, 1, exitOpacity);
        y = mapRange(localProgress, holdEnd, 1, 0, exitY);
        scale = mapRange(localProgress, holdEnd, 1, 1, exitScale);
      }

      return { opacity, y, scale };
    };

    const renderBridge = (progress) => {
      const cardWindows = [
        { start: 0, end: 0.31 },
        { start: 0.2, end: 0.58 },
        { start: 0.42, end: 1 }
      ];

      const cardStates = cardWindows.map(({ start, end }, index) => {
        const localProgress = clamp((progress - start) / (end - start), 0, 1);
        return getCardState(
          localProgress,
          index === 2 ? { enterEnd: 0.16, holdEnd: 0.992, enterY: 20, exitY: -4, enterScale: 0.986, exitScale: 1.001, exitOpacity: 0.22 } : undefined
        );
      });

      bridge.style.setProperty('--bridge-lite-field', Math.max(...cardStates.map((state) => state.opacity)).toFixed(4));

      cardStates.forEach((state, index) => {
        const card = cards[index];
        card.style.setProperty('--bridge-lite-opacity', state.opacity.toFixed(4));
        card.style.setProperty('--bridge-lite-shift-y', `${state.y.toFixed(2)}px`);
        card.style.setProperty('--bridge-lite-scale', state.scale.toFixed(4));
      });
    };

    const measureBridge = () => {
      const rect = bridge.getBoundingClientRect();
      bridgeStart = rect.top + window.scrollY;
      totalScrollable = Math.max(bridge.offsetHeight - bridgeShell.getBoundingClientRect().height, 1);
    };

    const readBridgeProgress = () => {
      const scrolled = clamp(window.scrollY - bridgeStart, 0, totalScrollable);
      return totalScrollable > 0 ? scrolled / totalScrollable : 0;
    };

    const updateBridge = () => {
      frame = 0;
      targetProgress = readBridgeProgress();

      const delta = targetProgress - currentProgress;
      const shouldSnap = Math.abs(delta) < 0.0008;
      currentProgress = shouldSnap ? targetProgress : currentProgress + (delta * 0.22);
      renderBridge(currentProgress);

      if (!shouldSnap) {
        frame = window.requestAnimationFrame(updateBridge);
      }
    };

    const scheduleBridgeUpdate = () => {
      if (frame) return;
      frame = window.requestAnimationFrame(updateBridge);
    };

    const handleBridgeResize = () => {
      measureBridge();
      targetProgress = readBridgeProgress();
      if (frame) return;
      frame = window.requestAnimationFrame(updateBridge);
    };

    measureBridge();
    targetProgress = readBridgeProgress();
    currentProgress = targetProgress;
    renderBridge(currentProgress);
    window.addEventListener('scroll', scheduleBridgeUpdate, { passive: true });
    window.addEventListener('resize', handleBridgeResize);
    window.addEventListener('orientationchange', handleBridgeResize);
    window.visualViewport?.addEventListener('resize', handleBridgeResize);
  })();

  (() => {
    const header = document.querySelector('.home-v3-header');
    if (!(header instanceof HTMLElement)) return;
    const menuButton = header.querySelector('.home-v3-menu-toggle');
    const mobileNav = header.querySelector('.home-v3-mobile-nav');

    let frame = 0;

    const updateHeader = () => {
      frame = 0;
      header.classList.toggle('is-scrolled', window.scrollY > 120);
    };

    const scheduleHeaderUpdate = () => {
      if (frame) return;
      frame = window.requestAnimationFrame(updateHeader);
    };

    updateHeader();
    window.addEventListener('scroll', scheduleHeaderUpdate, { passive: true });
    window.addEventListener('resize', scheduleHeaderUpdate);

    if (!(menuButton instanceof HTMLButtonElement) || !(mobileNav instanceof HTMLElement)) return;

    const setMenuOpen = (isOpen) => {
      header.classList.toggle('is-menu-open', isOpen);
      menuButton.setAttribute('aria-expanded', String(isOpen));
      mobileNav.setAttribute('aria-hidden', String(!isOpen));
      mobileNav.inert = !isOpen;
    };

    menuButton.addEventListener('click', () => {
      setMenuOpen(!header.classList.contains('is-menu-open'));
    });

    mobileNav.addEventListener('click', (event) => {
      if (event.target instanceof HTMLAnchorElement) setMenuOpen(false);
    });

    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setMenuOpen(false);
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth > 768) setMenuOpen(false);
    });
  })();

  (() => {
    const sections = Array.from(document.querySelectorAll('[data-home-v3-reveal]'));
    const lateSections = Array.from(document.querySelectorAll('[data-home-v3-reveal-late]'));
    if (!sections.length && !lateSections.length) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      sections.forEach((section) => section.classList.add('is-visible'));
      lateSections.forEach((section) => section.classList.add('is-visible'));
      return;
    }

    const standardObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          standardObserver.unobserve(entry.target);
        });
      },
      {
        threshold: 0.26,
        rootMargin: '0px 0px -16% 0px'
      }
    );

    const lateObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          lateObserver.unobserve(entry.target);
        });
      },
      {
        threshold: 0.5,
        rootMargin: '0px 0px -12% 0px'
      }
    );

    sections.forEach((section) => standardObserver.observe(section));
    lateSections.forEach((section) => lateObserver.observe(section));
  })();

  (() => {
    const rows = Array.from(document.querySelectorAll('.home-v3-fit-row'));
    if (!rows.length) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const closeRow = (row) => {
      const summary = row.querySelector('summary');
      const answer = row.querySelector('.home-v3-fit-row-answer');
      if (!answer || !row.open) return;

      window.cancelAnimationFrame(row._fitAnimationFrame ?? 0);
      if (row._fitTransitionEndHandler) {
        answer.removeEventListener('transitionend', row._fitTransitionEndHandler);
      }

      if (prefersReducedMotion) {
        row.open = false;
        row.classList.remove('is-open', 'is-animating');
        answer.style.height = '';
        return;
      }

      row.classList.add('is-animating');
      answer.style.height = `${answer.scrollHeight}px`;
      row.classList.remove('is-open');

      row._fitAnimationFrame = window.requestAnimationFrame(() => {
        answer.style.height = '0px';
      });

      row._fitTransitionEndHandler = (event) => {
        if (event.propertyName !== 'height') return;
        answer.removeEventListener('transitionend', row._fitTransitionEndHandler);
        row._fitTransitionEndHandler = null;
        row.open = false;
        row.classList.remove('is-animating');
        answer.style.height = '';
      };
      answer.addEventListener('transitionend', row._fitTransitionEndHandler);
    };

    const openRow = (row) => {
      const answer = row.querySelector('.home-v3-fit-row-answer');
      if (!answer || row.open) return;

      window.cancelAnimationFrame(row._fitAnimationFrame ?? 0);
      if (row._fitTransitionEndHandler) {
        answer.removeEventListener('transitionend', row._fitTransitionEndHandler);
      }

      row.open = true;

      if (prefersReducedMotion) {
        row.classList.add('is-open');
        answer.style.height = '';
        return;
      }

      row.classList.add('is-animating');
      answer.style.height = '0px';

      row._fitAnimationFrame = window.requestAnimationFrame(() => {
        row.classList.add('is-open');
        answer.style.height = `${answer.scrollHeight}px`;
      });

      row._fitTransitionEndHandler = (event) => {
        if (event.propertyName !== 'height') return;
        answer.removeEventListener('transitionend', row._fitTransitionEndHandler);
        row._fitTransitionEndHandler = null;
        row.classList.remove('is-animating');
        answer.style.height = 'auto';
      };
      answer.addEventListener('transitionend', row._fitTransitionEndHandler);
    };

    rows.forEach((row) => {
      const summary = row.querySelector('summary');
      const answer = row.querySelector('.home-v3-fit-row-answer');
      if (!summary || !answer) return;

      if (row.open) {
        row.classList.add('is-open');
        answer.style.height = 'auto';
      }

      summary.addEventListener('click', (event) => {
        event.preventDefault();

        if (row.open) {
          closeRow(row);
          return;
        }

        rows.forEach((otherRow) => {
          if (otherRow !== row) closeRow(otherRow);
        });
        openRow(row);
      });
    });

  })();
</script>


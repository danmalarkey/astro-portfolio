    opacity: 0.3;
    -webkit-mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.96), rgba(0, 0, 0, 0.48) 30%, rgba(0, 0, 0, 0.16) 58%, rgba(0, 0, 0, 0.04) 78%, transparent 100%);
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.96), rgba(0, 0, 0, 0.48) 30%, rgba(0, 0, 0, 0.16) 58%, rgba(0, 0, 0, 0.04) 78%, transparent 100%);
    animation: home-window-rays-enter 1400ms ease 420ms both;
  }

  .home-hero-noise {
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;

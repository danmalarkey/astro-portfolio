---

<Layout
  title="Dan Malarkey | Design Leadership for Teams in Motion"
  description="Dan Malarkey helps teams structure workflows, delivery systems, communication models, and product infrastructure required to scale."
>
  <main class="home">
    <section class="home-intro">
      <Header />

      <section class="home-hero">
        <div class="home-hero-frame">
          <div class="home-window" aria-hidden="true">
            <div class="home-window-rays"></div>
            <canvas id="home-stars"></canvas>
            <div class="home-hero-noise"></div>
            <div class="home-window-light-field"></div>
            <div class="home-window-core"></div>
            <div class="home-window-glow"></div>
            <div class="home-window-haze"></div>
            <div class="home-window-orbit"></div>
          </div>

          <div class="dm-grid-l dm-grid-l--grid-sys home-hero-grid">
            <div class="home-hero-copy gc-start-2 gc-span-16">
              <div class="home-hero-primary">
                <p class="home-kicker">Chief Product Designer at feature[23]</p>
                <h1>Clarity &amp; vision for teams in motion.</h1>
              </div>
              <div class="home-hero-support">
                <p class="home-lead">
                  I design systems of work for organizations navigating growth, complexity, and change. I help leaders connect business direction, product decisions, operating realities, and delivery infrastructure so the work can scale with more clarity.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>
    </section>

    <section class="section home-client-trust" aria-label="Organizations I have supported" data-home-reveal>
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <div class="home-client-trust-shell gc-start-3 gc-span-22">
          <p class="home-client-trust-label">Organizations I’ve supported</p>
          <div class="home-client-marquee" aria-hidden="true">
            <div class="home-client-marquee-track">
              {supportedOrganizationLoop.map((organization) => (
                <span
                  class="home-client-logo"
                  style={`--logo-width-scale: ${organization.widthScale ?? 1}; --logo-height-scale: ${organization.heightScale ?? 1};`}
                >
                  <img src={withBase(organization.logo)} alt="" loading="lazy" decoding="async" />
                </span>
              ))}
            </div>
          </div>
          <ul class="home-client-trust-list sr-only">
            {supportedOrganizations.map((organization) => (
              <li>{organization.name}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section id="focus-areas" class="section home-section-flow home-focus-areas" aria-label="Focus areas" data-home-reveal hidden>
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <SectionHeader
          eyebrow="Focus areas across the organization"
          title="Different areas. One connected model."
          body="Direction, operating models, emerging technology, standards, and delivery decisions all shape each other. I focus where those decisions need to stay connected, so your teams can move with clearer priorities and fewer disconnected efforts."
          accent
          headClass="home-focus-areas-head gc-start-2 gc-span-10"
          bodyClass="gc-start-15 gc-span-11"
        />

        <div class="home-section-content home-focus-areas-grid gc-start-2 gc-span-24" role="list">
          {focusAreaCards.map((item) => (
            <a
              class:list={[
                'home-focus-card',
                `home-focus-card--${item.size}`,
                `home-focus-card--${item.tone}`,
                item.image && 'home-focus-card--image'
              ]}
              href={withBase(item.href)}
              role="listitem"
              style={item.image ? `--home-focus-card-image: url('${withBase(item.image)}')` : undefined}
            >
              <span class="home-focus-card-visual" aria-hidden="true"></span>
              <span class="home-focus-card-content">
                <span class="home-focus-card-title">{item.title}</span>
                <span class="home-focus-card-description">{item.description}</span>
                <span class="home-focus-card-action">How I help</span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section home-section-flow home-focus-services" aria-label="Focus areas">
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <SectionHeader
          eyebrow="Focus areas across the organization"
          title="Different areas. One connected model."
          body="Direction, operating models, emerging technology, standards, and delivery decisions all shape each other. I focus where those decisions need to stay connected, so your teams can move with clearer priorities and fewer disconnected efforts."
          accent
          headClass="home-focus-services-head gc-start-2 gc-span-10"
          bodyClass="gc-start-15 gc-span-11"
          reveal
          revealType="reveal"
        />

        <PinnedStackCards
          className="home-section-content gc-start-2 gc-span-24"
          items={focusAreaServiceRows.map((item) => ({
            title: item.title,
            titleLines: item.titleLines,
            href: item.href,
            image: item.image,
            tags: item.capabilities,
            fitLine: item.fitLine,
            body: item.description
          }))}
        />
      </div>
    </section>

          <section class="section home-pillars" aria-label="Clarity, strategy, and systems" data-home-reveal>
        <div class="dm-grid-l dm-grid-l--grid-sys">
          <div class="home-pillars-shell gc-start-2 gc-span-24">
            <div class="home-pillars-head">
              <p class="home-section-label">How the work holds</p>
              <h2>Clearer priorities when the stakes are high.</h2>
            </div>
            <div class="home-pillars-surface" data-home-reveal-late>
              <div class="home-pillars-grid" role="list">
                {bridgePillars.map((pillar) => (
                  <article class={`home-pillar home-pillar--${pillar.tone}`} role="listitem">
                    <p class="home-pillar-index">{pillar.index}</p>
                    <div class="home-pillar-main">
                      <h2 class="home-pillar-title">{pillar.title}</h2>

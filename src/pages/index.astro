  @keyframes home-masthead-enter {
    from {
      opacity: 0;
      transform: translateY(-0.8rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes home-masthead-item-enter {
    from {
      opacity: 0;
      transform: translateY(-0.28rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes home-window-frame-enter {
    from {
      opacity: 0;
      transform: translateY(1rem) scale(0.992);
    }

    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes home-window-field-enter {
    from {
      opacity: 0;
      filter: saturate(0.82) brightness(0.86);
    }

    to {
      opacity: 1;
      filter: saturate(1) brightness(1);
    }
  }

  @keyframes home-window-rays-enter {
    from {
      opacity: 0;
      transform: rotate(-22deg) translate3d(-1.4rem, -1rem, 0);
    }

    to {
      opacity: 0.3;
      transform: rotate(-22deg) translate3d(0, 0, 0);
    }
  }

  @keyframes home-window-light-enter {
    from {
      opacity: 0;
    }

    to {
      opacity: 0.62;
    }
  }

  @keyframes home-window-core-enter {
    from {
      opacity: 0;
      transform: scale(0.86);
    }

    to {
      opacity: 0.24;
      transform: scale(1);
    }
  }

  @keyframes home-window-glow-enter {
    from {
      opacity: 0;
    }

    to {
      opacity: 0.4;
    }
  }

  @keyframes home-window-orbit-enter {
    from {
      opacity: 0;
      transform: translate3d(2rem, 0, 0) scale(0.97);
    }

    to {
      opacity: 0.96;
      transform: translate3d(0, 0, 0) scale(1);
    }
  }

  @keyframes home-hero-copy-enter {
    from {
      opacity: 0;
      transform: translateY(0.85rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }


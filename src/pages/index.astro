  .home-practice-floor-glow {
    left: 50%;
    bottom: 0.8rem;
    width: 56%;
    height: 1.15rem;
    border-radius: 999rem;
    background:
      radial-gradient(ellipse at center,
        rgba(130, 188, 255, 0.4) 0%,
        rgba(130, 188, 255, 0.18) 34%,
        rgba(130, 188, 255, 0) 72%);

  .home-pillar-body {
    max-width: none;
    margin-top: auto;
    padding-top: var(--home-section-gap);
    font-size: var(--home-type-body);
    line-height: var(--home-line-body);
    letter-spacing: var(--home-tracking-text);
    color: rgba(180, 188, 203, 0.8);

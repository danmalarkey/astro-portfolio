    opacity: 1;
    transform: scale(1.02);
  }

  .home-pillar--clarity::before {
    background:
      radial-gradient(ellipse 88% 72% at 68% 28%, rgba(126, 160, 255, 0.18) 0%, rgba(126, 160, 255, 0.07) 28%, rgba(126, 160, 255, 0) 62%);

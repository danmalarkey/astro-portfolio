  .home-practice-icon--outline {
    opacity: 0.8;
    transform: translateY(0) scale(1);
    filter:
      drop-shadow(0 0 0.55rem rgba(180, 201, 232, 0.12))
      drop-shadow(0 0 1.15rem rgba(123, 158, 218, 0.08));
  }

  .home-practice-icon--detail {
    position: absolute;
    opacity: 0;
    transform: translateY(0.5rem) scale(0.985);
    filter: drop-shadow(0 1.5rem 2.5rem rgba(70, 130, 255, 0.1));
  }

  .home-practice-card--rocket .home-practice-icon--outline {
    width: min(100%, 11.3rem);
    max-height: 14.6rem;
  }

  .home-practice-card--rocket .home-practice-icon--detail {
    width: min(100%, 12.2rem);
    max-height: 14.9rem;
  }

  .home-practice-card--rocket .home-practice-nebula {
    width: 120%;
    height: 92%;
    top: 50%;
  }

  .home-practice-card--rocket .home-practice-floor-glow {
    width: 48%;
  }

  .home-practice-card--telescope .home-practice-visual {
    width: min(100%, 19.6rem);
  }

  .home-practice-card--telescope .home-practice-icon--outline {
    width: min(100%, 15.25rem);
    max-height: 12.2rem;
  }

  .home-practice-card--telescope .home-practice-icon--detail {
    width: min(100%, 17rem);
    max-height: 13.1rem;
  }

  .home-practice-card--telescope .home-practice-nebula {
    width: 138%;
    height: 76%;
    top: 44%;
  }

  .home-practice-card--telescope .home-practice-floor-glow {
    width: 58%;
  }

  .home-practice-card--helmet .home-practice-icon--outline {
    width: min(100%, 12.35rem);
    max-height: 12.75rem;
  }

  .home-practice-card--helmet .home-practice-icon--detail {
    width: min(100%, 13.55rem);
    max-height: 13.3rem;
  }

  .home-practice-card--helmet .home-practice-nebula {
    width: 116%;
    height: 74%;
    top: 46%;
  }

  .home-practice-card--helmet .home-practice-floor-glow {
    width: 50%;
  }

  @media (hover: hover) and (pointer: fine) {
    .home-practice-card:hover .home-practice-icon--outline {
      opacity: 0;
      transform: translateY(-0.25rem) scale(1.01);
    }

    .home-practice-card:hover .home-practice-icon--detail {
      opacity: 1;
      transform: translateY(-0.15rem) scale(1.015);
    }

    .home-practice-card:hover .home-practice-glow,
    .home-practice-card:hover .home-practice-nebula,
    .home-practice-card:hover .home-practice-stars {
      opacity: 0.9;
      transform: translate(-50%, -50%) scale(1);
    }

    .home-practice-card:hover .home-practice-glow {
      filter: blur(28px);
    }

    .home-practice-card:hover .home-practice-floor-glow {
      opacity: 1;
      transform: translateX(-50%) scale(1);
    }
  }

  @media (hover: none), (pointer: coarse) {
    .home-practice-icon--outline {
      opacity: 0;
    }

    .home-practice-icon--detail {
      opacity: 1;
      transform: translateY(0) scale(1);
    }

    .home-practice-glow,
    .home-practice-nebula,
    .home-practice-stars {
      opacity: 0.82;
      transform: translate(-50%, -50%) scale(1);
    }

    .home-practice-floor-glow {
      opacity: 0.92;
      transform: translateX(-50%) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-practice-nebula,
    .home-practice-glow,
    .home-practice-floor-glow,
    .home-practice-stars,
    .home-practice-icon,
    .home-pillars-head .home-section-label,
    .home-pillars-head h2,
    .home-pillars-surface,
    .home-actors .home-actor-lane,
    .home-fit-row,
    .home-fit-row-icon::before,
    .home-fit-row-icon::after,
    .home-fit-row-answer {
      transition: none;
    }

    .home-header-availability-dot::after,
    .home-engagement-availability-dot,
    .home-engagement-availability::after {
      animation: none;
    }
  }

  @keyframes home-header-availability-pulse {
    0%,
    100% {
      opacity: 0;
      transform: scale(0.72);
    }

    42% {
      opacity: 0.62;
      transform: scale(1);
    }

    72% {
      opacity: 0;
      transform: scale(1.24);
    }
  }


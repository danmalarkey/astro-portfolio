---
import Layout from '../layouts/Layout.astro';
import Header from '../layouts/Header.astro';
import HomeFooter from '../components/HomeFooter.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { writingRoadmapEntries } from '../data/writing-roadmap';

const baseUrl = Astro.url.pathname.startsWith('/astro-portfolio') ? '/astro-portfolio/' : '/';
const homeV3BridgeVariant: 'legacy' | 'lite' | 'pillars' = 'pillars';
const homeV3ActorsVariant: 'legacy' | 'concept' = 'concept';
const homeV3ActorsConceptVariant: 'scene' | 'lane' = 'lane';
const homeV3PracticeVariant: 'grid' | 'story-stack' | 'solid-cards' = 'grid';
const withBase = (path: string) => `${baseUrl}${path.startsWith('/') ? path.slice(1) : path}`;
const proofDraftImage = withBase('images/case-studies/home/tri-proof-bg.png');
const createActorMailto = (actor: string, prompt: string) => {
  const params = new URLSearchParams();
  params.set('subject', `[${actor}] Advisory inquiry`);
  params.set('body', `Hi Dan,\n\nI'm reaching out as ${prompt} and would like to talk about design leadership support.\n\nContext:\n- Team/company:\n- What we're navigating:\n- What kind of support we need:\n\nThanks,`);
  return `mailto:hello@danmalarkey.com?${params.toString()}`;
};

const supportedOrganizations = ['Nike', 'Adidas', 'Spotify', 'Stripe', 'Linear', 'Figma'];
const supportedOrganizationLoop = [...supportedOrganizations, ...supportedOrganizations];

const leverageCards = [
  {
    title: 'AI-enabled product exploration',
    descriptionLines: [
      'Explore new workflows, model system',
      'behavior, and pressure-test what needs',
      'to be true before teams invest.'
    ],
    cardFit: 'Explore new workflows, model system behavior, and pressure-test what needs to be true before teams invest.',
    artType: 'ai',
    conceptLabel: 'AI product systems',
    conceptSignals: ['Workflow', 'Prompts', 'Behavior'],
    laneRows: [
      { label: 'Workflow', detail: 'Human control' },
      { label: 'Prompts', detail: 'Reusable systems' },
      { label: 'Behavior', detail: 'Product integrity' }
    ],
    image: 'images/home-v3/blueprint/operating-model-blueprint-transparent.png',
    imageAlt: 'AI-enabled product systems blueprint',
    actorSlug: '/work-with/ai-enabled-systems',
    actorLabel: 'a product or AI systems leader'
  },
  {
    title: 'Executives, Founders, & Product Owners',
    descriptionLines: [
      'Clarifying product direction, aligning',
      'investment priorities, and making design',
      'a driver of business outcomes.'
    ],
    cardFit: 'For teams that need sharper product direction and clearer investment bets.',
    artType: 'executive',
    conceptLabel: 'Strategic direction',
    conceptSignals: ['Direction', 'Investment', 'Outcomes'],
    laneRows: [
      { label: 'Direction', detail: 'What matters now' },
      { label: 'Investment', detail: 'Sequence bets' },
      { label: 'Outcomes', detail: 'Business impact' }
    ],
    image: 'images/dan-right.png',
    imageAlt: 'Executive product design leadership and strategy collaboration',
    actorSlug: '/work-with/executives-and-product-drivers',
    actorLabel: 'an executive or product leader'
  },
  {
    title: 'Product & Engineering Teams',
    descriptionLines: [
      'Reducing delivery friction across workflows,',
      'handoffs, and shared tooling so teams can',
      'ship with more confidence.'
    ],
    cardFit: 'For teams slowed by delivery friction, ambiguity, or weak handoffs.',
    artType: 'product',
    conceptLabel: 'Execution systems',
    conceptSignals: ['Roadmap', 'Handoffs', 'Delivery'],
    laneRows: [
      { label: 'Roadmap', detail: 'Reduce ambiguity' },
      { label: 'Handoffs', detail: 'Better flow' },
      { label: 'Delivery', detail: 'Ship confidently' }
    ],
    image: 'images/img.png',
    imageAlt: 'Cross-functional product and engineering collaboration',
    actorSlug: '/work-with/product-and-engineering-teams',
    actorLabel: 'a product or engineering leader'
  },
  {
    title: 'Designers & Design Leaders',
    descriptionLines: [
      'Raising craft maturity, establishing standards,',
      'and strengthening design influence in product,',
      'operational, and organizational decisions.'
    ],
    cardFit: 'For organizations building stronger standards, coaching, and design influence.',
    artType: 'design',
    conceptLabel: 'Capability building',
    conceptSignals: ['Standards', 'Coaching', 'Influence'],
    laneRows: [
      { label: 'Standards', detail: 'Quality bar' },
      { label: 'Coaching', detail: 'Raise judgment' },
      { label: 'Influence', detail: 'Earlier decisions' }
    ],
    image: 'images/dan.png',
    imageAlt: 'Design leadership and team development',
    actorSlug: '/work-with/designers-and-design-leaders',
    actorLabel: 'a design leader'
  }
];

const actorAudienceCards = leverageCards.filter((item) => item.artType !== 'ai');

const focusAreaCards = [
  {
    title: 'Operating Model',
    description: 'Keep business direction, operating reality, product behavior, and delivery decisions connected.',
    href: '/work-with/operating-model',
    size: 'large',
    tone: 'operating',
    image: 'images/op-model/noise-to-sig.png'
  },
  {
    title: 'Direction & Prioritization',
    description: 'Clarify what matters, what to sequence, and where to focus.',
    href: '/work-with/direction-and-prioritization',
    size: 'small',
    tone: 'direction',
    image: 'images/direction/hero-bg.png'
  },
  {
    title: 'Standards & Scale',
    description: 'Preserve quality, accessibility, and consistency as complexity grows.',
    href: '/work-with/standards-and-scale',
    size: 'small',
    tone: 'standards',
    image: 'images/standards/standards-hero-bg.png'
  },
  {
    title: 'AI-enabled Systems',
    description: 'Turn AI capability into useful systems, not disconnected experiments.',
    href: '/work-with/ai-enabled-systems',
    size: 'large',
    tone: 'ai',
    image: 'images/work-ai/certainty-run-out.png'
  }
];

const practiceStats = [
  {
    eyebrow: 'Current role',
    labelLines: ['Chief Product Designer', 'at feature[23]'],
    text: 'Built and scaled a design practice focused on repeatable outcomes, stronger team quality, and dependable delivery partnership.',
    visualType: 'rocket',
    outlineImage: withBase('images/home-v3/practice/practice-rocket-outline.svg'),
    detailImage: withBase('images/home-v3/practice/practice-rocket-detail.png')
  },
  {
    eyebrow: 'Experience',
    labelLines: ['17+ years across', 'product and design'],
    text: 'Hands-on leadership across startup and enterprise environments, from direction setting through implementation.',
    visualType: 'telescope',
    outlineImage: withBase('images/home-v3/practice/practice-telescope-outline.svg'),
    detailImage: withBase('images/home-v3/practice/practice-telescope-detail.png')
  },
  {
    eyebrow: 'Operating Model',
    labelLines: ['Systems-led, people-first', 'operating model'],
    text: 'Clarifies goals, concepts, and activities to align teams and build standards that keep momentum high without creating chaos.',
    visualType: 'helmet',
    outlineImage: withBase('images/home-v3/practice/practice-helmet-outline.svg'),
    detailImage: withBase('images/home-v3/practice/practice-helmet-detail.png')
  }
];

const bridgePillars = [
  {
    index: '1.0',
    tone: 'clarity',
    title: 'Clarity.',
    headline: 'Make better decisions sooner with clearer direction.',
    body: 'Create shared understanding, sharper context, and alignment leaders can trust.'
  },
  {
    index: '2.0',
    tone: 'strategy',
    title: 'Strategy.',
    headline: 'Turn competing inputs into a path people can commit to.',
    body: 'Align priorities, tradeoffs, sequencing, and investment around what matters most.'
  },
  {
    index: '3.0',
    tone: 'systems',
    title: 'Systems.',
    headline: 'Create the standards and rhythms that sustain execution.',
    body: 'Build the operating models, practices, and guardrails that help execution hold.'
  }
];

const changeSignals = [
  {
    label: 'Leadership signal',
    title: 'The product story becomes easier to defend.',
    text: 'Executive conversations get sharper when the customer value, business tradeoffs, and delivery constraints connect in one coherent direction.'
  },
  {
    label: 'Decision quality',
    title: 'Ambiguity turns into usable judgment.',
    text: 'Teams get clearer criteria for what matters, what can wait, and where design quality has to protect the business.'
  },
  {
    label: 'Execution drag',
    title: 'Avoidable loops start to disappear.',
    text: 'Product, design, and engineering spend less time reworking direction because the standards, handoffs, and decision rights are explicit.'
  },
  {
    label: 'Operating leverage',
    title: 'Design leadership becomes a system.',
    text: 'Patterns, rituals, and product standards stop living in one person’s head and start helping the organization make better calls repeatedly.'
  },
  {
    label: 'Team confidence',
    title: 'People can move without guessing.',
    text: 'Strong teams do better work when they are not decoding vague direction, defending the same points, or waiting for alignment to re-form.'
  }
];

const operatingShifts = [
  {
    result: 'Conceptual integrity',
    before: '',
    mechanism: 'Core concepts, behavior, standards, and implementation logic stay consistent.',
    after: ''
  },
  {
    result: 'Sharper vision',
    before: '',
    mechanism: 'Decision confidence becomes easier to see, choose, communicate, and sustain.',
    after: ''
  },
  {
    result: 'Baseline rigor',
    before: '',
    mechanism: 'Accessibility, ethical standards, and best practices drive shared expectations.',
    after: ''
  },
  {
    result: 'Integrated systems',
    before: '',
    mechanism: 'Rituals, artifacts, and infrastructure keep disciplines connected.',
    after: ''
  },
  {
    result: 'Confident teams',
    before: '',
    mechanism: 'Visible constraints, clear direction, and decisions teams trust reduce drift, ambiguity, and costly rework.',
    after: ''
  }
];

const caseStudies = [
  {
    image: withBase('images/case-studies/home/insurance.png'),
    imageAlt: 'Insurance platform workflow and operations context',
    logo: 'Trident Reciprocal',
    logoImage: '',
    logoAlt: 'Trident Reciprocal insurance operations platform',
    stacked: true,
    role: 'Design leadership through feature[23]',
    tags: ['Insurance operations platform', 'Underwriting workflows', 'AI-assisted delivery'],
    outcome: 'Rebuilt underwriting workflows and member-facing systems for operational scale.',
    text: 'At feature[23], I contributed to rebuilding core insurance workflows and member platform experiences to support regulatory demands, operational stability, and future member growth.'
  },
  {
    image: withBase('images/case-studies/home/insurance.png'),
    imageAlt: 'Enterprise logistics shipment workflow planning interface',
    logo: 'Total Military Management',
    logoImage: '',
    logoAlt: 'Total Military Management enterprise logistics platform',
    stacked: true,
    role: 'Design leadership through feature[23]',
    tags: ['Enterprise logistics platform', 'Shipment coordination', 'Workflow transformation'],
    outcome: 'Re-architected shipment workflows to save an estimated ~6,000 hours per year.',
    text: 'Reshaped migration decisions around role-based shipment coordination and operational efficiency instead of preserving legacy bloat.'
  },
  {
    image: withBase('images/img.png'),
    imageAlt: 'Reporting architecture and KPI dashboard strategy',
    logo: 'Superior Fence & Rail / Fence360',
    logoImage: '',
    logoAlt: 'Superior Fence & Rail Fence360 commercial field operations platform',
    role: 'Design leadership through feature[23]',
    tags: ['Commercial field operations platform', 'Reporting systems', 'Operational tooling'],
    outcome: 'Reframed reporting architecture around growth, field visibility, and financial clarity.',
    text: 'Restructured navigation, KPI prioritization, and drill-down patterns to support better operational decisions at scale.'
  },
  {
    image: withBase('images/case-studies/home/beaver-operations.svg'),
    imageAlt: 'Restaurant commerce and operations workflow platform',
    logo: 'Shokudo',
    logoImage: '',
    logoAlt: 'Shokudo restaurant commerce and operations platform',
    role: 'Design leadership through feature[23]',
    tags: ['Restaurant commerce platform', 'Billing systems', 'Operations workflows'],
    outcome: 'Structured ordering, billing, communication, and delivery workflows.',
    text: 'Helped frame operational tooling for restaurant technology where customer experience, back-of-house workflows, and business controls need to stay connected.'
  },
  {
    image: withBase('images/home-v3/blueprint/operating-model-blueprint-transparent.png'),
    imageAlt: 'Product delivery infrastructure blueprint',
    logo: 'Studio',
    logoImage: '',
    logoAlt: 'Studio product delivery infrastructure',
    role: 'Internal product delivery infrastructure',
    tags: ['Product delivery infrastructure', 'Design system alignment', 'Prototype review'],
    outcome: 'Internal delivery infrastructure for prototypes, design systems, shared context, and alignment.',
    text: 'A future case study on the internal workspace used to help teams build and review operational product systems with more clarity.'
  }
];

const proofDraftCards = [
  {
    kicker: 'Regulated insurance platform',
    details: ['Insurance operations', 'Business workshops', 'Conceptual product design', 'Agent, member, and underwriting workflows'],
    title: 'Helped shape core insurance workflows across agents, members, and underwriting.',
    image: proofDraftImage,
    imageAlt: 'Swimmer moving through pool water',
    imagePosition: 'center center'
  },
  {
    kicker: 'Franchise operations platform',
    details: ['Bid Management', 'Reporting & Forecasting', 'Analytics', 'Franchise Expansion & Growth'],
    title: 'Contributed operational tooling that helps franchise teams see, manage, and forecast fence installations.',
    image: 'https://images.unsplash.com/photo-1560749003-f4b1e17e2dff?q=80&w=1674&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D',
    imageAlt: 'Person working at a desk with technology',
    imagePosition: 'center center'
  },
  {
    kicker: 'Global seafood supply chain platform',
    details: ['Food distribution', 'Global supply chain operations', 'Production scheduling', 'Workflow design'],
    title: 'Helped shape operations workflows across a global seafood supply chain platform, including production floor scheduling.',
    image: 'https://images.unsplash.com/photo-1588160282477-7abbf7ee8c5f?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D',
    imageAlt: 'Seafood displayed on ice',
    imagePosition: 'center center'
  },
  {
    kicker: 'Veteran services data platform',
    details: ['Veteran services', 'Secure intake workflows', 'Sensitive data management', 'Reporting systems'],
    title: 'Contributed to veteran intake and secure data management for a growing national nonprofit.',
    image: 'https://images.unsplash.com/photo-1696271929832-6a91a90b5884?q=80&w=2674&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D',
    imageAlt: 'Veteran service dog sitting beside a person',
    imagePosition: 'center center'
  }
];

const engagementModels = [
  {
    title: 'Fractional design leadership',
    fit: 'For sustained leadership',
    text: 'Embedded leadership support for product direction, organizational alignment, and critical design decisions across teams.'
  },
  {
    title: 'AI-enabled product exploration',
    fit: 'For high-stakes inflection points',
    text: 'Explore new workflows, model system behavior, and pressure-test what needs to be true before teams invest.'
  },
  {
    title: 'Transformation and reset work',
    fit: 'For change, scale, or recovery',
    text: 'Focused engagements to diagnose operational friction, realign teams, and establish stronger product and design foundations.'
  }
];

const fitQuestions = [
  {
    question: 'Are you looking for a full-time role?',
    answer: 'No. I am happy in my current role at feature[23]. I am open to select advisory, consulting, and fractional leadership engagements.'
  },
  {
    question: 'When should a team reach out?',
    answer: 'When direction is moving, the stakes are real, and leadership needs sharper decisions across product, design, and engineering.'
  },
  {
    question: 'What kinds of teams are a fit?',
    answer: 'Executives, product leaders, engineering partners, and design teams working through growth, transformation, or complex delivery.'
  },
  {
    question: 'Is this strategy or execution support?',
    answer: 'Both. The work is strongest when direction, standards, and implementation details stay connected.'
  },
  {
    question: 'What work is not a fit?',
    answer: 'Quick-turn identity work, low-leverage collateral, and isolated visual polish are not the fit. I work best on product direction, UX systems, design leadership, and implementation-focused product work.'
  }
];

const featuredPractice = practiceStats[0];
const supportingPractice = practiceStats.slice(1);
const featuredWriting = writingRoadmapEntries[0];
const supportingWriting = writingRoadmapEntries.slice(1);
const writingVisualVariants = ['quiet', 'quiet-violet', 'quiet-blue', 'quiet-ink'];
const getWritingVisualVariant = (index: number) => writingVisualVariants[index % writingVisualVariants.length];
---

<Layout
  title="Dan Malarkey | Design Leadership for Teams in Motion"
  description="Dan Malarkey helps teams structure workflows, delivery systems, communication models, and product infrastructure required to scale."
>
  <main class="home-v3">
    <section class="home-v3-intro">
      <Header />

      <section class="home-v3-hero">
        <div class="dm-grid-l dm-grid-l--grid-sys home-v3-hero-layout">
          <div class="home-v3-hero-frame gc-start-1 gc-span-26">
            <div class="home-v3-window" aria-hidden="true">
              <div class="home-v3-window-rays"></div>
              <canvas id="home-v3-stars"></canvas>
              <div class="home-v3-hero-noise"></div>
              <div class="home-v3-window-light-field"></div>
              <div class="home-v3-window-core"></div>
              <div class="home-v3-window-glow"></div>
              <div class="home-v3-window-haze"></div>
              <div class="home-v3-window-orbit"></div>
            </div>

            <div class="dm-grid-l dm-grid-l--grid-sys home-v3-hero-grid">
              <div class="home-v3-hero-copy gc-start-2 gc-span-16">
                <div class="home-v3-hero-primary">
                  <p class="home-v3-kicker">Chief Product Designer at feature[23]</p>
                  <h1>For teams in motion.</h1>
                </div>
                <div class="home-v3-hero-support">
                  <p class="home-v3-lead">
                    I design systems of work. Across insurance, logistics, restaurant technology, and operational software, I help organizations structure the workflows, delivery systems, communication models, and product infrastructure required to scale.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </section>

    <section id="focus-areas" class="section home-v3-focus-areas" aria-label="Focus areas" data-home-v3-reveal>
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <SectionHeader
          eyebrow="Focus areas across the organization"
          title="Different focus areas. One connected model."
          body="Organizations rarely struggle in one isolated place. Direction, operating models, emerging technology, standards, and delivery decisions all shape each other. I focus where those pressures need to stay connected so teams can make better decisions, move with clearer priorities, and build systems that hold as conditions change."
          accent
          headClass="home-v3-focus-areas-head gc-start-2 gc-span-10"
          bodyClass="gc-start-15 gc-span-11"
        />

        <div class="home-v3-focus-areas-grid gc-start-2 gc-span-24" role="list">
          {focusAreaCards.map((item) => (
            <a
              class:list={[
                'home-v3-focus-card',
                `home-v3-focus-card--${item.size}`,
                `home-v3-focus-card--${item.tone}`,
                item.image && 'home-v3-focus-card--image'
              ]}
              href={withBase(item.href)}
              role="listitem"
              style={item.image ? `--home-v3-focus-card-image: url('${withBase(item.image)}')` : undefined}
            >
              <span class="home-v3-focus-card-visual" aria-hidden="true"></span>
              <span class="home-v3-focus-card-content">
                <span class="home-v3-focus-card-title">{item.title}</span>
                <span class="home-v3-focus-card-description">{item.description}</span>
                <span class="home-v3-focus-card-action">How I help</span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section home-v3-client-trust" aria-label="Organizations I have supported" data-home-v3-reveal>
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <div class="home-v3-client-trust-shell gc-start-3 gc-span-22">
          <p class="home-v3-client-trust-label">Organizations I’ve supported</p>
          <div class="home-v3-client-marquee" aria-hidden="true">
            <div class="home-v3-client-marquee-track">
              {supportedOrganizationLoop.map((organization) => (
                <span class="home-v3-client-logo">{organization}</span>
              ))}
            </div>
          </div>
          <ul class="home-v3-client-trust-list sr-only">
            {supportedOrganizations.map((organization) => (
              <li>{organization}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    {homeV3BridgeVariant === 'pillars' ? (
      <section class="section home-v3-pillars" aria-label="Clarity, strategy, and systems" data-home-v3-reveal>
        <div class="dm-grid-l dm-grid-l--grid-sys">
          <div class="home-v3-pillars-shell gc-start-2 gc-span-24">
            <div class="home-v3-pillars-head">
              <p class="home-v3-section-label">How the work holds</p>
              <h2>Clearer priorities when the stakes are high.</h2>
            </div>
            <div class="home-v3-pillars-surface" data-home-v3-reveal-late>
              <div class="home-v3-pillars-grid" role="list">
                {bridgePillars.map((pillar) => (
                  <article class={`home-v3-pillar home-v3-pillar--${pillar.tone}`} role="listitem">
                    <p class="home-v3-pillar-index">{pillar.index}</p>
                    <div class="home-v3-pillar-main">
                      <h2 class="home-v3-pillar-title">{pillar.title}</h2>
                      <p class="home-v3-pillar-headline">{pillar.headline}</p>
                    </div>
                    <p class="home-v3-pillar-body">{pillar.body}</p>
                  </article>
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>
    ) : homeV3BridgeVariant === 'legacy' ? (
      <section class="section home-v3-bridge" aria-label="Operating range" data-home-v3-bridge>
        <div class="dm-grid-l dm-grid-l--grid-sys">
          <div class="home-v3-bridge-shell gc-start-1 gc-span-26">
            <div class="home-v3-bridge-atmosphere" aria-hidden="true">
              <span class="home-v3-bridge-beam"></span>
              <span class="home-v3-bridge-beam-core"></span>
              <span class="home-v3-bridge-haze home-v3-bridge-haze--one"></span>
              <span class="home-v3-bridge-haze home-v3-bridge-haze--two"></span>
              <span class="home-v3-bridge-haze home-v3-bridge-haze--three"></span>
              <span class="home-v3-bridge-arc"></span>
              <span class="home-v3-bridge-node home-v3-bridge-node--one"></span>
              <span class="home-v3-bridge-node home-v3-bridge-node--two"></span>
              <span class="home-v3-bridge-node home-v3-bridge-node--three"></span>
              <span class="home-v3-bridge-node home-v3-bridge-node--four"></span>
            </div>
            <div class="home-v3-bridge-stage" data-home-v3-bridge-stage>
              <div class="home-v3-bridge-bg" data-home-v3-bridge-bg aria-hidden="true"></div>
              <div class="home-v3-bridge-words" aria-hidden="true">
                <div class="home-v3-bridge-scene home-v3-bridge-scene--strategy" data-home-v3-bridge-scene="strategy">
                  <h2 class="home-v3-bridge-word" data-home-v3-bridge-word="strategy">Strategy.</h2>
                </div>
                <div class="home-v3-bridge-scene home-v3-bridge-scene--systems" data-home-v3-bridge-scene="systems">
                  <h2 class="home-v3-bridge-word" data-home-v3-bridge-word="systems">Systems.</h2>
                </div>
                <div class="home-v3-bridge-scene home-v3-bridge-scene--clarity" data-home-v3-bridge-scene="clarity">
                  <h2 class="home-v3-bridge-word" data-home-v3-bridge-word="clarity">Clarity.</h2>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    ) : (
      <section class="section home-v3-bridge-lite" aria-label="Operating range" data-home-v3-bridge-lite>
        <div class="dm-grid-l dm-grid-l--grid-sys">
          <div class="home-v3-bridge-lite-shell gc-start-1 gc-span-26">
            <div class="home-v3-bridge-lite-stage">
              <div class="home-v3-bridge-lite-backdrop" aria-hidden="true"></div>

  #home-stars {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    z-index: 1;
  }

  .home-window-light-field,
  .home-window-core,
  .home-window-glow,
  .home-window-haze,
  .home-window-orbit {
    position: absolute;
    pointer-events: none;
  }

  .home-window-light-field {
    inset: 0;
    background:
      linear-gradient(116deg, rgba(231, 235, 242, 0) 60%, rgba(176, 204, 255, 0.03) 70%, rgba(176, 204, 255, 0.01) 76%, rgba(231, 235, 242, 0) 82%),
      radial-gradient(circle at 86% 18%, rgba(176, 204, 255, 0.04), rgba(176, 204, 255, 0) 20%),
      radial-gradient(circle at 72% 84%, rgba(176, 204, 255, 0.028), rgba(176, 204, 255, 0) 20%);

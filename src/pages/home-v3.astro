const needModes = [
  {
    title: 'Shared priorities teams can align around',
    text: 'Less drift, cleaner decisions, and clearer alignment on what matters now.'
  },
  {
    title: 'Product vision translated into real direction',
    text: 'Goals, constraints, and customer reality shaped into direction teams can actually build against.'

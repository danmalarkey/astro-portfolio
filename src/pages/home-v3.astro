<script is:inline>
  (() => {
    const initStarfield = (id, options = {}) => {
      const canvas = document.getElementById(id);
      if (!(canvas instanceof HTMLCanvasElement)) return;

      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const stars = [];
      let width = 0;
      let height = 0;
      const count = options.count ?? 120;
      const drift = options.drift ?? 0.02;
      const shootingStars = [];
      let nextShootingStarAt = 0;

      const resize = () => {
        width = window.innerWidth;
        height = window.innerHeight;
        const ratio = Math.max(window.devicePixelRatio || 1, 1);
        canvas.width = Math.floor(width * ratio);
        canvas.height = Math.floor(height * ratio);
        canvas.style.width = `${width}px`;
        canvas.style.height = `${height}px`;
        ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
      };

      const seed = () => {
        stars.length = 0;
        for (let i = 0; i < count; i += 1) {
          stars.push({
            x: Math.random() * width,
            y: Math.random() * height,
            radius: Math.random() * 1.8 + 0.3,
            alpha: Math.random() * 0.8 + 0.12,
            vx: (Math.random() - 0.5) * drift,
            vy: (Math.random() - 0.5) * drift
          });
        }
      };

      const draw = () => {
        ctx.clearRect(0, 0, width, height);
        for (const star of stars) {
          if (!prefersReducedMotion) {
            star.x += star.vx;
            star.y += star.vy;

            if (star.x < 0) star.x = width;
            if (star.x > width) star.x = 0;
            if (star.y < 0) star.y = height;
            if (star.y > height) star.y = 0;
          }

          ctx.fillStyle = `rgba(231, 235, 242, ${star.alpha})`;
          ctx.beginPath();
          ctx.arc(star.x, star.y, star.radius, 0, Math.PI * 2);
          ctx.fill();
        }

        if (!prefersReducedMotion) {
          const now = performance.now();

          // Frequent but controlled shooting stars for atmospheric motion.
          if (now >= nextShootingStarAt && shootingStars.length < 2) {
            const fromLeft = Math.random() > 0.5;
            const startX = fromLeft ? -120 : width + 120;
            const startY = Math.random() * (height * 0.45) + 20;
            const speed = 2.2 + Math.random() * 1.1;
            const angle = fromLeft ? 0.35 + Math.random() * 0.25 : Math.PI - (0.35 + Math.random() * 0.25);
            shootingStars.push({
              x: startX,
              y: startY,
              vx: Math.cos(angle) * speed,
              vy: Math.sin(angle) * speed,
              life: 0,
              maxLife: 150 + Math.random() * 60
            });
            nextShootingStarAt = now + 1100 + Math.random() * 1600;
          }

          for (let i = shootingStars.length - 1; i >= 0; i -= 1) {
            const shootingStar = shootingStars[i];
            shootingStar.x += shootingStar.vx;
            shootingStar.y += shootingStar.vy;
            shootingStar.life += 1;

            const t = shootingStar.life / shootingStar.maxLife;
            const alpha = Math.max(0, 0.92 * (1 - t));
            const tailX = shootingStar.x - shootingStar.vx * 9;
            const tailY = shootingStar.y - shootingStar.vy * 9;

            const gradient = ctx.createLinearGradient(shootingStar.x, shootingStar.y, tailX, tailY);
            gradient.addColorStop(0, `rgba(255, 255, 255, ${alpha})`);
            gradient.addColorStop(1, 'rgba(255, 255, 255, 0)');

            ctx.strokeStyle = gradient;
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.moveTo(shootingStar.x, shootingStar.y);
            ctx.lineTo(tailX, tailY);
            ctx.stroke();

            if (
              shootingStar.life >= shootingStar.maxLife ||
              shootingStar.x < -240 ||
              shootingStar.x > width + 240 ||
              shootingStar.y > height + 120
            ) {
              shootingStars.splice(i, 1);
            }
          }
        }

        if (!prefersReducedMotion) requestAnimationFrame(draw);
      };

      resize();
      seed();
      draw();
      nextShootingStarAt = performance.now() + 1800;
      window.addEventListener('resize', () => {
        resize();
        seed();
      });
    };

    initStarfield('home-v3-stars', { count: 96, drift: 0.01 });
    initStarfield('home-v3-close-stars', { count: 95, drift: 0.008 });
  })();

  (() => {
    const rail = document.getElementById('case-rail');
    const prevButton = document.querySelector('[data-case-prev]');
    const nextButton = document.querySelector('[data-case-next]');
    const currentNode = document.querySelector('[data-case-current]');
    const progressNode = document.querySelector('[data-case-progress]');

    if (!rail || !(rail instanceof HTMLElement) || !prevButton || !nextButton) return;

    const cards = Array.from(rail.querySelectorAll('.case-card'));
    const totalCards = cards.length;
    let activeIndex = 0;
    const EDGE_EPSILON = 4;

    const syncRailTailSpace = () => {
      const firstCard = cards[0];
      if (!(firstCard instanceof HTMLElement)) return;
      const trailingSpace = Math.max(0, rail.clientWidth - firstCard.offsetWidth);
      rail.style.setProperty('--size-case-rail-tail-space', `${trailingSpace}px`);
    };

    const updateProgress = () => {
      if (currentNode) currentNode.textContent = `${activeIndex + 1}`;
      if (progressNode instanceof HTMLElement) {
        const progress = totalCards <= 1 ? 1 : (activeIndex + 1) / totalCards;
        progressNode.style.transform = `scaleX(${progress.toFixed(4)})`;
      }
    };

    const updateActiveIndex = () => {
      if (rail.scrollLeft <= EDGE_EPSILON) {
        activeIndex = 0;
        updateProgress();
        return;
      }

      const maxScroll = Math.max(0, rail.scrollWidth - rail.clientWidth);
      if (rail.scrollLeft >= maxScroll - EDGE_EPSILON) {
        activeIndex = Math.max(0, totalCards - 1);
        updateProgress();
        return;
      }

      const railStart = rail.scrollLeft;
      let closestIndex = 0;
      let closestDistance = Number.POSITIVE_INFINITY;

      cards.forEach((card, index) => {
        if (!(card instanceof HTMLElement)) return;
        const distance = Math.abs(card.offsetLeft - railStart);
        if (distance < closestDistance) {
          closestDistance = distance;
          closestIndex = index;
        }
      });

      activeIndex = closestIndex;
      updateProgress();
    };

    const updateButtons = () => {
      prevButton.removeAttribute('disabled');
      nextButton.removeAttribute('disabled');
      updateActiveIndex();
    };

    const scrollToIndex = (index) => {
      const nextIndex = Math.max(0, Math.min(index, totalCards - 1));
      const targetCard = cards[nextIndex];
      if (!(targetCard instanceof HTMLElement)) return;
      rail.scrollTo({ left: targetCard.offsetLeft, behavior: 'smooth' });
    };

    prevButton.addEventListener('click', () => {
      updateActiveIndex();
      const nextIndex = activeIndex <= 0 ? totalCards - 1 : activeIndex - 1;
      scrollToIndex(nextIndex);
    });
    nextButton.addEventListener('click', () => {
      updateActiveIndex();
      const nextIndex = activeIndex >= totalCards - 1 ? 0 : activeIndex + 1;
      scrollToIndex(nextIndex);
    });
    rail.addEventListener('scroll', updateButtons, { passive: true });
    window.addEventListener('resize', () => {
      syncRailTailSpace();
      updateButtons();
    });

    syncRailTailSpace();
    updateProgress();
    updateButtons();
  })();
</script>


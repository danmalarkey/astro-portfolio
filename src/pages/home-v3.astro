            <button type="button" class="case-rail-btn case-rail-btn--icon" data-case-prev aria-controls="case-rail" aria-label="Scroll to previous case study">
              <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <path d="M10.75 2.75 5.5 8l5.25 5.25" />
              </svg>
            </button>
            <button type="button" class="case-rail-btn case-rail-btn--icon" data-case-next aria-controls="case-rail" aria-label="Scroll to next case study">

    imageAlt: 'Member platform sign-up experience for a regional bank',
    logo: 'Regional bank membership platform',
    logoImage: '',
    logoAlt: 'Regional bank membership platform',
    role: 'Product design through feature[23]',
    tags: ['Visual', 'Member onboarding', 'Conversion'],
    outcome: 'Designed a member sign-up experience focused on clarity, confidence, and completion.',
    text: 'Used visual hierarchy and onboarding flow design to reduce friction in a high-intent account and membership enrollment experience.'

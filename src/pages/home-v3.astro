            {beforeAfterColumns.map((column) => (
              <article class={`home-v3-panel home-v3-shift-card home-v3-shift-card--${column.label.toLowerCase()}`} role="listitem">
                <p class="home-v3-card-label">{column.label}</p>
                <ul class="home-v3-shift-list">
                  {column.rows.map((row) => <li>{row}</li>)}

          <p class="home-v3-footer-title">Dan Malarkey</p>
          <p class="home-v3-footer-copy">Product design leadership for organizations navigating complexity, change, and growth.</p>
        </div>
        <div class="home-v3-footer-links">
          <a href={withBase('/work')}>Work</a>
          <a href={withBase('/writing')}>Writing</a>

    </section>

    <section class="home-v3-close" data-home-v3-reveal>
      <div class="home-v3-close-shell">
        <canvas id="home-v3-close-stars" aria-hidden="true"></canvas>
        <div class="home-v3-close-dome" aria-hidden="true"></div>
        <div class="home-v3-close-content">
          <p class="home-v3-section-label">Work with me</p>
          <h2>If your product organization needs sharper direction and stronger design leadership, let’s talk.</h2>
          <div class="home-v3-actions home-v3-actions--close">
            <a class="home-v3-button home-v3-button--solid" href="mailto:hello@danmalarkey.com">Start a conversation</a>
            <a class="home-v3-button home-v3-button--ghost" href={withBase('/about')}>About Dan</a>

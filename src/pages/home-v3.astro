    text: 'Focused support for rebuilding workflows, reestablishing standards, and improving operating rhythm across teams.'
  }
];

const writingEntries = [
  {
    title: 'What design leaders do when product direction is unclear',
    type: 'Essay',
    summary: 'A practical framework for clarifying decisions, reducing drift, and giving teams direction they can execute against.',
    href: withBase('/writing/design-leaders-when-direction-is-unclear')
  },
  {
    title: 'Using AI to compress design-to-build cycles without creating chaos',
    type: 'Drafting',
    summary: 'How AI can improve speed and implementation readiness when it is used as a systems multiplier instead of a shortcut.',
    href: withBase('/writing')

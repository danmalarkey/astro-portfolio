  },
  {
    title: 'Fractional leadership that stays close to execution',
    text: 'Supporting strategy and organizational alignment while still getting into the work when outcomes depend on it.'
  }
];

const engagementModels = [
  {
    title: 'Fractional design leadership',
    fit: 'Best for sustained leadership',
    text: 'Embedded leadership support for product direction, organizational alignment, and critical design decisions across teams.'
  },
  {
    title: 'Advisory and consulting engagements',
    fit: 'Best for high-stakes inflection points',
    text: 'Targeted support for high-stakes decisions, product direction, and delivery friction where senior design leadership is needed quickly.'
  },
  {

            {[featuredWriting, ...supportingWriting].map((entry, index) => (
              <article class={`home-v3-writing-volume home-v3-writing-volume--${(index % 4) + 1}`} role="listitem">
                <div class="home-v3-writing-volume-head">
                  <p class="home-v3-writing-volume-meta home-v3-card-meta-text">{entry.type}</p>
                </div>
                <h3 class="home-v3-writing-volume-title home-v3-card-title-text">
                  {entry.live ? <a href={withBase(`/writing/${entry.slug}`)}>{entry.title}</a> : entry.title}
                </h3>
                <p class="home-v3-writing-volume-summary home-v3-card-copy-text home-v3-card-copy-text--muted">{entry.summary}</p>
              </article>
            ))}

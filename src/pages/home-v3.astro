---
import Layout from '../layouts/Layout.astro';
import { writingRoadmapEntries } from '../data/writing-roadmap';

const baseUrl = Astro.url.pathname.startsWith('/astro-portfolio') ? '/astro-portfolio/' : '/';
const homeV3BridgeVariant: 'legacy' | 'lite' | 'pillars' = 'pillars';
const homeV3ActorsVariant: 'legacy' | 'concept' = 'concept';
const homeV3ActorsConceptVariant: 'scene' | 'lane' = 'lane';
const homeV3PracticeVariant: 'grid' | 'story-stack' | 'solid-cards' = 'grid';
const homeV3ShiftVariant: 'contrast' | 'hidden' = 'hidden';
const withBase = (path: string) => `${baseUrl}${path.startsWith('/') ? path.slice(1) : path}`;
const createActorMailto = (actor: string, prompt: string) => {
  const params = new URLSearchParams();
  params.set('subject', `[${actor}] Advisory inquiry`);
  params.set('body', `Hi Dan,\n\nI'm reaching out as ${prompt} and would like to talk about design leadership support.\n\nContext:\n- Team/company:\n- What we're navigating:\n- What kind of support we need:\n\nThanks,`);
  return `mailto:hello@danmalarkey.com?${params.toString()}`;
};

const leverageCards = [
  {
    title: 'Executives and product drivers',
    descriptionLines: [
      'Clarifying product direction, aligning',
      'investment priorities, and making design',
      'a driver of business outcomes.'
    ],
    cardFit: 'For teams that need sharper product direction and clearer investment bets.',
    artType: 'executive',
    conceptLabel: 'Strategic direction',
    conceptSignals: ['Direction', 'Investment', 'Outcomes'],
    laneRows: [
      { label: 'Direction', detail: 'What matters now' },
      { label: 'Investment', detail: 'Sequence bets' },
      { label: 'Outcomes', detail: 'Business impact' }
    ],
    image: 'images/dan-right.png',
    imageAlt: 'Executive product design leadership and strategy collaboration',
    actorSlug: '/work-with/executives-and-product-drivers',
    actorLabel: 'an executive or product leader'
  },
  {
    title: 'Product and engineering teams',
    descriptionLines: [
      'Reducing delivery friction, improving',
      'collaboration, and creating repeatable',
      'patterns teams can ship with confidence.'
    ],
    cardFit: 'For teams slowed by delivery friction, ambiguity, or weak handoffs.',
    artType: 'product',
    conceptLabel: 'Execution systems',
    conceptSignals: ['Roadmap', 'Handoffs', 'Delivery'],
    laneRows: [
      { label: 'Roadmap', detail: 'Reduce ambiguity' },
      { label: 'Handoffs', detail: 'Better flow' },
      { label: 'Delivery', detail: 'Ship confidently' }
    ],
    image: 'images/img.png',
    imageAlt: 'Cross-functional product and engineering collaboration',
    actorSlug: '/work-with/product-and-engineering-teams',
    actorLabel: 'a product or engineering leader'
  },
  {
    title: 'Designers and design leaders',
    descriptionLines: [
      'Raising craft maturity, establishing standards,',
      'and strengthening design influence in strategic',
      'product and organizational decisions.'
    ],
    cardFit: 'For organizations building stronger standards, coaching, and design influence.',
    artType: 'design',
    conceptLabel: 'Capability building',
    conceptSignals: ['Standards', 'Coaching', 'Influence'],
    laneRows: [
      { label: 'Standards', detail: 'Quality bar' },
      { label: 'Coaching', detail: 'Raise judgment' },
      { label: 'Influence', detail: 'Earlier decisions' }
    ],
    image: 'images/dan.png',
    imageAlt: 'Design leadership and team development',
    actorSlug: '/work-with/designers-and-design-leaders',
    actorLabel: 'a design leader'
  }
];

const practiceStats = [
  {
    eyebrow: 'Current role',
    labelLines: ['Chief Product Designer', 'at feature[23]'],
    text: 'Built and scaled a design practice focused on repeatable outcomes, stronger team quality, and dependable delivery partnership.',
    visualType: 'rocket',
    outlineImage: withBase('images/home-v3/practice/practice-rocket-outline.svg'),
    detailImage: withBase('images/home-v3/practice/practice-rocket-detail.png')
  },
  {
    eyebrow: 'Experience',
    labelLines: ['17+ years across', 'product and design'],
    text: 'Hands-on leadership across startup and enterprise environments, from direction setting through implementation.',
    visualType: 'telescope',
    outlineImage: withBase('images/home-v3/practice/practice-telescope-outline.svg'),
    detailImage: withBase('images/home-v3/practice/practice-telescope-detail.png')
  },
  {
    eyebrow: 'Operating model',
    labelLines: ['Systems-led, people-first', 'operating model'],
    text: 'Clarifies priorities, aligns teams, and builds standards that keep momentum high without creating chaos.',
    visualType: 'helmet',
    outlineImage: withBase('images/home-v3/practice/practice-helmet-outline.svg'),
    detailImage: withBase('images/home-v3/practice/practice-helmet-detail.png')
  }
];

const bridgePillars = [
  {
    index: '1.0',
    tone: 'clarity',
    title: 'Clarity.',
    headline: 'Make better decisions sooner.',
    detail: 'Create shared understanding of what matters now.'
  },
  {
    index: '2.0',
    tone: 'strategy',
    title: 'Strategy.',
    headline: 'Align direction, priorities, and investment.',
    detail: 'Turn competing inputs into a path teams can commit to.'
  },
  {
    index: '3.0',
    tone: 'systems',
    title: 'Systems.',
    headline: 'Build operating models that help teams execute.',
    detail: 'Create the standards and rhythms that sustain momentum.'
  }
];

const beforeAfterColumns = [
  {
    label: 'Before',
    rows: [
      'Priorities are moving, but decision criteria are unclear',
      'Design is active, but not shaping direction early enough',
      'Teams are shipping, but alignment debt keeps compounding',
      'Leadership feels momentum, but confidence in the path is uneven'
    ]
  },
  {
    label: 'After',
    rows: [
      'Decisions are clearer, easier to defend, and easier to execute',
      'Design contributes to direction, not only execution',
      'Teams have stronger operating rhythm and fewer avoidable loops',
      'Leadership gets speed with better signal and less chaos'
    ]
  }
];

const howItChangesRows = [
  'Clear decision criteria and tradeoff framing before execution starts',
  'Goals and constraints translated into a clearer product vision teams can work from',
  'Design involved earlier in direction-setting, not only interface delivery',
  'Shared working patterns across leadership, product, engineering, and design',
  'Systems and standards that reduce rework without adding process drag'
];

const caseStudies = [
  {
    image: withBase('images/case-studies/home/insurance.png'),
    imageAlt: 'Insurance platform workflow and operations context',
    logo: 'Home Insurance Platform',
    logoImage: '',
    logoAlt: 'Home insurance platform',
    stacked: true,
    role: 'Design leadership through feature[23]',
    tags: ['Platform', 'Mission critical', 'AI acceleration'],
    outcome: 'Helped lead a mission-critical digital transformation across internal operations and member-facing experiences.',
    text: 'At feature[23], I contributed to rebuilding core insurance workflows and member platform experiences to support regulatory demands, operational stability, and future member growth.'
  },
  {
    image: withBase('images/case-studies/home/beaver-operations.svg'),
    imageAlt: 'Global seafood supply chain operations platform',
    logo: 'Beaver Street Fisheries',
    logoImage: '',
    logoAlt: 'Beaver Street Fisheries',
    stacked: false,
    role: 'Design leadership through feature[23]',
    tags: ['Platform', 'Supply chain', 'Enterprise operations'],
    outcome: 'Unified a global seafood supply chain with a custom operations platform across compliance, logistics, and production.',
    text: 'At feature[23], I helped design and build an operations layer that replaced spreadsheet-driven workflows and improved coordination across sourcing, inbound logistics, and kitchen production.'
  },
  {
    image: withBase('images/case-studies/home/insurance.png'),
    imageAlt: 'Enterprise logistics shipment workflow planning interface',
    logo: 'Enterprise Logistics Platform',
    logoImage: '',
    logoAlt: 'Enterprise logistics platform',
    stacked: true,
    role: 'Design leadership through feature[23]',
    tags: ['Systems', 'Migration', 'Operational efficiency'],
    outcome: 'Re-architected shipment workflows to save an estimated ~6,000 hours per year.',
    text: 'Reshaped migration decisions around role-based workflows and operational efficiency instead of preserving legacy bloat.'
  },
  {
    image: withBase('images/img.png'),
    imageAlt: 'Reporting architecture and KPI dashboard strategy',
    logo: 'Field Operations Reporting Platform',
    logoImage: '',
    logoAlt: 'Field operations reporting platform',
    role: 'Design leadership through feature[23]',
    tags: ['Hybrid', 'Reporting', 'KPI clarity'],
    outcome: 'Reframed reporting architecture around commercial growth and financial clarity.',
    text: 'Restructured navigation, KPI prioritization, and drill-down patterns to support better operational decisions at scale.'
  },
  {
    image: withBase('images/case-studies/home/vystar-bg-img.png'),
    imageAlt: 'Member platform sign-up experience for a regional bank',
    logo: 'Regional Bank Membership Platform',
    logoImage: '',
    logoAlt: 'Regional bank membership platform',
    role: 'Product design through feature[23]',
    tags: ['Visual', 'Member onboarding', 'Conversion'],
    outcome: 'Designed a member sign-up experience focused on clarity, confidence, and completion.',
    text: 'Used visual hierarchy and onboarding flow design to reduce friction in a high-intent account and membership enrollment experience.'
  }
];

const engagementModels = [
  {
    title: 'Fractional design leadership',
    fit: 'Best for sustained leadership',
    text: 'Embedded leadership support for product direction, organizational alignment, and critical design decisions across teams.'
  },
  {
    title: 'Advisory and consulting engagements',
    fit: 'Best for high-stakes inflection points',
    text: 'Targeted support for high-stakes decisions, product direction, and delivery friction where senior design leadership is needed quickly.'
  },
  {
    title: 'Transformation and reset work',
    fit: 'Best for change, scale, or recovery',
    text: 'Focused engagements to diagnose operational friction, realign teams, and establish stronger product and design foundations.'
  }
];

const featuredPractice = practiceStats[0];
const supportingPractice = practiceStats.slice(1);
const featuredWriting = writingRoadmapEntries[0];
const supportingWriting = writingRoadmapEntries.slice(1);
---

<Layout
  title="Dan Malarkey | Homepage v3 Exploration"
  description="Homepage v3 exploration for Dan Malarkey focused on fractional chief product design leadership, selected proof, and writing."
>
  <main class="home-v3">
    <section class="home-v3-intro">
      <header class="home-v3-header">
        <div class="home-v3-header-shell">
          <nav class="home-v3-nav" aria-label="Primary">
            <a class="home-v3-brand" href={withBase('/')} aria-label="Dan Malarkey">
              <img src={withBase('/images/brand/d-logo-halfmoon.svg')} alt="Dan Malarkey" />
            </a>
            <div class="home-v3-nav-links">
              <a href={withBase('/work')}>Work</a>
              <a href={withBase('/about')}>About</a>
              <a href={withBase('/writing')}>Writing</a>
              <a href="mailto:hello@danmalarkey.com" class="home-v3-nav-cta">Talk to me</a>
            </div>
          </nav>
        </div>
      </header>

      <section class="home-v3-hero">
        <div class="dm-grid-l dm-grid-l--grid-sys home-v3-hero-layout">
          <div class="home-v3-hero-frame gc-start-1 gc-span-26">
            <div class="home-v3-window" aria-hidden="true">
              <div class="home-v3-window-rays"></div>
              <canvas id="home-v3-stars"></canvas>
              <div class="home-v3-hero-noise"></div>
              <div class="home-v3-window-light-field"></div>
              <div class="home-v3-window-core"></div>
              <div class="home-v3-window-glow"></div>
              <div class="home-v3-window-haze"></div>
              <div class="home-v3-window-orbit"></div>
            </div>

            <div class="dm-grid-l dm-grid-l--grid-sys home-v3-hero-grid">
              <div class="home-v3-hero-copy gc-start-2 gc-span-16">
                <div class="home-v3-hero-primary">
                  <p class="home-v3-kicker">Design leadership</p>
                  <h1>For teams in motion.</h1>
                </div>
                <div class="home-v3-hero-support">
                  <p class="home-v3-lead">
                    I help executives, product leaders, and cross-functional teams bring clarity to complex product decisions, align execution, and build design capability that scales.
                  </p>
                  <div class="home-v3-actions">
                    <a class="home-v3-button home-v3-button--solid" href="mailto:hello@danmalarkey.com">Work with me</a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </section>

    {homeV3BridgeVariant === 'pillars' ? (
      <section class="home-v3-pillars" aria-label="Clarity, strategy, and systems">
        <div class="dm-grid-l dm-grid-l--grid-sys">
          <div class="home-v3-pillars-shell gc-start-2 gc-span-24">
            <div class="home-v3-pillars-surface">
              <div class="home-v3-pillars-grid" role="list">
                {bridgePillars.map((pillar) => (
                  <article class={`home-v3-pillar home-v3-pillar--${pillar.tone}`} role="listitem">
                    <p class="home-v3-pillar-index">{pillar.index}</p>
                    <div class="home-v3-pillar-main">
                      <h2 class="home-v3-pillar-title">{pillar.title}</h2>
                      <p class="home-v3-pillar-headline">{pillar.headline}</p>
                    </div>
                    <p class="home-v3-pillar-detail">{pillar.detail}</p>
                  </article>
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>
    ) : homeV3BridgeVariant === 'legacy' ? (
      <section class="home-v3-bridge" aria-label="Operating range" data-home-v3-bridge>
        <div class="dm-grid-l dm-grid-l--grid-sys">
          <div class="home-v3-bridge-shell gc-start-1 gc-span-26">
            <div class="home-v3-bridge-atmosphere" aria-hidden="true">
              <span class="home-v3-bridge-beam"></span>
              <span class="home-v3-bridge-beam-core"></span>
              <span class="home-v3-bridge-haze home-v3-bridge-haze--one"></span>
              <span class="home-v3-bridge-haze home-v3-bridge-haze--two"></span>
              <span class="home-v3-bridge-haze home-v3-bridge-haze--three"></span>
              <span class="home-v3-bridge-arc"></span>
              <span class="home-v3-bridge-node home-v3-bridge-node--one"></span>
              <span class="home-v3-bridge-node home-v3-bridge-node--two"></span>
              <span class="home-v3-bridge-node home-v3-bridge-node--three"></span>
              <span class="home-v3-bridge-node home-v3-bridge-node--four"></span>
            </div>
            <div class="home-v3-bridge-stage" data-home-v3-bridge-stage>
              <div class="home-v3-bridge-bg" data-home-v3-bridge-bg aria-hidden="true"></div>
              <div class="home-v3-bridge-words" aria-hidden="true">
                <div class="home-v3-bridge-scene home-v3-bridge-scene--strategy" data-home-v3-bridge-scene="strategy">
                  <h2 class="home-v3-bridge-word" data-home-v3-bridge-word="strategy">Strategy.</h2>
                </div>
                <div class="home-v3-bridge-scene home-v3-bridge-scene--systems" data-home-v3-bridge-scene="systems">
                  <h2 class="home-v3-bridge-word" data-home-v3-bridge-word="systems">Systems.</h2>
                </div>
                <div class="home-v3-bridge-scene home-v3-bridge-scene--clarity" data-home-v3-bridge-scene="clarity">
                  <h2 class="home-v3-bridge-word" data-home-v3-bridge-word="clarity">Clarity.</h2>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    ) : (
      <section class="home-v3-bridge-lite" aria-label="Operating range" data-home-v3-bridge-lite>
        <div class="dm-grid-l dm-grid-l--grid-sys">
          <div class="home-v3-bridge-lite-shell gc-start-1 gc-span-26">
            <div class="home-v3-bridge-lite-stage">
              <div class="home-v3-bridge-lite-backdrop" aria-hidden="true"></div>
              <div class="home-v3-bridge-lite-stars" aria-hidden="true"></div>
              <div class="home-v3-bridge-lite-card home-v3-bridge-lite-card--strategy" data-home-v3-bridge-lite-card="clarity" data-ghost="CLARITY">
                <h2 class="home-v3-bridge-lite-word">Clarity.</h2>
              </div>
              <div class="home-v3-bridge-lite-card home-v3-bridge-lite-card--systems" data-home-v3-bridge-lite-card="strategy" data-ghost="STRATEGY">
                <h2 class="home-v3-bridge-lite-word">Strategy.</h2>
              </div>
              <div class="home-v3-bridge-lite-card home-v3-bridge-lite-card--clarity" data-home-v3-bridge-lite-card="systems" data-ghost="SYSTEMS">
                <h2 class="home-v3-bridge-lite-word">Systems.</h2>
              </div>
              <div class="home-v3-bridge-lite-mobile" aria-hidden="true">
                <div class="home-v3-bridge-lite-mobile-row home-v3-bridge-lite-mobile-row--clarity" data-ghost="CLARITY">
                  <h2 class="home-v3-bridge-lite-mobile-word">Clarity.</h2>
                </div>
                <div class="home-v3-bridge-lite-mobile-row home-v3-bridge-lite-mobile-row--strategy" data-ghost="STRATEGY">
                  <h2 class="home-v3-bridge-lite-mobile-word">Strategy.</h2>
                </div>
                <div class="home-v3-bridge-lite-mobile-row home-v3-bridge-lite-mobile-row--systems" data-ghost="SYSTEMS">
                  <h2 class="home-v3-bridge-lite-mobile-word">Systems.</h2>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    )}

    <section class="home-v3-actors" data-home-v3-reveal>
      <div class="dm-grid-l dm-grid-l--grid-sys home-v3-actors-intro">
        <div class="home-v3-section-head home-v3-section-head--compact gc-start-2 gc-span-14">
          <p class="home-v3-section-label">Across the organization</p>
          <h2>Where it matters most.</h2>
          <p>I support the people setting direction, the teams building product, and the design leaders scaling capability.</p>
        </div>
      </div>

      {homeV3ActorsVariant === 'legacy' && (
      <div class="home-v3-actor-grid col-layout col-layout--3x8 dm-grid-l dm-grid-l--grid-sys" role="list">
        {leverageCards.map((item) => (
          <article class={`home-v3-actor-card home-v3-actor-card--${item.artType}`} role="listitem">
            <div class="home-v3-actor-card-media" aria-hidden="true">
              <div class={`home-v3-actor-atmosphere home-v3-actor-atmosphere--${item.artType}`}></div>
              <div class={`home-v3-actor-traces home-v3-actor-traces--${item.artType}`}>
                <span class="home-v3-trace home-v3-trace--a"></span>
                <span class="home-v3-trace home-v3-trace--b"></span>
                <span class="home-v3-trace home-v3-trace--c"></span>
                <span class="home-v3-trace-node home-v3-trace-node--a"></span>
                <span class="home-v3-trace-node home-v3-trace-node--b"></span>
                <span class="home-v3-trace-node home-v3-trace-node--c"></span>
              </div>
              {item.artType === 'product' && (
                <div class="home-v3-product-network">
                  <span class="home-v3-product-network-line home-v3-product-network-line--trace-a-top home-v3-product-network-line--neutral home-v3-product-network-line--thin"></span>
                  <span class="home-v3-product-network-line home-v3-product-network-line--trace-a-down home-v3-product-network-line--neutral home-v3-product-network-line--thin"></span>
                  <span class="home-v3-product-network-line home-v3-product-network-line--trace-a-mid home-v3-product-network-line--neutral home-v3-product-network-line--thin"></span>
                  <span class="home-v3-product-network-line home-v3-product-network-line--trace-a-down-2 home-v3-product-network-line--neutral home-v3-product-network-line--thin"></span>
                  <span class="home-v3-product-network-line home-v3-product-network-line--trace-a-bottom home-v3-product-network-line--blue home-v3-product-network-line--thick"></span>

                  <span class="home-v3-product-network-line home-v3-product-network-line--trace-b-drop home-v3-product-network-line--blue home-v3-product-network-line--thin"></span>
                  <span class="home-v3-product-network-line home-v3-product-network-line--trace-b-top home-v3-product-network-line--blue home-v3-product-network-line--thick"></span>
                  <span class="home-v3-product-network-line home-v3-product-network-line--trace-b-down home-v3-product-network-line--blue home-v3-product-network-line--thin"></span>
                  <span class="home-v3-product-network-line home-v3-product-network-line--trace-b-right home-v3-product-network-line--blue home-v3-product-network-line--thick"></span>

                  <span class="home-v3-product-network-line home-v3-product-network-line--trace-c-right home-v3-product-network-line--cyan home-v3-product-network-line--thin"></span>
                  <span class="home-v3-product-network-line home-v3-product-network-line--trace-c-left home-v3-product-network-line--cyan home-v3-product-network-line--thin"></span>
                  <span class="home-v3-product-network-line home-v3-product-network-line--trace-c-down home-v3-product-network-line--cyan home-v3-product-network-line--thin"></span>
                  <span class="home-v3-product-network-line home-v3-product-network-line--trace-c-bottom home-v3-product-network-line--cyan home-v3-product-network-line--thin"></span>
                  <span class="home-v3-product-network-line home-v3-product-network-line--trace-d-bridge home-v3-product-network-line--neutral home-v3-product-network-line--thin"></span>

                  <span class="home-v3-product-network-node home-v3-product-network-node--neutral home-v3-product-network-node--a"></span>
                  <span class="home-v3-product-network-node home-v3-product-network-node--blue home-v3-product-network-node--b"></span>
                  <span class="home-v3-product-network-node home-v3-product-network-node--blue home-v3-product-network-node--c"></span>
                  <span class="home-v3-product-network-node home-v3-product-network-node--neutral home-v3-product-network-node--d"></span>
                  <span class="home-v3-product-network-node home-v3-product-network-node--neutral home-v3-product-network-node--e"></span>
                  <span class="home-v3-product-network-node home-v3-product-network-node--cyan home-v3-product-network-node--f"></span>
                  <span class="home-v3-product-network-node home-v3-product-network-node--cyan home-v3-product-network-node--g"></span>
                  <span class="home-v3-product-network-node home-v3-product-network-node--neutral home-v3-product-network-node--h"></span>
                  <span class="home-v3-product-network-node home-v3-product-network-node--neutral home-v3-product-network-node--i"></span>
                </div>
              )}
              <div class={`home-v3-actor-art home-v3-actor-art--${item.artType}`}>
                {item.artType === 'executive' && (
                  <>
                    <div class="home-v3-executive-chart">
                      <div class="home-v3-executive-surface">
                        <div class="home-v3-executive-surface-head">
                          <div class="home-v3-executive-surface-metric">
                            <div class="home-v3-executive-surface-value-row">
                              <span class="home-v3-executive-surface-value">Higher-value decisions</span>
                              <span class="home-v3-executive-surface-delta">Clearer direction compounds business value</span>
                            </div>
                          </div>
                        </div>

                        <div class="home-v3-executive-plot-shell">
                          <div class="home-v3-executive-plot-guides" aria-hidden="true"></div>

                          <svg class="home-v3-executive-plot" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                            <defs>
                              <linearGradient id="home-v3-executive-lift-stroke" x1="0%" y1="0%" x2="100%" y2="0%">
                                <stop offset="0%" stop-color="#c7ab73" stop-opacity="0.72"></stop>
                                <stop offset="62%" stop-color="#e7c97d" stop-opacity="0.96"></stop>
                                <stop offset="100%" stop-color="#f8eed2" stop-opacity="1"></stop>
                              </linearGradient>
                              <linearGradient id="home-v3-executive-lift-fill" x1="0%" y1="0%" x2="0%" y2="100%">

const supportAreas = [
  {
    title: 'Product direction under pressure',
    text: 'Clarifying priorities, tradeoffs, and product vision when the stakes are high and ambiguity is expensive.'
  },
  {
    title: 'Design systems and delivery partnership',
    text: 'Building patterns, working norms, and design capability that help product and engineering move faster without lowering the bar.'
  },
  {
    title: 'Fractional leadership that stays close to execution',
    text: 'Supporting strategy and organizational alignment while still getting into the work when outcomes depend on it.'
  }
];

const engagementModels = [
  {
    title: 'Fractional chief product design support',
    fit: 'Best for ongoing leadership needs',
    text: 'Embedded support for direction-setting, team alignment, critical design decisions, and design capability growth.'
  },
  {
    title: 'Advisory engagements',
    fit: 'Best for high-stakes inflection points',
    text: 'Senior perspective for product ambiguity, organizational change, or design investment decisions where clarity matters quickly.'
  },
  {
    title: 'Transformation and reset work',

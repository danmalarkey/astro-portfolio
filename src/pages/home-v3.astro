      </div>

      <div class="dm-grid-l dm-grid-l--grid-sys">
        <div class="home-v3-engagement-rows gc-start-2 gc-span-22" role="list" aria-label="Ways to engage">
          {engagementModels.map((item, index) => (
            <article class="home-v3-engagement-row" role="listitem">
              <span class="home-v3-engagement-row-stars" aria-hidden="true"></span>
              <span class="home-v3-engagement-row-index">{String(index + 1).padStart(2, '0')}/</span>
              <div class="home-v3-engagement-row-copy">
                <h3 class="home-v3-card-title-text">{item.title}</h3>

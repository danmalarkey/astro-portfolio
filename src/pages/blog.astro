---
import Layout from "../layouts/Layout.astro";
import Header from "../layouts/Header.astro";
const pageTitle = "Writing | Dan Malarkey";
---
<Layout title={pageTitle}>
    <Header />
    <main>
        <section class="section">
            <div class="dm-grid-l dm-grid-l--grid-sys">
                <div class="gc-start-2 gc-span-18">
                    <h1 class="section-title text-white">Writing</h1>
                    <p>
                        Essays, notes, and field observations on design leadership, product direction, systems, and the practical use of AI in delivery.
                    </p>
                    <p class="small-text">
                        This page is being rebuilt from the Astro starter blog scaffold into the portfolio writing system.
                    </p>
                </div>
            </div>
        </section>
    </main>
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import Header from '../../layouts/Header.astro';
import ActorAudiencePage from '../../components/ActorAudiencePage.astro';
---

<Layout title="For Designers and Design Leaders | Dan Malarkey">
  <Header />
  <main>
    <ActorAudiencePage
      audienceTitle="Designers and design leaders"
      heroTitle="Support for raising design maturity, standards, and strategic influence."
      heroBody="I help design leaders raise craft maturity, establish stronger standards, and increase design influence in strategic product and organizational decisions while staying grounded in the actual work."
      heroSignals={[
        { label: 'Standards', detail: 'Set the quality bar' },
        { label: 'Coaching', detail: 'Raise team judgment' },
        { label: 'Influence', detail: 'Move design into earlier decisions' }
      ]}
      actorMailtoSubject="[Designers and design leaders] Leadership advisory"
      actorMailtoPrompt="design leadership"
      whatYouGet={[
        { title: 'Operating model support', text: 'Help clarifying how design should work with product and engineering at your stage of growth, including where design should shape direction earlier.' },
        { title: 'Standards and systems', text: 'Guidance on patterns, documentation, and quality bars that improve consistency without creating process drag or slowing delivery.' },
        { title: 'Leadership leverage with execution credibility', text: 'Support for increasing design influence in strategic decisions while maintaining credibility through strong craft, systems thinking, and practical execution depth.' }
      ]}
      idealFor={[
        'Organizations building stronger standards, coaching, and design influence',
        'Design leaders scaling teams or raising the quality bar',
        'Principal/lead designers expanding strategic scope',
        'Organizations that want design to influence decisions earlier'
      ]}
      signals={[
        'Design quality varies across teams because standards are implicit.',
        'Design is involved, but too late to shape product direction meaningfully.',
        'Leaders need a stronger way to connect design work to business outcomes.',
        'The team needs mentorship and systems thinking, not just artifact review.',
        'Design leadership needs more leverage in the room and more follow-through in the work.'
      ]}
    />
  </main>
</Layout>

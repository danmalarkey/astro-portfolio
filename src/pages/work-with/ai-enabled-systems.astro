---
import Layout from '../../layouts/Layout.astro';
import Header from '../../layouts/Header.astro';
import HomeFooter from '../../components/HomeFooter.astro';
import FocusAreaJumpCards from '../../components/FocusAreaJumpCards.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import Button from '../../components/Button.astro';

const baseUrl = Astro.url.pathname.startsWith('/astro-portfolio') ? '/astro-portfolio/' : '/';
const withBase = (path: string) => `${baseUrl}${path.startsWith('/') ? path.slice(1) : path}`;

const mailParams = new URLSearchParams();
mailParams.set('subject', '[AI-enabled product systems] Advisory inquiry');
mailParams.set('body', `Hi Dan,\n\nI'm reaching out about AI-enabled product systems and would like to talk through what we are building.\n\nContext:\n- Team/company:\n- Product or workflow:\n- Where AI is creating opportunity or friction:\n- Desired engagement shape:\n\nThanks,`);
const mailto = `mailto:hello@danmalarkey.com?${mailParams.toString()}`;

const stuckColumns = [
  {
    icon: 'radar',
    title: 'Emerging territory on the horizon',
    text: 'The team is working at the edge of an emerging capability, before user behavior and product value are fully understood.'
  },
  {
    icon: 'boundary',
    title: 'Pressure before clarity',
    text: 'Momentum to ship can outpace clarity about the right problem, workflow, and durable product behavior.'
  },
  {
    icon: 'artifacts',
    title: 'Artifacts that sharpen thinking',
    text: 'The team needs artifacts that sharpen the conversation, not polished concepts pretending certainty already exists.'
  },
  {
    icon: 'decision',
    title: 'Better questions, better bets',
    text: 'Leaders need sharper questions, stronger hypotheses, and enough structure to decide what is worth pursuing.'
  }
];

const outputs = [
  {
    title: 'Opportunity frames',
    text: 'Defined spaces where AI can create meaningful product leverage.',
    bgImage: '/images/work-ai/translation-new-1.png'
  },
  {
    title: 'Speculative prototypes',
    text: 'Probes, scenarios, or storyboards to provoke better questions.',
    bgImage: '/images/work-ai/translation-new-2.png'
  },
  {
    title: 'AI behavior models',
    text: 'Models for confidence, agency, control, review, failure, and escalation.',
    bgImage: '/images/work-ai/translation-new-3.png'
  },
  {
    title: 'System maps',
    text: 'Maps that expose operational, ethical, product, and implementation dependencies.',
    bgImage: '/images/work-ai/translation-new-4.png'
  },
  {
    title: 'Product direction',
    text: 'Principles and product direction that translate exploration into the next phase of work.',
    bgImage: '/images/work-ai/translation-new-5.png'
  },
  {
    title: 'Decision principles',
    text: 'Clear criteria to align stakeholders and make high-integrity decisions.',
    bgImage: '/images/work-ai/translation-new-6.png'
  }
];

const explorationPrinciples = [
  {
    title: 'Make to discover',
    text: 'Make the work visible enough for the team to notice what discussion alone would miss.',
    badge: 'Surface what discussion misses'
  },
  {
    title: 'Hold uncertainty',
    text: 'Stay with ambiguity long enough to compare multiple futures instead of forcing the first plausible answer into a product plan.',
    badge: 'Before the plan hardens'
  },
  {
    title: 'Use assumptions deliberately',
    text: 'Model imagined users, workflows, decisions, and system responses as temporary scaffolding, then pressure-test what those assumptions reveal.',
    badge: 'Test what would need to be true'
  },
  {
    title: 'Frame consequences early',
    text: 'Explore trust, ethics, operational risk, unintended behavior, and organizational impact before implementation makes those choices expensive.',
    badge: 'Before the cost of change rises'
  }
];

const activityCards = [
  {
    title: 'Exploration workshops',
    text: 'Open-ended sessions that help teams think beyond feature lists and identify the sharper product questions hiding inside the AI opportunity.'
  },
  {
    title: 'Design probes',
    text: 'Small artifacts, sketches, prompts, workflows, or provocations built to generate reaction and reveal what the team does not yet understand.'
  },
  {
    title: 'Scenario and systems modeling',
    text: 'Future-oriented journeys, actor maps, behavior models, and dependency diagrams that show how an AI-enabled system might work or fail.'
  },
  {
    title: 'AI behavior simulation',
    text: 'Conceptual modeling for non-human system behavior: what it suggests, refuses, explains, escalates, remembers, or hands back to people.'
  }
];
---

<Layout
  title="Explore the Unknown | AI-enabled Product Systems | Dan Malarkey"
  description="Design leadership for AI-enabled product systems, prompt workflows, UX behavior, and implementation-ready product direction."
>
  <Header />
  <main class="ai-systems-page">
    <section
      class="ai-systems-hero"
      style={`--ai-systems-hero-bg: url('${withBase('/images/work-ai/hero-img.png')}')`}
      aria-labelledby="ai-systems-title"
    >
      <div class="ai-systems-hero-rays" aria-hidden="true"></div>
      <div class="ai-systems-hero-light" aria-hidden="true"></div>
      <div class="ai-systems-hero-grid dm-grid-l dm-grid-l--grid-sys">
        <div class="ai-systems-hero-copy gc-start-2 gc-span-13">
          <p class="ai-systems-kicker">AI-enabled product systems</p>
          <h1 id="ai-systems-title">Explore the unknown.</h1>
          <p>
            I help teams use design to explore what AI could make possible before the product path is obvious: new workflows, unfamiliar behaviors, system boundaries, and the decision frames needed to move from possibility into direction.
          </p>
        </div>
      </div>
    </section>

    <section class="ai-systems-section ai-systems-section--signals" aria-labelledby="ai-systems-breaks">
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <SectionHeader
          eyebrow="Where teams get stuck"
          title="The work starts where certainty runs out."
          body="AI product work often begins before there is clean data, a stable user behavior, or a known market pattern. Design creates value here by making the unknown discussable, testable, and directional."
          headingId="ai-systems-breaks"
          accent
          reveal
          revealType="late"
        />

        <div class="stuck-grid gc-start-2 gc-span-24" role="list" aria-label="Where AI-enabled product teams get stuck" data-motion-reveal-late>
          {stuckColumns.map((item) => (
            <article class="stuck-item" role="listitem" data-motion-item>
              <div class="stuck-item-icon" aria-hidden="true">
                {item.icon === 'radar' && (
                  <svg viewBox="0 0 64 64" focusable="false">
                    <path d="M19 35a13 13 0 0 1 18.8-11.6" />
                    <path d="M13 35a19 19 0 0 1 29.2-16" />
                    <path d="M8 35a24 24 0 0 1 38.8-19" />
                    <path class="stuck-item-icon-mark--accent" d="M31 35l15-16" />
                    <circle class="stuck-item-icon-mark--accent" cx="31" cy="35" r="3" />
                    <circle cx="47" cy="18" r="2.5" />
                  </svg>
                )}
                {item.icon === 'boundary' && (
                  <svg viewBox="0 0 64 64" focusable="false">
                    <path d="M36 16h14v11" stroke-dasharray="4 5" />
                    <path d="M50 37v11H36" stroke-dasharray="4 5" />
                    <path d="M27 48H14V37" stroke-dasharray="4 5" />
                    <path d="M14 27V16h13" stroke-dasharray="4 5" />
                    <path d="M9 32h31" />
                    <path d="M30 23l10 9-10 9" />
                    <path class="stuck-item-icon-mark--accent" d="M15 24h13" />
                    <path class="stuck-item-icon-mark--accent" d="M15 40h13" />
                  </svg>
                )}
                {item.icon === 'artifacts' && (
                  <svg viewBox="0 0 64 64" focusable="false">
                    <path d="M22 13h27v19H22z" />
                    <path d="M16 21h27v19H16z" />
                    <path class="stuck-item-icon-mark--accent" d="M11 30h27v21H11z" />
                    <path d="M17 37h12" />
                    <path d="M17 44h8" />
                    <path d="M33 37h11" />
                  </svg>
                )}
                {item.icon === 'decision' && (
                  <svg viewBox="0 0 64 64" focusable="false">
                    <path d="M9 17c10 0 15 5 22 15" />
                    <path d="M9 47c10 0 15-5 22-15" />
                    <path d="M10 32h21" />
                    <circle class="stuck-item-icon-mark--accent" cx="35" cy="32" r="3.2" />
                    <path class="stuck-item-icon-mark--accent" d="M39 32h16" />
                    <path class="stuck-item-icon-mark--accent" d="M49 25l7 7-7 7" />
                  </svg>
                )}
              </div>
              <div class="stuck-item-copy">
                <h3 class="stuck-item-title">{item.title}</h3>
                <p class="stuck-item-body">{item.text}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <figure class="ai-systems-certainty-visual ai-systems-certainty-visual--full-bleed" data-motion-reveal aria-hidden="true">
      <img
        src={withBase('/images/work-ai/certainty-run-out.png')}
        alt=""
        loading="lazy"
        decoding="async"
      />
    </figure>

    <section class="ai-systems-section ai-systems-principles" aria-labelledby="ai-systems-principles" data-motion-reveal>
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <SectionHeader
          eyebrow="How exploration works"
          title="The first signal is not the horizon."
          body="In ambiguous AI contexts, exploration helps teams look past the first promising demo or early signal. The work is to compare possible futures, examine what would need to be true, and find the questions that deserve product investment."
          headingId="ai-systems-principles"
          accent
          reveal
        />

        <div class="signal-row-list gc-start-2 gc-span-24" role="list" data-motion-item>
          {explorationPrinciples.map((principle, index) => (
            <article class="signal-row" role="listitem">
              <span class="signal-row-stars" aria-hidden="true"></span>
              <span class="signal-row-index">{String(index + 1).padStart(2, '0')}</span>
              <div class="signal-row-copy">
                <h3 class="signal-row-title">{principle.title}</h3>
                <p class="signal-row-text">{principle.text}</p>
              </div>
              <span class="signal-row-badge">{principle.badge}</span>
            </article>
          ))}
        </div>
      </div>
    </section>
    <section class="ai-systems-section ai-systems-activities" aria-labelledby="ai-systems-activities" data-motion-reveal>
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <SectionHeader
          eyebrow="Activities"
          title="Artifacts for thinking, not theater."
          body="These activities help teams make uncertainty visible, test possible futures, and create enough structure to decide what deserves product investment."
          headingId="ai-systems-activities"
          accent
          reveal
        />

        <div class="ai-systems-activity-grid gc-start-2 gc-span-24" role="list" aria-label="AI-enabled product systems activities" data-motion-item>
          {activityCards.map((activity, index) => (
            <article class="ai-systems-activity-card" role="listitem">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{activity.title}</h3>
              <p>{activity.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="ai-systems-section ai-systems-section--mid-cta" aria-labelledby="ai-systems-mid-cta" data-motion-reveal>
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <div class="ai-systems-cta-inner ai-systems-cta-inner--accent gc-start-2 gc-span-24" data-motion-item>
          <p class="ai-systems-kicker">Before the AI work hardens</p>
          <h2 id="ai-systems-mid-cta">Turn exploration into product direction.</h2>
          <p>
            When AI possibilities are moving faster than shared understanding, teams need structured exploration before pilots, workflows, and standards start pulling apart.
          </p>
          <div class="ai-systems-actions" aria-label="AI-enabled product systems CTA actions">
            <Button href={mailto}>Start a conversation</Button>
            <Button href={withBase('/work-with/operating-model')} variant="ghost">Explore Operating Model</Button>
          </div>
        </div>
      </div>
    </section>

    <section class="ai-systems-band" aria-labelledby="ai-systems-output" data-motion-reveal>
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <SectionHeader
          eyebrow="Translation"
          title="Exploration has to become usable direction."
          body="Turning ambiguity into clarity through structured outputs that connect insight to action and reduce risk."
          headingId="ai-systems-output"
          accent
          reveal
        />
        <div class="ai-systems-output-list gc-start-2 gc-span-24" role="list" data-motion-item>
          {outputs.map((output, index) => (
            <article
              class="ai-systems-output-card"
              role="listitem"
              style={`--ai-systems-output-bg-image: url('${withBase(output.bgImage)}')`}
            >
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{output.title}</h3>
              <p>{output.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <FocusAreaJumpCards current="ai" />

    <HomeFooter
      eyebrow="AI-enabled product systems"
      title="If AI work needs to hold together as product strategy, system behavior, and delivery, let’s talk."
      body="I'm available for select advisory, consulting, and fractional leadership engagements where AI-enabled systems need to connect product direction, standards, and implementation."
    />
  </main>
</Layout>

<style lang="scss">
  .ai-systems-page {
    --ai-page-bg: var(--ds-background);
    --ai-page-surface: var(--ds-surface);
    --ai-page-surface-strong: var(--ds-surface-strong);
    --ai-page-border: var(--ds-border);
    --ai-page-border-soft: var(--ds-border-soft);
    --ai-page-text: var(--ds-text);
    --ai-page-text-muted: var(--ds-text-muted);
    --ai-page-text-soft: var(--ds-text-soft);
    --ai-page-accent: rgba(176, 204, 255, 0.88);
    --ai-page-warm: rgba(255, 244, 170, 0.9);
    --ai-hero-glow: 111, 162, 232;
    --ai-output-card-bg: rgba(var(--ds-surface-panel-rgb), 0.96);
    --section-header-accent-color: var(--ai-page-accent);
    --section-header-title-color: rgba(245, 248, 255, 0.96);
    --section-header-body-color: var(--ai-page-text-muted);

    min-height: 100vh;
    padding-inline: 0;
    overflow: hidden;
    background:
      radial-gradient(ellipse at 82% 4%, rgba(94, 122, 188, 0.2), rgba(94, 122, 188, 0) 34rem),
      radial-gradient(ellipse at 14% 8%, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0) 24rem),
      var(--ai-page-bg);
    color: var(--ai-page-text);
  }

  .ai-systems-hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: center;
    min-height: calc(100vh - 5rem);
    min-height: calc(100dvh - 5rem);
    padding: clamp(6rem, 10vw, 8.5rem) 0 clamp(5rem, 9vw, 8rem);
    overflow: hidden;
    background:
      linear-gradient(90deg, rgba(3, 8, 20, 0.96) 0%, rgba(3, 8, 20, 0.82) 34%, rgba(7, 16, 27, 0.18) 72%, rgba(7, 16, 27, 0.04) 100%),
      var(--ai-systems-hero-bg);
    background-position: center, center right;
    background-repeat: no-repeat;
    background-size: auto, cover;
  }

  .ai-systems-hero-light {
    position: absolute;
    top: 8%;
    right: -40%;
    z-index: 0;
    width: min(118vw, 84rem);
    height: min(84vh, 48rem);
    border-radius: var(--radius-pill);
    pointer-events: none;
    background:
      radial-gradient(
        ellipse at 62% 42%,
        rgba(191, 215, 255, 0.34) 0%,
        rgba(var(--ai-hero-glow), 0.18) 28%,
        rgba(var(--ai-hero-glow), 0.07) 52%,
        transparent 76%
    );
    filter: blur(34px);
    opacity: 0.86;
    transform: rotate(-35deg);
  }

  .ai-systems-hero-rays {
    --ai-rays-opacity: 0.5;

    position: absolute;
    top: -8rem;
    left: -10rem;
    z-index: 0;
    width: min(100rem, 118vw);
    height: 78rem;
    transform: rotate(-22deg);
    transform-origin: top left;
    pointer-events: none;
    background:
      linear-gradient(90deg, transparent 10%, rgba(255, 255, 255, 0.22) 13%, rgba(255, 255, 255, 0.055) 15.5%, transparent 19%),
      linear-gradient(90deg, transparent 18%, rgba(176, 204, 255, 0.18) 21%, rgba(176, 204, 255, 0.045) 23.5%, transparent 28%),
      linear-gradient(90deg, transparent 29%, rgba(255, 255, 255, 0.13) 32%, rgba(255, 255, 255, 0.032) 34.5%, transparent 39%),
      linear-gradient(90deg, transparent 42%, rgba(121, 154, 255, 0.11) 45%, rgba(121, 154, 255, 0.028) 48%, transparent 55%);
    filter: blur(8px);
    opacity: var(--ai-rays-opacity);
    mix-blend-mode: screen;
    -webkit-mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.94), rgba(0, 0, 0, 0.44) 32%, rgba(0, 0, 0, 0.14) 60%, rgba(0, 0, 0, 0.04) 78%, transparent 100%);
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.94), rgba(0, 0, 0, 0.44) 32%, rgba(0, 0, 0, 0.14) 60%, rgba(0, 0, 0, 0.04) 78%, transparent 100%);
    animation: ai-systems-rays-enter 1400ms ease 280ms both;
  }

  .ai-systems-hero-grid,
  .ai-systems-section > .dm-grid-l,
  .ai-systems-band > .dm-grid-l {
    position: relative;
    z-index: 2;
  }

  .ai-systems-hero-grid {
    min-height: inherit;
    align-items: center;
  }

  .ai-systems-hero-copy {
    display: grid;
    gap: var(--ds-panel-gap);
    align-content: start;
  }

  .ai-systems-cta-inner {
    display: grid;
    align-content: start;
    gap: var(--spacing-md);
  }

  .ai-systems-hero-copy {
    position: relative;
    z-index: 4;
    animation: ai-systems-hero-copy-enter 820ms ease 420ms both;
  }

  .ai-systems-kicker {
    margin: 0;
    color: var(--ai-page-accent);
    font-size: var(--ds-type-label);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--ds-tracking-label);
    line-height: var(--ds-line-label);
    text-transform: uppercase;
  }

  .ai-systems-hero h1,
  .ai-systems-section h2,
  .ai-systems-band h2 {
    margin: 0;
    font-family: var(--font-family-display);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--ds-tracking-title);
    text-wrap: balance;
  }

  .ai-systems-hero h1 {
    max-width: 10ch;
    font-size: var(--ds-type-title-xl);
    line-height: var(--ds-line-card-title);
  }

  .ai-systems-section h2,
  .ai-systems-band h2 {
    color: rgba(245, 248, 255, 0.96);
    font-size: var(--ds-type-title-lg);
    line-height: var(--ds-line-card-title);
  }

  .ai-systems-hero-copy > p:not(.ai-systems-kicker) {
    max-width: 43rem;
    margin: 0;
    color: var(--ai-page-text-muted);
    font-size: var(--ds-type-lead);
    line-height: var(--ds-line-lead);
  }

  .ai-systems-actions {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--spacing-xs) * 1.5);
    margin-top: calc(var(--spacing-xs) * 0.25);
  }

  .ai-systems-section {
    position: relative;
    padding: clamp(4.5rem, 8vw, 7rem) 0;
  }

  .ai-systems-section--signals {
    padding-top: clamp(4.5rem, 8vw, 7rem);
  }

  .ai-systems-section--signals > .dm-grid-l {
    row-gap: clamp(1.65rem, 3.2vw, 3rem);
  }

  .ai-systems-band > .dm-grid-l {
    row-gap: var(--ds-section-content-gap);
  }

  .ai-systems-cta-inner {
    position: relative;
    overflow: hidden;
    padding: clamp(var(--spacing-lg), 5vw, calc(var(--spacing-4xl) + var(--spacing-xs)));
    border: var(--size-border-thin) solid color-mix(in srgb, var(--ai-page-accent) 26%, transparent);
    border-radius: var(--radius-panel);
    background:
      radial-gradient(ellipse at 84% 48%, rgba(var(--ai-hero-glow), 0.28), rgba(var(--ai-hero-glow), 0.1) 34%, transparent 66%),
      radial-gradient(ellipse at 104% 22%, color-mix(in srgb, var(--ai-page-accent) 16%, transparent), transparent 22rem),
      linear-gradient(135deg, color-mix(in srgb, var(--ai-page-bg) 78%, var(--ai-page-accent)), color-mix(in srgb, var(--ai-page-bg) 72%, rgb(var(--ai-hero-glow))) 54%, var(--ai-page-bg));
    color: var(--ai-page-text);
  }

  .ai-systems-cta-inner::after {
    content: "";
    position: absolute;
    top: 80%;
    right: min(-24rem, -12vw);
    width: min(64rem, 52vw);
    aspect-ratio: 1;
    border-radius: var(--radius-pill);
    pointer-events: none;
    opacity: 0.22;
    background:
      radial-gradient(circle, transparent 0 26%, color-mix(in srgb, var(--ai-page-accent) 28%, transparent) 26.2% 26.45%, transparent 26.7%),
      radial-gradient(circle, transparent 0 44%, color-mix(in srgb, var(--ai-page-accent) 20%, transparent) 44.2% 44.42%, transparent 44.7%),
      radial-gradient(circle, transparent 0 62%, color-mix(in srgb, var(--ai-page-accent) 16%, transparent) 62.2% 62.38%, transparent 62.7%);
    transform: translateY(-50%);
    mask-image: linear-gradient(90deg, transparent 0%, black 22%, black 82%, transparent 100%);
  }

  .ai-systems-cta-inner > * {
    position: relative;
    z-index: 1;
  }

  .ai-systems-cta-inner h2 {
    color: var(--ai-page-text);
  }

  .ai-systems-cta-inner > p:not(.ai-systems-kicker) {
    max-width: 58ch;
    margin: 0;
    color: var(--ai-page-text-muted);
    font-size: var(--ds-type-lead);
    line-height: var(--ds-line-lead);
    text-wrap: pretty;
  }

  .ai-systems-cta-inner .ai-systems-kicker {
    opacity: 0.76;
  }

  .ai-systems-cta-inner .ai-systems-actions {
    margin-top: var(--spacing-sm);
  }

  .ai-systems-cta-inner :global(.ds-button--ghost) {
    border-color: color-mix(in srgb, var(--ai-page-text) 18%, transparent);
    background: color-mix(in srgb, var(--ai-page-text) 3.5%, transparent);
    color: color-mix(in srgb, var(--ai-page-text) 92%, transparent);
  }

  .ai-systems-cta-inner :global(.ds-button--ghost:hover),
  .ai-systems-cta-inner :global(.ds-button--ghost:focus-visible) {
    background: color-mix(in srgb, var(--ai-page-text) 6%, transparent);
  }

  .ai-systems-output-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--spacing-sm);
  }

  .ai-systems-output-card {
    position: relative;
    display: grid;
    align-content: end;
    min-height: 19rem;
    padding: var(--spacing-md);
    overflow: hidden;
    border: var(--size-border-thin) solid var(--ai-page-border-soft);
    border-radius: var(--radius-card);
    background: var(--ai-output-card-bg);
  }

  .ai-systems-output-card::before,
  .ai-systems-output-card::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .ai-systems-output-card::before {
    z-index: 0;
    background-image: var(--ai-systems-output-bg-image);
    background-position: center;
    background-size: cover;
  }

  .ai-systems-output-card::after {
    z-index: 0;
    background:

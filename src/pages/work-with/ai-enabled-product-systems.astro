---
import Layout from '../../layouts/Layout.astro';
import Header from '../../layouts/Header.astro';
import HomeFooter from '../../components/HomeFooter.astro';
import Button from '../../components/Button.astro';

const baseUrl = Astro.url.pathname.startsWith('/astro-portfolio') ? '/astro-portfolio/' : '/';
const withBase = (path: string) => `${baseUrl}${path.startsWith('/') ? path.slice(1) : path}`;

const mailParams = new URLSearchParams();
mailParams.set('subject', '[AI-enabled product systems] Advisory inquiry');
mailParams.set('body', `Hi Dan,\n\nI'm reaching out about AI-enabled product systems and would like to talk through what we are building.\n\nContext:\n- Team/company:\n- Product or workflow:\n- Where AI is creating opportunity or friction:\n- Desired engagement shape:\n\nThanks,`);
const mailto = `mailto:hello@danmalarkey.com?${mailParams.toString()}`;

const problemSignals = [
  'The team is working at the edge of an emerging capability, before user behavior and product value are fully understood.',
  'There is pressure to ship AI, but the right problem, workflow, and product boundary are still forming.',
  'Promising demos are creating excitement without enough clarity about what should become durable product behavior.',
  'The team needs artifacts that provoke better thinking, not another polished concept pretending certainty exists.',
  'Leaders need sharper questions, stronger hypotheses, and enough structure to decide what is worth pursuing.'
];

const systemLayers = [
  {
    label: 'Possibility framing',
    title: 'Find the territory before locking the roadmap.',
    text: 'Use design to model what could become valuable when the market, user behavior, and product constraints are still unclear.'
  },
  {
    label: 'Behavior modeling',
    title: 'Explore what the intelligence should and should not do.',
    text: 'Shape scenarios, system behavior, confidence boundaries, human control, failure modes, and escalation before the interface hardens.'
  },
  {
    label: 'Speculative artifacts',
    title: 'Make ideas tangible enough to challenge.',
    text: 'Create probes, prototypes, storyboards, future-state journeys, mock workflows, and product concepts that reveal what the team does not yet know.'
  },
  {
    label: 'Systems thinking',
    title: 'Map how the product could change the work around it.',
    text: 'Look across roles, incentives, data, operations, trust, risk, and downstream consequences so the AI concept is not treated as an isolated feature.'
  },
  {
    label: 'Translation',
    title: 'Turn exploration into product direction.',
    text: 'Synthesize the strongest signals into principles, decision frames, behavior standards, and next-step product bets that execution teams can use.'
  }
];

const outputs = [
  'Opportunity frames for where AI could create meaningful product leverage',
  'Speculative prototypes, probes, scenarios, or storyboards to provoke better questions',
  'AI behavior models for confidence, agency, control, review, failure, and escalation',
  'Systems maps that expose operational, ethical, product, and implementation dependencies',
  'Principles and product direction that translate exploration into the next phase of work'
];

const explorationPrinciples = [
  {
    title: 'Make to discover',
    text: 'Use concepts, diagrams, prototype fragments, and story-based artifacts to surface insight before the team knows what the final solution should be.'
  },
  {
    title: 'Hold uncertainty',
    text: 'Stay with ambiguity long enough to compare multiple futures instead of forcing the first plausible answer into a product plan.'
  },
  {
    title: 'Use assumptions deliberately',
    text: 'Model imagined users, workflows, decisions, and system responses as temporary scaffolding, then pressure-test what those assumptions reveal.'
  },
  {
    title: 'Frame consequences early',
    text: 'Explore trust, ethics, operational risk, unintended behavior, and organizational impact before implementation makes those choices expensive.'
  }
];

const activityCards = [
  {
    title: 'Exploration workshops',
    text: 'Open-ended sessions that help teams think beyond feature lists and identify the sharper product questions hiding inside the AI opportunity.'
  },
  {
    title: 'Design probes',
    text: 'Small artifacts, interface sketches, prompts, workflows, or provocations built to generate reaction and reveal what the team does not yet understand.'
  },
  {
    title: 'Scenario and systems modeling',
    text: 'Future-oriented journeys, actor maps, behavior models, and dependency diagrams that show how an AI-enabled system might work or fail.'
  },
  {
    title: 'AI behavior simulation',
    text: 'Conceptual modeling for non-human system behavior: what it suggests, refuses, explains, escalates, remembers, or hands back to people.'
  }
];
---

<Layout
  title="Explore the Unknown | AI-enabled Product Systems | Dan Malarkey"
  description="Design leadership for AI-enabled product systems, prompt workflows, UX behavior, and implementation-ready product direction."
>
  <Header />
  <main class="ai-systems-page">
    <section class="ai-systems-hero" aria-labelledby="ai-systems-title">
      <div class="ai-systems-hero-rays" aria-hidden="true"></div>
      <div class="ai-systems-hero-grid dm-grid-l dm-grid-l--grid-sys">
        <div class="ai-systems-hero-copy gc-start-2 gc-span-13">
          <p class="ai-systems-kicker">AI-enabled product systems</p>
          <h1 id="ai-systems-title">Explore the unknown.</h1>
          <p>
            I help teams use design to explore what AI could make possible before the product path is obvious: new workflows, unfamiliar behaviors, speculative systems, and the decision frames needed to move from possibility into direction.
          </p>
          <div class="ai-systems-actions" aria-label="AI-enabled product systems actions">
            <Button href={mailto}>Start a conversation</Button>
            <Button href="#ai-systems-output" variant="ghost">See outputs</Button>
          </div>
        </div>

        <div class="ai-systems-blueprint gc-start-13 gc-span-14" aria-hidden="true">
          <img
            src={withBase('/images/home-v3/blueprint/operating-model-blueprint-transparent.png')}
            alt=""
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
    </section>

    <section class="ai-systems-section ai-systems-section--signals" aria-labelledby="ai-systems-breaks" data-motion-reveal>
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <div class="ai-systems-section-head gc-start-2 gc-span-10" data-motion-item>
          <p class="ai-systems-kicker">Where teams get stuck</p>
          <h2 id="ai-systems-breaks">The work starts where certainty runs out.</h2>
          <p>
            AI product work often begins before there is clean data, a stable user behavior, or a known market pattern. Design creates value here by making the unknown discussable, testable, and directional.
          </p>
        </div>

        <div class="ai-systems-signal-list gc-start-14 gc-span-10" role="list" data-motion-item>
          {problemSignals.map((signal) => (
            <p role="listitem">{signal}</p>
          ))}
        </div>
      </div>
    </section>

    <section class="ai-systems-section ai-systems-system" aria-labelledby="ai-systems-system" data-motion-reveal>
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <div class="ai-systems-mosaic gc-start-2 gc-span-24" aria-labelledby="ai-systems-system">
          <div class="ai-systems-mosaic-column ai-systems-mosaic-column--left">
            {systemLayers.slice(0, 2).map((layer, index) => (
              <article class="ai-systems-mosaic-card" data-motion-reveal-late>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <p>{layer.label}</p>
                <h3>{layer.title}</h3>
                <p>{layer.text}</p>
              </article>
            ))}
          </div>

          <div class="ai-systems-mosaic-column ai-systems-mosaic-column--center">
            <article class="ai-systems-mosaic-card ai-systems-mosaic-card--primary" data-motion-reveal-late>
              <p class="ai-systems-kicker">Contribution model</p>
              <h2 id="ai-systems-system">Design as a way to discover what is worth imagining.</h2>
            </article>

            <article class="ai-systems-mosaic-card ai-systems-mosaic-card--support" data-motion-reveal-late>
              <span>03</span>
              <p>{systemLayers[2].label}</p>
              <h3>{systemLayers[2].title}</h3>
              <p>{systemLayers[2].text}</p>
            </article>
          </div>

          <div class="ai-systems-mosaic-column ai-systems-mosaic-column--right">
            {systemLayers.slice(3).map((layer, index) => (
              <article class="ai-systems-mosaic-card" data-motion-reveal-late>
                <span>{String(index + 4).padStart(2, '0')}</span>
                <p>{layer.label}</p>
                <h3>{layer.title}</h3>
                <p>{layer.text}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="ai-systems-section ai-systems-principles" aria-labelledby="ai-systems-principles" data-motion-reveal>
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <div class="ai-systems-section-head gc-start-2 gc-span-9" data-motion-item>
          <p class="ai-systems-kicker">How exploration works</p>
          <h2 id="ai-systems-principles">The point is not to validate a solution too early.</h2>
          <p>
            In ambiguous AI contexts, the work is to provoke better judgment: make possibilities visible, examine assumptions, and find the questions that deserve product investment.
          </p>
        </div>

        <div class="ai-systems-principle-grid gc-start-12 gc-span-13" role="list" data-motion-item>
          {explorationPrinciples.map((principle) => (
            <article class="ai-systems-principle-card" role="listitem">
              <h3>{principle.title}</h3>
              <p>{principle.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="ai-systems-section ai-systems-activities" aria-labelledby="ai-systems-activities" data-motion-reveal>
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <div class="ai-systems-section-head ai-systems-section-head--wide gc-start-2 gc-span-14" data-motion-item>
          <p class="ai-systems-kicker">Activities</p>
          <h2 id="ai-systems-activities">Artifacts for thinking, not theater.</h2>
        </div>

        <div class="ai-systems-activity-grid gc-start-2 gc-span-24" role="list" data-motion-item>
          {activityCards.map((activity) => (
            <article class="ai-systems-activity-card" role="listitem">
              <h3>{activity.title}</h3>
              <p>{activity.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="ai-systems-band" aria-labelledby="ai-systems-output" data-motion-reveal>
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <div class="ai-systems-band-copy gc-start-2 gc-span-9" data-motion-item>
          <p class="ai-systems-kicker">Translation</p>
          <h2 id="ai-systems-output">Exploration has to become usable direction.</h2>
        </div>
        <div class="ai-systems-output-list gc-start-13 gc-span-11" role="list" data-motion-item>
          {outputs.map((output) => (
            <p role="listitem">{output}</p>
          ))}
        </div>
      </div>
    </section>

    <HomeFooter
      eyebrow="AI-enabled product systems"
      title="If the AI work needs to hold together as a product system, let's talk."
      body="I'm available for select advisory, consulting, and fractional leadership engagements where AI, product direction, UX systems, and implementation need to move together."
    />
  </main>
</Layout>

<style lang="scss">
  .ai-systems-page {
    --ai-page-bg: var(--ds-background);
    --ai-page-surface: var(--ds-surface);
    --ai-page-surface-strong: var(--ds-surface-strong);
    --ai-page-border: var(--ds-border);
    --ai-page-border-soft: var(--ds-border-soft);
    --ai-page-text: var(--ds-text);
    --ai-page-text-muted: var(--ds-text-muted);
    --ai-page-text-soft: var(--ds-text-soft);
    --ai-page-accent: rgba(176, 204, 255, 0.88);
    --ai-page-warm: rgba(255, 244, 170, 0.9);

    min-height: 100vh;
    padding-inline: 0;
    overflow: hidden;
    background:
      radial-gradient(ellipse at 82% 4%, rgba(94, 122, 188, 0.2), rgba(94, 122, 188, 0) 34rem),
      radial-gradient(ellipse at 14% 8%, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0) 24rem),
      var(--ai-page-bg);
    color: var(--ai-page-text);
  }

  .ai-systems-hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: calc(100vh - 5rem);
    min-height: calc(100dvh - 5rem);
    padding: clamp(6rem, 10vw, 8.5rem) 0 clamp(5rem, 9vw, 8rem);
    overflow: hidden;
  }

  .ai-systems-hero::before,
  .ai-systems-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .ai-systems-hero::before {
    z-index: 0;
    background-image:
      linear-gradient(rgba(231, 235, 242, 0.035) 0.0625rem, transparent 0.0625rem),
      linear-gradient(90deg, rgba(231, 235, 242, 0.03) 0.0625rem, transparent 0.0625rem);
    background-size: 5rem 5rem;
    mask-image: radial-gradient(ellipse at 68% 44%, #000, transparent 68%);
    opacity: 0.72;
  }

  .ai-systems-hero::after {
    z-index: 1;
    background:
      linear-gradient(90deg, var(--ai-page-bg) 0%, rgba(5, 6, 8, 0.96) 32%, rgba(5, 6, 8, 0.62) 50%, rgba(5, 6, 8, 0.08) 74%, rgba(5, 6, 8, 0) 100%),
      linear-gradient(180deg, rgba(5, 6, 8, 0) 70%, var(--ai-page-bg) 100%),
      radial-gradient(ellipse at 24% 54%, rgba(255, 255, 255, 0.035), rgba(255, 255, 255, 0) 28rem);
  }

  .ai-systems-hero-rays {
    --ai-rays-opacity: 0.5;

    position: absolute;
    top: -8rem;
    left: -10rem;
    z-index: 2;
    width: min(100rem, 118vw);
    height: 78rem;
    transform: rotate(-22deg);
    transform-origin: top left;
    pointer-events: none;
    background:
      linear-gradient(90deg, transparent 10%, rgba(255, 255, 255, 0.22) 13%, rgba(255, 255, 255, 0.055) 15.5%, transparent 19%),
      linear-gradient(90deg, transparent 18%, rgba(176, 204, 255, 0.18) 21%, rgba(176, 204, 255, 0.045) 23.5%, transparent 28%),
      linear-gradient(90deg, transparent 29%, rgba(255, 255, 255, 0.13) 32%, rgba(255, 255, 255, 0.032) 34.5%, transparent 39%),
      linear-gradient(90deg, transparent 42%, rgba(121, 154, 255, 0.11) 45%, rgba(121, 154, 255, 0.028) 48%, transparent 55%);
    filter: blur(8px);
    opacity: var(--ai-rays-opacity);
    mix-blend-mode: screen;
    -webkit-mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.94), rgba(0, 0, 0, 0.44) 32%, rgba(0, 0, 0, 0.14) 60%, rgba(0, 0, 0, 0.04) 78%, transparent 100%);
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.94), rgba(0, 0, 0, 0.44) 32%, rgba(0, 0, 0, 0.14) 60%, rgba(0, 0, 0, 0.04) 78%, transparent 100%);
    animation: ai-systems-rays-enter 1400ms ease 280ms both;
  }

  .ai-systems-hero-grid,
  .ai-systems-section > .dm-grid-l,
  .ai-systems-band > .dm-grid-l {
    position: relative;
    z-index: 2;
  }

  .ai-systems-hero-grid {
    min-height: inherit;
    align-items: center;
  }

  .ai-systems-hero-copy,
  .ai-systems-section-head,
  .ai-systems-band-copy {
    display: grid;
    gap: var(--ds-panel-gap);
    align-content: start;
  }

  .ai-systems-hero-copy {
    position: relative;
    z-index: 4;
    animation: ai-systems-hero-copy-enter 820ms ease 420ms both;
  }

  .ai-systems-kicker {
    margin: 0;
    color: var(--ai-page-accent);
    font-size: var(--ds-type-label);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--ds-tracking-label);
    line-height: 1;
    text-transform: uppercase;
  }

  .ai-systems-hero h1,
  .ai-systems-section h2,
  .ai-systems-band h2 {
    margin: 0;
    font-family: var(--font-family-display);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--ds-tracking-title);
    text-wrap: balance;
  }

  .ai-systems-hero h1 {
    max-width: 10ch;
    font-size: clamp(4.15rem, 9.2vw, 8.4rem);
    line-height: 0.88;
  }

  .ai-systems-section h2,
  .ai-systems-band h2 {
    color: rgba(245, 248, 255, 0.96);
    font-size: var(--ds-type-title-lg);
    line-height: 0.96;
  }

  .ai-systems-hero-copy > p:not(.ai-systems-kicker),
  .ai-systems-section-head > p:not(.ai-systems-kicker) {
    max-width: 43rem;
    margin: 0;
    color: var(--ai-page-text-muted);
    font-size: var(--ds-type-lead);
    line-height: 1.58;
  }

  .ai-systems-actions {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--spacing-xs) * 1.5);
    margin-top: calc(var(--spacing-xs) * 0.25);
  }

  .ai-systems-blueprint {
    position: absolute;
    top: 58%;
    right: clamp(-18rem, -12vw, -8rem);
    z-index: 1;
    width: min(56vw, 62rem);
    aspect-ratio: 2 / 2.25;
    transform: translateY(-50%);
    pointer-events: none;
  }

  .ai-systems-blueprint::before {
    content: '';
    position: absolute;
    inset: 10% 2% 8%;
    border-radius: 50%;
    background: radial-gradient(ellipse at center, rgba(100, 138, 220, 0.16), rgba(100, 138, 220, 0) 68%);
    filter: blur(1.5rem);
  }

  .ai-systems-blueprint img {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(78rem, 128%);
    max-width: none;
    height: auto;
    transform: translate(-50%, -50%);
    filter: drop-shadow(0 1.8rem 3.5rem rgba(0, 0, 0, 0.28));
    opacity: 0.22;
    mask-image: linear-gradient(180deg, #000 0%, #000 72%, transparent 100%);
  }

  .ai-systems-section {
    position: relative;
    padding: clamp(4.5rem, 8vw, 7rem) 0;
  }

  .ai-systems-section--signals {
    padding-top: clamp(4.5rem, 8vw, 7rem);
  }

  .ai-systems-section-head--wide {
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .ai-systems-signal-list,
  .ai-systems-output-list {
    display: grid;
    border-top: var(--size-border-thin) solid var(--ai-page-border-soft);
  }

  .ai-systems-signal-list p,
  .ai-systems-output-list p {
    margin: 0;
    padding: var(--spacing-sm) 0;
    border-bottom: var(--size-border-thin) solid var(--ai-page-border-soft);
    color: var(--ai-page-text-muted);
    font-size: var(--ds-type-body-lg);
    line-height: 1.45;
  }

  .ai-systems-principle-grid,
  .ai-systems-activity-grid {
    display: grid;
    gap: var(--spacing-sm);
  }

  .ai-systems-principle-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .ai-systems-activity-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }

  .ai-systems-principle-card,
  .ai-systems-activity-card {
    display: grid;
    align-content: start;
    gap: var(--spacing-sm);
    min-height: 13rem;
    padding: var(--spacing-md);
    border: var(--size-border-thin) solid var(--ai-page-border-soft);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.038), rgba(255, 255, 255, 0.012)),
      rgba(9, 11, 16, 0.72);
  }

  .ai-systems-principle-card h3,
  .ai-systems-activity-card h3 {
    margin: 0;
    color: var(--ai-page-text);
    font-size: clamp(1.18rem, 1.55vw, 1.5rem);
    line-height: 1.08;
    letter-spacing: var(--ds-tracking-card);
    text-wrap: balance;
  }

  .ai-systems-principle-card p,
  .ai-systems-activity-card p {
    margin: 0;
    color: var(--ai-page-text-muted);
    line-height: 1.55;
  }

  .ai-systems-system {
    position: relative;
  }

  .ai-systems-system::before {
    content: '';
    position: absolute;
    inset: 10% auto auto 44%;
    width: min(42rem, 58vw);
    height: 28rem;
    pointer-events: none;
    background: radial-gradient(ellipse at center, rgba(98, 137, 230, 0.14), transparent 68%);
    filter: blur(1.25rem);
    opacity: 0.82;
  }

  .ai-systems-mosaic {
    --ai-mosaic-radius: var(--radius-lg);
    --ai-mosaic-surface: rgba(255, 255, 255, 0.035);
    --ai-mosaic-surface-strong: rgba(255, 255, 255, 0.055);
    --ai-mosaic-border: rgba(231, 235, 242, 0.1);
    --ai-mosaic-border-strong: rgba(176, 204, 255, 0.2);

    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(20rem, 1.28fr) minmax(0, 0.82fr);
    gap: var(--spacing-sm);
    margin-top: clamp(2rem, 4vw, 3.5rem);
    padding-top: clamp(2rem, 4vw, 3.5rem);
    border-top: var(--size-border-thin) solid var(--ai-page-border-soft);
  }

  .ai-systems-mosaic::before {
    content: '';
    position: absolute;
    inset: 12% 18% 6%;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(ellipse at center, rgba(106, 142, 226, 0.16), transparent 66%);
    filter: blur(1.25rem);
    opacity: 0.78;
  }

  .ai-systems-mosaic-column {
    display: grid;
    gap: var(--spacing-sm);
  }

  .ai-systems-mosaic-column--left,
  .ai-systems-mosaic-column--right {
    grid-auto-rows: minmax(13rem, auto);
  }

  .ai-systems-mosaic-column--center {
    grid-template-rows: minmax(19rem, auto) minmax(13rem, auto);
  }

  .ai-systems-mosaic-card {
    position: relative;
    display: grid;
    align-content: end;
    min-height: 13rem;
    padding: clamp(1.15rem, 1.8vw, 1.55rem);
    overflow: hidden;
    border: var(--size-border-thin) solid var(--ai-mosaic-border);
    border-radius: var(--ai-mosaic-radius);
    background:
      linear-gradient(180deg, var(--ai-mosaic-surface-strong), rgba(255, 255, 255, 0.012)),
      rgba(7, 9, 13, 0.82);
    box-shadow: 0 1.2rem 3.2rem rgba(0, 0, 0, 0.22);
  }

  .ai-systems-mosaic-column--left .ai-systems-mosaic-card {
    box-shadow:
      0 1.2rem 3.2rem rgba(0, 0, 0, 0.22),
      inset calc(var(--size-border-thin) * -1) 0 0 rgba(206, 226, 255, 0.38),
      inset -1rem 0 1.8rem rgba(84, 145, 255, 0.08);
  }

  .ai-systems-mosaic-column--right .ai-systems-mosaic-card {
    box-shadow:
      0 1.2rem 3.2rem rgba(0, 0, 0, 0.22),
      inset var(--size-border-thin) 0 0 rgba(206, 226, 255, 0.38),
      inset 1rem 0 1.8rem rgba(84, 145, 255, 0.08);
  }

  .ai-systems-mosaic-card::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(circle at 18% 12%, rgba(176, 204, 255, 0.13), transparent 14rem),
      linear-gradient(135deg, rgba(255, 255, 255, 0.052), transparent 42%);
    opacity: 0.72;
  }

  .ai-systems-mosaic-card::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 40%;
    pointer-events: none;
    background: linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.22));
  }

  .ai-systems-mosaic-column--left .ai-systems-mosaic-card::after {
    inset: 18% 0 18% auto;
    width: 1px;
    height: auto;

---
import Layout from '../../layouts/Layout.astro';
import Header from '../../layouts/Header.astro';
import ActorAudiencePage from '../../components/ActorAudiencePage.astro';
---

<Layout title="For Product and Engineering Teams | Dan Malarkey">
  <Header />
  <main>
    <ActorAudiencePage
      audienceTitle="Product and engineering teams"
      heroTitle="Design leadership that improves delivery partnership, not just design output."
      heroBody="I work with product and engineering teams to reduce delivery friction, improve implementation readiness, and create patterns teams can ship with confidence, while staying close enough to the work to help solve execution problems directly."
      actorMailtoSubject="[Product and engineering teams] Design leadership support"
      actorMailtoPrompt="product or engineering leadership"
      whatYouGet={[
        { title: 'Better design-to-build execution', text: 'Design patterns, flows, and documentation that reduce ambiguity and make implementation faster without lowering quality.' },
        { title: 'Systems, workflow, and product vision support', text: 'Support for complex product flows and operational software where teams need both vision clarity and system-level execution decisions.' },
        { title: 'Hands-on problem solving when needed', text: 'A leadership partner who can get into the trenches, and when useful, move into the IDE to help close the gap between intent and implementation.' }
      ]}
      idealFor={[
        'Teams dealing with delivery friction and repeated rework',
        'Products with systems-heavy workflows or operational complexity',
        'Organizations adopting AI-assisted delivery practices responsibly',
        'Teams that need senior thinking plus execution support'
      ]}
      signals={[
        'Engineering is building fast, but product intent is not landing clearly.',
        'Design work creates artifacts, but not enough implementation leverage.',
        'The team needs someone who can help define the path and solve practical execution problems.',
        'Cross-functional collaboration depends too much on individuals translating context.',
        'The team needs stronger patterns and standards, not just more screens.'
      ]}
    />
  </main>
</Layout>

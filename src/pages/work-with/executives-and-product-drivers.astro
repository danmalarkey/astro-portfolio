---
import Layout from '../../layouts/Layout.astro';
import Header from '../../layouts/Header.astro';
import ActorAudiencePage from '../../components/ActorAudiencePage.astro';
---

<Layout title="For Executives and Product Drivers | Dan Malarkey">
  <Header />
  <main>
    <ActorAudiencePage
      audienceTitle="Executives and product drivers"
      heroTitle="Design leadership support for leaders who need clarity, alignment, and a stronger shared vision."
      heroBody="I help executive and product leadership teams clarify product direction, align investment priorities, and make design a driver of business outcomes by turning goals, constraints, and competing needs into direction teams can actually execute."
      heroSignals={[
        { label: 'Direction', detail: 'Clarify what matters now' },
        { label: 'Investment', detail: 'Sequence bets with more confidence' },
        { label: 'Outcomes', detail: 'Tie design to business decisions' }
      ]}
      actorMailtoSubject="[Executives and product drivers] Advisory inquiry"
      actorMailtoPrompt="executive or product leadership"
      whatYouGet={[
        { title: 'Clarity and direction-setting', text: 'Clarify priorities, tradeoffs, and what the team is actually trying to achieve so decisions are easier to align on and defend.' },
        { title: 'Shared understanding across leadership', text: 'Create alignment across stakeholders so teams stop burning cycles on interpretation, politics drag, and conflicting expectations.' },
        { title: 'Vision that can be executed', text: 'Translate goals and constraints into product vision and direction the team can actually build, not just agree with in a meeting.' }
      ]}
      idealFor={[
        'Teams that need sharper product direction and clearer investment bets',
        'Leaders navigating growth, change, or product ambiguity',
        'Teams where delivery is moving but direction is drifting',
        'Organizations investing in product/design capability' 
      ]}
      signals={[
        'Leaders keep asking, “What should we be doing?” and the team needs a stronger answer than another meeting.',
        'The team is shipping, but decisions are still getting reopened late.',
        'Product, engineering, and design are not working from the same definition of success.',
        'Leadership knows the direction matters, but the operating rhythm is weak.',
        'A platform or experience transformation needs stronger design leadership than the team currently has.'
      ]}
    />
  </main>
</Layout>

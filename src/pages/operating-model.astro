---
import Layout from '../layouts/Layout.astro';
import Header from '../layouts/Header.astro';
import HomeFooter from '../components/HomeFooter.astro';
import FocusAreaJumpCards from '../components/FocusAreaJumpCards.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Button from '../components/Button.astro';

const baseUrl = Astro.url.pathname.startsWith('/astro-portfolio') ? '/astro-portfolio/' : '/';
const withBase = (path: string) => `${baseUrl}${path.startsWith('/') ? path.slice(1) : path}`;

const mailParams = new URLSearchParams();
mailParams.set('subject', '[Operating model] Advisory inquiry');
mailParams.set('body', `Hi Dan,\n\nI'm reaching out about operating model support and would like to talk through what we are building.\n\nContext:\n- Team/company:\n- Product or system:\n- Where the work is drifting or fragmenting:\n- Desired engagement shape:\n\nThanks,`);
const mailto = `mailto:hello@danmalarkey.com?${mailParams.toString()}`;

const modelLayers = [
  {
    title: 'Business Intent',
    text: 'What the organization is trying to make true.',
    focus: 'The business intent the model has to preserve.',
    backgroundImage: '/images/op-model/business-intent-bg.png'
  },
  {
    title: 'Concepts',
    text: 'The core abstractions, relationships, rules, and boundaries that give the system conceptual integrity.',
    focus: 'The shared model behind product behavior.',
    backgroundImage: '/images/op-model/concepts-bg.png'
  },
  {
    title: 'Activities',
    text: 'The goals, jobs, decisions, and work patterns people move through to accomplish something meaningful.',
    focus: 'The human activity the system needs to support.',
    backgroundImage: '/images/op-model/activities-hold-bg.png'
  },
  {
    title: 'Operations',
    text: 'How the organization supports, coordinates, governs, and delivers the work.',
    focus: 'The operating reality surrounding the product.',
    backgroundImage: '/images/op-model/operations-bg.png'
  },
  {
    title: 'Behavior',
    text: 'How the system responds, guides, prevents errors, and builds trust in use.',
    focus: 'The product behavior people experience in use.',
    backgroundImage: '/images/op-model/behavior-bg.png'
  },
  {
    title: 'Design systems',
    text: 'How decisions, standards, patterns, accessibility, and implementation guidance become reusable.',
    focus: 'The reusable standards that keep delivery coherent.',
    backgroundImage: '/images/op-model/expression-bg.png'
  }
];

const stuckPatterns = [
  {
    icon: 'intent',
    title: 'Intent gets diluted',
    text: 'Business priorities lose coherence through delivery.'
  },
  {
    icon: 'models',
    title: 'Teams operate from different models',
    text: 'The work looks aligned before the thinking is.'
  },
  {
    icon: 'direction',
    title: 'Direction outpaces understanding',
    text: 'Product strategy evolves faster than organizational alignment.'
  },
  {
    icon: 'workflow',
    title: 'Workflows mirror the org chart',
    text: 'Internal structure shapes the experience more than real user activity.'
  },
  {
    icon: 'behavior',
    title: 'Behavior becomes inconsistent',
    text: 'Similar interactions produce different expectations and outcomes.'
  },
  {
    icon: 'local',
    title: 'Teams optimize locally',
    text: 'Individual decisions improve delivery while weakening overall coherence.'
  }
];

const supportAreas = [
  {
    title: 'Strategic priorities stay visible',
    text: 'Business goals continue shaping decisions beyond planning conversations.'
  },
  {
    title: 'Operational friction decreases',
    text: 'Organizations spend less energy compensating for conflicting assumptions and disconnected workflows.'
  },
  {
    title: 'Decisions become easier to sustain',
    text: 'Leaders can make changes without destabilizing the broader operating environment.'
  },
  {
    title: 'Products behave more consistently',
    text: 'Customer experience, operational capability, and implementation move in the same direction.'
  },
  {
    title: 'Organizations gain steadier movement',
    text: 'Priorities become easier to maintain as products, standards, and responsibilities evolve.'
  }
];

const outputs = [
  {
    title: 'Product model maps',
    text: 'Define concepts, relationships, rules, and business logic so teams understand what the product is built around.',
    backgroundImage: '/images/op-model/product-model-maps-bg.png'
  },
  {
    title: 'Workflow and activity models',
    text: 'Clarify how work actually moves through the organization, including goals, jobs, decisions, handoffs, and constraints.',
    backgroundImage: '/images/op-model/activities-bg.png'
  },
  {
    title: 'Operating principles',
    text: 'Connect strategy to delivery decisions teams can act on.',
    backgroundImage: '/images/op-model/op-principles-bg.png'
  },
  {
    title: 'Decision frameworks',
    text: 'Support product, design, engineering, and operational tradeoffs.',
    backgroundImage: '/images/op-model/decision-frameworks-bg.png'
  },
  {
    title: 'UX system patterns',
    text: 'Tie interface patterns to implementation and operational realities.',
    backgroundImage: '/images/op-model/system-patterns-bg.png'
  },
  {
    title: 'Operating standards',
    text: 'Establish shared expectations for terminology, behavior, accessibility, and quality.',
    backgroundImage: '/images/op-model/operating-standards-bg.png'
  }
];
---

<Layout
  title="Operating Model | Dan Malarkey"
  description="Operating model support for organizations that need stronger business clarity, product coherence, and aligned product execution."
>
  <Header />
  <main class="operating-model-page">
    <section class="operating-model-hero" aria-labelledby="operating-model-title" data-operating-model-parallax>
      <div class="operating-model-hero-rays" aria-hidden="true"></div>
      <div class="operating-model-hero-light" aria-hidden="true"></div>
      <div class="operating-model-hero-blueprint" aria-hidden="true">
        <img
          src={withBase('/images/home-v3/blueprint/operating-model-blueprint-transparent.png')}
          alt=""
          loading="eager"
          decoding="async"
        />
      </div>
      <div class="dm-grid-l dm-grid-l--grid-sys operating-model-hero-grid">
        <div class="operating-model-hero-copy gc-start-2 gc-span-13">
          <p class="operating-model-kicker">Operating model</p>
          <h1 id="operating-model-title">Products reflect the organizations behind them.</h1>
          <p>
            Strong product work reflects aligned business intent, operational capability, shared understanding, and implementation decisions. Product logic, workflows, system behavior, and delivery choices should reinforce the same underlying model.
          </p>
        </div>
      </div>
    </section>

    <section
      class="operating-model-section operating-model-section--signal"
      style={`--operating-model-signal-bg: url('${withBase('/images/op-model/noise-to-sig.png')}')`}
      aria-labelledby="operating-model-signal"
      data-motion-reveal
    >
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <SectionHeader
          eyebrow="Operating clarity"
          title="Separate the signal from the noise."
          headingId="operating-model-signal"
          headClass="operating-model-signal-head gc-start-10 gc-span-11"
          bodyClass="operating-model-signal-body gc-start-10 gc-span-11"
          accent
          reveal
        >
          <Fragment slot="body">
          <p>
            Strong operating models help organizations distinguish between short-term delivery pressure and the decisions that shape operational success, product vision, and long-term capability.
          </p>
          <p>
            The work goes beyond interfaces. It is aligning business goals, user activities, behaviors, workflows, and constraints that shape the entire journey.
          </p>
          </Fragment>
        </SectionHeader>
      </div>
    </section>

    <section class="operating-model-section operating-model-section--stuck" aria-labelledby="operating-model-stuck" data-motion-reveal>
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <SectionHeader
          eyebrow="Where alignment starts to break down"
          title="Drift starts long before the interface."
          body="Product fragmentation rarely happens all at once. It usually begins earlier—when business goals, operating assumptions, user activities, and delivery decisions start moving in different directions. By the time it reaches the interface, the underlying model is already under strain."
          headingId="operating-model-stuck"
          accent
          reveal
        />
        <div class="focus-diagnostic-list operating-model-stuck-list gc-start-2 gc-span-24" role="list" aria-label="Where operating model work gets stuck" data-motion-item>
          {stuckPatterns.map((pattern) => (
            <article class="focus-diagnostic-item operating-model-stuck-item" role="listitem">
              <div class="operating-model-drift-icon" aria-hidden="true">
                {pattern.icon === 'intent' && (
                  <svg viewBox="0 0 48 48" focusable="false">
                    <path d="M24 6v36" />
                    <path d="M6 24h36" />
                    <circle cx="24" cy="24" r="6" />
                    <circle class="operating-model-drift-icon-fill" cx="24" cy="24" r="2" />
                  </svg>
                )}
                {pattern.icon === 'models' && (
                  <svg viewBox="0 0 48 48" focusable="false">
                    <rect x="8" y="14" width="14" height="14" />
                    <rect x="26" y="20" width="14" height="14" />
                    <path d="M22 21h4" />
                    <path d="M15 28v8h18v-2" />
                  </svg>
                )}
                {pattern.icon === 'direction' && (
                  <svg viewBox="0 0 48 48" focusable="false">
                    <path d="M7 34l10-12 8 8 16-20" />
                    <path d="M34 10h7v7" />
                  </svg>
                )}
                {pattern.icon === 'workflow' && (
                  <svg viewBox="0 0 48 48" focusable="false">
                    <rect x="19" y="6" width="10" height="10" />
                    <rect x="6" y="32" width="10" height="10" />
                    <rect x="19" y="32" width="10" height="10" />
                    <rect x="32" y="32" width="10" height="10" />
                    <path d="M24 16v8M11 32v-8h26v8M24 24v8" />
                  </svg>
                )}
                {pattern.icon === 'behavior' && (
                  <svg viewBox="0 0 48 48" focusable="false">
                    <path d="M24 7a17 17 0 0 1 16.2 11.8" />
                    <path d="M41 24a17 17 0 0 1-10 15.5" stroke-dasharray="5 5" />
                    <path d="M24 41A17 17 0 0 1 7.8 29.2" />
                    <path d="M7 24A17 17 0 0 1 17 8.5" stroke-dasharray="5 5" />
                  </svg>
                )}
                {pattern.icon === 'local' && (
                  <svg viewBox="0 0 48 48" focusable="false">
                    <circle class="operating-model-drift-icon-fill" cx="12" cy="12" r="2.5" />
                    <circle class="operating-model-drift-icon-fill" cx="24" cy="12" r="2.5" />
                    <circle class="operating-model-drift-icon-fill" cx="36" cy="12" r="2.5" />
                    <circle class="operating-model-drift-icon-fill" cx="12" cy="24" r="2.5" />
                    <circle class="operating-model-drift-icon-fill" cx="24" cy="24" r="2.5" />
                    <circle class="operating-model-drift-icon-fill" cx="36" cy="24" r="2.5" />
                    <circle class="operating-model-drift-icon-fill" cx="12" cy="36" r="2.5" />
                    <circle class="operating-model-drift-icon-fill" cx="24" cy="36" r="2.5" />
                    <circle class="operating-model-drift-icon-fill" cx="36" cy="36" r="2.5" />
                  </svg>
                )}
              </div>
              <div>
                <h3>{pattern.title}</h3>
                <p>{pattern.text}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="operating-model-band" aria-labelledby="operating-model-layers" data-motion-reveal>
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <SectionHeader
          eyebrow="What has to stay aligned"
          title="Hold alignment through execution."
          body="Execution stays aligned when business intent, conceptual integrity, human activity, operations, behavior, and design systems continue reinforcing the same direction."
          headingId="operating-model-layers"
          accent
          reveal
        />
        <div
          class="operating-model-layer-system gc-start-2 gc-span-24"
          data-operating-model-layers
          data-active-layer="0"
          data-motion-item
        >
          <div class="operating-model-layer-track" role="tablist" aria-label="Operating model layers">
            {modelLayers.map((layer, index) => (
              <button
                class="operating-model-layer-step"
                type="button"
                role="tab"
                aria-selected={index === 0 ? 'true' : 'false'}
                aria-controls={`operating-model-layer-panel-${index}`}
                id={`operating-model-layer-tab-${index}`}
                data-layer-index={index}
                data-layer-bg={withBase(layer.backgroundImage)}
              >
                <span class="operating-model-layer-step-node" aria-hidden="true">
                  <svg viewBox="0 0 24 24" focusable="false">
                    <circle class="operating-model-layer-step-node-track" cx="12" cy="12" r="8" />
                    <circle class="operating-model-layer-step-node-progress" cx="12" cy="12" r="8" pathLength="1" />
                  </svg>
                </span>
                <span class="operating-model-layer-step-index">{String(index + 1).padStart(2, '0')}</span>
                <span class="operating-model-layer-step-title">{layer.title}</span>
              </button>
            ))}
          </div>
          <div class="operating-model-layer-card">
            <div class="operating-model-layer-backgrounds" aria-hidden="true">
              {modelLayers.map((layer, index) => (
                <div
                  class="operating-model-layer-background"
                  data-layer-background={index}
                  aria-hidden={index === 0 ? 'false' : 'true'}
                  style={`background-image: url('${withBase(layer.backgroundImage)}')`}
                ></div>
              ))}
            </div>
            <div class="operating-model-layer-panels">
              {modelLayers.map((layer, index) => (
                <article
                  class="operating-model-layer-panel"
                  id={`operating-model-layer-panel-${index}`}
                  role="tabpanel"
                  aria-labelledby={`operating-model-layer-tab-${index}`}
                  data-layer-panel={index}
                  aria-hidden={index === 0 ? 'false' : 'true'}
                >
                  <div class="operating-model-layer-panel-top">
                    <span class="operating-model-layer-panel-index">{String(index + 1).padStart(2, '0')}</span>
                    <h3>{layer.title}</h3>
                    <p>{layer.text}</p>
                  </div>
                  {'focus' in layer && (
                    <div class="operating-model-layer-focus">
                      <span>Focus</span>
                      {layer.focus && <p>{layer.focus}</p>}
                    </div>
                  )}
                </article>
              ))}
            </div>
            <div class="operating-model-layer-card-visual" aria-hidden="true"></div>
          </div>
        </div>
      </div>
    </section>

    <section class="operating-model-band" aria-labelledby="operating-model-outputs" data-motion-reveal>
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <SectionHeader
          eyebrow="What supports better decisions"
          title="The work becomes useful when decisions improve."
          body="Decision infrastructure gives teams the models, frameworks, principles, patterns, and standards they need to keep priorities, product direction, implementation choices, and operating reality connected."
          headingId="operating-model-outputs"
          accent
          reveal
        />
        <div class="operating-model-output-list gc-start-2 gc-span-24" role="list" data-motion-item>
          {outputs.map((output, index) => (
            <article
              class="operating-model-output-card"
              role="listitem"
              style={`--operating-model-output-bg: url('${withBase(output.backgroundImage)}')`}
            >
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{output.title}</h3>
              <p>{output.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="operating-model-section operating-model-section--split" aria-labelledby="operating-model-support" data-motion-reveal>
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <SectionHeader
          eyebrow="What gets better"
          title="When organizations maintain direction."
          body="When the right layers stay connected and better decisions are easier to make, priorities stay visible, friction decreases, and systems evolve with more consistency."
          headingId="operating-model-support"
          accent
          reveal
        />
        <div class="operating-model-clarity-grid gc-start-2 gc-span-24" role="list" data-motion-item>
          {supportAreas.map((area, index) => (
            <article class="operating-model-clarity-card" role="listitem">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{area.title}</h3>
              <p>{area.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="operating-model-section operating-model-section--mid-cta" aria-labelledby="operating-model-mid-cta" data-motion-reveal>
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <div class="operating-model-cta-inner operating-model-cta-inner--accent gc-start-2 gc-span-24" data-motion-item>
          <p class="operating-model-kicker">Before drift becomes expensive</p>
          <h2 id="operating-model-mid-cta">Do not let execution outrun understanding.</h2>
          <p>
            When teams move before the business is aligned, speed becomes expensive. I help organizations clarify what needs to be true before product, technology, and delivery decisions start compounding.
          </p>
          <div class="operating-model-actions" aria-label="Operating model CTA actions">
            <Button href={mailto}>Start a conversation</Button>
            <Button href={withBase('/standards-and-scale')} variant="ghost">Explore Standards & Scale</Button>
          </div>
        </div>
      </div>
    </section>

    <FocusAreaJumpCards current="operating" />

    <HomeFooter
      eyebrow="Operating model"
      title="If the organization behind the product needs to become more coherent, let’s talk."
      body="I’m available for select advisory, consulting, and fractional leadership engagements where stronger organizational clarity, product thinking, and operating structure can move the work forward."
    />
  </main>
</Layout>

<style lang="scss">
  .operating-model-page {
    --operating-model-bg: var(--ds-background);
    --operating-model-surface: var(--ds-surface);
    --operating-model-surface-strong: var(--ds-surface-strong);
    --operating-model-border: var(--ds-border);
    --operating-model-border-soft: var(--ds-border-soft);
    --operating-model-text: var(--ds-text);
    --operating-model-text-muted: var(--ds-text-muted);
    --operating-model-text-soft: var(--ds-text-soft);
    --operating-model-accent: rgba(176, 204, 255, 0.88);
    --operating-model-orbit-accent: rgba(191, 215, 255, 0.98);
    --operating-model-warm: rgba(255, 244, 170, 0.9);
    --operating-model-glow: 111, 162, 232;
    --operating-model-orbit-glow: 111, 162, 232;
    --section-header-accent-color: var(--operating-model-accent);
    --section-header-title-color: rgba(245, 248, 255, 0.96);
    --section-header-body-color: var(--operating-model-text-muted);
    --operating-model-layer-crossfade-duration: 880ms;
    --operating-model-layer-exit-duration: 540ms;
    --operating-model-layer-enter-delay: 210ms;

    min-height: 100vh;
    padding-inline: 0;
    overflow: hidden;
    background:
      radial-gradient(ellipse at 82% 4%, rgba(94, 122, 188, 0.2), rgba(94, 122, 188, 0) 34rem),
      radial-gradient(ellipse at 14% 8%, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0) 24rem),
      var(--operating-model-bg);
    color: var(--operating-model-text);
  }

  .operating-model-hero {
    --operating-model-parallax-soft: 0rem;
    --operating-model-parallax-medium: 0rem;
    --operating-model-parallax-strong: 0rem;
    --operating-model-parallax-blueprint-x: 0rem;

    position: relative;
    isolation: isolate;
    display: grid;
    align-items: center;
    min-height: calc(100vh - 5rem);
    min-height: calc(100dvh - 5rem);
    padding: clamp(6rem, 10vw, 8.5rem) 0 clamp(5rem, 9vw, 8rem);
    overflow: hidden;
    background: linear-gradient(90deg, var(--operating-model-bg) 0%, var(--operating-model-bg) 46%, rgba(7, 16, 27, 0.82) 100%);
  }

  .operating-model-hero-light {
    position: absolute;
    top: 8%;
    right: -40%;
    z-index: 0;
    width: min(118vw, 84rem);
    height: min(84vh, 48rem);
    border-radius: var(--radius-pill);
    pointer-events: none;
    background:
      radial-gradient(
        ellipse at 62% 42%,
        rgba(191, 215, 255, 0.28) 0%,
        rgba(var(--operating-model-glow), 0.15) 28%,
        rgba(var(--operating-model-glow), 0.06) 52%,
        transparent 76%
      );
    filter: blur(34px);
    opacity: 0.78;
    transform: translate3d(0, var(--operating-model-parallax-soft), 0) rotate(-35deg);
  }

  .operating-model-hero-rays {
    --operating-model-rays-opacity: 0.42;

    position: absolute;
    top: -8rem;
    left: -10rem;
    z-index: 0;
    width: min(100rem, 118vw);
    height: 78rem;
    transform: translate3d(0, var(--operating-model-parallax-medium), 0) rotate(-22deg);
    transform-origin: top left;
    pointer-events: none;
    background:
      linear-gradient(90deg, transparent 10%, rgba(255, 255, 255, 0.18) 13%, rgba(255, 255, 255, 0.045) 15.5%, transparent 19%),
      linear-gradient(90deg, transparent 18%, rgba(176, 204, 255, 0.14) 21%, rgba(176, 204, 255, 0.04) 23.5%, transparent 28%),
      linear-gradient(90deg, transparent 29%, rgba(255, 255, 255, 0.1) 32%, rgba(255, 255, 255, 0.03) 34.5%, transparent 39%);
    filter: blur(8px);
    opacity: var(--operating-model-rays-opacity);
    mix-blend-mode: screen;
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.94), rgba(0, 0, 0, 0.44) 32%, rgba(0, 0, 0, 0.14) 60%, rgba(0, 0, 0, 0.04) 78%, transparent 100%);
    animation: operating-model-rays-enter 1400ms ease 280ms both;
  }

  .operating-model-hero-blueprint {
    position: absolute;
    top: 50%;
    right: -12%;
    z-index: 1;
    width: min(46vw, 36rem);
    pointer-events: none;
    opacity: 0.16;
    transform: translate3d(var(--operating-model-parallax-blueprint-x), calc(-48% + var(--operating-model-parallax-strong)), 0) rotate(-8deg);
    filter: drop-shadow(0 0 3rem rgba(var(--operating-model-glow), 0.12));
    mix-blend-mode: screen;
  }

  .operating-model-hero-blueprint img {
    display: block;
    width: 100%;
    height: auto;
  }

  .operating-model-hero-grid,
  .operating-model-section > .dm-grid-l,
  .operating-model-band > .dm-grid-l {
    position: relative;
    z-index: 2;
  }

  .operating-model-hero-grid {
    min-height: inherit;
    align-items: center;
  }

  .operating-model-hero-copy {
    display: grid;
    gap: var(--ds-panel-gap);
    align-content: start;
  }

  .operating-model-cta-inner {
    display: grid;
    align-content: start;
    gap: var(--spacing-md);
  }

  .operating-model-hero-copy {
    position: relative;
    z-index: 4;
    animation: operating-model-hero-copy-enter 820ms ease 420ms both;
  }

  .operating-model-kicker {
    margin: 0;
    color: var(--operating-model-accent);
    font-size: var(--ds-type-label);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--ds-tracking-label);
    line-height: var(--ds-line-label);
    text-transform: uppercase;
  }

  .operating-model-hero h1,
  .operating-model-section h2,
  .operating-model-band h2 {
    margin: 0;
    font-family: var(--font-family-display);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--ds-tracking-title);
    text-wrap: balance;
  }

  .operating-model-hero h1 {
    max-width: 12ch;
    color: var(--operating-model-text);
    font-size: var(--ds-type-title-xl);
    line-height: var(--ds-line-card-title);
  }

  .operating-model-section h2,
  .operating-model-band h2 {
    color: rgba(245, 248, 255, 0.96);
    font-size: var(--ds-type-title-lg);
    line-height: var(--ds-line-card-title);
  }


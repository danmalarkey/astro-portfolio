    }

    .operating-model-hero-copy,
    .operating-model-stuck-list,
    .operating-model-layer-system,
    .operating-model-clarity-grid,
    .operating-model-cta-inner,
    .operating-model-output-list {
      grid-column: 1 / -1;
      margin-inline: var(--operating-model-mobile-gutter);
    }

    .operating-model-hero {
      align-items: end;
      height: 100vh;
      height: 100dvh;
      min-height: 0;

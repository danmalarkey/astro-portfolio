<script>
  const hero = document.querySelector<HTMLElement>('[data-operating-model-parallax]');
  const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
  const layerSystem = document.querySelector<HTMLElement>('[data-operating-model-layers]');

  if (hero && !motionQuery.matches) {
    let frame = 0;

    const clamp = (value: number, min: number, max: number) => Math.min(Math.max(value, min), max);

    const updateHeroParallax = () => {
      frame = 0;

      const rect = hero.getBoundingClientRect();
      const progress = clamp((rect.top * -1) / Math.max(rect.height, 1), 0, 1);

      hero.style.setProperty('--operating-model-parallax-soft', `${progress * 1.8}rem`);
      hero.style.setProperty('--operating-model-parallax-medium', `${progress * 3.2}rem`);
      hero.style.setProperty('--operating-model-parallax-strong', `${progress * 6.5}rem`);
      hero.style.setProperty('--operating-model-parallax-blueprint-x', `${progress * -2.4}rem`);
    };

    const scheduleHeroParallax = () => {
      if (frame) return;
      frame = window.requestAnimationFrame(updateHeroParallax);
    };

    updateHeroParallax();
    window.addEventListener('scroll', scheduleHeroParallax, { passive: true });
    window.addEventListener('resize', scheduleHeroParallax);
  }

  if (layerSystem) {
    const layerTabs = Array.from(layerSystem.querySelectorAll<HTMLButtonElement>('[data-layer-index]'));
    const layerPanels = Array.from(layerSystem.querySelectorAll<HTMLElement>('[data-layer-panel]'));
    const layerBackgrounds = Array.from(layerSystem.querySelectorAll<HTMLElement>('[data-layer-background]'));
    const layerDuration = 18000;
    const layerTransitionDuration = 1100;
    let activeLayer = 0;
    let layerTimer: number | undefined;
    let layerTransitionTimer: number | undefined;

    const setActiveLayer = (index: number) => {
      const previousLayer = activeLayer;
      activeLayer = index;
      layerSystem.dataset.activeLayer = String(index);

      layerTabs.forEach((tab, tabIndex) => {
        tab.setAttribute('aria-selected', String(tabIndex === index));
      });

      window.clearTimeout(layerTransitionTimer);

      layerPanels.forEach((panel, panelIndex) => {
        if (panelIndex === index) {
          panel.setAttribute('aria-hidden', 'false');
          panel.dataset.layerPanelState = 'active';
          return;
        }

        if (panelIndex === previousLayer && previousLayer !== index) {
          panel.setAttribute('aria-hidden', 'true');
          panel.dataset.layerPanelState = 'leaving';
          return;
        }

        panel.setAttribute('aria-hidden', 'true');
        panel.dataset.layerPanelState = 'inactive';
      });

      layerTransitionTimer = window.setTimeout(() => {
        layerPanels.forEach((panel, panelIndex) => {
          if (panelIndex !== activeLayer) {
            panel.dataset.layerPanelState = 'inactive';
          }
        });
      }, layerTransitionDuration);

      layerBackgrounds.forEach((background, backgroundIndex) => {
        background.setAttribute('aria-hidden', String(backgroundIndex !== index));
      });
    };

    const startLayerTimer = () => {
      if (motionQuery.matches || layerTabs.length < 2) return;
      window.clearInterval(layerTimer);
      layerTimer = window.setInterval(() => {
        setActiveLayer((activeLayer + 1) % layerTabs.length);
      }, layerDuration);
    };

    layerTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        setActiveLayer(Number(tab.dataset.layerIndex ?? 0));
        startLayerTimer();
      });
    });

    setActiveLayer(activeLayer);
    layerSystem.dataset.layerReady = 'true';
    startLayerTimer();
  }
</script>

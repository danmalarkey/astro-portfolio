---
import Layout from "../layouts/Layout.astro";
import Header from "../layouts/Header.astro";
---

<Layout title="Library | Dan Malarkey">
  <Header />
  <main>
    <section class="section section-panel section-surface--warm">
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <div class="gc-start-2 gc-span-18">
          <h1 class="section-title">Library</h1>
          <p>
            A curated collection of books, references, and recommendations is in progress.
            This will include resources for designers building their careers and leaders learning how design creates leverage.
          </p>
          <p class="small-text">
            Future plans include personal recommendations, notes, and eventually data-fed collections (including vinyl and other lab projects).
          </p>
        </div>
      </div>
    </section>
  </main>
</Layout>

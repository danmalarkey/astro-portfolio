---
import Layout from "../layouts/Layout.astro";
import Header from "../layouts/Header.astro";
import PageIntro from "../components/PageIntro.astro";
---

<Layout title="Library | Dan Malarkey">
  <Header />
  <main>
    <section class="section section-panel section-surface--warm">
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <PageIntro
          eyebrow="Library"
          title="Books, references, and recommendations that shape how I think."
          body="A curated collection of books, references, and recommendations is in progress. This will include resources for designers building their careers and leaders learning how design creates leverage."
          meta="Future plans include personal recommendations, notes, and eventually data-fed collections (including vinyl and other lab projects)."
        />
      </div>
    </section>
  </main>
</Layout>

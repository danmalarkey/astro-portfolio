  .portfolio-outcome-composition {
    display: grid;
    grid-template-columns: var(--portfolio-outcome-index-width) minmax(0, 1fr);
    column-gap: var(--portfolio-outcome-column-gap);
    row-gap: clamp(2.5rem, 4vw, 4rem);
  }

  .portfolio-outcome-composition > .portfolio-study-head,
  .portfolio-outcome-stack {
    grid-column: 2;

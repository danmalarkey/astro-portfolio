  :global(.press-focus-stack .pinned-stack-card) {
    --press-focus-accent-rgb: 126, 160, 255;
    border-color: rgba(231, 235, 242, 0.08);
    border-radius: var(--radius-card);
    background:
      radial-gradient(ellipse at 78% 18%, rgba(var(--press-focus-accent-rgb), 0.12), transparent 24rem),
      linear-gradient(180deg, rgba(137, 169, 226, 0.055), rgba(137, 169, 226, 0.02)),
      rgba(var(--ds-surface-panel-rgb), 0.86);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.018),
      0 1.2rem 2.8rem rgba(0, 0, 0, 0.18);
    transition:
      border-color 280ms ease,
      box-shadow 420ms ease;

<script is:inline>
  (() => {
    const rails = Array.from(document.querySelectorAll('[data-proof-rail]'));
    const hoverQuery = window.matchMedia('(hover: hover) and (pointer: fine)');
    const compactQuery = window.matchMedia('(max-width: 64rem)');

    rails.forEach((rail) => {
      const items = Array.from(rail.querySelectorAll('[data-proof-rail-item]'));
      const triggers = items
        .map((item) => item.querySelector('[data-proof-rail-trigger]'))
        .filter((trigger) => trigger instanceof HTMLButtonElement);

      const setActive = (activeItem) => {
        items.forEach((item) => {
          const isActive = item === activeItem;
          const trigger = item.querySelector('[data-proof-rail-trigger]');
          const details = item.querySelector('[data-proof-rail-details]');
          const copy = item.querySelector('[data-proof-rail-copy]');
          const collapsedLabel = item.querySelector('[data-proof-rail-collapsed-label]');
          item.classList.toggle('is-active', isActive);
          trigger?.setAttribute('aria-expanded', String(compactQuery.matches || isActive));
          details?.setAttribute('aria-hidden', String(!compactQuery.matches && !isActive));
          copy?.setAttribute('aria-hidden', String(!compactQuery.matches && !isActive));
          collapsedLabel?.setAttribute('aria-hidden', String(compactQuery.matches || isActive));
        });
      };

      const syncCompactState = () => {
        const activeItem = items.find((item) => item.classList.contains('is-active')) ?? items[0];
        if (activeItem) setActive(activeItem);
      };

      items.forEach((item) => {
        const trigger = item.querySelector('[data-proof-rail-trigger]');
        if (!(trigger instanceof HTMLButtonElement)) return;

        trigger.addEventListener('click', () => setActive(item));
        trigger.addEventListener('focus', () => setActive(item));
        item.addEventListener('pointerenter', () => {
          if (hoverQuery.matches) setActive(item);
        });
      });

      rail.addEventListener('keydown', (event) => {
        if (!(event.target instanceof HTMLButtonElement)) return;
        const currentIndex = triggers.indexOf(event.target);
        if (currentIndex < 0) return;

        let nextIndex = currentIndex;
        if (event.key === 'ArrowRight') nextIndex = (currentIndex + 1) % triggers.length;
        else if (event.key === 'ArrowLeft') nextIndex = (currentIndex - 1 + triggers.length) % triggers.length;
        else if (event.key === 'Home') nextIndex = 0;
        else if (event.key === 'End') nextIndex = triggers.length - 1;
        else return;

        event.preventDefault();
        triggers[nextIndex]?.focus();
      });

      compactQuery.addEventListener('change', syncCompactState);
      syncCompactState();
    });
  })();
</script>

<script is:inline>
  (() => {
    const initStarfield = (id, options = {}) => {
      const canvas = document.getElementById(id);
      if (!(canvas instanceof HTMLCanvasElement)) return;

      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const stars = [];
      let width = 0;
      let height = 0;
      const count = options.count ?? 120;
      const drift = options.drift ?? 0.02;
      const shootingStars = [];
      let nextShootingStarAt = 0;

      const getBounds = () => {
        const frame = canvas.closest('.home-window') ?? canvas.parentElement;
        const rect = frame?.getBoundingClientRect();

        return {
          width: Math.max(1, rect?.width || window.innerWidth),
          height: Math.max(1, rect?.height || window.innerHeight)
        };
      };

      const resize = () => {
        const previousWidth = width;
        const previousHeight = height;
        const bounds = getBounds();
        width = bounds.width;
        height = bounds.height;
        const ratio = Math.max(window.devicePixelRatio || 1, 1);
        canvas.width = Math.floor(width * ratio);
        canvas.height = Math.floor(height * ratio);
        canvas.style.width = `${width}px`;
        canvas.style.height = `${height}px`;
        ctx.setTransform(ratio, 0, 0, ratio, 0, 0);

        if (previousWidth > 0 && previousHeight > 0 && stars.length) {
          const scaleX = width / previousWidth;
          const scaleY = height / previousHeight;
          stars.forEach((star) => {
            star.x *= scaleX;
            star.y *= scaleY;
          });
        }
      };

      const seed = () => {
        stars.length = 0;
        for (let i = 0; i < count; i += 1) {
          stars.push({
            x: Math.random() * width,
            y: Math.random() * height,
            radius: Math.random() * 1.44 + 0.24,
            alpha: Math.random() * 0.8 + 0.12,
            vx: (Math.random() - 0.5) * drift,
            vy: (Math.random() - 0.5) * drift,
            twinkles: Math.random() < 0.2,
            twinklePhase: Math.random() * Math.PI * 2,
            twinkleSpeed: 0.0007 + Math.random() * 0.0007,
            twinkleDepth: 0.24 + Math.random() * 0.18
          });
        }
      };

      const draw = () => {
        ctx.clearRect(0, 0, width, height);
        const now = prefersReducedMotion ? 0 : performance.now();

        for (const star of stars) {
          if (!prefersReducedMotion) {
            star.x += star.vx;
            star.y += star.vy;

            if (star.x < 0) star.x = width;
            if (star.x > width) star.x = 0;
            if (star.y < 0) star.y = height;
            if (star.y > height) star.y = 0;
          }

          const twinkle = !prefersReducedMotion && star.twinkles
            ? (Math.sin((now * star.twinkleSpeed) + star.twinklePhase) + 1) / 2
            : 0.5;
          const twinkleScale = !prefersReducedMotion && star.twinkles
            ? 1 - star.twinkleDepth + (star.twinkleDepth * twinkle * 2)
            : 1;

          ctx.fillStyle = `rgba(231, 235, 242, ${Math.min(1, star.alpha * twinkleScale)})`;
          ctx.beginPath();
          ctx.arc(star.x, star.y, star.radius * (0.93 + (twinkle * 0.14)), 0, Math.PI * 2);
          ctx.fill();
        }

        if (!prefersReducedMotion) {
          // Keep shooting stars occasional so the hero stays calm.
          if (now >= nextShootingStarAt && shootingStars.length < 1) {
            const fromLeft = Math.random() > 0.5;
            const startX = fromLeft ? -120 : width + 120;
            const startY = Math.random() * (height * 0.45) + 20;
            const speed = 2.2 + Math.random() * 1.1;
            const angle = fromLeft ? 0.35 + Math.random() * 0.25 : Math.PI - (0.35 + Math.random() * 0.25);
            shootingStars.push({
              x: startX,
              y: startY,
              vx: Math.cos(angle) * speed,
              vy: Math.sin(angle) * speed,
              life: 0,
              maxLife: 150 + Math.random() * 60
            });
            nextShootingStarAt = now + 2400 + Math.random() * 2600;
          }

          for (let i = shootingStars.length - 1; i >= 0; i -= 1) {
            const shootingStar = shootingStars[i];
            shootingStar.x += shootingStar.vx;
            shootingStar.y += shootingStar.vy;
            shootingStar.life += 1;

            const t = shootingStar.life / shootingStar.maxLife;
            const alpha = Math.max(0, 0.92 * (1 - t));
            const tailX = shootingStar.x - shootingStar.vx * 9;
            const tailY = shootingStar.y - shootingStar.vy * 9;

            const gradient = ctx.createLinearGradient(shootingStar.x, shootingStar.y, tailX, tailY);
            gradient.addColorStop(0, `rgba(255, 255, 255, ${alpha})`);
            gradient.addColorStop(1, 'rgba(255, 255, 255, 0)');

            ctx.strokeStyle = gradient;
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.moveTo(shootingStar.x, shootingStar.y);
            ctx.lineTo(tailX, tailY);
            ctx.stroke();

            if (
              shootingStar.life >= shootingStar.maxLife ||
              shootingStar.x < -240 ||
              shootingStar.x > width + 240 ||
              shootingStar.y > height + 120
            ) {
              shootingStars.splice(i, 1);
            }
          }
        }

        if (!prefersReducedMotion) requestAnimationFrame(draw);
      };

      resize();
      seed();
      draw();
      nextShootingStarAt = performance.now() + 2600;
      window.addEventListener('resize', resize);
    };

    initStarfield('home-stars', { count: 96, drift: 0.01 });
  })();

  (() => {
    const rails = Array.from(document.querySelectorAll('[data-home-edge-rail]'));
    if (!rails.length) return;

    const syncEdgeRailWidths = () => {
      rails.forEach((rail) => {
        if (!(rail instanceof HTMLElement)) return;
        const left = Math.max(0, rail.getBoundingClientRect().left);
        rail.style.setProperty('--home-rail-viewport-width', `${Math.max(0, window.innerWidth - left)}px`);
      });
    };

    syncEdgeRailWidths();
    window.addEventListener('resize', syncEdgeRailWidths);
  })();

  (() => {
    const header = document.querySelector('.home-header');
    if (!(header instanceof HTMLElement)) return;
    const menuButton = header.querySelector('.home-menu-toggle');
    const mobileNav = header.querySelector('.home-mobile-nav');

    let frame = 0;

    const updateHeader = () => {
      frame = 0;
      header.classList.toggle('is-scrolled', window.scrollY > 120);
    };

    const scheduleHeaderUpdate = () => {
      if (frame) return;
      frame = window.requestAnimationFrame(updateHeader);
    };

    updateHeader();
    window.addEventListener('scroll', scheduleHeaderUpdate, { passive: true });
    window.addEventListener('resize', scheduleHeaderUpdate);

    if (!(menuButton instanceof HTMLButtonElement) || !(mobileNav instanceof HTMLElement)) return;

    const setMenuOpen = (isOpen) => {
      header.classList.toggle('is-menu-open', isOpen);
      menuButton.setAttribute('aria-expanded', String(isOpen));
      mobileNav.setAttribute('aria-hidden', String(!isOpen));
      mobileNav.inert = !isOpen;
    };

    menuButton.addEventListener('click', () => {
      setMenuOpen(!header.classList.contains('is-menu-open'));
    });

    mobileNav.addEventListener('click', (event) => {
      if (event.target instanceof HTMLAnchorElement) setMenuOpen(false);
    });

    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setMenuOpen(false);
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth > 768) setMenuOpen(false);
    });
  })();

  (() => {
    const sections = Array.from(document.querySelectorAll('[data-home-reveal]'));
    const lateSections = Array.from(document.querySelectorAll('[data-home-reveal-late]'));
    if (!sections.length && !lateSections.length) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      sections.forEach((section) => section.classList.add('is-visible'));
      lateSections.forEach((section) => section.classList.add('is-visible'));
      return;
    }

    const standardObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          standardObserver.unobserve(entry.target);
        });
      },
      {
        threshold: 0.12,
        rootMargin: '0px 0px -16% 0px'
      }
    );

    const lateObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          lateObserver.unobserve(entry.target);
        });
      },
      {
        threshold: 0.5,
        rootMargin: '0px 0px -12% 0px'
      }
    );

    sections.forEach((section) => standardObserver.observe(section));
    lateSections.forEach((section) => lateObserver.observe(section));
  })();

  (() => {
    const mobileQuery = window.matchMedia('(max-width: 48rem)');
    if (!mobileQuery.matches) return;

    const targets = Array.from(document.querySelectorAll('[data-mobile-reveal]'));
    if (!targets.length) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion || !('IntersectionObserver' in window)) {
      targets.forEach((target) => target.classList.add('is-mobile-visible'));
      return;
    }

    targets.forEach((target) => target.classList.add('is-mobile-motion-pending'));

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-mobile-visible');
          observer.unobserve(entry.target);
        });
      },
      {
        threshold: 0.08,
        rootMargin: '0px 0px -8% 0px'
      }
    );

    // Give mobile Safari a painted starting frame before any visible target resolves.
    window.requestAnimationFrame(() => {
      window.requestAnimationFrame(() => {
        targets.forEach((target) => observer.observe(target));
      });
    });
  })();

  (() => {
    const assemblies = Array.from(document.querySelectorAll('[data-scroll-assembly]'));
    if (!assemblies.length) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) return;

    const clamp = (value, minimum, maximum) => Math.min(Math.max(value, minimum), maximum);
    const smoothstep = (value) => value * value * (3 - 2 * value);
    let animationFrame = 0;
    let needsMeasurement = true;
    let assemblyLayouts = [];

    const getTrajectory = (item, travelX, travelY) => {
      if (item.classList.contains('scroll-assembly-item--drop-in')) {
        return { x: 0, y: -travelY * 1.15, rotation: 0, scaleDelta: 0.14 };
      }

      if (item.classList.contains('scroll-assembly-item--from-lower-left')) {
        return { x: -travelX, y: travelY, rotation: -2, scaleDelta: 0.03 };
      }

      if (item.classList.contains('scroll-assembly-item--from-upper-right')) {
        return { x: travelX, y: -travelY * 0.9, rotation: 2, scaleDelta: 0.03 };
      }

      if (item.classList.contains('scroll-assembly-item--from-lower-right')) {
        return { x: travelX, y: travelY, rotation: -2, scaleDelta: 0.03 };
      }

      return { x: 0, y: travelY * 0.75, rotation: 0.5, scaleDelta: 0.025 };
    };

    const measureAssemblies = () => {
      assemblies.forEach((assembly) => {
        assembly.classList.add('is-scroll-assembly-measuring');
        assembly.classList.remove('is-scroll-assembly-ready');
      });

      assemblyLayouts = assemblies.map((assembly) => {
        const assemblyRect = assembly.getBoundingClientRect();
        const items = Array.from(assembly.querySelectorAll('.scroll-assembly-item'));

        return {
          assembly,
          assemblyWidth: assemblyRect.width,
          items: items.map((item, index) => {
            const itemRect = item.getBoundingClientRect();

            return {
              item,
              index,
              layoutTop: itemRect.top - assemblyRect.top,
              layoutLeft: itemRect.left - assemblyRect.left,
              width: itemRect.width
            };
          })
        };
      });

      assemblies.forEach((assembly) => assembly.classList.remove('is-scroll-assembly-measuring'));

      needsMeasurement = false;
    };

    const updateAssemblies = () => {
      animationFrame = 0;
      if (needsMeasurement) measureAssemblies();

      const viewportHeight = window.innerHeight;
      const viewportWidth = window.innerWidth;
      const travelX = viewportWidth * 1.05;
      const travelY = Math.min(viewportHeight * 0.22, 224);

      assemblyLayouts.forEach(({ assembly, assemblyWidth, items }) => {
        const scene = assembly.dataset.scrollAssemblyDriver === 'scene'
          ? assembly.closest('[data-scroll-assembly-scene]')
          : null;
        const sceneIsActive = Boolean(scene && viewportWidth > 1024 && viewportHeight >= 704);
        scene?.classList.toggle('is-scroll-assembly-scene-ready', sceneIsActive);
        const entryRatio = Number(assembly.dataset.scrollAssemblyEntry ?? 1.55);
        const settleRatio = Number(assembly.dataset.scrollAssemblySettle ?? 0.15);
        const entryLine = viewportHeight * (Number.isFinite(entryRatio) ? entryRatio : 1.55);
        const settleLine = viewportHeight * (Number.isFinite(settleRatio) ? settleRatio : 0.15);
        const progressRange = Math.max(entryLine - settleLine, viewportHeight * 0.5);
        const assemblyTop = assembly.getBoundingClientRect().top;
        const clusterRequested = assembly.dataset.scrollAssemblyMode === 'cluster';
        const spreadRequested = assembly.dataset.scrollAssemblyMode === 'spread';
        const isClusterAssembly = clusterRequested && viewportWidth > 1024;
        const isSpreadAssembly = spreadRequested && viewportWidth > 1024;
        const clusterMotionIsActive = isClusterAssembly && (!scene || sceneIsActive);
        let sceneProgress = 1;

        if (scene && sceneIsActive) {
          const sceneStart = Number(assembly.dataset.scrollAssemblySceneStart ?? 0.06);
          const sceneEnd = Number(assembly.dataset.scrollAssemblySceneEnd ?? 0.62);
          const start = Number.isFinite(sceneStart) ? sceneStart : 0.06;
          const end = Math.max(Number.isFinite(sceneEnd) ? sceneEnd : 0.62, start + 0.1);
          const sceneRect = scene.getBoundingClientRect();
          const sceneTravel = Math.max(scene.offsetHeight - viewportHeight, 1);
          const timelineProgress = clamp(-sceneRect.top / sceneTravel, 0, 1);

          sceneProgress = clamp((timelineProgress - start) / (end - start), 0, 1);
        }

        items.forEach(({ item, index, layoutTop, layoutLeft, width }) => {
          const finalTop = assemblyTop + (isClusterAssembly ? 0 : layoutTop);
          const stagger = (isClusterAssembly || isSpreadAssembly) ? 0 : index * 0.03;
          const rawProgress = scene
            ? sceneProgress
            : clamp((entryLine - finalTop) / progressRange, 0, 1);
          const staggeredProgress = clamp((rawProgress - stagger) / (1 - stagger), 0, 1);
          const specializedMotionIsInactive =
            (clusterRequested && !clusterMotionIsActive) ||
            (spreadRequested && !isSpreadAssembly);
          const progress = specializedMotionIsInactive
            ? 1
            : smoothstep(staggeredProgress);
          const remaining = 1 - progress;
          const trajectory = isClusterAssembly
            ? {
                x: assemblyWidth / 2 - (layoutLeft + width / 2),
                y: -layoutTop,
                rotation: [0, -1.8, 1.6][index] ?? 0,
                scaleDelta: 0.015
              }
            : isSpreadAssembly
              ? {
                  x: assemblyWidth / 2 - (layoutLeft + width / 2) + (index === 0 ? -24 : 24),
                  y: 112 + index * 18,
                  rotation: index === 0 ? -2.4 : 2.4,
                  scaleDelta: 0.08
                }
              : getTrajectory(item, travelX, travelY);
          const copyProgress = isSpreadAssembly
            ? smoothstep(clamp((staggeredProgress - 0.48) / 0.52, 0, 1))
            : 1;

          item.style.setProperty('--scroll-assembly-x', `${trajectory.x * remaining}px`);
          item.style.setProperty('--scroll-assembly-y', `${trajectory.y * remaining}px`);
          item.style.setProperty('--scroll-assembly-rotation', `${trajectory.rotation * remaining}deg`);
          item.style.setProperty('--scroll-assembly-scale', String(1 - trajectory.scaleDelta * remaining));
          item.style.setProperty(
            '--scroll-assembly-opacity',
            String((isClusterAssembly || isSpreadAssembly) ? 0.78 + progress * 0.22 : 0.28 + progress * 0.72)
          );
          item.style.setProperty(
            '--scroll-assembly-blur',
            `${(isClusterAssembly || isSpreadAssembly) ? 0 : 3 * remaining}px`
          );
          item.style.setProperty(
            '--scroll-assembly-image-scale',
            String(isClusterAssembly ? 1 : 1 + (isSpreadAssembly ? 0.08 : 0.04) * remaining)
          );
          item.style.setProperty('--scroll-assembly-copy-opacity', String(copyProgress));
          item.style.setProperty('--scroll-assembly-copy-y', `${24 * (1 - copyProgress)}px`);
          item.style.zIndex = isSpreadAssembly ? String(items.length - index) : '';
        });

        assembly.classList.add('is-scroll-assembly-ready');
      });
    };

    const scheduleAssemblyUpdate = () => {
      if (animationFrame) return;
      animationFrame = window.requestAnimationFrame(updateAssemblies);
    };

    updateAssemblies();
    window.addEventListener('scroll', scheduleAssemblyUpdate, { passive: true });
    window.addEventListener('resize', () => {
      needsMeasurement = true;
      scheduleAssemblyUpdate();
    });

    document.fonts?.ready.then(() => {
      needsMeasurement = true;
      scheduleAssemblyUpdate();
    });
  })();

  (() => {
    const rows = Array.from(document.querySelectorAll('.home-fit-row'));
    if (!rows.length) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const closeRow = (row) => {
      const summary = row.querySelector('summary');
      const answer = row.querySelector('.home-fit-row-answer');
      if (!answer || !row.open) return;

      window.cancelAnimationFrame(row._fitAnimationFrame ?? 0);
      if (row._fitTransitionEndHandler) {
        answer.removeEventListener('transitionend', row._fitTransitionEndHandler);
      }

      if (prefersReducedMotion) {
        row.open = false;
        row.classList.remove('is-open', 'is-animating');
        answer.style.height = '';
        return;
      }

      row.classList.add('is-animating');
      answer.style.height = `${answer.scrollHeight}px`;
      row.classList.remove('is-open');

      row._fitAnimationFrame = window.requestAnimationFrame(() => {
        answer.style.height = '0px';
      });

      row._fitTransitionEndHandler = (event) => {
        if (event.propertyName !== 'height') return;
        answer.removeEventListener('transitionend', row._fitTransitionEndHandler);
        row._fitTransitionEndHandler = null;
        row.open = false;
        row.classList.remove('is-animating');
        answer.style.height = '';
      };
      answer.addEventListener('transitionend', row._fitTransitionEndHandler);
    };

    const openRow = (row) => {
      const answer = row.querySelector('.home-fit-row-answer');
      if (!answer || row.open) return;

      window.cancelAnimationFrame(row._fitAnimationFrame ?? 0);
      if (row._fitTransitionEndHandler) {
        answer.removeEventListener('transitionend', row._fitTransitionEndHandler);
      }

      row.open = true;

      if (prefersReducedMotion) {
        row.classList.add('is-open');
        answer.style.height = '';
        return;
      }

      row.classList.add('is-animating');
      answer.style.height = '0px';

      row._fitAnimationFrame = window.requestAnimationFrame(() => {
        row.classList.add('is-open');
        answer.style.height = `${answer.scrollHeight}px`;
      });

      row._fitTransitionEndHandler = (event) => {
        if (event.propertyName !== 'height') return;
        answer.removeEventListener('transitionend', row._fitTransitionEndHandler);
        row._fitTransitionEndHandler = null;
        row.classList.remove('is-animating');
        answer.style.height = 'auto';
      };
      answer.addEventListener('transitionend', row._fitTransitionEndHandler);
    };

    rows.forEach((row) => {
      const summary = row.querySelector('summary');
      const answer = row.querySelector('.home-fit-row-answer');
      if (!summary || !answer) return;

      if (row.open) {
        row.classList.add('is-open');
        answer.style.height = 'auto';
      }

      summary.addEventListener('click', (event) => {
        event.preventDefault();

        if (row.open) {
          closeRow(row);
          return;
        }

        rows.forEach((otherRow) => {
          if (otherRow !== row) closeRow(otherRow);
        });
        openRow(row);
      });
    });

  })();
</script>

<script is:inline>
  (() => {
    const assembly = document.querySelector('[data-focus-assembly]');
    const stage = assembly?.querySelector('[data-focus-stage]');
    const stack = stage?.querySelector('.portfolio-focus-stack');
    const section = assembly?.closest('.portfolio-focus');
    const heading = section?.querySelector('.portfolio-focus-head');
    const cards = stage ? Array.from(stage.querySelectorAll('.portfolio-focus-card-slot')) : [];
    if (!assembly || !stage || !stack || !(section instanceof HTMLElement) || !(heading instanceof HTMLElement) || !cards.length) return;

    const desktopMotionQuery = window.matchMedia('(min-width: 64.0625rem) and (min-height: 44rem)');
    const mobileDeckQuery = window.matchMedia('(max-width: 48rem)');
    const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    let frame = 0;

    const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

    const reset = () => {
      assembly.classList.remove('is-focus-motion-ready', 'is-focus-settled', 'is-focus-mobile-fan-ready');
      assembly.style.removeProperty('--focus-mobile-card-height');
      assembly.style.removeProperty('--focus-mobile-pin-top');
      assembly.style.removeProperty('--focus-mobile-scroll-height');
      cards.forEach((card) => {
        card.style.removeProperty('--focus-width');
        card.style.removeProperty('--focus-opacity');
        card.style.removeProperty('--focus-deck-x');
        card.style.removeProperty('--focus-deck-y');
        card.style.removeProperty('--focus-deck-rotation');
        card.style.removeProperty('--focus-deck-scale');
      });
    };

    const update = () => {
      frame = 0;
      const firstCardTop = cards[0].getBoundingClientRect().top;
      section.classList.toggle('is-focus-surface-light', firstCardTop <= window.innerHeight);

      if (reducedMotionQuery.matches) {
        reset();
        return;
      }

      if (mobileDeckQuery.matches) {
        assembly.classList.remove('is-focus-motion-ready', 'is-focus-settled');
        assembly.classList.add('is-focus-mobile-fan-ready');

        const viewportHeight = window.innerHeight;
        const cardHeight = cards[0].offsetHeight;
        const cardGap = 10;
        const cardStep = cardHeight + cardGap;
        const pinTop = viewportHeight - (cardHeight * 0.55);
        const releaseDistance = cardStep * (cards.length - 1);
        const assemblyTop = assembly.getBoundingClientRect().top;
        const scrollDistance = clamp(pinTop - assemblyTop, 0, releaseDistance);
        const stageReleaseDistance = Math.max(0, pinTop - stage.getBoundingClientRect().top);

        assembly.style.setProperty('--focus-mobile-card-height', `${cardHeight}px`);
        assembly.style.setProperty('--focus-mobile-pin-top', `${pinTop}px`);
        assembly.style.setProperty('--focus-mobile-scroll-height', `${cardHeight + releaseDistance}px`);

        cards.forEach((card, index) => {
          const releasedDistance = Math.max(0, scrollDistance - (index * cardStep));
          const isFrontCard = index === cards.length - 1;
          const straightenDistance = isFrontCard ? stageReleaseDistance : releasedDistance;
          const straightenProgress = clamp(straightenDistance / (cardHeight * 0.28), 0, 1);
          const easedStraighten = 1 - Math.pow(1 - straightenProgress, 3);
          const fanRemaining = 1 - easedStraighten;
          const fanOffset = index - ((cards.length - 1) / 2);
          const x = fanOffset * 7 * fanRemaining;
          const y = (index * 5 * fanRemaining) - releasedDistance;
          const rotation = fanOffset * 1.8 * fanRemaining;
          const scale = 1 - (index * 0.006 * fanRemaining);

          card.style.setProperty('--focus-deck-x', `${x}px`);
          card.style.setProperty('--focus-deck-y', `${y}px`);
          card.style.setProperty('--focus-deck-rotation', `${rotation}deg`);
          card.style.setProperty('--focus-deck-scale', String(scale));
          card.style.setProperty('--focus-opacity', '1');
          card.style.removeProperty('--focus-width');
        });

        return;
      }

      if (!desktopMotionQuery.matches) {
        reset();
        return;
      }

      assembly.classList.remove('is-focus-mobile-fan-ready');
      assembly.style.removeProperty('--focus-mobile-card-height');
      assembly.style.removeProperty('--focus-mobile-pin-top');
      assembly.style.removeProperty('--focus-mobile-scroll-height');
      assembly.classList.add('is-focus-motion-ready');
      const stackRect = stack.getBoundingClientRect();
      const viewportHeight = window.innerHeight;
      const finalWidth = heading.clientWidth;
      const entryWidth = Math.min(window.innerWidth * 0.9, stack.clientWidth);
      let allSettled = true;

      cards.forEach((card) => {
        const startLine = viewportHeight * 0.96;
        const endLine = viewportHeight * 0.42;
        const naturalTop = stackRect.top + card.offsetTop;
        const progress = clamp((startLine - naturalTop) / (startLine - endLine), 0, 1);
        const easedProgress = 1 - Math.pow(1 - progress, 3);
        const width = entryWidth + (finalWidth - entryWidth) * easedProgress;

        if (progress < 1) allSettled = false;

        card.style.setProperty('--focus-width', `${width}px`);
        card.style.setProperty('--focus-opacity', String(0.72 + easedProgress * 0.28));
      });

      assembly.classList.toggle('is-focus-settled', allSettled);
    };

    const schedule = () => {
      if (frame) return;
      frame = window.requestAnimationFrame(update);
    };

    frame = window.requestAnimationFrame(update);
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    desktopMotionQuery.addEventListener?.('change', schedule);
    mobileDeckQuery.addEventListener?.('change', schedule);
    reducedMotionQuery.addEventListener?.('change', schedule);
    document.fonts?.ready.then(schedule);
  })();
</script>


  /* Study 01: full-size outcome cards form a vertical stack and enter from the left. */
  .portfolio-outcome-study {
    --portfolio-outcome-index-width: clamp(14rem, 16vw, 18rem);
    --portfolio-outcome-column-gap: clamp(1.5rem, 3vw, 3rem);

      justify-content: space-between;
      gap: 0.65rem;
      padding: var(--home-nav-padding);
      border: 1px solid transparent;
      border-radius: 0;
      background: transparent;
      box-shadow: none;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }

    .home-header.is-menu-open .home-nav {
      border-radius: 1rem;
      border-color: rgba(231, 235, 242, 0.1);
      background: rgba(var(--home-surface-panel-rgb), 0.86);
      box-shadow:
        inset 0 0 0 1px rgba(255, 255, 255, 0.025),
        0 0.55rem 1.4rem rgba(0, 0, 0, 0.16);
      backdrop-filter: blur(16px) saturate(1.06);
      -webkit-backdrop-filter: blur(16px) saturate(1.06);
    }

    .home-header.is-scrolled .home-nav {
      padding: 0.6rem 0.72rem;
      border-radius: 1rem;
      border-color: rgba(231, 235, 242, 0.08);
      background: rgba(var(--home-surface-panel-rgb), 0.82);
      box-shadow:
        inset 0 0 0 1px rgba(255, 255, 255, 0.025),
        0 0.55rem 1.4rem rgba(0, 0, 0, 0.16);
      backdrop-filter: blur(16px) saturate(1.06);
      -webkit-backdrop-filter: blur(16px) saturate(1.06);
    }

    .home-nav-links {
      display: none;
    }

    .home-brand {

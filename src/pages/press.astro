  /* Portfolio layout studies share one calm, keyboard-accessible stage behavior. */
  .home--portfolio .portfolio-study {
    position: relative;
    isolation: isolate;
  }

  .home--portfolio .portfolio-study--light {
    --home-text: var(--portfolio-light-ink);

const createActorMailto = (actor: string, prompt: string) => {
  const params = new URLSearchParams();
  params.set('subject', `[${actor}] Advisory inquiry`);
  params.set('body', `Hi Dan,\n\nI'm reaching out as ${prompt} and would like to talk about design leadership support.\n\nContext:\n- Team/company:\n- What we're navigating:\n- What kind of support we need:\n\nThanks,`);
  return `mailto:hello@danmalarkey.com?${params.toString()}`;
};


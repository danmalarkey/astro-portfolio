      transform 420ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .home-fit-row-answer > p {
    overflow: visible;
  }

  .home-fit-row.is-open .home-fit-row-answer {
    opacity: 1;
    transform: translateY(0);
  }

  .home-shift-head {
    display: grid;
    gap: var(--spacing-sm);
    max-width: 54rem;
    margin-bottom: var(--home-section-gap);
  }

  .home-shift-head h2 {
    max-width: 34ch;
    color: rgba(244, 247, 255, 0.96);
    text-wrap: balance;
  }

  .home-shift-head p:not(.home-section-label) {
    max-width: 46rem;
    margin: 0;
    color: rgba(231, 235, 242, 0.68);
    font-size: var(--home-type-body);
    line-height: var(--home-line-body);
  }

  .home-shift-cards {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-auto-rows: minmax(12rem, auto);
    gap: var(--home-panel-gap);
    align-items: stretch;
  }

  .home-shift-card {
    position: relative;
    isolation: isolate;
    display: grid;
    align-content: end;
    min-height: 12rem;
    padding: clamp(1.1rem, 1.55vw, 1.4rem);
    border: 1px solid transparent;
    border-radius: var(--radius-card);
    background:
      linear-gradient(152deg, rgba(255, 255, 255, 0.035), rgba(255, 255, 255, 0.012) 42%, rgba(255, 255, 255, 0.02)) padding-box,
      linear-gradient(180deg, rgba(9, 16, 30, 0.98), rgba(var(--home-surface-panel-rgb), 0.98)) padding-box,
      linear-gradient(138deg, rgba(231, 235, 242, 0.2), rgba(143, 126, 210, 0.12) 32%, rgba(231, 235, 242, 0.055) 74%) border-box;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.035),
      0 1rem 2.2rem rgba(0, 0, 0, 0.14);
    overflow: hidden;
  }

  .home-shift-card::before,
  .home-shift-card::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .home-shift-card::before {
    z-index: 0;
    background:
      radial-gradient(ellipse 28rem 14rem at 12% 6%, rgba(171, 154, 225, 0.095), rgba(171, 154, 225, 0) 58%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.012), rgba(255, 255, 255, 0));
    opacity: 1;
  }

  .home-shift-card::after {
    z-index: 2;
    border: 1px solid transparent;
    border-radius: inherit;
    background:
      linear-gradient(135deg, rgba(231, 235, 242, 0.22), rgba(167, 151, 222, 0.1) 28%, rgba(231, 235, 242, 0.035) 68%) border-box;
    -webkit-mask:
      linear-gradient(#000 0 0) padding-box,
      linear-gradient(#000 0 0);
    mask:
      linear-gradient(#000 0 0) padding-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.025);
  }

  .home-shift-card--1 {
    grid-column: span 3;
    min-height: 16rem;
  }

  .home-shift-card--2 {
    grid-column: span 3;
    min-height: 16rem;
    background:
      linear-gradient(152deg, rgba(167, 151, 222, 0.052), rgba(255, 255, 255, 0.012) 42%, rgba(255, 255, 255, 0.018)) padding-box,
      linear-gradient(180deg, rgba(9, 16, 30, 0.98), rgba(var(--home-surface-panel-rgb), 0.98)) padding-box,
      linear-gradient(138deg, rgba(231, 235, 242, 0.18), rgba(143, 126, 210, 0.12) 32%, rgba(231, 235, 242, 0.055) 74%) border-box;
  }

  .home-shift-card--3,
  .home-shift-card--4,
  .home-shift-card--5 {
    grid-column: span 2;
  }

  .home-shift-card--3 {
    background:
      linear-gradient(32deg, rgba(167, 151, 222, 0.05), rgba(255, 255, 255, 0.012) 48%, rgba(255, 255, 255, 0.018)) padding-box,
      linear-gradient(180deg, rgba(9, 16, 30, 0.98), rgba(var(--home-surface-panel-rgb), 0.98)) padding-box,
      linear-gradient(138deg, rgba(231, 235, 242, 0.16), rgba(143, 126, 210, 0.105) 32%, rgba(231, 235, 242, 0.055) 74%) border-box;
  }

  .home-shift-card--4 {
    background:
      linear-gradient(152deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0.012) 42%, rgba(91, 107, 154, 0.05)) padding-box,
      linear-gradient(180deg, rgba(9, 16, 30, 0.98), rgba(var(--home-surface-panel-rgb), 0.98)) padding-box,
      linear-gradient(138deg, rgba(231, 235, 242, 0.16), rgba(143, 126, 210, 0.105) 32%, rgba(231, 235, 242, 0.055) 74%) border-box;
  }

  .home-shift-card--5 {
    background:
      linear-gradient(205deg, rgba(167, 151, 222, 0.055), rgba(255, 255, 255, 0.012) 42%, rgba(255, 255, 255, 0.018)) padding-box,
      linear-gradient(180deg, rgba(9, 16, 30, 0.98), rgba(var(--home-surface-panel-rgb), 0.98)) padding-box,
      linear-gradient(138deg, rgba(231, 235, 242, 0.16), rgba(143, 126, 210, 0.105) 32%, rgba(231, 235, 242, 0.055) 74%) border-box;
  }

  .home-shift-card-copy {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 0.72rem;
    max-width: 38rem;
  }

  .home-shift-card h3,
  .home-fit-row h3 {
    margin: 0;
    color: rgba(244, 247, 255, 0.94);
    font-size: var(--home-type-card-title-compact);
    font-weight: var(--font-weight-regular);
    line-height: var(--home-line-section-title-compact);
    letter-spacing: var(--home-tracking-card);
    text-wrap: balance;
  }

  .home-fit-row h3 {
    color: inherit;
    font-size: var(--home-type-title-sm);
    line-height: var(--home-line-title);
  }

  .home-shift-card-label {
    margin: 0;
    color: rgba(231, 235, 242, 0.48);
    font-size: var(--home-type-label-compact);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--home-tracking-label);
    line-height: var(--home-line-label);
  }

  .home-shift-card p:not(.home-shift-card-label),
  .home-fit-row p {
    max-width: 56ch;
    margin: 0.25rem 0 0;
    color: rgba(231, 235, 242, 0.62);
    font-size: var(--home-type-body);
    line-height: var(--home-line-body);
    letter-spacing: var(--home-tracking-text);
    text-wrap: pretty;
  }

  .home-fit-row p {
    max-width: 64ch;
    margin: 0;
    padding: 0 var(--spacing-3xl) var(--spacing-xl) 0;
  }

  .home-operating-shift-layout {
    align-items: center;
    row-gap: 1.65rem;
  }

  .home-operating-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    align-items: start;
  }

  .home-operating-grid-item {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--spacing-sm);
    min-height: clamp(14.25rem, 17vw, 17.5rem);
    padding: 0 clamp(1.75rem, 2.2vw, 2.6rem) 0 clamp(1.35rem, 1.7vw, 1.9rem);
    border-left: 1px solid rgba(231, 235, 242, 0.065);
  }

  .home-operating-grid-item:last-child {
    padding-right: 0;
  }

  .home-operating-grid-index {
    margin: 0;
    color: rgba(231, 235, 242, 0.36);
    font-size: var(--home-type-label-compact);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--home-tracking-label);
    line-height: var(--home-line-label);
  }

  .home-operating-grid-copy {
    display: grid;
    gap: 0.72rem;
    margin-top: auto;
    padding-bottom: 0.15rem;
  }

  .home-operating-grid-title span {
    display: block;
  }

  .home-operating-grid-text {
    margin: 0;
    color: rgba(231, 235, 242, 0.7);
    font-size: var(--home-type-body-xs);
    line-height: var(--home-line-body-compact);
    text-wrap: pretty;
  }

  .home-writing--editorial {
    position: relative;
    width: 100%;
    max-width: none;
    margin: 0;
    overflow: hidden;
  }

  .home-writing--editorial .home-section-label,
  .home-writing--editorial .home-card-meta-text {
    color: rgba(231, 235, 242, 0.56);
  }

  .home-writing--editorial .home-writing-head h2,
  .home-writing--editorial .home-writing-head p:not(.home-section-label) {
    color: var(--home-text);
  }

  .home-writing-head {
    display: grid;
    gap: var(--home-section-eyebrow-gap);
    max-width: 44rem;
  }

  .home-writing-rail-wrap {
    position: relative;
    z-index: 1;
    margin-top: 0;
  }

  .home-writing-rail {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(20rem, 24vw);
    gap: var(--spacing-md);
    overflow-x: auto;
    overflow-y: visible;
    width: var(--home-rail-viewport-width, 100%);
    overscroll-behavior-x: contain;
    padding: 0 0 0.25rem;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
  }

  .home-writing-rail::-webkit-scrollbar {
    display: none;
  }

  .home-writing-volume {
    position: relative;
    isolation: isolate;
    min-height: 24rem;
    border-radius: var(--radius-card);
    border: 1px solid rgba(231, 235, 242, 0.1);
    background:
      linear-gradient(180deg, rgba(20, 22, 30, 0.3), rgba(6, 7, 11, 0.34)),
      var(--home-surface-deep);
    color: var(--home-text);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      inset 0 -1px 0 rgba(255, 255, 255, 0.03),
      0 1.1rem 2.4rem rgba(0, 0, 0, 0.24);
    overflow: hidden;
    scroll-snap-align: start;
  }

  .home-writing-volume-link {
    position: relative;
    z-index: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    min-height: inherit;
    padding: 1.45rem;
    color: inherit;
    text-decoration: none;
  }

  .home-writing-volume-link:focus-visible {
    outline: 2px solid rgba(231, 235, 242, 0.5);
    outline-offset: -0.45rem;
  }

  .home-writing-volume::after {
    content: '';
    position: absolute;
    left: 1px;
    right: 1px;
    bottom: 0;
    z-index: 5;
    height: 1px;
    border-radius: 999px;
    pointer-events: none;
    background:
      linear-gradient(90deg, transparent, rgba(231, 235, 242, 0.16) 14%, rgba(255, 255, 255, 0.62) 48%, rgba(139, 164, 255, 0.26) 72%, transparent);
    box-shadow:
      0 -0.5rem 1.2rem rgba(231, 235, 242, 0.055),
      0 0 1rem rgba(105, 133, 255, 0.06);
    opacity: 0.74;
  }

  .home-writing-volume-art {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    opacity: 0.96;
    transform: scale(1);
    transform-origin: center bottom;
  }

  .home-writing-volume-art::before,
  .home-writing-volume-art::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .home-writing-volume-art::after {
    background:
      conic-gradient(from 210deg at 56% 76%, rgba(111, 87, 255, 0), rgba(111, 87, 255, 0.48), rgba(96, 136, 255, 0.38), rgba(236, 202, 128, 0.22), rgba(111, 87, 255, 0)),
      radial-gradient(ellipse at 34% 48%, rgba(214, 177, 138, 0.26), rgba(214, 177, 138, 0) 26%),
      radial-gradient(ellipse at 76% 38%, rgba(118, 138, 255, 0.34), rgba(118, 138, 255, 0) 32%),
      linear-gradient(42deg, transparent 0 42%, rgba(255, 255, 255, 0.12) 46%, transparent 53%),
      radial-gradient(circle at 55% 78%, rgba(255, 255, 255, 0.1), transparent 24%),
      linear-gradient(160deg, rgba(35, 34, 70, 0.88), rgba(8, 8, 16, 0.98));
    filter: blur(0.12rem);
    opacity: 0;
  }

  .home-writing-volume--quiet .home-writing-volume-art,
  .home-writing-volume--quiet-violet .home-writing-volume-art,
  .home-writing-volume--quiet-blue .home-writing-volume-art,
  .home-writing-volume--quiet-ink .home-writing-volume-art {
    opacity: 0.5;
    background:
      radial-gradient(circle at 84% 22%, rgba(231, 235, 242, 0.045), transparent 14rem),
      linear-gradient(145deg, rgba(255, 255, 255, 0.018), rgba(255, 255, 255, 0) 42%);
  }

  .home-writing-volume--quiet-violet .home-writing-volume-art {
    background:
      radial-gradient(circle at 72% 38%, rgba(119, 105, 214, 0.16), transparent 16rem),
      linear-gradient(145deg, rgba(70, 61, 132, 0.08), rgba(255, 255, 255, 0) 46%);
  }

  .home-writing-volume--quiet-blue .home-writing-volume-art {
    background:
      radial-gradient(circle at 82% 28%, rgba(90, 154, 196, 0.14), transparent 16rem),
      linear-gradient(145deg, rgba(45, 69, 96, 0.09), rgba(255, 255, 255, 0) 46%);
  }

  .home-writing-volume--quiet-ink .home-writing-volume-art {
    background:
      radial-gradient(circle at 30% 74%, rgba(231, 235, 242, 0.055), transparent 14rem),
      linear-gradient(145deg, rgba(255, 255, 255, 0.02), rgba(255, 255, 255, 0) 46%);
  }

  .home-writing-volume--quiet .home-writing-volume-art::before,
  .home-writing-volume--quiet-violet .home-writing-volume-art::before,
  .home-writing-volume--quiet-blue .home-writing-volume-art::before,
  .home-writing-volume--quiet-ink .home-writing-volume-art::before {
    background: none;
  }

  .home-writing-volume--gradient-warm .home-writing-volume-art {
    background:
      conic-gradient(from 210deg at 56% 76%, rgba(111, 87, 255, 0), rgba(111, 87, 255, 0.48), rgba(96, 136, 255, 0.38), rgba(236, 202, 128, 0.22), rgba(111, 87, 255, 0)),
      radial-gradient(ellipse at 34% 48%, rgba(214, 177, 138, 0.26), rgba(214, 177, 138, 0) 26%),
      radial-gradient(ellipse at 76% 38%, rgba(118, 138, 255, 0.34), rgba(118, 138, 255, 0) 32%),
      linear-gradient(160deg, rgba(35, 34, 70, 0.88), rgba(8, 8, 16, 0.98));
  }

  .home-writing-volume--gradient-warm .home-writing-volume-art::before {
    background:
      linear-gradient(42deg, transparent 0 42%, rgba(255, 255, 255, 0.12) 46%, transparent 53%),
      radial-gradient(circle at 55% 78%, rgba(255, 255, 255, 0.1), transparent 24%);
    filter: blur(0.55rem);
  }

  .home-writing-volume--gradient-cool .home-writing-volume-art {
    background:
      conic-gradient(from 32deg at 66% 70%, rgba(112, 218, 255, 0), rgba(112, 218, 255, 0.32), rgba(82, 102, 255, 0.42), rgba(55, 76, 120, 0.12), rgba(112, 218, 255, 0)),
      radial-gradient(ellipse at 72% 36%, rgba(122, 190, 255, 0.34), rgba(122, 190, 255, 0) 28%),
      radial-gradient(ellipse at 28% 62%, rgba(97, 112, 185, 0.34), rgba(97, 112, 185, 0) 34%),
      linear-gradient(180deg, rgba(24, 39, 55, 0.84), rgba(7, 10, 16, 0.98));
  }

  .home-writing-volume--gradient-cool .home-writing-volume-art::before {
    background:
      linear-gradient(138deg, transparent 0 38%, rgba(255, 255, 255, 0.11) 45%, transparent 54%),
      radial-gradient(circle at 66% 58%, rgba(255, 255, 255, 0.08), transparent 22%);
    filter: blur(0.48rem);
  }

  .home-writing-volume-head {
    position: relative;
    z-index: 4;
    display: grid;
    gap: var(--spacing-xs);
  }

  .home-writing-volume-meta,
  .home-writing-volume-title,
  .home-writing-volume-summary {
    position: relative;
    z-index: 4;
  }

  .home-writing-volume-title {
    max-width: none;
    font-size: var(--home-type-card-title-compact);
    line-height: var(--home-line-title);
    letter-spacing: var(--home-tracking-card);
  }

  .home-writing-volume-summary {
    display: -webkit-box;
    margin: auto 0 0;
    overflow: hidden;
    color: rgba(231, 235, 242, 0.58);
    font-size: var(--home-type-body-xs);
    line-height: var(--home-line-body-compact);
    letter-spacing: var(--home-tracking-text);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    text-overflow: ellipsis;
  }

  @media (hover: hover) and (pointer: fine) {
    .home-writing-volume:hover {
      border-color: rgba(231, 235, 242, 0.2);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.08),
        inset 0 -1px 0 rgba(255, 255, 255, 0.04),
        0 1.4rem 2.8rem rgba(0, 0, 0, 0.28);
    }

    .home-writing-volume:hover .home-writing-volume-art,
    .home-writing-volume:focus-within .home-writing-volume-art {
      opacity: 0.82;
      transform: scale(1.045);
    }

    .home-writing-volume:hover .home-writing-volume-art::after,
    .home-writing-volume:focus-within .home-writing-volume-art::after {
      opacity: 1;
    }

    .home-writing-volume-link:hover .home-writing-volume-title,
    .home-writing-volume-link:focus-visible .home-writing-volume-title {
      color: rgba(255, 255, 255, 1);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .home-writing-volume,
    .home-writing-volume-art,
    .home-writing-volume-art::after,
    .home-writing-volume-title {
      transition:
        border-color 0.22s ease,
        box-shadow 0.22s ease,
        opacity 0.22s ease,
        transform 0.22s ease,
        color 0.22s ease;
    }
  }

  @media (max-width: 64rem) {
    .proof-rail {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: minmax(18rem, 82vw);
      height: 30rem;
      max-height: 30rem;
      overflow-x: auto;
      padding-bottom: var(--spacing-xs);
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .proof-rail::-webkit-scrollbar {
      display: none;
    }

    .proof-rail-item,
    .proof-rail-item.is-active {
      min-height: 30rem;
      scroll-snap-align: start;
    }

    .proof-rail-copy,
    .proof-rail-item.is-active .proof-rail-copy {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .proof-rail-collapsed-label {
      display: none;
    }

    .proof-rail-image {
      filter: saturate(0.88) contrast(0.98) brightness(0.65);
      transform: scale(1.01);
    }

    .proof-rail-item.is-active .proof-rail-image {
      filter: saturate(0.92) contrast(0.98) brightness(0.82);
    }
  }

  @media (max-width: 78rem) {
    .home-trust-grid,
    .home-outcome-grid,
    .home-writing-grid {
      grid-template-columns: 1fr;
    }

    .home-shift-head,
    .home-shift-cards,
    .home-client-trust-shell,
    .home-operating-shift-head,
    .home-operating-grid,
    .home-engagement-availability,
    .home-fit-rows,
    .home-writing-head,
    .home-writing-rail-wrap {
      grid-column: 2 / span 24;
    }

    .home-engagement-availability {
      justify-self: start;
      align-self: start;
      margin: 0.2rem 0 0;
      white-space: normal;
    }

    .home-shift-cards {
      grid-template-columns: minmax(0, 1fr);
    }

    .home-shift-card,
    .home-shift-card--1,
    .home-shift-card--2,
    .home-shift-card--3,
    .home-shift-card--4,
    .home-shift-card--5 {
      grid-column: 1;
      grid-row: auto;
      min-height: 17rem;
    }

    .home-operating-shift-head,
    .home-operating-grid {
      max-width: 48rem;
    }

    .home-operating-shift-head h2 {
      max-width: 15ch;
    }

    .home-operating-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.05rem 2rem;
    }

    .home-operating-grid-item {
      border-left: 0;
      padding-inline: 0;
    }

    .home-writing-layout {
      row-gap: var(--spacing-sm);
    }

    .home-writing-rail {
      grid-auto-columns: minmax(17rem, 21rem);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x proximity;
      scrollbar-width: none;
    }

    .home-needs-panel-grid {
      grid-template-columns: 1fr;
    }

    .home-needs-panel-item,
    .home-needs-panel-item:nth-child(2n) {
      border-right: 0;
    }
  }

  @media (max-width: 48rem) {
    .home {
      padding: 0;
      --home-section-spacing: var(--spacing-3xl);
      --home-shell: min(100% - (var(--home-mobile-section-gutter) * 2), 84rem);
      --home-outer-gap: 0.75rem;
      --home-header-top: var(--home-mobile-page-gutter);
      --home-header-inline: var(--home-outer-gap);
      --home-nav-padding: 0.72rem 0;
      --home-brand-width: 1.22rem;
      --home-brand-width-scrolled: 0.8rem;
      --home-type-body-xs: var(--home-mobile-type-body-sm);
      --home-type-body-sm: var(--home-mobile-type-body);
      --home-type-body: var(--home-mobile-type-body);
      --home-type-lead: var(--home-mobile-type-body);
      --home-type-card-title: var(--home-mobile-type-title-sm);
      --home-type-title-sm: var(--home-mobile-type-title-sm);
      --home-type-title-md: var(--home-mobile-type-title-md);
      --home-type-title-lg: var(--home-mobile-type-title-lg);
      --home-type-title-xl: var(--home-mobile-type-title-xl);
      --home-type-hero: var(--home-mobile-type-title-xl);
      --home-type-section-title-compact: var(--home-mobile-type-title-md);
      --home-section-content-gap: var(--home-mobile-section-content-gap);
    }

    .home > .section > .dm-grid-l.dm-grid-l--grid-sys {
      row-gap: var(--ds-mobile-section-header-gap);
      padding-inline: var(--home-mobile-content-gutter);
    }

    .home > .section > .dm-grid-l.dm-grid-l--grid-sys > * {
      min-width: 0;
    }

    .home > .section :global(.section-header),
    .home > .section :global(.section-header-body) {
      margin-inline: 0;
    }

    .home-intro {
      display: block;
      height: auto;
      min-height: auto;
      padding-top: 0;
      padding-bottom: 0;
    }

    .home-header {
      top: 0;
      padding: 0;
      padding-inline: var(--home-header-inline);
    }

    .home-header-shell {
      width: 100%;
    }

    .home-hero {

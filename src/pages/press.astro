      padding: 0.34rem 0.54rem;
      font-size: var(--home-mobile-type-label-decorative);
      overflow: hidden;
    }

    .home-header-availability > span:last-child {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .home-nav-cta {
      white-space: nowrap;
    }

    .home-menu-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.48rem;
      min-height: 2.25rem;
      margin-left: auto;
      padding: 0 0.72rem;
      border: 1px solid rgba(231, 235, 242, 0.12);
      border-radius: 999rem;
      background: rgba(255, 255, 255, 0.04);
      color: rgba(244, 247, 255, 0.9);
      font: inherit;
      font-size: var(--home-mobile-type-label-decorative);
      font-weight: var(--font-weight-medium);
      line-height: var(--home-line-label);
      letter-spacing: 0;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }

    .home-menu-toggle:focus-visible {
      outline: 1px solid rgba(231, 235, 242, 0.42);
      outline-offset: 0.18rem;
    }

    .home-menu-toggle-icon {
      position: relative;
      width: 0.95rem;
      height: 0.5rem;
    }

    .home-menu-toggle-icon::before,
    .home-menu-toggle-icon::after {
      content: '';
      position: absolute;
      left: 0;
      width: 100%;
      height: 1px;
      border-radius: 999rem;
      background: currentColor;
      transition:
        transform 220ms ease,
        top 220ms ease;
    }

    .home-menu-toggle-icon::before {
      top: 0;
    }

    .home-menu-toggle-icon::after {
      top: 0.5rem;
    }

    .home-header.is-menu-open .home-menu-toggle-icon::before {
      top: 0.25rem;
      transform: rotate(42deg);
    }

    .home-header.is-menu-open .home-menu-toggle-icon::after {
      top: 0.25rem;
      transform: rotate(-42deg);
    }

    .home-mobile-nav {
      display: flex;
      position: fixed;
      inset: 0;
      z-index: 1;
      align-items: stretch;
      justify-content: stretch;
      padding: calc(var(--home-mobile-page-gutter) + 3.25rem) var(--home-header-inline) var(--home-header-inline);
      pointer-events: none;
      opacity: 0;
      background:
        radial-gradient(ellipse at 78% 8%, rgba(105, 133, 255, 0.16), transparent 18rem),
        radial-gradient(ellipse at 12% 92%, rgba(231, 235, 242, 0.08), transparent 16rem),
        rgba(4, 5, 8, 0.56);
      backdrop-filter: blur(0) saturate(1);
      -webkit-backdrop-filter: blur(0) saturate(1);
      transition:
        opacity 260ms ease,
        backdrop-filter 360ms ease;
    }

    .home-header.is-menu-open .home-mobile-nav {
      pointer-events: auto;
      opacity: 1;
      backdrop-filter: blur(18px) saturate(1.08);
      -webkit-backdrop-filter: blur(18px) saturate(1.08);
    }

    .home-mobile-nav-panel {
      position: relative;
      display: grid;
      grid-template-rows: auto minmax(0, 1fr) auto;
      gap: clamp(1.15rem, 5vw, 2rem);
      width: 100%;
      min-height: 0;
      padding: clamp(1.35rem, 5vw, 1.9rem);
      border: 1px solid rgba(231, 235, 242, 0.1);
      border-radius: var(--radius-xl);
      overflow: hidden;
      background:
        radial-gradient(ellipse 90% 44% at 74% 0%, rgba(101, 126, 218, 0.16), transparent 62%),
        radial-gradient(ellipse 56% 34% at 10% 100%, rgba(231, 235, 242, 0.07), transparent 70%),
        linear-gradient(180deg, rgba(13, 15, 21, 0.96), rgba(var(--home-bg-rgb), 0.98));
      box-shadow:
        inset 0 0 0 1px rgba(255, 255, 255, 0.026),
        0 1.6rem 4rem rgba(0, 0, 0, 0.36);
      opacity: 0;
      transform: translateY(-0.7rem) scale(0.985);
      transition:
        opacity 260ms ease,
        transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .home-mobile-nav-panel::before {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      background:
        linear-gradient(90deg, rgba(255, 255, 255, 0.026) 0 1px, transparent 1px 100%),
        linear-gradient(180deg, rgba(255, 255, 255, 0.028), transparent 26%);
      background-size: 33.333% 100%, 100% 100%;
      opacity: 0.28;
      mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.82), transparent 78%);
    }

    .home-header.is-menu-open .home-mobile-nav-panel {
      opacity: 1;
      transform: translateY(0) scale(1);
    }

    .home-mobile-nav-primary,
    .home-mobile-nav-secondary {
      position: relative;
      z-index: 1;
    }

    .home-mobile-nav-primary {
      display: grid;
      align-content: start;
      gap: 0.1rem;
      padding-top: 0.15rem;
    }

    .home-mobile-nav-primary a {
      display: flex;
      align-items: center;
      min-height: clamp(3.8rem, 15vw, 5.35rem);
      color: rgba(244, 247, 255, 0.94);
      font-family: var(--home-display);
      font-size: clamp(2.7rem, 15vw, 4.65rem);
      font-weight: var(--font-weight-medium);
      line-height: var(--home-line-title);
      letter-spacing: var(--home-tracking-title);
    }

    .home-mobile-nav-secondary {
      align-self: end;
      display: grid;
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      gap: 1.25rem;
      padding-top: 0.95rem;
      border-top: 1px solid rgba(231, 235, 242, 0.09);
    }

    .home-mobile-nav-group {
      display: grid;
      align-content: start;
      gap: 0.66rem;
    }

    .home-mobile-nav-group p {
      margin: 0 0 0.14rem;
      color: rgba(231, 235, 242, 0.38);
      font-size: var(--home-type-label-compact);
      font-weight: var(--font-weight-medium);
      letter-spacing: var(--home-tracking-label);
      line-height: var(--home-line-label);
    }

    .home-mobile-nav-group a {
      color: rgba(231, 235, 242, 0.68);
      font-size: var(--home-type-body-sm);
      line-height: var(--home-line-body-compact);
      text-wrap: pretty;
    }

    .home-mobile-nav-actions {
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 0.72rem;
    }

    .home-mobile-nav-action {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 3rem;
      padding: 0 0.9rem;
      border-radius: 999rem;
      font-size: var(--home-type-body-sm);
      font-weight: var(--font-weight-medium);
      line-height: var(--home-line-label);
      text-align: center;
      color: rgba(var(--home-bg-rgb), 0.96);
    }

    .home-mobile-nav-panel .home-mobile-nav-action,
    .home-mobile-nav-panel .home-mobile-nav-action:link,
    .home-mobile-nav-panel .home-mobile-nav-action:visited,
    .home-mobile-nav-panel .home-mobile-nav-action:hover,
    .home-mobile-nav-panel .home-mobile-nav-action:focus-visible,
    .home-mobile-nav-panel .home-mobile-nav-action:active,
    .home-mobile-nav-action--primary,
    .home-mobile-nav-action--secondary {
      border: 1px solid rgba(231, 235, 242, 0.22);
      background: rgba(244, 247, 255, 0.92);
      color: rgba(var(--home-bg-rgb), 0.96);
      -webkit-text-fill-color: rgba(var(--home-bg-rgb), 0.96);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.48),
        0 0.65rem 1.4rem rgba(0, 0, 0, 0.18);
    }

    .home-mobile-nav-primary a,
    .home-mobile-nav-group,
    .home-mobile-nav-actions {
      opacity: 0;
      transform: translateY(0.85rem);
      transition:
        opacity 380ms ease,
        transform 520ms cubic-bezier(0.16, 1, 0.3, 1);
      transition-delay: calc(70ms + (var(--nav-item-index, 0) * 54ms));
    }

    .home-header.is-menu-open .home-mobile-nav-primary a,
    .home-header.is-menu-open .home-mobile-nav-group,
    .home-header.is-menu-open .home-mobile-nav-actions {
      opacity: 1;
      transform: translateY(0);
    }

    .home-mobile-nav-primary a:hover,
    .home-mobile-nav-primary a:focus-visible,
    .home-mobile-nav-group a:hover,
    .home-mobile-nav-group a:focus-visible {
      color: var(--home-text);
      outline: none;
    }

    .home-mobile-nav-action--primary:hover,
    .home-mobile-nav-action--primary:focus-visible,
    .home-mobile-nav-action--secondary:hover,
    .home-mobile-nav-action--secondary:focus-visible {
      color: rgba(var(--home-bg-rgb), 0.96);
      background: rgba(255, 255, 255, 0.98);
      outline: none;
    }

    .home-mobile-nav-primary a:focus-visible,
    .home-mobile-nav-group a:focus-visible {
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 0.24em;
    }

    @media (max-height: 42rem) {
      .home-mobile-nav {
        padding-top: calc(var(--home-mobile-page-gutter) + 2.85rem);
      }

      .home-mobile-nav-panel {
        gap: 1.2rem;
        overflow-y: auto;
      }

      .home-mobile-nav-primary {
        align-content: start;
      }

      .home-mobile-nav-primary a {
        min-height: 3.15rem;
        font-size: clamp(2.2rem, 12vw, 3.2rem);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .home-mobile-nav,
      .home-mobile-nav-panel,
      .home-mobile-nav-primary a,
      .home-mobile-nav-group,
      .home-mobile-nav-actions,
      .home-menu-toggle-icon::before,
      .home-menu-toggle-icon::after {
        transition: none;
      }

      .home-mobile-nav-primary a,
      .home-mobile-nav-group,
      .home-mobile-nav-actions {
        transform: none;
      }
    }


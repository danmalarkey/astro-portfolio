  .home-focus-services :global(.press-focus-stack) {
    margin-top: var(--spacing-xs);
  }

  :global(.press-focus-stack .pinned-stack-card:nth-child(2)) {
    --press-focus-accent-rgb: 148, 108, 255;
  }

  :global(.press-focus-stack .pinned-stack-card:nth-child(3)) {
    --press-focus-accent-rgb: 102, 128, 255;
  }

  :global(.press-focus-stack .pinned-stack-card:nth-child(4)) {
    --press-focus-accent-rgb: 116, 190, 226;
  }

  :global(.press-focus-stack .pinned-stack-card::before) {
    opacity: 0.16;
    filter: saturate(0.68) contrast(0.92);
  }

  :global(.press-focus-stack .pinned-stack-card::after) {
    background:
      linear-gradient(90deg, rgba(7, 13, 25, 0.96) 0%, rgba(7, 13, 25, 0.84) 42%, rgba(7, 13, 25, 0.22) 74%, rgba(7, 13, 25, 0.68) 100%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.025), rgba(255, 255, 255, 0.004) 36%, rgba(255, 255, 255, 0));
  }

  :global(.press-focus-stack.is-scroll-ready .pinned-stack-card.is-active) {
    border-color: transparent;
    background:
      radial-gradient(ellipse at 78% 18%, rgba(var(--press-focus-accent-rgb), 0.14), transparent 24rem) padding-box,
      linear-gradient(180deg, rgba(137, 169, 226, 0.065), rgba(137, 169, 226, 0.022)) padding-box,
      linear-gradient(rgba(var(--ds-surface-panel-rgb), 0.9), rgba(var(--ds-surface-panel-rgb), 0.9)) padding-box,
      linear-gradient(
        112deg,
        rgba(101, 130, 218, 0.26) 0%,
        rgba(220, 232, 255, 0.9) 17%,
        rgba(170, 122, 255, 0.82) 31%,
        rgba(95, 213, 240, 0.76) 47%,
        rgba(245, 248, 255, 0.88) 58%,
        rgba(101, 130, 218, 0.26) 76%,
        rgba(54, 75, 132, 0.18) 100%
      ) border-box;
    background-size: auto, auto, auto, 260% 100%;
    background-position: 0 0, 0 0, 0 0, 100% 0;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 0 0 1px rgba(189, 210, 255, 0.08),
      0 0 2.4rem rgba(var(--press-focus-accent-rgb), 0.16),
      0 1.4rem 3rem rgba(0, 0, 0, 0.2);
    animation: press-focus-chrome-shine 6s ease-in-out infinite;
  }

  @keyframes press-focus-chrome-shine {
    0%, 100% {
      background-position: 0 0, 0 0, 0 0, 100% 0;
    }

    50% {
      background-position: 0 0, 0 0, 0 0, 0% 0;

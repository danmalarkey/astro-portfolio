  title: 'In Fast Company.',
  description: 'A forthcoming article featuring an interview with me, arriving this winter.',
  date: 'Winter 2026',
  image: withBase('images/catalist/music-item-photo-viewer-desktop.webp'),
  href: ''
};
const showPortfolioPressFeature = Boolean(pressFeature.href);

const fitQuestions = [
  {
    question: 'Are you looking for a full-time role?',
    answerPrefix: 'No. I am happy in my current role at ',
    answerLink: {
      label: 'feature[23]',
      href: 'https://www.feature23.com/'
    },
    answerSuffix: '. I am open to select advisory, consulting, and fractional leadership engagements.'
  },
  {
    question: 'When should a team reach out?',
    answer: 'When a decision has real consequences and the organization needs an experienced partner who can work with leaders and the teams doing the work.'
  },
  {
    question: 'What kinds of teams are a fit?',
    answer: 'Organizations with complex products, cross-functional teams, and problems that cannot be solved by changing the interface alone.'
  },
  {
    question: 'Is this strategy or execution support?',
    answer: 'Both. I am most useful when the same person needs to help shape the decision and stay involved as the team works through it.'
  },
  {
    question: 'What work is not a fit?',
    answer: 'Brand identity, marketing collateral, quick production work, and isolated visual polish are not the fit, but I am open to conversation.'
  }
];

const featuredPractice = practiceStats[0];
const supportingPractice = practiceStats.slice(1);
---

<Layout
  title={pageCopy.title}
  description={pageCopy.description}
>
  <main class:list={['home', isPortfolioVariant && 'home--portfolio']}>
    <section class="home-intro">
      <Header />

      <section class="home-hero">
        <div class="home-hero-frame">
          <div class="home-window" aria-hidden="true">
            <div class="home-window-rays"></div>
            <canvas id="home-stars"></canvas>
            <div class="home-hero-noise"></div>
            <div class="home-window-light-field"></div>
            <div class="home-window-core"></div>
            <div class="home-window-glow"></div>
            <div class="home-window-haze"></div>
            <div class="home-window-orbit"></div>
          </div>

          <div class="dm-grid-l dm-grid-l--grid-sys home-hero-grid">
            <div class="home-hero-copy gc-start-2 gc-span-16">
              <div class="home-hero-primary">
                <p class="home-kicker home-kicker--accent">Chief Product Designer at feature[23]</p>
                <h1>
                  <span class="home-hero-title-line">Clarity &amp; vision for</span>
                  <span class="home-hero-title-line">teams in motion.</span>
                </h1>
              </div>
              <div class="home-hero-support">
                <p class="home-lead">{pageCopy.heroLead}</p>
              </div>
            </div>
          </div>
        </div>
      </section>
    </section>

    {isPortfolioVariant && (
    <section class="section home-practice portfolio-practice-evidence" data-home-reveal>
      <div class="dm-grid-l dm-grid-l--grid-sys home-practice-intro">
        <SectionHeader
          eyebrow="Clarity under pressure."
          title={pageCopy.practiceBody}
          accent
          headClass="gc-start-2 gc-span-24"
        />
      </div>

      <div class="home-practice-grid col-layout col-layout--3x8 dm-grid-l dm-grid-l--grid-sys u-no-pt" role="list" aria-label="Design leadership proof points">
        {visiblePracticeStats.map((item) => (
          <article class={`concept-card home-practice-card home-practice-card--grid home-practice-card--${item.visualType}`} role="listitem">
            <p class="home-practice-card-eyebrow">{item.eyebrow}</p>
            <div class="home-practice-visual" aria-hidden="true">
              <div class="home-practice-nebula"></div>
              <div class="home-practice-glow"></div>
              <div class="home-practice-floor-glow"></div>
              <div class="home-practice-stars"></div>
              <img class="home-practice-icon home-practice-icon--outline" src={item.outlineImage} alt="" loading="lazy" decoding="async" />
              <img class="home-practice-icon home-practice-icon--detail" src={item.detailImage} alt="" loading="lazy" decoding="async" />
            </div>
            <div class="home-practice-copy">
              <p class="home-practice-value">
                {item.labelLines.map((line) => <span class="home-practice-value-line">{line}</span>)}
              </p>
              <p class="home-practice-text">{item.text}</p>
            </div>
          </article>
        ))}
      </div>
    </section>
    )}

    {isPortfolioVariant && showPortfolioLeadershipMantraCards && (
    <section class="section home-blended-leadership portfolio-leadership-mantra">
      <div class="dm-grid-l dm-grid-l--grid-sys home-actors-intro" data-home-reveal>
        <SectionHeader
          eyebrow="How I lead"
          title="Clarity, strategy, and systems keep direction coherent from the first decision through delivery."
          accent
          headClass="gc-start-2 gc-span-24"
        />
      </div>

      <div
        class="home-actor-lane-grid col-layout col-layout--3x8 dm-grid-l dm-grid-l--grid-sys scroll-assembly"
        role="list"
        aria-label="Leadership principles"
        data-scroll-assembly
        data-scroll-assembly-mode="cluster"
        data-scroll-assembly-entry="1.02"
        data-scroll-assembly-settle="0.42"
      >
        {blendedLeadershipCards.map((item, index) => (
          <article
            class:list={[
              'concept-card',
              'home-actor-lane',
              'home-blended-leadership-card',
              `home-actor-lane--${item.artType}`,
              'scroll-assembly-item',
              index === 0 && 'scroll-assembly-item--from-lower-left',
              index === 1 && 'scroll-assembly-item--from-bottom',
              index === 2 && 'scroll-assembly-item--from-lower-right'
            ]}
            role="listitem"
          >
            <div class="home-actor-lane-head">
              <p class="home-actor-lane-kicker">{item.conceptLabel}</p>
            </div>

            <div class="home-actor-lane-copy">
              <h3>{item.title}</h3>
              <p>{item.cardFit}</p>
            </div>

            <div class="home-actor-lane-strip">
              {item.laneRows.map((row, rowIndex) => (
                <div class={`home-actor-lane-metric home-actor-lane-metric--${rowIndex + 1}`}>
                  <span class="home-actor-lane-metric-label">{row.label}</span>
                  <span class="home-actor-lane-metric-detail">{row.detail}</span>
                </div>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>
    )}

    {(!isPortfolioVariant || showPortfolioLegacyOutcomeRail) && (
    <section class="section proof-showcase" data-home-reveal>
      <div class="dm-grid-l dm-grid-l--grid-sys proof-showcase-intro">
        <SectionHeader
          eyebrow="Selected work"
          title="Real business outcomes."
          accent
          headClass="proof-showcase-head gc-start-2 gc-span-24"
        />
      </div>

      <div class="proof-rail-wrap dm-grid-l dm-grid-l--grid-sys">
        <div class="proof-rail gc-start-2 gc-span-24" role="list" aria-label="Selected engagements" data-proof-rail>
          {proofDraftCards.map((item, index) => (
            <div class:list={['proof-rail-item', index === 0 && 'is-active']} role="listitem" data-proof-rail-item>
              <button
                class="proof-rail-trigger"
                type="button"
                aria-expanded={index === 0 ? 'true' : 'false'}
                aria-controls={`proof-rail-details-${index}`}
                data-proof-rail-trigger
              >
                <img class="proof-rail-image" src={item.image} alt="" loading="lazy" decoding="async" />
                <span class="proof-rail-shade" aria-hidden="true"></span>
                <span
                  class="proof-rail-collapsed-label"
                  aria-hidden={index === 0 ? 'true' : 'false'}
                  data-proof-rail-collapsed-label
                >
                  {item.kickerLines.map((line) => <span class="proof-rail-collapsed-label-line">{line}</span>)}
                </span>
                <span
                  class="proof-rail-copy"
                  aria-hidden={index === 0 ? 'false' : 'true'}
                  data-proof-rail-copy
                >
                  <span class="proof-rail-kicker">{item.kicker}</span>
                  <span class="proof-rail-title" role="heading" aria-level="3">{item.title}</span>
                  <span
                    id={`proof-rail-details-${index}`}
                    class="proof-rail-details"
                    aria-hidden={index === 0 ? 'false' : 'true'}
                    data-proof-rail-details
                  >
                    {item.details.map((detail) => <span>{detail}</span>)}
                  </span>
                </span>
              </button>
            </div>
          ))}
        </div>
      </div>

      <div class="home-client-trust home-client-trust--proof" aria-label="Organizations I have supported" data-home-reveal>
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <div class="home-client-trust-shell gc-start-2 gc-span-24">
          <p class="home-client-trust-label">Organizations I’ve supported</p>
          <div class="home-client-marquee" aria-hidden="true">
            <div class="home-client-marquee-track">
              {supportedOrganizationLoop.map((organization) => (
                <span
                  class="home-client-logo"
                  style={`--logo-width-scale: ${organization.widthScale ?? 1}; --logo-height-scale: ${organization.heightScale ?? 1};`}
                >
                  <img src={withBase(organization.logo)} alt="" loading="lazy" decoding="async" />
                </span>
              ))}
            </div>
          </div>
          <ul class="home-client-trust-list sr-only">
            {supportedOrganizations.map((organization) => (
              <li>{organization.name}</li>
            ))}
          </ul>
        </div>
      </div>
      </div>
    </section>
    )}

    {isPortfolioVariant && (
    <section class="section portfolio-study portfolio-study--light portfolio-outcome-study" aria-labelledby="portfolio-outcome-study-title">
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <div class="portfolio-outcome-composition gc-start-2 gc-span-24">
          <header class="portfolio-study-head portfolio-outcome-head" data-home-reveal>
            <SectionHeader
              eyebrow="Business outcomes"
              title="Different organizations. Different journeys. Tied to priorities that matter across the business."
              headingId="portfolio-outcome-study-title"
              accent
              headClass="portfolio-outcome-section-header"
            />
          </header>

          <div class="portfolio-outcome-stack">
            <div class="portfolio-outcome-stack-stage" role="list" aria-label="Selected work">
              {proofDraftCards.map((item, index) => (
                <div
                  class="portfolio-outcome-card-slot"
                  role="listitem"
                  style={`--outcome-index: ${index}`}
                  data-home-reveal
                  data-mobile-reveal="case-study"
                >
                  <article class="portfolio-outcome-card">
                    <img src={item.image} alt={`${item.kicker} selected work`} loading="lazy" decoding="async" />
                    <span class="portfolio-outcome-card-shade" aria-hidden="true"></span>
                    <div class="portfolio-outcome-card-copy">
                      <p>{item.kicker}</p>
                      <h3>{item.title}</h3>
                      <div class="portfolio-outcome-card-details" aria-label="Leadership focus">
                        {item.details.map((detail) => <span>{detail}</span>)}
                      </div>
                    </div>
                  </article>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <div class="home-client-trust home-client-trust--proof home-client-trust--portfolio-outcomes" aria-label="Organizations I have supported" data-home-reveal>
        <div class="dm-grid-l dm-grid-l--grid-sys">
          <div class="home-client-trust-shell gc-start-2 gc-span-24">
            <p class="home-client-trust-label">Organizations I’ve supported</p>
            <div class="home-client-marquee" aria-hidden="true">
              <div class="home-client-marquee-track">
                {supportedOrganizationLoop.map((organization) => (
                  <span
                    class="home-client-logo"
                    style={`--logo-width-scale: ${organization.widthScale ?? 1}; --logo-height-scale: ${organization.heightScale ?? 1};`}
                  >
                    <img src={withBase(organization.logo)} alt="" loading="lazy" decoding="async" />
                  </span>
                ))}
              </div>
            </div>
            <ul class="home-client-trust-list sr-only">
              {supportedOrganizations.map((organization) => (
                <li>{organization.name}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>
    )}

    {!isPortfolioVariant && (
    <section class="section home-blended-leadership" data-home-reveal>
      <div class="dm-grid-l dm-grid-l--grid-sys home-actors-intro">
        <SectionHeader
          eyebrow="How I lead"
          title="I work across business context, product decisions, team alignment, standards, and delivery to keep direction on course."
          accent
          headClass="gc-start-2 gc-span-24"
        />
      </div>

      <div class="home-actor-lane-grid col-layout col-layout--3x8 dm-grid-l dm-grid-l--grid-sys" role="list">
        {blendedLeadershipCards.map((item) => (
          <article class={`concept-card home-actor-lane home-blended-leadership-card home-actor-lane--${item.artType}`} role="listitem">
            <div class="home-actor-lane-head">
              <p class="home-actor-lane-kicker">{item.conceptLabel}</p>
            </div>

            <div class="home-actor-lane-copy">
              <h3>{item.title}</h3>
              <p>{item.cardFit}</p>
            </div>

            <div class="home-actor-lane-strip">
              {item.laneRows.map((row, rowIndex) => (
                <div class={`home-actor-lane-metric home-actor-lane-metric--${rowIndex + 1}`}>
                  <span class="home-actor-lane-metric-label">{row.label}</span>
                  <span class="home-actor-lane-metric-detail">{row.detail}</span>
                </div>
              ))}
            </div>

            <div class="home-actor-lane-footer">
              <div class="home-actions home-actions--actor home-actions--actor-lane">
                <Button href={createActorMailto(item.title, item.actorLabel)} variant="ghost" size="compact">
                  <span>Work with me</span>
                  <span aria-hidden="true">↗</span>
                </Button>
                <a class="home-actor-link" href={withBase(item.actorSlug)}>How I help</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>
    )}

    {!isPortfolioVariant && (
    <section class="section home-actors" data-home-reveal>
      <div class="dm-grid-l dm-grid-l--grid-sys home-actors-intro">
        <SectionHeader
          eyebrow={pageCopy.engagementEyebrow}
          title={pageCopy.engagementTitle}
          body={pageCopy.engagementBody}
          accent
        />
      </div>

      <div class="home-actor-lane-grid col-layout col-layout--3x8 dm-grid-l dm-grid-l--grid-sys" role="list">
        {actorAudienceCards.map((item) => (
          <article class={`concept-card home-actor-lane home-actor-lane--${item.artType}`} role="listitem">
            <div class="home-actor-lane-head">
              <p class="home-actor-lane-kicker">{item.conceptLabel}</p>
            </div>

            <div class="home-actor-lane-copy">
              <h3>{item.title}</h3>
              <p>{item.cardFit}</p>
            </div>

            <div class="home-actor-lane-strip">
              {item.laneRows.map((row, rowIndex) => (
                <div class={`home-actor-lane-metric home-actor-lane-metric--${rowIndex + 1}`}>
                  <span class="home-actor-lane-metric-label">{row.label}</span>
                  <span class="home-actor-lane-metric-detail">{row.detail}</span>
                </div>
              ))}
            </div>

            <div class="home-actor-lane-footer">
              <div class="home-actions home-actions--actor home-actions--actor-lane">
                <Button href={createActorMailto(item.title, item.actorLabel)} variant="ghost" size="compact">
                  <span>Work with me</span>
                  <span aria-hidden="true">↗</span>
                </Button>
                <a class="home-actor-link" href={withBase(item.actorSlug)}>How I help</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>
    )}

    {!isPortfolioVariant && (
    <section
      id="engagement-row-study"
      class="section engagement-mosaic"
      aria-label="Ways to engage concept"
    >
      <div class="dm-grid-l dm-grid-l--grid-sys engagement-mosaic-intro" data-home-reveal>
        <SectionHeader
          eyebrow={pageCopy.mosaicEyebrow}
          title={pageCopy.mosaicTitle}
          body={pageCopy.mosaicBody}
          headClass="gc-start-2 gc-span-10"
          bodyClass="gc-start-15 gc-span-11"
        />
      </div>

      <div class="dm-grid-l dm-grid-l--grid-sys">
        <div class="engagement-mosaic-grid gc-start-2 gc-span-24">
          {mosaicCards.map((item, index) => (
            <article
              class:list={[
                'engagement-mosaic-card',
                `engagement-mosaic-card--${item.artType}`,
                index === 0 ? 'engagement-mosaic-card--featured' : 'engagement-mosaic-card--supporting'
              ]}
            >
              <img
                class="engagement-mosaic-image"
                src={withBase(item.showcaseImage)}
                alt=""
                loading="lazy"
                decoding="async"
              />
              <span class="engagement-mosaic-shade" aria-hidden="true"></span>

              <div class="engagement-mosaic-content">
                <div class="engagement-mosaic-heading">
                  <p class="home-section-label engagement-mosaic-kicker">{item.conceptLabel}</p>
                  <h3>{item.title}</h3>
                  <p class="engagement-mosaic-summary">{item.cardFit}</p>
                </div>

                <div class="home-actions engagement-mosaic-actions">
                  <Button href={createActorMailto(item.title, item.actorLabel)} variant="ghost" size="compact">
                    <span>Work with me</span>
                    <span aria-hidden="true">↗</span>
                  </Button>
                  <a class="home-actor-link" href={withBase(item.actorSlug)}>How I help</a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
    )}

    {isPortfolioVariant && (
    <section
      id="engagement-row-study"
      class="section engagement-mosaic"
      aria-label="Connected design approach"
    >
      <div class="dm-grid-l dm-grid-l--grid-sys engagement-mosaic-intro" data-home-reveal>
        <SectionHeader
          eyebrow={pageCopy.mosaicEyebrow}
          title={pageCopy.mosaicTitle}
          body={pageCopy.mosaicBody}
          headClass="gc-start-6 gc-span-16"
          bodyClass="gc-start-14 gc-span-8"
        />
      </div>

      <div class="dm-grid-l dm-grid-l--grid-sys">
        <div class="engagement-mosaic-grid scroll-assembly gc-start-6 gc-span-16" data-scroll-assembly>
          {mosaicCards.map((item, index) => (
            <article
              class:list={[
                'engagement-mosaic-card',
                `engagement-mosaic-card--${item.artType}`,
                index === 0 ? 'engagement-mosaic-card--featured' : 'engagement-mosaic-card--supporting',
                'scroll-assembly-item',
                index === 0 && 'scroll-assembly-item--from-lower-left',
                index === 1 && 'scroll-assembly-item--from-upper-right',
                index === 2 && 'scroll-assembly-item--from-lower-right'
              ]}
            >
              <img
                class="engagement-mosaic-image"
                src={withBase(item.showcaseImage)}
                alt=""
                loading="lazy"
                decoding="async"
              />
              <span class="engagement-mosaic-shade" aria-hidden="true"></span>

              <div class="engagement-mosaic-content">
                <div class="engagement-mosaic-heading">
                  <h3>{item.title}</h3>
                  <p class="engagement-mosaic-summary">{item.cardFit}</p>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
    )}

    {isPortfolioVariant && (
    <section class="section portfolio-focus" aria-labelledby="portfolio-focus-title">
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <header class="portfolio-focus-head gc-start-4 gc-span-20" data-home-reveal data-mobile-reveal="rise">
          <div class="portfolio-focus-heading">
            <p class="home-section-label home-kicker--accent">How I lead</p>
            <h2 id="portfolio-focus-title">Clarity, strategy, and systems keep direction coherent from the first decision through delivery.</h2>
          </div>
        </header>

        <div class="portfolio-focus-assembly gc-start-2 gc-span-24" data-focus-assembly>
          <div class="portfolio-focus-stage" data-focus-stage>
            <div class="portfolio-focus-stack" role="list" aria-label="Focus areas">
              {focusAreaCards.map((item, index) => (
                <div class="portfolio-focus-card-slot" role="listitem" style={`--focus-index: ${index}`}>
                  <article class="portfolio-focus-card">
                    <img src={withBase(item.image)} alt="" loading="lazy" decoding="async" />
                    <span class="portfolio-focus-card-shade" aria-hidden="true"></span>
                    <span class="portfolio-focus-card-copy">
                      <span class="portfolio-focus-card-title">{item.title}</span>
                      <span class="portfolio-focus-card-description">{item.description}</span>
                      <span class="portfolio-focus-card-action">Page coming soon</span>
                    </span>
                  </article>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
    )}

    {isPortfolioVariant && showPortfolioLegacyPublishedItems && (
    <section class="section portfolio-features" data-home-reveal aria-label="Press and independent product">
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <div class="portfolio-feature-grid gc-start-2 gc-span-24">
          <article class="portfolio-feature portfolio-feature--press">
            <div class="portfolio-feature-media portfolio-feature-media--press">
              <img src={pressFeature.image} alt="" loading="lazy" decoding="async" aria-hidden="true" />
              <div class="portfolio-feature-press-mark" aria-hidden="true">
                <span>{pressFeature.publication}</span>
                <span>{pressFeature.date}</span>
              </div>
            </div>

            <div class="portfolio-feature-copy">
              <p class="home-section-label">In the press</p>
              <div class="portfolio-feature-heading">
                <h2>{pressFeature.title}</h2>
                <p class="portfolio-feature-meta">{pressFeature.date}</p>
              </div>
              <p class="portfolio-feature-description">{pressFeature.description}</p>
              {pressFeature.href && (
                <Button href={pressFeature.href} variant="ghost" size="compact" target="_blank" rel="noreferrer">
                  <span>Read the article</span>
                  <span aria-hidden="true">↗</span>
                </Button>
              )}
            </div>
          </article>

          <article class="portfolio-feature portfolio-feature--product">
            <a
              class="portfolio-feature-media"
              href={catalistFeature.href}
              target="_blank"
              rel="noreferrer"
              aria-label="Explore Catalist in a new tab"
            >
              <img src={catalistFeature.image} alt="Catalist music collection and item details interface" loading="lazy" decoding="async" />
            </a>

            <div class="portfolio-feature-copy">
              <p class="home-section-label">{catalistFeature.eyebrow}</p>
              <div class="portfolio-feature-heading">
                <h2>{catalistFeature.title}</h2>
                <p class="portfolio-feature-meta">Built independently</p>
              </div>
              <p class="portfolio-feature-description">{catalistFeature.description}</p>
              <p class="portfolio-feature-role">{catalistFeature.role}</p>
              <Button
                href={catalistFeature.href}
                variant="ghost"
                size="compact"
                target="_blank"
                rel="noreferrer"
                ariaLabel="Explore Catalist in a new tab"
              >
                <span>Explore Catalist</span>
                <span aria-hidden="true">↗</span>
              </Button>
            </div>
          </article>
        </div>
      </div>
    </section>
    )}

    {isPortfolioVariant && (
    <section class="section portfolio-study portfolio-study--light portfolio-editorial-study" aria-labelledby="portfolio-editorial-study-title">
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <header class="portfolio-study-head portfolio-editorial-head gc-start-2 gc-span-24" data-home-reveal>
          <div class="portfolio-study-heading">
            <h2 id="portfolio-editorial-study-title">
              {showPortfolioPressFeature ? 'Insights.' : 'What I’m working on.'}

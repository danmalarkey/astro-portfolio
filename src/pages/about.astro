---
import Layout from "../layouts/Layout.astro";
import Header from "../layouts/Header.astro";
import HomeFooter from "../components/HomeFooter.astro";
const isDev = import.meta.env.DEV;

const proofHighlights = [
  {
    label: "Current role",
    title: "Chief Product Designer at feature[23]",
    text: "I lead design work across complex client engagements and help shape how design contributes to product direction, delivery quality, and business outcomes."
  },
  {
    label: "Scope",
    title: "Strategy through execution",
    text: "I work across executive alignment, product direction, system design, team standards, and implementation-ready delivery patterns."
  },
  {
    label: "Operating context",
    title: "Growth, complexity, and change",
    text: "Most of my strongest work happens when organizations need clarity, momentum, and better decisions under pressure."
  }
];

const principles = [
  {
    title: "Direction before execution",
    text: "The fastest teams still lose time when priorities are unclear. I help leaders clarify what matters, what changes, and what design needs to drive."
  },
  {
    title: "Systems-led, people-first",
    text: "Design scales when standards, decisions, and teams work together. The system should support people, not become more process overhead."
  },
  {
    title: "Progress without chaos",
    text: "I care about momentum, but not at the cost of quality, accessibility, or long-term maintainability. Speed should increase confidence, not debt."
  }
];

const collaborationModes = [
  {
    title: "Executive advisory",
    detail: "For leaders navigating product ambiguity, organizational change, or design investment decisions.",
    note: "Placeholder: add engagement examples, cadence, and outcomes."
  },
  {
    title: "Fractional design leadership",
    detail: "For teams that need senior design leadership embedded in product direction, prioritization, and delivery partnership.",
    note: "Placeholder: define what is included, what is not, and how engagements are structured."
  },
  {
    title: "Transformation and reset work",
    detail: "For organizations rebuilding workflows, teams, or systems where design needs to create alignment and restore momentum.",
    note: "Placeholder: add before/after patterns and ideal engagement signals."
  }
];

const localSignals = [
  "Jacksonville, Florida",
  "Available for select advisory and fractional engagements",
  "Email-first outreach: hello@danmalarkey.com"
];

const beyondDesign = [
  {
    title: "Writing and field notes",
    text: "A place to publish what I am learning about design leadership, product direction, systems, and AI in delivery as the work evolves.",
    note: "This will connect to the Writing section and can include more personal perspective alongside practical frameworks."
  },
  {
    title: "Library and recommendations",
    text: "Books, references, and resources for designers building their careers and leaders learning where design creates leverage.",
    note: "This is also the natural home for curated reading lists and recommendation notes over time."
  },
  {
    title: "Play / lab work (future)",
    text: "Experiments and personal builds that reflect how I think and what I enjoy making outside of client work.",
    note: "Potential home for vinyl collection integrations, data-fed collections, and other curiosity-driven projects."
  }
];
---

<Layout title="About Dan Malarkey | Design Leadership in Practice">
  <Header />
  <main>
    <section class="section about-a-hero" id="about-top">
      <div class="sky-burst" aria-hidden="true"></div>
      <div class="dm-grid-l dm-grid-l--grid-sys about-a-hero-grid">
        <article class="gc-start-2 gc-span-22 about-a-statement-card" aria-labelledby="about-a-statement-title">
          <div class="about-a-statement-top">
            <p class="about-a-kicker">About</p>
            <div class="intro-sub-list intro-sub-list--top" aria-label="Role and location">
              <p class="pill">
                <span>Chief Product Designer at feature[23]</span>
                <span class="separator" aria-hidden="true">/</span>
                <span>Jacksonville, Florida</span>
                <span class="separator" aria-hidden="true">/</span>
                <span>17+ years</span>
              </p>
            </div>
          </div>

          <div class="about-a-statement-grid">
            <div class="about-a-statement-title-col">
              <h1 class="about-a-display" id="about-a-statement-title">
                Clarity and direction for product work that cannot afford confusion.
              </h1>
            </div>

            <div class="about-a-statement-body-col">
              <p class="about-a-statement-lead">
                I help organizations move through complexity by improving decision quality, aligning teams, and building the design capability needed to sustain momentum.
              </p>
              <div class="about-a-statement-columns">
                <p>
                  At feature[23], I contribute across high-stakes client work where product direction, operational quality, and delivery confidence all need senior design leadership.
                </p>
                <p class="about-a-side-accent">Available for select advisory and fractional engagements.</p>
              </div>
            </div>
          </div>
        </article>
      </div>
    </section>

    <section class="section section-panel section-surface--warm about-a-dossier">
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <div class="gc-start-2 gc-span-3 about-a-index-col">
          <p class="about-a-kicker">01 / Profile</p>
        </div>
        <div class="gc-start-6 gc-span-11 about-a-body-col">
          <h2 class="section-title">The way I work is strategic, systems-led, and close to the work.</h2>
          <div class="about-a-body-copy">
            <p>
              Across 17+ years in product and design leadership, I have worked across startups and larger organizations, helping teams make better decisions earlier and execute with more confidence. My strongest work sits at the intersection of strategy, systems, and execution.
            </p>
            <p>
              I am most useful when teams have momentum but need sharper direction, stronger operating rhythm, or better alignment across executives, product, engineering, and design. I tend to get pulled into moments where ambiguity is expensive.
            </p>
            <p>
              This site is not intended to be a gallery of polished UI alone. I want it to reflect how I actually contribute: clarifying direction, improving decision quality, building design capability, and staying close enough to the work that teams can move without losing confidence.
            </p>
          </div>
        </div>
        <div class="gc-start-18 gc-span-7 about-a-proof-rail" aria-label="Profile proof points">
          {proofHighlights.map((item, index) => (
            <article class="about-a-proof-row">
              <p class="about-a-proof-index">{String(index + 1).padStart(2, '0')}</p>
              <div class="about-a-proof-content">
                <p class="about-a-proof-label">{item.label}</p>
                <p class="about-a-proof-title">{item.title}</p>
                <p class="about-a-proof-text">{item.text}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-panel section-surface--dark about-a-principles">
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <div class="gc-start-2 gc-span-3 about-a-index-col">
          <p class="about-a-kicker">02 / Principles</p>
        </div>
        <div class="gc-start-6 gc-span-18 about-a-ruled-list" role="list">
          {principles.map((item, index) => (
            <article class="about-a-ruled-item" role="listitem">
              <p class="about-a-ruled-number">{String(index + 1).padStart(2, '0')}</p>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-panel section-surface--light about-a-services">
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <div class="gc-start-2 gc-span-3 about-a-index-col">
          <p class="about-a-kicker">03 / Engagements</p>
        </div>
        <div class="gc-start-6 gc-span-18 about-a-rows" role="list">
          {collaborationModes.map((item) => (
            <article class="about-a-row" role="listitem">
              <h3>{item.title}</h3>
              <p>{item.detail}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-panel section-surface--warm about-a-beyond">
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <div class="gc-start-2 gc-span-3 about-a-index-col">
          <p class="about-a-kicker">04 / More than design</p>
        </div>
        <div class="gc-start-6 gc-span-8 section-intro section-intro--compact">
          <h2 class="section-title">The site should also hold the parts of my work that are personal, curious, and still useful.</h2>
          <p class="section-intro-body">
            Writing, recommendations, and experiments can strengthen trust if they are structured intentionally and do not compete with the site’s primary purpose.
          </p>
        </div>
        <div class="gc-start-15 gc-span-9 about-a-rows" role="list" aria-label="More than design placeholders">
          {beyondDesign.map((item) => (
            <article class="about-a-row" role="listitem">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-panel section-surface--dark about-a-local">
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <div class="gc-start-2 gc-span-3 about-a-index-col">
          <p class="about-a-kicker">05 / Availability</p>
        </div>
        <div class="gc-start-6 gc-span-10 section-intro section-intro--compact">
          <h2 class="section-title text-white">Selective engagements, not a full-time search.</h2>
          <p class="section-intro-body">
            I am happy in my current role. This site is for advisory, fractional leadership, and targeted consulting support where senior design leadership can improve clarity, alignment, and execution quality.
          </p>
        </div>
        <div class="gc-start-17 gc-span-7 about-a-local-list-wrap">
          <ul class="about-a-local-list">
            {localSignals.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </section>
  </main>

  {isDev && (
    <details class="about-page-dev-support">
      <summary aria-label="Toggle About page support notes">Support</summary>
      <div class="about-page-dev-support-panel">
        <p class="about-page-dev-support-title">About page support notes</p>
        <ul>
          <li>Hero uses homepage hero system classes for type rhythm consistency.</li>
          <li>Interior visual direction here is nebula/surface only (no star canvas).</li>
          <li>"More than design" is the current placeholder for personal/lab direction.</li>
          <li>Engagement and local sections still need final launch copy tightening.</li>
          <li>Collaboration rows and beyond-design rows intentionally hide dev filler notes in page flow.</li>
        </ul>
      </div>
    </details>
  )}

  <HomeFooter
    eyebrow="Work with me"
    title="If this sounds like the kind of design leadership your team needs, reach out."
    body="I am available for select advisory and fractional engagements, especially where product direction, systems, and delivery alignment need senior design leadership."
  />
</Layout>

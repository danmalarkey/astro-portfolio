---
import HomeFooter from "../components/HomeFooter.astro";
import PinnedStackCards from "../components/PinnedStackCards.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { focusAreaServiceRows } from "../data/focus-area-service-rows";
import Header from "../layouts/Header.astro";
import Layout from "../layouts/Layout.astro";

const baseUrl = Astro.url.pathname.startsWith("/astro-portfolio") ? "/astro-portfolio/" : "/";
const withBase = (path: string) => `${baseUrl}${path.startsWith("/") ? path.slice(1) : path}`;

const profileRows = [
  {
    number: "01",
    label: "Current role",
    title: "Chief Product Designer at feature[23]",
    titleLines: ["Chief Product Designer", "at feature[23]"],
    body: "Growing design capabilities with executives, product leaders, designers, and engineers, helping teams stay focused on people, outcomes, and responsible execution.",
  },
  {
    number: "02",
    label: "Scope",
    title: "Product design, systems, standards, and delivery",
    titleLines: ["Product design, systems,", "standards, and delivery"],
    body: "Strategy, workshops, workflow modeling, design systems, accessibility, AI-enabled exploration, and implementation support.",
  },
  {
    number: "03",
    label: "Operating context",
    title: "Operational software and middle-market companies",
    titleLines: ["Operational software", "and middle-market companies"],
    body: "Where business goals, human activity, technology, compliance, and delivery constraints need to stay connected.",
  }
];

const visibleDesignPrinciples = [
  {
    number: "01",
    title: "Clarity before execution",
    body: "Teams make better decisions when they understand what they are trying to make true before moving too quickly. Clarity is not a delay. It keeps effort from scattering.",
  },
  {
    number: "02",
    title: "Make the model visible",
    body: "Every product carries an underlying model: the business goal, the people involved, the activity being supported, the rules of the system, and the decisions that shape behavior. When that model is unclear, the product becomes harder to explain, build, use, and sustain.",
  },
  {
    number: "03",
    title: "Start with human activity",
    body: "Strong product decisions start with what people are trying to do. Goals, jobs, decisions, workflows, and constraints matter because they explain what the system needs to support.",
  },
  {
    number: "04",
    title: "Standards protect decisions",
    body: "Standards are not decoration or process for its own sake. They help teams make better decisions repeatedly and protect accessibility, consistency, quality, and trust as more people become involved.",
  },
  {
    number: "05",
    title: "Rigor is responsibility",
    body: "Craft matters, but rigor is larger than polish. It is the discipline of asking better questions, using evidence, understanding constraints, and making decisions that can be defended beyond preference.",
  },
  {
    number: "06",
    title: "AI needs direction",
    body: "AI does not remove the need for design judgment. It increases the need for clarity, standards, human control, and responsible decision-making. The goal is not more disconnected output. The goal is useful systems people can understand, trust, and operate.",
  }
];
---

<Layout
  title="About Dan Malarkey | Product Design, Systems, and Delivery Leadership"
  description="About Dan Malarkey, a Chief Product Designer focused on clarity, systems, standards, accessibility, AI-enabled work, and responsible execution."
>
  <Header />

  <main class="about-page">
    <section class="about-hero" aria-labelledby="about-hero-title" style={`--about-hero-image: url('${withBase("/images/about/dan-drillstack.png")}')`}>
      <div class="about-hero-field" aria-hidden="true"></div>
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <div class="about-hero-copy gc-start-2 gc-span-18">
          <p class="about-kicker type-eyebrow">About Dan</p>
          <h1 id="about-hero-title">Hey. I'm Dan Malarkey.</h1>
          <div class="about-hero-body">
            <p>
              I’m a Chief Product Designer with 17+ years across product design, operational software, design systems, accessibility, and delivery. For the last 14 years, I’ve helped shape product direction and design practice at <a class="inline-link" href="https://www.feature23.com/" target="_blank" rel="noreferrer">feature[23]</a>. I balance business goals, human activity, technology, standards, and implementation so decisions can safely move the business forward.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="about-section about-profile-section" aria-label="Profile snapshot" data-motion-reveal>
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <figure class="about-profile-image gc-start-1 gc-span-18" data-motion-item>
          <img src={withBase("/images/about/board.png")} alt="Whiteboard with product workflow notes arranged in columns" loading="lazy" decoding="async" />
        </figure>
        <aside class="about-profile-rows gc-start-12 gc-span-13" aria-label="Profile snapshot" role="list" data-motion-item>
          {profileRows.map((item) => (
            <article class="about-profile-row" role="listitem">
              <p class="about-profile-index">{item.label}</p>
              <h3 class="type-title-geist-300">{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))}
        </aside>
      </div>
    </section>

    <section class="about-section about-story-section" aria-labelledby="about-story-title" data-motion-reveal>
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <article class="about-article about-article--split dm-grid-l dm-grid-l--grid-sys gc-start-1 gc-span-26" data-motion-item>
          <figure class="about-practitioner-image gc-start-11 gc-span-16" aria-hidden="true">
            <img src={withBase("/images/dan.png")} alt="" loading="lazy" decoding="async" />
          </figure>
          <div class="about-article-columns about-article-columns--overlay gc-start-2 gc-span-13">
            <div class="about-article-head">
              <h2 id="about-story-title" class="about-story-title--sm">A practitioner of clarity, systems, and responsible execution.</h2>
            </div>
            <p>
              I’ve committed my career to the craft and rigor of helping middle-market businesses make better product decisions. I believe strong design connects business goals, human activity, and team capability into systems that can carry an organization further than any individual feature or initiative. Systems matter because disconnected decisions create drift, and drift quietly undermines progress.
            </p>
            <p>
              I believe good design leadership starts with understanding. Ask better questions. Understand constraints. Help people see the situation more clearly. When teams share the same understanding of the problem, they make better decisions with greater confidence. Responsible execution starts earlier than implementation. It starts with diagnosis, planning, alignment, and the decisions teams make before the work becomes expensive to change.
            </p>
          </div>
        </article>
      </div>
    </section>

    <section class="about-section about-image-section" aria-label="Personal image row" data-motion-reveal hidden>
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <div class="about-image-row gc-start-2 gc-span-24" data-motion-item>
          <figure class="about-image-row-item">
            <img src={withBase("/images/about/drillstack-group.JPG")} alt="Dan with a group during a working session" loading="lazy" decoding="async" />
          </figure>
          <figure class="about-image-row-item">
            <img src={withBase("/images/about/asheville-pic.JPG")} alt="Dan outside in Asheville" loading="lazy" decoding="async" />
          </figure>
          <figure class="about-image-row-item">
            <img src={withBase("/images/about/dan-family.JPG")} alt="Dan in a family photo" loading="lazy" decoding="async" />
          </figure>
        </div>
      </div>
    </section>

    <section class="about-section about-principles-visible-section" aria-labelledby="about-principles-visible-title">
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <SectionHeader
          eyebrow="Design Principles"
          title="How I think, lead, and evaluate design."
          headingId="about-principles-visible-title"
          headClass="about-principles-visible-head gc-start-2 gc-span-10"
        />
        <div class="about-principles-visible gc-start-13 gc-span-13" role="list">
          {visibleDesignPrinciples.map((item) => (
            <article class="about-principle-row" role="listitem">
              <div class="about-principle-copy">
                <h3 class="type-title-geist-300">{item.title}</h3>
                <p>{item.body}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="about-section about-mosaic-section" aria-label="Image mosaic" data-motion-reveal>
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <div class="about-mosaic gc-start-2 gc-span-24" data-motion-item>
          <figure class="about-mosaic-item about-mosaic-item--session">
            <img src={withBase("/images/about/about-songlinkr.jpg")} alt="Dan working through product structure with a team during an archived client session" loading="lazy" decoding="async" />
          </figure>
          <figure class="about-mosaic-item about-mosaic-item--asheville">
            <img src={withBase("/images/about/asheville-pic.JPG")} alt="Dan outside in Asheville" loading="lazy" decoding="async" />
          </figure>
          <figure class="about-mosaic-item about-mosaic-item--group">
            <img src={withBase("/images/about/drillstack-group.JPG")} alt="Dan with a group during a working session" loading="lazy" decoding="async" />
          </figure>
          <figure class="about-mosaic-item about-mosaic-item--family">
            <img src={withBase("/images/about/dan-family.JPG")} alt="Dan in a family photo" loading="lazy" decoding="async" />
          </figure>
        </div>
      </div>
    </section>

    <section class="about-section about-focus-section" aria-labelledby="about-focus-title" data-motion-reveal-early>
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <SectionHeader
          eyebrow="Where this connects"
          title="The same practice shows up in a few focused areas."
          body="Operating models, direction, standards, and AI-enabled systems are different entry points into the same concern: helping teams make better decisions and keep the system coherent."
          headingId="about-focus-title"
          headClass="gc-start-2 gc-span-10"
          bodyClass="gc-start-15 gc-span-11"
          reveal
        />
        <div class="about-focus-stack gc-start-2 gc-span-24">
          <PinnedStackCards
            items={focusAreaServiceRows.map((item) => ({
              title: item.title,
              titleLines: item.titleLines,
              href: item.href,
              image: item.image,
              tags: item.capabilities,
              fitLine: item.fitLine,
              body: item.description
            }))}
          />
        </div>
      </div>
    </section>
  </main>

  <HomeFooter
    eyebrow="Work with me"
    title="If the work needs clearer direction and stronger systems, let’s talk."
    body="I’m usually a strong fit when business goals, product direction, technology, standards, and delivery need to move together."
    ctaLabel="Start a conversation"
  />
</Layout>

<style>
  .about-page {
    --about-shell-gutter: var(--ds-mobile-content-gutter);
    --about-section-space: calc(var(--spacing-4xl) + var(--spacing-3xl));
    --about-rule: var(--ds-border-soft);
    --about-accent: var(--color-tag-text-accent);
    --about-hero-bottom-space: clamp(var(--spacing-3xl), 7vw, calc(var(--spacing-4xl) + var(--spacing-lg)));
    --about-hero-image-size: min(48rem, 54vw);
    --about-hero-image-offset: max(calc(var(--spacing-4xl) * -1.5), -6vw);
    --about-hero-image-opacity: .62;
    --about-hero-dot-size: 1rem;
    position: relative;
    overflow-x: clip;
    overflow-y: visible;
    padding: 0;
    color: var(--ds-text);
  }

  .about-hero,
  .about-section {
    position: relative;
    padding: var(--about-section-space) 0;
  }

  .about-hero {
    display: grid;
    isolation: isolate;
    align-items: end;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    min-height: 100vh;
    min-height: 100dvh;
    margin-inline: calc(50% - 50vw);
    padding: 0 0 var(--about-hero-bottom-space);
    box-sizing: border-box;
    border-bottom: var(--size-border-thin) solid var(--about-rule);
    background:
      radial-gradient(ellipse at 74% 4%, color-mix(in srgb, var(--about-accent) 20%, transparent), transparent 36rem),
      radial-gradient(ellipse at 8% 22%, var(--ds-surface-strong), transparent 30rem),
      var(--ds-background);
  }

  .about-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    opacity: 0.63;
    background: radial-gradient(circle, color-mix(in srgb, var(--ds-text) 10%, transparent) 0 var(--size-border-thin), transparent calc(var(--size-border-thin) + .025rem)) left top / var(--about-hero-dot-size) var(--about-hero-dot-size) repeat;
    mask-image: linear-gradient(90deg, black 0 46%, transparent 68%);
    animation: about-hero-dots-enter 1200ms ease 260ms both;
  }

  .about-hero-field {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background:
      radial-gradient(ellipse at 78% 42%, color-mix(in srgb, var(--about-accent) 14%, transparent), transparent 34rem),
      linear-gradient(180deg, rgba(var(--ds-background-rgb), .08), var(--ds-background)),
      linear-gradient(90deg, rgba(var(--ds-background-rgb), .98), rgba(var(--ds-background-rgb), .78) 48%, rgba(var(--ds-background-rgb), .9));
  }

  .about-hero-field::before {
    content: "";
    position: absolute;
    top: 8%;
    right: var(--about-hero-image-offset);
    width: var(--about-hero-image-size);
    aspect-ratio: 1;
    background-image: var(--about-hero-image);
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    filter: brightness(.62) saturate(.94);
    opacity: var(--about-hero-image-opacity);
    transform: translate3d(1.25rem, 0, 0) rotate(-2deg) scale(1.015);
    mask-image: radial-gradient(ellipse at 50% 50%, black 0 48%, rgba(0, 0, 0, .72) 66%, transparent 84%);
    animation: about-hero-image-enter 1200ms ease 180ms both;
  }

  .about-hero-field::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 76% 42%, rgba(var(--ds-background-rgb), .02), rgba(var(--ds-background-rgb), .42) 54%, rgba(var(--ds-background-rgb), .84) 82%),
      linear-gradient(90deg, rgba(var(--ds-background-rgb), .98) 0%, rgba(var(--ds-background-rgb), .72) 46%, rgba(var(--ds-background-rgb), .2) 74%, rgba(var(--ds-background-rgb), .64) 100%);
  }

  .about-hero-copy,
  .about-profile-rows {
    position: relative;
    z-index: 1;
  }

  .about-hero-copy {
    z-index: 2;
    opacity: 0;
    transform: translateY(1rem);
    animation: about-hero-copy-enter 820ms ease 220ms both;
  }

  .about-kicker {
    --type-eyebrow-color: var(--ds-text-soft);
  }

  .about-page h1,
  .about-page h2 {
    margin: 0;
    font-family: var(--font-family-display);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--ds-tracking-title);
    text-wrap: balance;
  }

  .about-hero h1 {
    max-width: 12ch;
    margin-top: var(--spacing-lg);
    color: var(--ds-text);
    font-size: var(--ds-type-title-xl);
    line-height: .94;
  }

  .about-hero-body {
    max-width: 54rem;
    margin-top: clamp(var(--spacing-xl), 4vw, var(--spacing-3xl));
  }

  .about-hero-body p + p {
    margin-top: 0;
  }

  .about-hero-body p,
  .about-profile-row p:not(.about-profile-index) {
    margin: 0;
    color: var(--ds-text-muted);
    font-size: var(--ds-type-lead);
    line-height: var(--ds-line-lead);
    letter-spacing: var(--ds-tracking-text);
    text-wrap: pretty;
  }

  @keyframes about-hero-copy-enter {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes about-hero-image-enter {
    from {
      opacity: 0;
      transform: translate3d(1.25rem, 0, 0) rotate(-2deg) scale(1.015);
    }

    to {
      opacity: var(--about-hero-image-opacity);
      transform: translate3d(0, 0, 0) rotate(-2deg) scale(1);
    }
  }

  @keyframes about-hero-dots-enter {
    from {
      opacity: 0;
    }

    to {
      opacity: .63;
    }
  }

  @media (max-width: 62rem) {
    .about-hero-copy {
      grid-column: 2 / -2;
    }
  }

  @media (max-width: 48rem) {
    .about-page {
      --about-section-space: var(--spacing-3xl);
      --about-hero-bottom-space: clamp(var(--spacing-xl), 10vw, var(--spacing-3xl));
      --about-hero-image-size: min(34rem, 92vw);
      --about-hero-image-offset: -38%;
      --about-hero-image-opacity: .34;
      --about-hero-dot-size: .875rem;
    }

    .about-page .dm-grid-l.dm-grid-l--grid-sys {
      row-gap: var(--ds-mobile-section-content-gap);
      padding-inline: 0;
    }

    .about-hero-copy {
      grid-column: 1 / -1;
      margin-inline: var(--about-shell-gutter);
      min-width: 0;
    }

    .about-hero {
      height: 100vh;
      height: 100dvh;
      min-height: 100vh;
      min-height: 100dvh;
      padding: 0 0 var(--about-hero-bottom-space);
      align-items: end;
    }

    .about-hero-field::before {
      top: 11%;
    }

    .about-hero h1 {
      max-width: 9.5ch;
      font-size: var(--ds-mobile-type-title-xl);
    }

    .about-hero-body p,
    .about-profile-row p:not(.about-profile-index) {
      font-size: var(--ds-mobile-type-body);
      line-height: var(--ds-line-body);
    }
  }

  .about-article {
    min-width: 0;
  }

  .about-article--split {
    align-items: start;
  }

  .about-article--split > * {
    grid-row: 1;
  }

  .about-article-head {
    position: relative;
    z-index: 2;
    display: grid;
    align-content: start;
    gap: var(--spacing-md);
  }

  .about-article > h2,
  .about-article-head h2 {
    color: var(--ds-text);
    font-family: var(--font-family-display);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0;
    text-wrap: balance;
  }

  .about-article > h2,
  .about-article-head h2 {
    font-size: var(--ds-type-title-lg);
    line-height: var(--ds-line-card-title);
  }

  .about-article-head .about-story-title--sm {
    font-size: var(--ds-type-title-md);
  }

  .about-article > p:not(.about-kicker) {
    max-width: 46rem;
    margin: var(--spacing-md) 0 0;
    color: var(--ds-text-muted);
    font-size: var(--ds-type-body);
    line-height: var(--ds-line-body);
    letter-spacing: var(--ds-tracking-text);
    text-wrap: pretty;
  }

  .about-article-columns {
    position: relative;
    z-index: 2;
    align-self: end;
    margin-top: 0;
    max-width: 46rem;
  }

  .about-article-columns--overlay {
    --about-overlay-space: clamp(var(--spacing-md), 3vw, var(--spacing-xl));
    display: grid;
    gap: var(--spacing-lg);
    padding: var(--about-overlay-space);
    padding-left: 0;
    background: none;
  }

  .about-article-columns--overlay::before {
    content: "";
    position: absolute;
    inset: 0 0 0 calc(var(--about-overlay-space) * -1);
    z-index: -1;
    background:
      linear-gradient(180deg, rgba(var(--ds-background-rgb), .92), rgba(var(--ds-background-rgb), .84)),
      rgba(var(--ds-surface-panel-rgb), .78);
  }

  .about-article-columns--overlay .about-article-head {
    max-width: 34rem;
  }

  .about-article-columns > p {
    margin: 0;
    color: var(--ds-text-muted);
    font-size: var(--ds-type-body);
    line-height: var(--ds-line-body);
    letter-spacing: var(--ds-tracking-text);
    text-wrap: pretty;
  }

  .about-article-columns > p + p {
    margin-top: 0;
  }

  .about-practitioner-image {
    position: relative;
    z-index: 1;
    min-height: clamp(28rem, 45vw, 42rem);
    margin: 0;
    overflow: hidden;
  }

  .about-practitioner-image::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(var(--ds-background-rgb), .22), transparent 45%),
      linear-gradient(180deg, transparent 42%, rgba(var(--ds-background-rgb), .4));
    pointer-events: none;
  }

  .about-practitioner-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(.74) saturate(.9);
  }

  .about-article > .about-kicker {
    margin: 0 0 var(--spacing-md);
  }

  .about-article-head .about-kicker {
    margin: 0;
  }

  .about-article .about-story-lede {
    max-width: 49rem;
    margin-top: clamp(var(--spacing-xl), 5vw, var(--spacing-3xl));
    color: rgba(244, 247, 255, .9);
    font-family: var(--font-family-display);
    font-size: var(--ds-type-lead);
    line-height: var(--ds-line-lead);
  }

  .about-article blockquote {
    margin: clamp(var(--spacing-3xl), 7vw, var(--spacing-4xl)) 0;
    padding: clamp(var(--spacing-lg), 4vw, var(--spacing-2xl)) 0;
    border-bottom: var(--size-border-thin) solid var(--ds-border);
  }

  .about-article blockquote p {
    max-width: 11ch;
    margin: 0;
    color: var(--ds-text);
    font-family: var(--font-family-display);
    font-size: var(--ds-type-title-lg);
    line-height: var(--ds-line-card-title);
  }

  .about-image-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--spacing-sm);
    align-items: stretch;
  }

  .about-image-row-item {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-bottom: var(--size-border-thin) solid var(--ds-border);
    border-radius: 0;
    background: rgba(var(--ds-surface-panel-rgb), .72);
    box-shadow: none;
  }

  .about-image-row-item::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(180deg, transparent 52%, rgba(var(--ds-background-rgb), .26)),
      radial-gradient(ellipse at 70% 10%, var(--ds-border), transparent 46%);
  }

  .about-image-row-item img {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: brightness(.82) saturate(.9);
  }

  .about-profile-section {
    padding-top: calc(var(--about-section-space) + var(--spacing-3xl));
  }

  .about-profile-image {
    position: relative;
    z-index: 1;
    grid-row: 1;
    min-height: clamp(40rem, 60vw, 56rem);
    margin: 0;
    margin-left: calc(50% - 50vw);
    overflow: hidden;
  }

  .about-profile-image::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgba(var(--ds-background-rgb), .22), transparent 45%),
      linear-gradient(180deg, transparent 42%, rgba(var(--ds-background-rgb), .36));
  }

  .about-profile-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(.82) saturate(.9);
  }

  .about-profile-rows {
    position: relative;
    z-index: 2;
    display: grid;
    grid-row: 1;

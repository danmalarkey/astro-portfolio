---
import HomeFooter from "../components/HomeFooter.astro";
import Header from "../layouts/Header.astro";
import Layout from "../layouts/Layout.astro";

const baseUrl = Astro.url.pathname.startsWith('/astro-portfolio') ? '/astro-portfolio/' : '/';
const withBase = (path: string) => `${baseUrl}${path.startsWith('/') ? path.slice(1) : path}`;

const profileRows = [
  {
    number: '01',
    eyebrow: 'Current role',
    title: 'Chief Product Designer at feature[23]',
    text: 'Leading product design across complex software engagements with executives, product leaders, designers, and engineers.'
  },
  {
    number: '02',
    eyebrow: 'Scope',
    title: 'Product design, systems, standards, and delivery',
    text: 'Strategy, workshops, workflow modeling, design systems, accessibility, AI-enabled exploration, and implementation support.'
  },
  {
    number: '03',
    eyebrow: 'Operating context',
    title: 'Operational software and middle-market complexity',
    text: 'Where business goals, human activity, technology, compliance, and delivery constraints need to stay connected.'
  }
];

const workMethods = [
  {
    number: '01',
    title: 'Define direction',
    text: 'Clarify the product, business, and organizational choices before delivery accelerates.'
  },
  {
    number: '02',
    title: 'Model the system',
    text: 'Map roles, activities, workflows, rules, and behavior before teams design from assumptions.'
  },
  {
    number: '03',
    title: 'Strengthen the standard',
    text: 'Connect design systems, accessibility, ethical standards, implementation guidance, and governance.'
  },
  {
    number: '04',
    title: 'Support delivery',
    text: 'Stay close to the build to reduce drift and help teams move with confidence.'
  }
];

const operatingContexts = [
  {
    title: 'Regulated and operational systems',
    text: 'Insurance, logistics, nonprofit services, food distribution, and financial workflows.'
  },
  {
    title: 'Product and delivery systems',
    text: 'Design systems, delivery environments, implementation guidance, and reusable product infrastructure.'
  },
  {
    title: 'AI-enabled workflows',
    text: 'AI-assisted concepting, product exploration, documentation, and delivery workflows.'
  }
];
---

<Layout
  title="About Dan Malarkey | Product Design, Systems, and Delivery Leadership"
  description="About Dan Malarkey, a Chief Product Designer focused on clarity, systems, standards, accessibility, AI-enabled work, and responsible execution."
>
  <Header />
  <main class="about-page">
    <section class="about-hero" aria-labelledby="about-hero-title" style={`--about-hero-image: url('${withBase('/images/about/dan-drillstack.png')}')`}>
      <div class="about-hero-field" aria-hidden="true"></div>
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <div class="about-hero-copy gc-start-2 gc-span-18">
          <p class="about-kicker">About Dan</p>
          <h1 id="about-hero-title">Clarity, systems, and responsible execution.</h1>
          <div class="about-hero-body">
            <p>
              I’m a Chief Product Designer with 17+ years of experience across product design, operational software, design systems, accessibility, and delivery.
            </p>
            <p>
              For the last 14 years, I’ve helped shape product direction and design practice at feature[23], working where business goals, human activity, technology, and implementation need to hold together.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="about-section about-profile" aria-labelledby="about-profile-title">
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <figure class="about-profile-media gc-start-2 gc-span-11">
          <img src={withBase('/images/dan-right.png')} alt="Dan leading a whiteboard session with a product team" loading="lazy" decoding="async" />
        </figure>

        <div class="about-profile-panel gc-start-15 gc-span-10">
          <div class="about-profile-rows" role="list">
            {profileRows.map((item, index) => (
              <article class="about-profile-row" role="listitem">
                <p class="about-row-index">{item.number}</p>
                <div>
                  <p class="about-row-eyebrow">{item.eyebrow}</p>
                  <h3 id={index === 0 ? 'about-profile-title' : undefined}>{item.title}</h3>
                  <p>{item.text}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="about-section about-editorial about-origin" aria-labelledby="about-origin-title">
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <div class="about-section-head gc-start-2 gc-span-8">
          <p class="about-kicker">How I got here</p>
          <h2 id="about-origin-title">I came to design through structure.</h2>
        </div>
        <div class="about-copy-block gc-start-12 gc-span-12">
          <p>
            I originally wanted to be an architect. What pulled me into design was the same underlying discipline: structure, proportion, typography, grid systems, and the clarity of Swiss design and mid-century modernism.
          </p>
          <p>
            That foundation still shapes how I work. I care about how things look, but I care more about whether the thinking holds. Good design is not decoration around a decision. It is the discipline that helps people understand what the decision should be.
          </p>
          <div class="about-copy-subsection">
            <h3>The most important design work often happens before the screen.</h3>
          </div>
          <p>
            Early in my career, I realized the visible product is only one expression of a much larger system. The business, the human activity, and the technology all have to stay in balance. When one side is ignored, the system tips.
          </p>
          <p>
            That changed how I understood design. The work was not only about making the product easier to use. It was about helping teams understand what should be built, how it should work, what constraints mattered, and how decisions would hold up once the system moved into delivery.
          </p>
        </div>
      </div>
    </section>

    <section class="about-archive" aria-labelledby="about-archive-title">
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <figure class="about-archive-media gc-start-3 gc-span-8">
          <img src={withBase('/images/about/about-songlinkr.jpg')} alt="Archived client session artifact from 2016" loading="lazy" decoding="async" />
        </figure>
        <div class="about-archive-copy gc-start-13 gc-span-10">
          <p class="about-kicker">From the archives</p>
          <h2 id="about-archive-title">The tools have changed. The work has not.</h2>
          <p class="about-archive-note">From a client session, 2016.</p>
          <p>
            Make the model visible. Explain the tradeoffs. Help the room understand what needs to happen next.
          </p>
        </div>
      </div>
    </section>

    <section class="about-section about-responsibility" aria-labelledby="about-responsibility-title">
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <div class="about-section-head gc-start-2 gc-span-8">
          <p class="about-kicker">Craft and responsibility</p>
          <h2 id="about-responsibility-title">Rigor is an ethical concern.</h2>
        </div>
        <div class="about-copy-block gc-start-12 gc-span-12">
          <p>
            I care about craft because the details reveal the thinking behind the work. But rigor is not just polish. Rigor is how teams move beyond preference, bias, and assumption. It is how evidence, accessibility, standards, and responsible judgment become part of the way products are shaped.
          </p>
          <p>
            The stronger the rigor, the more trust the work can carry — with executives, stakeholders, teams, and the people who depend on the systems we build.
          </p>
        </div>
      </div>
    </section>

    <section class="about-section about-work" aria-labelledby="about-work-title">
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <div class="about-section-head gc-start-2 gc-span-9">
          <p class="about-kicker">How I work</p>
          <h2 id="about-work-title">I turn ambiguity into structure teams can use.</h2>
        </div>
        <div class="about-copy-block gc-start-13 gc-span-11">
          <p>
            I help teams clarify direction, model the system, strengthen the standard, and stay close enough to delivery to protect intent.
          </p>
        </div>

        <div class="about-method-grid gc-start-2 gc-span-24" role="list">
          {workMethods.map((item) => (
            <article class="about-method-card" role="listitem">
              <p>{item.number}</p>
              <h3>{item.title}</h3>
              <span>{item.text}</span>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="about-section about-context" aria-labelledby="about-context-title">
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <div class="about-section-head gc-start-2 gc-span-9">
          <p class="about-kicker">Where this shows up</p>
          <h2 id="about-context-title">The work often lives inside complex operating environments.</h2>
        </div>
        <div class="about-copy-block gc-start-13 gc-span-11">
          <p>
            I’ve worked across insurance, logistics, food distribution, franchise operations, nonprofit services, restaurant commerce, financial workflows, and internal product infrastructure. The industries change. The pattern is consistent: business goals, product behavior, standards, and delivery choices need to stay connected.
          </p>
        </div>

        <div class="about-context-list gc-start-2 gc-span-24" role="list">
          {operatingContexts.map((item) => (
            <article class="about-context-row" role="listitem">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="about-section about-mentoring" aria-labelledby="about-mentoring-title">
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <div class="about-section-head gc-start-2 gc-span-8">
          <p class="about-kicker">Leadership and mentoring</p>
          <h2 id="about-mentoring-title">I care about helping designers become clearer thinkers.</h2>
        </div>
        <div class="about-copy-block gc-start-12 gc-span-12">
          <p>
            A large part of my work is helping designers, product teams, and engineering partners understand how strong design decisions are made: how to frame problems, explain tradeoffs, use evidence, and protect quality when the work becomes complicated.
          </p>
        </div>
      </div>
    </section>

  </main>

  <HomeFooter
    eyebrow="Work with me"
    title="If the work needs clearer direction and stronger systems, let’s talk."
    body="I’m usually a strong fit when business goals, product direction, technology, standards, and delivery need to move together."
    ctaLabel="Start a conversation"
  />
</Layout>

<style>
  .about-page {
    --about-shell-gutter: var(--ds-mobile-content-gutter);
    --about-section-space: clamp(var(--spacing-3xl), 8vw, calc(var(--spacing-4xl) + var(--spacing-3xl)));
    --about-panel-space: clamp(var(--spacing-lg), 4vw, var(--spacing-3xl));
    --about-hero-bottom-space: clamp(var(--spacing-3xl), 7vw, calc(var(--spacing-4xl) + var(--spacing-lg)));
    --about-hero-image-size: min(48rem, 54vw);
    --about-hero-image-offset: max(calc(var(--spacing-4xl) * -1.5), -6vw);
    --about-hero-image-opacity: 0.62;
    --about-hero-dot-size: 1rem;
    --about-profile-media-height: clamp(24rem, 34vw, 34rem);
    --about-profile-row-space: var(--spacing-md);
    --about-rule: var(--ds-border-soft);
    --about-accent: var(--color-tag-text-accent);
    --about-surface: rgba(var(--ds-surface-panel-rgb), 0.72);
    position: relative;
    overflow: hidden;
    padding-inline: 0;
    background:
      radial-gradient(ellipse at 72% 0%, color-mix(in srgb, var(--about-accent) 16%, transparent), transparent 34rem),
      radial-gradient(ellipse at 10% 18%, var(--ds-surface-strong), transparent 28rem),
      var(--ds-background);
    color: var(--ds-text);
  }

  .about-hero,
  .about-section,
  .about-archive {
    position: relative;
    padding: var(--about-section-space) 0;
  }

  .about-hero {
    display: grid;
    isolation: isolate;
    align-items: end;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    min-height: 100vh;
    min-height: 100dvh;
    margin-inline: calc(50% - 50vw);
    padding: 0 0 var(--about-hero-bottom-space);
    box-sizing: border-box;
    border-bottom: var(--size-border-thin) solid var(--about-rule);
    background:
      radial-gradient(ellipse at 74% 4%, color-mix(in srgb, var(--about-accent) 20%, transparent), transparent 36rem),
      radial-gradient(ellipse at 8% 22%, var(--ds-surface-strong), transparent 30rem),
      var(--ds-background);
  }

  .about-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    opacity: 0.63;
    background: radial-gradient(circle, color-mix(in srgb, var(--ds-text) 10%, transparent) 0 var(--size-border-thin), transparent calc(var(--size-border-thin) + 0.025rem)) left top / var(--about-hero-dot-size) var(--about-hero-dot-size) repeat;
    mask-image: linear-gradient(90deg, black 0 46%, transparent 68%);
    animation: about-hero-dots-enter 1200ms ease 260ms both;
  }

  .about-hero-field {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background:
      radial-gradient(ellipse at 78% 42%, color-mix(in srgb, var(--about-accent) 14%, transparent), transparent 34rem),
      linear-gradient(180deg, rgba(var(--ds-background-rgb), 0.08), var(--ds-background)),
      linear-gradient(90deg, rgba(var(--ds-background-rgb), 0.98), rgba(var(--ds-background-rgb), 0.78) 48%, rgba(var(--ds-background-rgb), 0.9));
  }

  .about-hero-field::before {
    content: "";
    position: absolute;
    top: 8%;
    right: var(--about-hero-image-offset);
    width: var(--about-hero-image-size);
    aspect-ratio: 1;
    background-image: var(--about-hero-image);
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    filter: brightness(0.62) saturate(0.94);
    opacity: var(--about-hero-image-opacity);
    transform: translate3d(1.25rem, 0, 0) rotate(-2deg) scale(1.015);
    mask-image: radial-gradient(ellipse at 50% 50%, black 0 48%, rgba(0, 0, 0, 0.72) 66%, transparent 84%);
    animation: about-hero-image-enter 1200ms ease 180ms both;
  }

  .about-hero-field::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 76% 42%, rgba(var(--ds-background-rgb), 0.02), rgba(var(--ds-background-rgb), 0.42) 54%, rgba(var(--ds-background-rgb), 0.84) 82%),
      linear-gradient(90deg, rgba(var(--ds-background-rgb), 0.98) 0%, rgba(var(--ds-background-rgb), 0.72) 46%, rgba(var(--ds-background-rgb), 0.2) 74%, rgba(var(--ds-background-rgb), 0.64) 100%);
    mask-image: none;
  }

  .about-hero-copy,
  .about-profile-media,
  .about-profile-panel,
  .about-section-head,
  .about-copy-block,
  .about-archive-media,
  .about-archive-copy,
  .about-method-grid,
  .about-context-list {
    position: relative;
    z-index: 1;
  }

  .about-hero-copy {
    z-index: 2;
    opacity: 0;
    transform: translateY(1rem);
    animation: about-hero-copy-enter 820ms ease 220ms both;
  }

  .about-kicker {
    margin: 0;
    color: var(--about-accent);
    font-size: var(--ds-type-label);
    font-weight: var(--font-weight-medium);
    line-height: var(--ds-line-label);
    letter-spacing: var(--ds-tracking-label);
    text-transform: uppercase;
  }

  .about-hero h1,
  .about-section-head h2,
  .about-archive h2 {
    margin: 0;
    color: var(--ds-text);
    font-family: var(--font-family-display);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--ds-tracking-title);
    text-wrap: balance;
  }

  .about-hero h1 {
    max-width: 12ch;
    margin-top: var(--spacing-lg);
    font-size: var(--ds-type-title-xl);
    line-height: 0.94;
  }

  .about-hero-body {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--spacing-md);
    max-width: 54rem;
    margin-top: clamp(var(--spacing-xl), 4vw, var(--spacing-3xl));
  }

  .about-hero-body p,
  .about-copy-block p,
  .about-archive-copy > p {
    margin: 0;
    color: var(--ds-text-muted);
    font-size: var(--ds-type-lead);
    line-height: var(--ds-line-lead);
    letter-spacing: var(--ds-tracking-text);
    text-wrap: pretty;
  }

  .about-profile {
    border-bottom: var(--size-border-thin) solid var(--about-rule);
  }

  @keyframes about-hero-copy-enter {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes about-hero-image-enter {
    from {
      opacity: 0;
      transform: translate3d(1.25rem, 0, 0) rotate(-2deg) scale(1.015);
    }

    to {
      opacity: var(--about-hero-image-opacity);
      transform: translate3d(0, 0, 0) rotate(-2deg) scale(1);
    }
  }

  @keyframes about-hero-dots-enter {
    from {
      opacity: 0;
    }

    to {
      opacity: 0.63;
    }
  }

  .about-profile > .dm-grid-l {
    align-items: stretch;
  }

  .about-profile-media {
    min-height: var(--about-profile-media-height);
    margin: 0;
    overflow: hidden;
    border: var(--size-border-thin) solid var(--ds-border-soft);
    border-radius: var(--radius-panel);
    background: var(--about-surface);
    box-shadow: var(--ds-shadow);
  }

  .about-profile-media img,
  .about-archive-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-profile-media img {
    object-position: center 44%;
    filter: brightness(0.7) saturate(1.02);
  }

  .about-profile-panel {
    display: grid;
    align-content: start;
  }

  .about-section-head {
    display: grid;
    align-content: start;
    gap: var(--ds-section-header-gap);
  }

  .about-section-head h2,
  .about-archive h2 {
    font-size: var(--ds-type-title-lg);
    line-height: var(--ds-line-card-title);
  }

  .about-profile-rows,
  .about-context-list {
    display: grid;
  }

  .about-context-list {
    border-top: var(--size-border-thin) solid var(--about-rule);
  }

  .about-profile-row {
    display: grid;
    grid-template-columns: minmax(2.5rem, 0.16fr) minmax(0, 0.84fr);
    gap: var(--spacing-md);
    padding: var(--about-profile-row-space) 0;
  }

  .about-profile-row + .about-profile-row {
    border-top: var(--size-border-thin) solid var(--about-rule);
  }

  .about-profile-row:first-child {
    padding-top: 0;
  }

  .about-row-index,
  .about-row-eyebrow,
  .about-method-card > p {
    margin: 0;
    color: var(--about-accent);
    font-size: var(--ds-type-label);
    font-weight: var(--font-weight-medium);
    line-height: var(--ds-line-label);
    letter-spacing: var(--ds-tracking-label);
    text-transform: uppercase;
  }

  .about-profile-row h3,
  .about-method-card h3,
  .about-context-row h3 {
    margin: 0;
    color: var(--ds-text);
    font-size: var(--ds-type-card-title-compact);
    font-weight: var(--font-weight-regular);
    line-height: var(--ds-line-card-title);
    letter-spacing: var(--ds-tracking-card);
    text-wrap: balance;
  }

  .about-profile-row h3 {
    margin-top: var(--spacing-xs);
  }

  .about-profile-row p:not(.about-row-index, .about-row-eyebrow),
  .about-method-card span,
  .about-context-row p {
    display: block;
    margin: var(--spacing-sm) 0 0;
    color: var(--ds-text-muted);
    font-size: var(--ds-type-body-sm);
    line-height: var(--ds-line-body-compact);
    letter-spacing: var(--ds-tracking-text);
    text-wrap: pretty;
  }

  .about-copy-subsection {
    margin-top: var(--spacing-lg);
    padding-top: var(--spacing-lg);
    border-top: var(--size-border-thin) solid var(--about-rule);
  }

  .about-copy-subsection h3 {
    max-width: 18ch;
    margin: 0;
    color: var(--ds-text);
    font-size: var(--ds-type-title-sm);
    font-weight: var(--font-weight-regular);
    line-height: var(--ds-line-section-title-compact);
    letter-spacing: var(--ds-tracking-title);
    text-wrap: balance;
  }

  .about-editorial,
  .about-responsibility,
  .about-work,
  .about-context,
  .about-mentoring {
    border-bottom: var(--size-border-thin) solid var(--about-rule);
  }

  .about-copy-block {
    display: grid;
    gap: var(--spacing-md);
  }

  .about-archive {
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.018), rgba(255, 255, 255, 0.006)),
      rgba(var(--ds-surface-panel-rgb), 0.38);
    border-bottom: var(--size-border-thin) solid var(--about-rule);
  }

  .about-archive > .dm-grid-l {
    align-items: center;
  }

  .about-archive-media {
    aspect-ratio: 1;
    margin: 0;
    overflow: hidden;
    border: var(--size-border-thin) solid var(--ds-border-soft);
    border-radius: var(--radius-panel);
    background: var(--about-surface);
  }

  .about-archive-media img {
    filter: brightness(0.72) saturate(0.95);
  }

  .about-archive-copy {
    display: grid;
    gap: var(--ds-section-header-gap);
    max-width: 42rem;
  }

  .about-archive-note {
    color: var(--ds-text-soft);
    font-size: var(--ds-type-body-sm);
  }

  .about-method-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--spacing-sm);
    margin-top: var(--ds-section-content-gap);
  }

  .about-method-card {
    display: grid;
    align-content: start;
    min-height: 20rem;
    padding: clamp(var(--spacing-md), 2.5vw, var(--spacing-xl));
    border: var(--size-border-thin) solid var(--ds-border-soft);
    border-radius: var(--radius-panel);
    background:
      radial-gradient(ellipse at 100% 0%, color-mix(in srgb, var(--about-accent) 16%, transparent), transparent 16rem),
      linear-gradient(180deg, var(--ds-surface-strong), color-mix(in srgb, var(--ds-surface) 64%, transparent)),
      rgba(var(--ds-surface-panel-rgb), 0.92);
  }

  .about-method-card h3 {
    margin-top: var(--spacing-lg);
  }

  .about-context-list {
    margin-top: var(--ds-section-content-gap);
  }

  .about-context-row {
    display: grid;
    grid-template-columns: minmax(14rem, 0.32fr) minmax(0, 0.68fr);
    gap: var(--spacing-xl);
    padding: var(--spacing-xl) 0;
    border-bottom: var(--size-border-thin) solid var(--about-rule);
  }

  .about-context-row p {
    max-width: 62ch;
    margin-top: 0;
  }

  @media (max-width: 78rem) {
    .about-hero-copy,
    .about-profile-media,
    .about-profile-panel,
    .about-section-head,
    .about-copy-block,
    .about-archive-media,
    .about-archive-copy,
    .about-method-grid,
    .about-context-list {
      grid-column: 2 / span 24;
    }

    .about-profile > .dm-grid-l {

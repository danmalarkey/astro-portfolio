---
import Layout from "../layouts/Layout.astro";
import Header from "../layouts/Header.astro";
import ButtonLink from "../components/ButtonLink.astro";
import PageIntro from "../components/PageIntro.astro";

const baseUrl = Astro.url.pathname.startsWith('/astro-portfolio') ? '/astro-portfolio/' : '/';
const withBase = (path: string) => `${baseUrl}${path.startsWith('/') ? path.slice(1) : path}`;

const workEntries = [
  {
    eyebrow: "Case study shell",
    title: "Insurance platform transformation",
    description: "Exec-first case study structure for a mission-critical platform transformation spanning internal operations and member-facing experience work.",
    path: "/work/insurance-platform-transformation",
    status: "Shell / public-safe draft"
  }
];
---

<Layout title="Work | Dan Malarkey">
  <Header />
  <main>
    <section class="section section-panel section-surface--dark">
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <PageIntro
          eyebrow="Work"
          title="Case studies built around decisions, systems, and business impact."
          body="Outcome-led case studies and selected leadership engagements are being assembled here. The homepage currently highlights the proof themes and business outcomes."
          meta="This page will focus on decisions, systems, and business impact, not just polished UI outputs. Some examples are anonymized and attributed to work delivered through feature[23] where relevant."
          titleClass="text-white"
        />
      </div>
    </section>

    <section class="section section-panel section-surface--warm">
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <div class="gc-start-2 gc-span-24 about-a-rows work-list-rows" role="list" aria-label="Work entries">
          {workEntries.map((entry) => (
            <article class="work-list-row" role="listitem">
              <div class="work-list-row-main">
                <p class="section-intro-eyebrow">{entry.eyebrow}</p>
                <h2 class="work-list-row-title">{entry.title}</h2>
                <p class="work-list-row-description">{entry.description}</p>
                <p class="work-list-row-meta">{entry.status}</p>
              </div>
              <div class="work-list-row-actions">
                <ButtonLink href={withBase(entry.path)} variant="primary" showArrow={true}>Open case study</ButtonLink>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>

---
import Layout from "../layouts/Layout.astro";
import Header from "../layouts/Header.astro";
---

<Layout title="Work | Dan Malarkey">
  <Header />
  <main>
    <section class="section section-panel section-surface--dark">
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <div class="gc-start-2 gc-span-18">
          <h1 class="section-title text-white">Work</h1>
          <p>
            Outcome-led case studies and selected leadership engagements are being assembled here.
            The homepage currently highlights the proof themes and business outcomes.
          </p>
          <p class="small-text">
            This page will focus on decisions, systems, and business impact, not just polished UI outputs.
          </p>
        </div>
      </div>
    </section>
  </main>
</Layout>

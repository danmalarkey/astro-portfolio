---
import FocusDiagnosticList from "../components/FocusDiagnosticList.astro";
import HomeFooter from "../components/HomeFooter.astro";
import PinnedStackCards from "../components/PinnedStackCards.astro";
import SectionHeader from "../components/SectionHeader.astro";
import Header from "../layouts/Header.astro";
import Layout from "../layouts/Layout.astro";

const baseUrl = Astro.url.pathname.startsWith("/astro-portfolio") ? "/astro-portfolio/" : "/";
const withBase = (path: string) => `${baseUrl}${path.startsWith("/") ? path.slice(1) : path}`;

const profileRows = [
  {
    number: "01",
    label: "Current role",
    title: "Chief Product Designer at feature[23]",
    titleLines: ["Chief Product Designer", "at feature[23]"],
    body: "Growing design capabilities with executives, product leaders, designers, and engineers, helping teams stay focused on people, outcomes, and responsible execution.",
  },
  {
    number: "02",
    label: "Scope",
    title: "Product design, systems, standards, and delivery",
    titleLines: ["Product design, systems,", "standards, and delivery"],
    body: "Strategy, workshops, workflow modeling, design systems, accessibility, AI-enabled exploration, and implementation support.",
  },
  {
    number: "03",
    label: "Operating context",
    title: "Operational software and middle-market companies",
    titleLines: ["Operational software", "and middle-market companies"],
    body: "Where business goals, human activity, technology, compliance, and delivery constraints need to stay connected.",
  }
];

const designPrinciples = [
  {
    title: "Clarity before execution",
    body: "I believe teams make better decisions when they understand what they are trying to make true before they start moving too quickly. Clarity is not a delay. It is what keeps effort from scattering.",
  },
  {
    title: "The model matters",
    body: "Every product carries an underlying model: the business goal, the people involved, the work being done, the rules of the system, and the decisions that shape behavior. When that model is unclear, the product becomes harder to explain, build, use, and sustain.",
  },
  {
    title: "Human activity comes first",
    body: "I care less about starting with artifacts and more about understanding what people are trying to do. Goals, jobs, decisions, workflows, and constraints matter because they explain what the system needs to support.",
  },
  {
    title: "Systems over isolated outputs",
    body: "A strong feature can still create problems if it does not fit the system around it. I try to understand how decisions connect across product direction, workflows, standards, implementation, and the teams responsible for carrying the work forward.",
  },
  {
    title: "Standards protect the work",
    body: "Standards are not decoration or process for its own sake. They help teams make better decisions repeatedly. They protect accessibility, consistency, quality, and trust when more people become involved in the work.",
  },
  {
    title: "Rigor is responsibility",
    body: "Craft matters, but rigor is larger than polish. It is the discipline of asking better questions, using evidence, understanding constraints, and making decisions that can be defended beyond preference.",
  },
  {
    title: "Accessibility is part of the foundation",
    body: "Accessibility is not a late-stage checklist. It belongs inside the standards, decisions, and expectations that shape the product from the beginning.",
  },
  {
    title: "Design should make teams stronger",
    body: "I believe good design practice should improve how teams think, not only what they produce. Designers, product leaders, engineers, and stakeholders should leave the work with a clearer understanding of the problem, the tradeoffs, and the decisions being made.",
  },
  {
    title: "AI needs direction",
    body: "AI does not remove the need for design judgment. It increases the need for clarity, standards, and responsible decision-making. The goal is not to produce more disconnected outputs. The goal is to shape useful systems people can understand, trust, and operate.",
  }
];
---

<Layout
  title="About Dan Malarkey | Product Design, Systems, and Delivery Leadership"
  description="About Dan Malarkey, a Chief Product Designer focused on clarity, systems, standards, accessibility, AI-enabled work, and responsible execution."
>
  <Header />

  <main class="about-v2-page">
    <section class="about-v2-hero" aria-labelledby="about-v2-hero-title" style={`--about-v2-hero-image: url('${withBase("/images/about/dan-drillstack.png")}')`} data-motion-reveal>
      <div class="about-v2-hero-field" aria-hidden="true"></div>
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <div class="about-v2-hero-copy gc-start-2 gc-span-12">
          <p class="about-v2-kicker">About Dan</p>
          <h1 id="about-v2-hero-title">Hey. I'm Dan Malarkey.</h1>
          <div class="about-v2-hero-body">
            <p>
              I’m a Chief Product Designer with 17+ years across product design, operational software, design systems, accessibility, and delivery.
            </p>
            <p>
              For the last 14 years, I’ve helped shape product direction and design practice at feature[23]. I balance business goals, human activity, technology, standards, and implementation so decisions can safely move the business forward.
            </p>
          </div>
        </div>
      </div>
    </section>

    {false && (
    <section class="about-v2-section about-v2-profile-section" aria-label="Profile snapshot" data-motion-reveal>
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <aside class="about-v2-operating-profile gc-start-2 gc-span-24" aria-label="Profile snapshot" data-motion-item>
          <div class="about-v2-profile-head">
            <figure class="about-v2-profile-image">
              <img src={withBase("/images/dan.png")} alt="Dan working through product structure with a team at a whiteboard" loading="lazy" decoding="async" />
            </figure>
          </div>
          <div class="about-v2-profile-rows" role="list">
            {profileRows.map((item) => (
              <article class="about-v2-profile-row" role="listitem">
                <p class="about-v2-profile-index">{item.number} {item.label}</p>
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.body}</p>
                </div>
              </article>
            ))}
          </div>
        </aside>
      </div>
    </section>
    )}

    <section class="about-v2-section about-v2-profile-section" aria-label="Profile snapshot">
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <PinnedStackCards
          className="gc-start-2 gc-span-24"
          items={profileRows.map((item) => ({
            title: item.title,
            titleLines: item.titleLines,
            eyebrow: item.label,
            body: item.body
          }))}
        />
      </div>
    </section>

    <section class="about-v2-section about-v2-story-section" aria-labelledby="about-v2-story-title" data-motion-reveal>
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <article class="about-v2-article about-v2-article--split dm-grid-l dm-grid-l--grid-sys gc-start-2 gc-span-24" data-motion-item>
          <figure class="about-v2-practitioner-image gc-start-11 gc-span-16" aria-hidden="true">
            <img src={withBase("/images/dan.png")} alt="" loading="lazy" decoding="async" />
          </figure>
          <div class="about-v2-article-columns about-v2-article-columns--overlay gc-start-3 gc-span-13">
            <div class="about-v2-article-head">
              <p class="about-v2-kicker">Clarity, Systems, and Responsible Execution</p>
              <h2 id="about-v2-story-title">I’m a practitioner of clarity.</h2>
            </div>
            <p>
              I've committed my career to the craft and rigor of helping middle-market businesses move forward. More than anything, I'm a practitioner of clarity. I believe strong design connects business goals, human activity, and team capability into systems that can carry an organization further than any individual feature or initiative. Systems matter because disconnected decisions create drift, and drift quietly undermines progress.
            </p>
            <p>
              I believe good design leadership starts with understanding. Ask better questions. Understand constraints. Help people see the situation more clearly. When teams share the same understanding of the problem, they make better decisions with greater confidence. Responsible execution starts earlier than implementation. It starts with diagnosis, planning, alignment, and the decisions teams make before the work becomes expensive to change. That is the throughline of my work: clarity, systems, and the judgment to carry decisions forward responsibly.
            </p>
          </div>
        </article>
      </div>
    </section>

    <section class="about-v2-section about-v2-image-section" aria-label="Personal image row" data-motion-reveal>
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <div class="about-v2-image-row gc-start-2 gc-span-24" data-motion-item>
          <figure class="about-v2-image-row-item">
            <img src={withBase("/images/about/drillstack-group.JPG")} alt="Dan with a group during a working session" loading="lazy" decoding="async" />
          </figure>
          <figure class="about-v2-image-row-item">
            <img src={withBase("/images/about/asheville-pic.JPG")} alt="Dan outside in Asheville" loading="lazy" decoding="async" />
          </figure>
          <figure class="about-v2-image-row-item">
            <img src={withBase("/images/about/me-lola.JPG")} alt="Dan with Lola" loading="lazy" decoding="async" />
          </figure>
        </div>
      </div>
    </section>

    <section class="about-v2-section about-v2-principles-section" aria-labelledby="about-v2-principles-title" data-motion-reveal>
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <SectionHeader
          eyebrow="Design Principles"
          title="The principles behind how I think, lead, and evaluate design."
          headingId="about-v2-principles-title"
          headClass="gc-start-2 gc-span-10"
          reveal
        />
        <div class="about-v2-article about-v2-principles gc-start-12 gc-span-14" data-motion-item>
          <FocusDiagnosticList
            items={designPrinciples.map(({ title, body }) => ({ title, text: body }))}
            className="about-v2-principles-list"
          />
        </div>
      </div>
    </section>

    <section class="about-v2-section about-v2-practice-section" aria-labelledby="about-v2-practice-title" data-motion-reveal>
      <div class="dm-grid-l dm-grid-l--grid-sys">
        <SectionHeader
          eyebrow="Practice and Principles"
          title="The tools keep changing. The responsibility has not."
          headingId="about-v2-practice-title"
          headClass="about-v2-practice-head gc-start-2 gc-span-8"
          reveal
        />
        <article class="about-v2-article about-v2-practice-copy gc-start-12 gc-span-8" data-motion-item>
          <p>Most of my career has been spent in the space between business direction and delivery.</p>
          <p>That space can get messy quickly. Teams need to understand the goal, the people involved, the work that has to happen, the constraints around it, and the standards that should guide decisions along the way. A large part of my practice has been built around making those things visible. Not just producing artifacts, but creating the models, language, systems, and shared understanding teams need before the work moves too far downstream. That is also how I think about design leadership. The goal is not to make design louder. The goal is to make design more useful: clearer reasoning, stronger standards, better questions, better tradeoffs, and fewer decisions made in isolation.</p>
          <p>The tools keep changing. The responsibility has not. Make the model visible. Explain the tradeoffs. Understand the constraints. Protect the standard. Help the people around the work understand what needs to happen next. That has been true in client sessions years ago. It is still true in the AI-enabled work happening now.</p>
        </article>
        <div class="about-v2-practice-media gc-start-21 gc-span-5" data-motion-item>
          <figure class="about-v2-practice-archive">
            <img src={withBase("/images/about/about-songlinkr.jpg")} alt="Archived client session from 2016" loading="lazy" decoding="async" />
            <figcaption>
              <span>Archived client session, 2016</span>
              Make the model visible. Explain the tradeoffs. Help the room understand what needs to happen next.
            </figcaption>
          </figure>
        </div>
      </div>
    </section>
  </main>

  <HomeFooter
    eyebrow="Work with me"
    title="If the work needs clearer direction and stronger systems, let’s talk."
    body="I’m usually a strong fit when business goals, product direction, technology, standards, and delivery need to move together."
    ctaLabel="Start a conversation"
  />
</Layout>

<style>
  .about-v2-page {
    --about-v2-section-space: calc(var(--spacing-4xl) + var(--spacing-3xl));
    --about-v2-rule: var(--ds-border-soft);
    --about-v2-accent: var(--color-tag-text-accent);
    --about-v2-paper: #eee8dc;
    --about-v2-paper-ink: #171512;
    --about-v2-paper-muted: rgba(23, 21, 18, .7);
    --about-v2-hero-image-size: min(48rem, 54vw);
    --about-v2-hero-image-offset: max(calc(var(--spacing-4xl) * -1.35), -5vw);
    position: relative;
    overflow-x: clip;
    overflow-y: visible;
    padding: 0;
    color: var(--ds-text);
  }

  .about-v2-hero,
  .about-v2-section {
    position: relative;
    padding: var(--about-v2-section-space) 0;
  }

  .about-v2-hero {
    display: grid;
    isolation: isolate;
    align-items: end;
    width: 100vw;
    min-height: 100vh;
    min-height: 100dvh;
    margin-inline: calc(50% - 50vw);
    padding: 0 0 clamp(var(--spacing-3xl), 7vw, calc(var(--spacing-4xl) + var(--spacing-lg)));
    box-sizing: border-box;
    border-bottom: var(--size-border-thin) solid var(--about-v2-rule);
    background:
      radial-gradient(ellipse at 74% 4%, color-mix(in srgb, var(--about-v2-accent) 20%, transparent), transparent 36rem),
      radial-gradient(ellipse at 8% 22%, var(--ds-surface-strong), transparent 30rem),
      var(--ds-background);
  }

  .about-v2-hero-field {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background:
      radial-gradient(ellipse at 78% 42%, color-mix(in srgb, var(--about-v2-accent) 14%, transparent), transparent 34rem),
      linear-gradient(180deg, rgba(var(--ds-background-rgb), .08), var(--ds-background)),
      linear-gradient(90deg, rgba(var(--ds-background-rgb), .98), rgba(var(--ds-background-rgb), .78) 48%, rgba(var(--ds-background-rgb), .9));
  }

  .about-v2-hero-field::before {
    content: "";
    position: absolute;
    top: 8%;
    right: var(--about-v2-hero-image-offset);
    width: var(--about-v2-hero-image-size);
    aspect-ratio: 1;
    background-image: var(--about-v2-hero-image);
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    filter: brightness(.62) saturate(.94);
    opacity: .62;
    transform: rotate(-2deg) scale(1.015);
    mask-image: radial-gradient(ellipse at 50% 50%, black 0 48%, rgba(0, 0, 0, .72) 66%, transparent 84%);
  }

  .about-v2-hero-field::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 76% 42%, rgba(var(--ds-background-rgb), .02), rgba(var(--ds-background-rgb), .42) 54%, rgba(var(--ds-background-rgb), .84) 82%),
      linear-gradient(90deg, rgba(var(--ds-background-rgb), .98) 0%, rgba(var(--ds-background-rgb), .72) 46%, rgba(var(--ds-background-rgb), .2) 74%, rgba(var(--ds-background-rgb), .64) 100%);
  }

  .about-v2-hero-copy,
  .about-v2-story-panel,
  .about-v2-archive-media,
  .about-v2-archive-copy,
  .about-v2-profile-head,
  .about-v2-profile-rows {
    position: relative;
    z-index: 1;
  }

  .about-v2-kicker,
  .about-v2-profile-index {
    margin: 0;
    color: var(--about-v2-accent);
    font-size: var(--ds-type-label);
    font-weight: var(--font-weight-medium);
    line-height: var(--ds-line-label);
    letter-spacing: var(--ds-tracking-label);
    text-transform: uppercase;
  }

  .about-v2-page h1,
  .about-v2-page h2,
  .about-v2-page h3 {
    margin: 0;
    font-family: var(--font-family-display);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--ds-tracking-title);
    text-wrap: balance;
  }

  .about-v2-hero h1 {
    max-width: 16ch;
    margin-top: var(--spacing-lg);
    color: var(--ds-text);
    font-size: var(--ds-type-title-xl);
    line-height: .94;
  }

  .about-v2-hero-body {
    max-width: 42rem;
    margin-top: clamp(var(--spacing-xl), 4vw, var(--spacing-3xl));
  }

  .about-v2-hero-body p + p {
    margin-top: var(--spacing-md);
  }

  .about-v2-hero-body p,
  .about-v2-archive-copy > p,
  .about-v2-profile-row p:not(.about-v2-profile-index) {
    margin: 0;
    color: var(--ds-text-muted);
    font-size: var(--ds-type-lead);
    line-height: var(--ds-line-lead);
    letter-spacing: var(--ds-tracking-text);
    text-wrap: pretty;
  }

  .about-v2-story {
    border-bottom: var(--size-border-thin) solid var(--about-v2-rule);
  }

  .about-v2-story-panel {
    overflow: hidden;
    background:
      linear-gradient(90deg, rgba(23, 21, 18, .08) 0 var(--size-border-thin), transparent var(--size-border-thin) 100%),
      linear-gradient(180deg, rgba(23, 21, 18, .055) 0 var(--size-border-thin), transparent var(--size-border-thin) 100%),
      linear-gradient(90deg, rgba(255, 255, 255, .44), transparent 20rem),
      var(--about-v2-paper);
    background-size: 8.333% 100%, 100% 6rem, 100% 100%, 100% 100%;
    color: var(--about-v2-paper-ink);
    box-shadow: 0 2rem 5rem rgba(0, 0, 0, .2);
  }

  .about-v2-story-inner {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(var(--spacing-sm), 2.2vw, var(--spacing-lg));
    row-gap: 0;
    max-width: 76rem;
    margin-inline: auto;
    padding: clamp(var(--spacing-2xl), 7vw, calc(var(--spacing-4xl) + var(--spacing-xl))) clamp(var(--spacing-md), 5vw, var(--spacing-4xl));
  }

  .about-v2-story h2,
  .about-v2-story h3 {
    grid-column: 1 / span 8;
    color: var(--about-v2-paper-ink);
    font-size: clamp(3.4rem, 7vw, 7.4rem);
    line-height: .86;
    letter-spacing: 0;
  }

  .about-v2-story h3 {
    grid-column: 4 / span 8;
    margin-top: clamp(var(--spacing-4xl), 9vw, calc(var(--spacing-4xl) * 1.6));
    font-size: clamp(2.85rem, 5.4vw, 5.8rem);
    line-height: .9;
  }

  .about-v2-story p {
    grid-column: 4 / span 7;
    margin: clamp(var(--spacing-sm), 2.2vw, var(--spacing-md)) 0 0;
    color: var(--about-v2-paper-muted);
    font-size: var(--ds-type-lead);
    line-height: 1.54;
    letter-spacing: 0;
    text-wrap: pretty;
  }

  .about-v2-story-lede {
    grid-column: 5 / span 7;
    margin-top: clamp(var(--spacing-xl), 5vw, var(--spacing-3xl));
    color: rgba(23, 21, 18, .82);
    font-family: var(--font-family-display);
    font-size: clamp(1.85rem, 2.9vw, 3.2rem);
    line-height: 1.08;
    letter-spacing: 0;
  }

  .about-v2-editorial-figure {
    --about-v2-figure-rule: rgba(23, 21, 18, .2);
    --about-v2-figure-muted: rgba(23, 21, 18, .54);
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(3.5rem, .16fr) minmax(0, 1fr);
    gap: clamp(var(--spacing-sm), 2vw, var(--spacing-md));
    margin: clamp(var(--spacing-2xl), 6vw, var(--spacing-4xl)) 0 clamp(var(--spacing-xl), 5vw, var(--spacing-3xl));
  }

  .about-v2-editorial-figure--wide {
    grid-column: 2 / span 10;
  }

  .about-v2-editorial-figure--inset {
    grid-column: 7 / span 5;
    width: auto;
    margin-left: auto;
  }

  .about-v2-editorial-figure--paired {
    grid-column: 2 / span 7;
    width: auto;
  }

  .about-v2-editorial-media {
    position: relative;
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(3.5rem, .16fr) minmax(0, 1fr);
    min-height: clamp(18rem, 34vw, 31rem);
    overflow: hidden;
    border-bottom: var(--size-border-thin) solid var(--about-v2-figure-rule);
    background:
      linear-gradient(90deg, rgba(238, 232, 220, .08) 0 var(--size-border-thin), transparent var(--size-border-thin) 100%),
      linear-gradient(180deg, rgba(238, 232, 220, .07) 0 var(--size-border-thin), transparent var(--size-border-thin) 100%),
      radial-gradient(ellipse at 72% 22%, rgba(255, 255, 255, .12), transparent 19rem),
      linear-gradient(135deg, #1b1915, #3a3428 48%, #171512);
    background-size: 16.666% 100%, 100% 25%, 100% 100%, 100% 100%;
  }

  .about-v2-editorial-figure--inset .about-v2-editorial-media {
    min-height: clamp(14rem, 24vw, 22rem);
  }

  .about-v2-editorial-figure--paired .about-v2-editorial-media {
    min-height: clamp(13rem, 22vw, 19rem);
  }

  .about-v2-editorial-media::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, transparent calc(16.666% - var(--size-border-thin)), rgba(238, 232, 220, .2) 16.666%, transparent calc(16.666% + var(--size-border-thin))),
      linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, .16) 100%);
    pointer-events: none;
  }

  .about-v2-editorial-number {
    position: relative;
    z-index: 1;
    align-self: end;
    padding: 0 0 clamp(var(--spacing-sm), 2vw, var(--spacing-md));
    color: rgba(238, 232, 220, .58);
    font-family: var(--font-family-display);
    font-size: clamp(2.8rem, 7vw, 6.5rem);
    font-weight: var(--font-weight-medium);
    line-height: .8;
    text-align: center;
  }

  .about-v2-editorial-label {
    position: relative;
    z-index: 1;
    align-self: end;
    justify-self: start;
    margin: 0 0 clamp(var(--spacing-sm), 2vw, var(--spacing-md));
    padding: .58rem .72rem .54rem;
    border: var(--size-border-thin) solid rgba(238, 232, 220, .2);
    background: rgba(23, 21, 18, .62);
    color: rgba(238, 232, 220, .76);
    font-size: var(--ds-type-label);
    font-weight: var(--font-weight-medium);
    letter-spacing: .04em;
    line-height: var(--ds-line-label);
    text-transform: uppercase;
  }

  .about-v2-editorial-figure figcaption {
    grid-column: 2;
    margin: 0;
    padding-top: .72rem;
    color: var(--about-v2-figure-muted);
    font-size: var(--ds-type-label);
    font-weight: var(--font-weight-medium);
    letter-spacing: .04em;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .about-v2-story blockquote {
    grid-column: 2 / span 10;
    margin: clamp(var(--spacing-3xl), 7vw, calc(var(--spacing-4xl) + var(--spacing-lg))) 0 clamp(var(--spacing-2xl), 6vw, var(--spacing-4xl));
    padding: clamp(var(--spacing-lg), 4vw, var(--spacing-2xl)) 0;
    border-bottom: var(--size-border-thin) solid rgba(23, 21, 18, .22);
  }

  .about-v2-story blockquote p {
    grid-column: auto;
    margin: 0;
    color: var(--about-v2-paper-ink);
    font-family: var(--font-family-display);
    font-size: clamp(3.2rem, 7vw, 7rem);
    line-height: .86;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .about-v2-archive {
    border-bottom: var(--size-border-thin) solid var(--about-v2-rule);
  }

  .about-v2-archive-media {
    margin: 0;
    overflow: hidden;
    aspect-ratio: 1;
    border: var(--size-border-thin) solid var(--about-v2-rule);
    background: rgba(var(--ds-surface-panel-rgb), .72);
  }


---
interface Props {
	title?: string;
	pageTitle?: string;
	description?: string;
}

// 1. Import the global SCSS here.
// Vite watches imports in the script section much better than @use in <style> tags.
import '../styles/global.scss';

const { title, pageTitle, description } = Astro.props as Props;
const resolvedTitle = pageTitle ?? title ?? "Dan Malarkey";
const resolvedDescription =
	description ??
	"Portfolio and writing platform for Dan Malarkey, focused on design leadership, product direction, and selective advisory work.";
const inferredBaseUrl = Astro.url.pathname.startsWith('/astro-portfolio') ? '/astro-portfolio/' : '/';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={resolvedDescription} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={`${inferredBaseUrl}favicon.svg`} />
		<meta name="generator" content={Astro.generator} />
		<title>{resolvedTitle}</title>
		<!--<style lang="scss" is:global>-->
		<!--	@use '../styles/global.scss';-->
		<!--</style>-->
	</head>
	<body>
		<slot />
		<script>
			(() => {
				const revealEls = Array.from(document.querySelectorAll('[data-motion-reveal], [data-motion-reveal-early], [data-motion-reveal-late]'));
				if (!revealEls.length) return;

				const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				if (prefersReducedMotion || !('IntersectionObserver' in window)) {
					revealEls.forEach((el) => el.classList.add('is-visible'));
					return;
				}

				const observe = (selector, options) => {
					const elements = Array.from(document.querySelectorAll(selector));
					if (!elements.length) return;

					const observer = new IntersectionObserver((entries) => {
						entries.forEach((entry) => {
							if (!entry.isIntersecting) return;
							entry.target.classList.add('is-visible');
							observer.unobserve(entry.target);
						});
					}, options);

					elements.forEach((el) => observer.observe(el));
				};

				observe('[data-motion-reveal]', {
					threshold: 0.22,
					rootMargin: '0px 0px -16% 0px'
				});

				observe('[data-motion-reveal-early]', {
					threshold: 0.08,
					rootMargin: '0px 0px 12% 0px'
				});

				observe('[data-motion-reveal-late]', {
					threshold: 0.5,
					rootMargin: '0px 0px -12% 0px'
				});
			})();
		</script>
	</body>
</html>

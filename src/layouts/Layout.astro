---
interface Props {
	title?: string;
	pageTitle?: string;
}

// 1. Import the global SCSS here.
// Vite watches imports in the script section much better than @use in <style> tags.
import '../styles/global.scss';

const { title, pageTitle } = Astro.props as Props;
const resolvedTitle = pageTitle ?? title ?? "Dan Malarkey";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Astro description" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{resolvedTitle}</title>
		<!--<style lang="scss" is:global>-->
		<!--	@use '../styles/global.scss';-->
		<!--</style>-->
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=arrow_right_alt" />
	</head>
	<body>
		<slot />
	</body>
</html>


---
interface Props {
    title?: string;
}

const baseUrl = Astro.url.pathname.startsWith('/astro-portfolio') ? '/astro-portfolio/' : '/';
const normalizePath = (value: string) => {
    const normalized = value.endsWith('/') && value !== '/' ? value.slice(0, -1) : value;
    return normalized || '/';
};
const stripBasePath = (path: string, base: string) => {
    const normalizedBase = base.endsWith('/') && base !== '/' ? base.slice(0, -1) : base;
    if (normalizedBase !== '/' && path.startsWith(normalizedBase)) {
        const stripped = path.slice(normalizedBase.length) || '/';
        return stripped.startsWith('/') ? stripped : `/${stripped}`;
    }
    return path;
};
const currentPath = normalizePath(stripBasePath(Astro.url.pathname, baseUrl));
const withBase = (path: string) => {
    const normalizedPath = path.startsWith('/') ? path.slice(1) : path;
    return baseUrl + normalizedPath;
};
---

<div class="header">
    <header>
        <!--<div class="logo">-->
        <!--    DM-->
        <!--</div>-->
        <ul class="header-nav">
            <li>
                <a href={withBase('/')} class={`header-nav--link ${currentPath === '/' ? 'active' : ''}`}>Home</a>
            </li>
            <li>
                <a href={withBase('/work')} class={`header-nav--link ${currentPath === '/work' ? 'active' : ''}`}>Work</a>
            </li>
            <li>
                <a href={withBase('/library')} class={`header-nav--link ${currentPath === '/library' ? 'active' : ''}`}>Library</a>
            </li>
            <li>
                <a href={withBase('/about')} class={`header-nav--link ${currentPath === '/about' ? 'active' : ''}`}>About</a>
            </li>
            <li>
                <a href={withBase('/blog')} class={`header-nav--link ${currentPath === '/blog' ? 'active' : ''}`}>Writing</a>
            </li>
            <li class="header-nav--item header-nav--item--cta">
                <a href="mailto:hello@danmalarkey.com" class="header-nav--link header-nav--link--cta">Work with me</a>
            </li>
        </ul>
    </header>
</div>

<style lang="scss">

    *, *:before, *:after {
        box-sizing: border-box;
    }

    .header {
        display: flex;
        position: relative;
        margin-top: var(--spacing-header-margin-top);
        justify-content: center;
        height: var(--size-header-shell-height);
        z-index: var(--z-index-floating-nav);

        header {
            display: inline-flex;
            align-self: center;
            align-items: center;
            justify-content: center;
            margin: var(--spacing-header-margin-top) auto 0 auto;
            background-color: var(--color-header-surface);
            padding: var(--spacing-header-panel-padding-block) var(--spacing-header-panel-padding-inline);
            color: var(--color-text-primary);
            border-radius: var(--radius-pill);
            position: fixed;
            z-index: var(--z-index-floating-nav);
            /* The blur magic */
            backdrop-filter: blur(var(--size-header-blur));
            -webkit-backdrop-filter: blur(var(--size-header-blur)); /* Safari support */

            /* Optional: Border to define edges */
            border: var(--size-border-thin) solid var(--color-border-on-dark-subtle);
            box-shadow: var(--shadow-header-floating);
        }

        @media (max-width: 62rem) {
            margin-top: var(--spacing-header-margin-top-mobile);
            height: var(--size-header-shell-height-mobile);

            header {
                width: calc(100% - var(--spacing-lg));
                justify-content: flex-start;
                overflow-x: auto;
                overflow-y: hidden;
                padding: var(--spacing-header-panel-padding-block) calc(var(--spacing-xs) * 0.875);
                scrollbar-width: none;
            }

            header::-webkit-scrollbar {
                display: none;
            }
        }

        @media (max-width: 48rem) {
            margin-top: var(--spacing-header-margin-top-mobile);
            height: var(--spacing-4xl);
        }
    }

    .header-nav {
		display: flex;
        margin-left: 0;
        padding-left: 0;
        white-space: nowrap;
        gap: var(--spacing-header-link-gap);

        .header-nav--link {
			color: var(--color-text-muted);
            text-decoration: none;
            padding: var(--spacing-xs) var(--spacing-header-link-padding-inline);
            background-color: transparent;
            border-radius: var(--radius-pill);


            &:hover {
                background-color: var(--color-header-link-hover);
             }

            &.active {
                font-weight: var(--font-weight-bold);
                background-color: var(--color-accent-primary);
                color: var(--color-ink-on-accent);
            }
        }

        li {
            list-style: none;
        }

        .header-nav--item--cta {
            margin-left: calc(var(--spacing-xs) * 0.5);
        }

        .header-nav--link--cta {
            color: var(--color-text-primary);
            background: var(--color-surface-glass-soft);
            border: var(--size-border-thin) solid var(--color-border-on-dark-soft);
            box-shadow: inset 0 0.0625rem 0 rgba(255, 255, 255, 0.06);
            font-weight: var(--font-weight-medium);
            transition:
                background-color var(--duration-transition-fast) var(--easing-standard),
                border-color var(--duration-transition-fast) var(--easing-standard),
                color var(--duration-transition-fast) var(--easing-standard),
                box-shadow var(--duration-transition-fast) var(--easing-standard),
                transform var(--duration-transition-fast) var(--easing-standard);

            @media (hover: hover) {
                &:hover {
                    background: var(--gradient-site-footer-cta);
                    color: var(--color-site-footer-cta-text);
                    border-color: var(--color-site-footer-cta-border);
                    box-shadow: var(--shadow-site-footer-cta-rest);
                    transform: translateY(var(--motion-lift-subtle));
                }
            }

            &:focus-visible {
                background: var(--gradient-site-footer-cta);
                color: var(--color-site-footer-cta-text);
                border-color: var(--color-site-footer-cta-border-hover);
                box-shadow: var(--shadow-site-footer-cta-rest), var(--shadow-site-footer-cta-focus);
            }

            &.active {
                background: var(--color-surface-glass-soft);
                color: var(--color-text-primary);
                border-color: var(--color-border-on-dark-soft);
                font-weight: var(--font-weight-medium);
            }
        }

        @media (max-width: 48rem) {
            .header-nav--item--cta {
                margin-left: calc(var(--spacing-xs) * 0.25);
            }

            .header-nav--link {
                padding: var(--spacing-xs) var(--spacing-header-link-padding-inline-mobile);
                font-size: var(--size-label-sm);
            }
        }
    }
</style>

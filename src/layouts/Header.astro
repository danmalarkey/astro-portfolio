
---
interface Props {
    title?: string;
}

const currentPath = Astro.url.pathname;
---

<div class="header">
    <header>
        <!--<div class="logo">-->
        <!--    DM-->
        <!--</div>-->
        <ul class="header-nav">
            <li>
                <a href="/" class={`header-nav--link ${currentPath === '/' ? 'active' : ''}`}>Home</a>
            </li>
            <li>
                <a href="/work" class={`header-nav--link ${currentPath === '/work' ? 'active' : ''}`}>Work</a>
            </li>
            <li>
                <a href="/writing" class={`header-nav--link ${currentPath === '/writing' ? 'active' : ''}`}>Writing</a>
            </li>
            <li>
                <a href="/library" class={`header-nav--link ${currentPath === '/library' ? 'active' : ''}`}>Library</a>
            </li>
            <li>
                <a href="/about" class={`header-nav--link ${currentPath === '/about' ? 'active' : ''}`}>About</a>
            </li>
            <li>
                <a href="/blog" class={`header-nav--link ${currentPath === '/blog' ? 'active' : ''}`}>Blog</a>
            </li>
            <li>
                <a href="/contact" class={`header-nav--link ${currentPath === '/contact' ? 'active' : ''}`}>Contact</a>
            </li>
        </ul>
    </header>
</div>

<style lang="scss">

    *, *:before, *:after {
        box-sizing: border-box;
    }

    .header {
        display: flex;
        position: relative;
        margin-top: var(--spacing-lg);
        justify-content: center;
        height: calc(var(--spacing-2xl) + var(--spacing-md));
        z-index: var(--z-index-floating-nav);

        header {
            display: inline-flex;
            align-self: center;
            align-items: center;
            justify-content: center;
            margin: var(--spacing-lg) auto 0 auto;
            background-color: var(--color-background-surface);
            background-color: var(--color-surface-glass-subtle);
            padding: calc(var(--spacing-xs) * 0.5) var(--spacing-sm);
            color: var(--color-text-primary);
            border-radius: var(--radius-pill);
            position: fixed;
            z-index: var(--z-index-floating-nav);
            /* The blur magic */
            backdrop-filter: blur(var(--size-header-blur));
            -webkit-backdrop-filter: blur(var(--size-header-blur)); /* Safari support */

            /* Optional: Border to define edges */
            border-bottom: var(--size-border-thin) solid var(--color-border-on-dark-subtle);
            box-shadow: 0 var(--spacing-lg) var(--spacing-2xl) var(--shadow-color-header);
        }

        @media (max-width: 62rem) {
            margin-top: var(--spacing-md);
            height: calc(var(--spacing-2xl) + var(--spacing-sm));

            header {
                width: calc(100% - var(--spacing-lg));
                justify-content: flex-start;
                overflow-x: auto;
                overflow-y: hidden;
                padding: calc(var(--spacing-xs) * 0.5) var(--spacing-xs);
                scrollbar-width: none;
            }

            header::-webkit-scrollbar {
                display: none;
            }
        }

        @media (max-width: 48rem) {
            margin-top: var(--spacing-sm);
            height: var(--spacing-4xl);
        }
    }

    .header-nav {
		display: flex;
        margin-left: 0;
        padding-left: 0;
        white-space: nowrap;
        gap: var(--spacing-header-link-gap);

        .header-nav--link {
			color: var(--color-text-muted);
            text-decoration: none;
            padding: var(--spacing-xs) var(--spacing-sm);
            background-color: transparent;
            border-radius: var(--radius-pill);


            &:hover {
                background-color: var(--color-border-subtle-dark);
             }

            &.active {
                font-weight: var(--font-weight-bold);
                background-color: var(--color-accent-primary);
                color: var(--color-ink-on-accent);
            }
        }

        li {
            list-style: none;
        }

        @media (max-width: 48rem) {
            .header-nav--link {
                padding: var(--spacing-xs) calc(var(--spacing-sm) - var(--spacing-xs));
                font-size: var(--size-label-sm);
            }
        }
    }
</style>

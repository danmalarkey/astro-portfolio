---
const baseUrl = Astro.url.pathname.startsWith('/astro-portfolio') ? '/astro-portfolio/' : '/';
const normalizePath = (value: string) => {
  const normalized = value.endsWith('/') && value !== '/' ? value.slice(0, -1) : value;
  return normalized || '/';
};
const stripBasePath = (path: string, base: string) => {
  const normalizedBase = base.endsWith('/') && base !== '/' ? base.slice(0, -1) : base;
  if (normalizedBase !== '/' && path.startsWith(normalizedBase)) {
    const stripped = path.slice(normalizedBase.length) || '/';
    return stripped.startsWith('/') ? stripped : `/${stripped}`;
  }
  return path;
};
const currentPath = normalizePath(stripBasePath(Astro.url.pathname, baseUrl));
const isPathActive = (target: string) => currentPath === target || currentPath.startsWith(`${target}/`);
const withBase = (path: string) => `${baseUrl}${path.startsWith('/') ? path.slice(1) : path}`;

const navItems = [
  { href: '/work', label: 'Work', active: isPathActive('/work') || isPathActive('/work-with') },
  { href: '/library', label: 'Library', active: isPathActive('/library') },
  { href: '/about', label: 'About', active: isPathActive('/about') },
  { href: '/writing', label: 'Writing', active: isPathActive('/writing') || isPathActive('/blog') }
];

const serviceItems = [
  { href: '/work-with/executives-and-product-drivers', label: 'Product direction' },
  { href: '/work-with/product-and-engineering-teams', label: 'UX systems' },
  { href: '/work-with/ai-enabled-product-systems', label: 'AI-enabled systems' },
  { href: '/work-with/operating-model', label: 'Operating model' }
];
---

<header class="site-header" data-site-header>
  <div class="site-header-shell dm-grid-l dm-grid-l--grid-sys">
    <nav class="site-header-nav gc-start-2 gc-span-24" aria-label="Primary">
      <a class="site-header-brand" href={withBase('/')} aria-label="Dan Malarkey">
        <img src={withBase('/images/brand/d-logo-halfmoon.svg')} alt="Dan Malarkey" />
      </a>

      <span class="site-header-availability" aria-label="Available for select engagements">
        <span class="site-header-availability-dot" aria-hidden="true"></span>
        <span>Available for select engagements</span>
      </span>

      <div class="site-header-nav-links">
        {navItems.map((item, index) => (
          <a
            href={withBase(item.href)}
            class:list={[item.active && 'is-active']}
            aria-current={item.active ? 'page' : undefined}
            style={`--nav-item-index: ${index}`}
          >
            {item.label}
          </a>
        ))}
        <a href="mailto:hello@danmalarkey.com" class="site-header-nav-cta" style="--nav-item-index: 4">Contact</a>
      </div>

      <button class="site-header-menu-toggle" type="button" aria-expanded="false" aria-controls="site-mobile-nav">
        <span>Menu</span>
        <span class="site-header-menu-toggle-icon" aria-hidden="true"></span>
      </button>
    </nav>

    <div class="site-mobile-nav" id="site-mobile-nav" aria-hidden="true" inert>
      <div class="site-mobile-nav-panel">
        <div class="site-mobile-nav-primary" aria-label="Primary mobile navigation">
          {navItems.map((item, index) => (
            <a
              href={withBase(item.href)}
              class:list={[item.active && 'is-active']}
              aria-current={item.active ? 'page' : undefined}
              style={`--nav-item-index: ${index}`}
            >
              {item.label}
            </a>
          ))}
        </div>

        <div class="site-mobile-nav-secondary" aria-label="Secondary mobile navigation">
          <div class="site-mobile-nav-group" style="--nav-item-index: 4">
            <p>Services</p>
            {serviceItems.map((item) => <a href={withBase(item.href)}>{item.label}</a>)}
          </div>
          <div class="site-mobile-nav-group" style="--nav-item-index: 5">
            <p>Contact</p>
            <a href="mailto:hello@danmalarkey.com">Email</a>
            <a href="https://www.linkedin.com/in/danmalarkey/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          </div>
        </div>

        <div class="site-mobile-nav-actions" style="--nav-item-index: 6" aria-label="Mobile navigation actions">
          <a class="site-mobile-nav-action site-mobile-nav-action--primary" href="mailto:hello@danmalarkey.com">Work with me</a>
          <a class="site-mobile-nav-action site-mobile-nav-action--secondary" href="mailto:hello@danmalarkey.com">Book a call</a>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  (() => {
    const headers = Array.from(document.querySelectorAll('[data-site-header]'));
    if (!headers.length) return;

    headers.forEach((header) => {
      if (!(header instanceof HTMLElement)) return;
      const menuButton = header.querySelector('.site-header-menu-toggle');
      const mobileNav = header.querySelector('.site-mobile-nav');
      if (!(menuButton instanceof HTMLButtonElement) || !(mobileNav instanceof HTMLElement)) return;

      const syncScrolled = () => {
        header.classList.toggle('is-scrolled', window.scrollY > 72);
      };

      const setMenuOpen = (isOpen) => {
        header.classList.toggle('is-menu-open', isOpen);
        menuButton.setAttribute('aria-expanded', String(isOpen));
        mobileNav.setAttribute('aria-hidden', String(!isOpen));
        if (isOpen) {
          mobileNav.removeAttribute('inert');
          document.documentElement.classList.add('site-nav-open');
        } else {
          mobileNav.setAttribute('inert', '');
          document.documentElement.classList.remove('site-nav-open');
        }
      };

      menuButton.addEventListener('click', () => {
        setMenuOpen(!header.classList.contains('is-menu-open'));
      });

      mobileNav.addEventListener('click', (event) => {
        const target = event.target;
        if (target instanceof HTMLAnchorElement) setMenuOpen(false);
      });

      window.addEventListener('scroll', syncScrolled, { passive: true });
      window.addEventListener('resize', () => {
        if (window.matchMedia('(min-width: 48.001rem)').matches) setMenuOpen(false);
      });
      window.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setMenuOpen(false);
      });

      syncScrolled();
    });
  })();
</script>

<style lang="scss">
  :global(html.site-nav-open) {
    overflow: hidden;
  }

  .site-header {
    --site-header-top: var(--spacing-lg);
    --site-header-inline: 0;
    --site-header-nav-padding: 1rem;
    --site-header-brand-width: 1.35rem;
    --site-header-brand-width-scrolled: 0.68rem;

    position: fixed;
    z-index: var(--z-index-floating-nav);
    top: var(--site-header-top);
    right: 0;
    left: 0;
    display: flex;
    justify-content: center;
    padding-inline: var(--site-header-inline);
    pointer-events: none;
  }

  .site-header-shell {
    width: 100%;
    pointer-events: none;
  }

  .site-header-nav {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 0.88rem;
    width: 100%;
    padding: var(--site-header-nav-padding);
    border: var(--size-border-thin) solid transparent;
    border-radius: var(--radius-lg);
    background: transparent;
    pointer-events: auto;
    transition:
      background 520ms ease,
      border-color 520ms ease,
      box-shadow 520ms ease,
      backdrop-filter 520ms ease;
    animation: site-header-enter 760ms ease 120ms both;
  }

  .site-header.is-scrolled .site-header-nav,
  .site-header.is-menu-open .site-header-nav {
    border-color: rgba(231, 235, 242, 0.08);
    background: rgba(10, 12, 18, 0.62);
    box-shadow:
      inset 0 0 0 0.0625rem rgba(255, 255, 255, 0.025),
      0 0.75rem 2rem rgba(0, 0, 0, 0.16);
    backdrop-filter: blur(1rem) saturate(1.06);
    -webkit-backdrop-filter: blur(1rem) saturate(1.06);
  }

  .site-header-brand {
    display: inline-flex;
    grid-column: 1;
    align-items: center;
    justify-content: flex-start;
    justify-self: start;
    line-height: 0;
    animation: site-header-item-enter 680ms ease 260ms both;
  }

  .site-header-brand img {
    display: block;
    width: var(--site-header-brand-width);
    height: auto;
    transition: width 520ms ease;
  }

  .site-header.is-scrolled .site-header-brand img {
    width: var(--site-header-brand-width-scrolled);
  }

  .site-header-availability {
    display: inline-flex;
    grid-column: 2;
    align-items: center;
    gap: 0.46rem;
    justify-self: start;
    width: fit-content;
    max-width: 100%;
    padding: 0.38rem 0.62rem;
    border: var(--size-border-thin) solid rgba(231, 235, 242, 0.1);
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.035);
    box-shadow:
      inset 0 0.0625rem 0 rgba(255, 255, 255, 0.045),
      0 0.45rem 1.2rem rgba(0, 0, 0, 0.1);
    color: var(--ds-text-muted, rgba(231, 235, 242, 0.72));
    font-size: var(--ds-type-label, 0.75rem);
    font-weight: var(--font-weight-medium);
    line-height: 1.15;
    white-space: nowrap;
    opacity: 0;
    transform: translateX(-0.28rem);
    pointer-events: none;
    transition:
      opacity 420ms ease,
      transform 420ms ease,
      border-color 420ms ease,
      background 420ms ease;
  }

  .site-header.is-scrolled .site-header-availability,
  .site-header.is-menu-open .site-header-availability {
    opacity: 1;
    transform: translateX(0);
    pointer-events: auto;
  }

  .site-header-availability-dot {
    position: relative;
    flex: 0 0 auto;
    width: 0.42rem;
    height: 0.42rem;
    border-radius: var(--radius-pill);
    background: rgba(165, 238, 194, 0.9);
    box-shadow:
      0 0 0 0.16rem rgba(105, 220, 150, 0.09),
      0 0 0.95rem rgba(105, 220, 150, 0.28);
  }

  .site-header-availability-dot::after {
    content: '';
    position: absolute;
    inset: -0.32rem;
    border: var(--size-border-thin) solid rgba(165, 238, 194, 0.22);
    border-radius: inherit;
    opacity: 0;
    transform: scale(0.72);
    animation: site-header-availability-pulse 2.4s ease-in-out infinite;
  }

  .site-header-nav-links {
    display: flex;
    grid-column: 4;
    align-items: center;
    gap: 0.72rem;
    justify-self: end;
    color: var(--ds-text-muted, rgba(231, 235, 242, 0.72));
    font-size: 0.82rem;
  }

  .site-header-nav-links a {
    color: inherit;
    text-decoration: none;
    animation: site-header-item-enter 620ms ease both;
    animation-delay: calc(340ms + (var(--nav-item-index, 0) * 60ms));
    transition: color var(--duration-transition-interactive-ui) var(--easing-standard);
  }

  .site-header-nav-links a:hover,
  .site-header-nav-links a:focus-visible,
  .site-header-nav-links a.is-active {
    color: var(--ds-text, #e7ebf2);
  }

  .site-header-nav-cta {
    padding: 0;
    border: 0;
    background: transparent;
  }

  .site-header-menu-toggle,
  .site-mobile-nav {
    display: none;
  }

  @keyframes site-header-enter {
    from {
      opacity: 0;
      transform: translateY(-0.8rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes site-header-item-enter {
    from {
      opacity: 0;
      transform: translateY(-0.28rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes site-header-availability-pulse {
    0%,
    100% {
      opacity: 0;
      transform: scale(0.72);
    }

    42% {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (max-width: 48rem) {
    .site-header {
      --site-header-top: var(--ds-mobile-page-gutter, 1.25rem);
      --site-header-inline: 0;
      --site-header-nav-padding: 0.72rem 0;
      --site-header-brand-width: 1.22rem;
      --site-header-brand-width-scrolled: 0.8rem;
    }

    .site-header-nav {
      grid-column: 1 / -1;
      display: flex;
      min-height: 0;
      align-items: center;
      justify-content: space-between;
      gap: 0.65rem;
      padding: var(--site-header-nav-padding);
      margin-inline: 0.75rem;
      border-radius: 0;
      background: transparent;
      box-shadow: none;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }

    .site-header.is-menu-open .site-header-nav,
    .site-header.is-scrolled .site-header-nav {
      padding: 0.6rem 0.72rem;
      border-radius: var(--radius-lg);
      background: rgba(10, 12, 18, 0.72);
      box-shadow:
        inset 0 0 0 0.0625rem rgba(255, 255, 255, 0.025),
        0 0.55rem 1.4rem rgba(0, 0, 0, 0.16);
      backdrop-filter: blur(1rem) saturate(1.06);
      -webkit-backdrop-filter: blur(1rem) saturate(1.06);
    }

    .site-header-nav-links {
      display: none;
    }

    .site-header-brand {
      grid-column: auto;
      justify-self: auto;
    }

    .site-header-brand img {
      width: var(--site-header-brand-width);
    }

    .site-header-availability {
      display: inline-flex;
      flex: 0 1 auto;
      min-width: 0;
      max-width: min(13rem, 42vw);
      padding: 0.34rem 0.54rem;
      overflow: hidden;
      font-size: var(--ds-mobile-type-label-decorative, 0.75rem);
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }

    .site-header-availability > span:last-child {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .site-header-menu-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.48rem;
      min-height: 2.25rem;
      margin-left: auto;
      padding: 0 0.72rem;
      border: var(--size-border-thin) solid rgba(231, 235, 242, 0.12);
      border-radius: var(--radius-pill);
      background: rgba(255, 255, 255, 0.04);
      color: rgba(244, 247, 255, 0.9);
      font: inherit;
      font-size: var(--ds-mobile-type-label-decorative, 0.75rem);
      font-weight: var(--font-weight-medium);
      line-height: 1;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }

    .site-header-menu-toggle:focus-visible {
      outline: var(--size-border-thin) solid rgba(231, 235, 242, 0.42);
      outline-offset: 0.18rem;
    }

    .site-header-menu-toggle-icon {
      position: relative;
      width: 0.95rem;
      height: 0.5rem;
    }

    .site-header-menu-toggle-icon::before,
    .site-header-menu-toggle-icon::after {
      content: '';
      position: absolute;
      left: 0;
      width: 100%;
      height: var(--size-border-thin);
      border-radius: var(--radius-pill);
      background: currentColor;
      transition:
        transform 220ms ease,
        top 220ms ease;
    }

    .site-header-menu-toggle-icon::before {
      top: 0;
    }

    .site-header-menu-toggle-icon::after {
      top: 0.5rem;
    }

    .site-header.is-menu-open .site-header-menu-toggle-icon::before {
      top: 0.25rem;
      transform: rotate(42deg);
    }

    .site-header.is-menu-open .site-header-menu-toggle-icon::after {
      top: 0.25rem;
      transform: rotate(-42deg);
    }

    .site-mobile-nav {
      position: fixed;
      z-index: 1;
      inset: 0;
      display: flex;
      align-items: stretch;
      justify-content: stretch;
      padding: calc(var(--ds-mobile-page-gutter, 1.25rem) + 3.25rem) var(--site-header-inline) var(--site-header-inline);
      pointer-events: none;
      opacity: 0;
      background:
        radial-gradient(ellipse at 78% 8%, rgba(105, 133, 255, 0.16), transparent 18rem),
        radial-gradient(ellipse at 12% 92%, rgba(231, 235, 242, 0.08), transparent 16rem),
        rgba(4, 5, 8, 0.56);
      backdrop-filter: blur(0) saturate(1);
      -webkit-backdrop-filter: blur(0) saturate(1);
      transition:
        opacity 260ms ease,
        backdrop-filter 360ms ease;
    }

    .site-header.is-menu-open .site-mobile-nav {
      pointer-events: auto;
      opacity: 1;
      backdrop-filter: blur(1.125rem) saturate(1.08);
      -webkit-backdrop-filter: blur(1.125rem) saturate(1.08);
    }

    .site-mobile-nav-panel {
      position: relative;
      display: grid;
      grid-template-rows: auto minmax(0, 1fr) auto;
      gap: clamp(1.15rem, 5vw, 2rem);
      width: 100%;
      min-height: 0;
      padding: clamp(1.35rem, 5vw, 1.9rem);
      overflow: hidden;
      border: var(--size-border-thin) solid rgba(231, 235, 242, 0.1);
      border-radius: 1.45rem;
      background:
        radial-gradient(ellipse 90% 44% at 74% 0%, rgba(101, 126, 218, 0.16), transparent 62%),
        radial-gradient(ellipse 56% 34% at 10% 100%, rgba(231, 235, 242, 0.07), transparent 70%),
        linear-gradient(180deg, rgba(13, 15, 21, 0.96), rgba(6, 7, 10, 0.98));
      box-shadow:
        inset 0 0 0 0.0625rem rgba(255, 255, 255, 0.026),
        0 1.6rem 4rem rgba(0, 0, 0, 0.36);
      opacity: 0;
      transform: translateY(-0.7rem) scale(0.985);
      transition:
        opacity 260ms ease,
        transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .site-mobile-nav-panel::before {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      background:
        linear-gradient(90deg, rgba(255, 255, 255, 0.026) 0 0.0625rem, transparent 0.0625rem 100%),
        linear-gradient(180deg, rgba(255, 255, 255, 0.028), transparent 26%);
      background-size: 33.333% 100%, 100% 100%;
      opacity: 0.28;
      mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.82), transparent 78%);
    }

    .site-header.is-menu-open .site-mobile-nav-panel {
      opacity: 1;
      transform: translateY(0) scale(1);
    }

    .site-mobile-nav-primary,
    .site-mobile-nav-secondary,
    .site-mobile-nav-actions {
      position: relative;
      z-index: 1;
    }

    .site-mobile-nav-primary {
      display: grid;
      align-content: start;
      gap: 0.1rem;
      padding-top: 0.15rem;
    }

    .site-mobile-nav-primary a {
      display: flex;
      align-items: center;
      min-height: clamp(3.8rem, 15vw, 5.35rem);
      color: rgba(244, 247, 255, 0.94);
      font-family: var(--font-family-display);
      font-size: clamp(2.7rem, 15vw, 4.65rem);
      font-weight: var(--font-weight-medium);
      line-height: 0.9;
      letter-spacing: var(--ds-tracking-title, -0.025em);
      text-decoration: none;
    }

    .site-mobile-nav-secondary {
      align-self: end;
      display: grid;
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      gap: 1.25rem;
      padding-top: 0.95rem;
      border-top: var(--size-border-thin) solid rgba(231, 235, 242, 0.09);
    }

    .site-mobile-nav-group {
      display: grid;
      align-content: start;
      gap: 0.66rem;
    }

    .site-mobile-nav-group p {
      margin: 0 0 0.14rem;
      color: rgba(231, 235, 242, 0.38);
      font-size: 0.68rem;
      font-weight: var(--font-weight-semibold);
      letter-spacing: 0.14em;
      line-height: 1;
      text-transform: uppercase;
    }

    .site-mobile-nav-group a {
      color: rgba(231, 235, 242, 0.68);
      font-size: 0.95rem;
      line-height: 1.22;
      text-decoration: none;
      text-wrap: pretty;
    }

    .site-mobile-nav-actions {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 0.72rem;
    }

    .site-mobile-nav-action {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 3rem;
      padding: 0 0.9rem;
      border: var(--size-border-thin) solid rgba(231, 235, 242, 0.22);
      border-radius: var(--radius-pill);
      background: rgba(244, 247, 255, 0.92);
      color: rgba(6, 7, 10, 0.96);
      box-shadow:
        inset 0 0.0625rem 0 rgba(255, 255, 255, 0.48),
        0 0.65rem 1.4rem rgba(0, 0, 0, 0.18);
      font-size: 0.95rem;
      font-weight: var(--font-weight-medium);
      line-height: 1;
      text-align: center;
      text-decoration: none;
    }

    .site-mobile-nav-primary a,
    .site-mobile-nav-group,
    .site-mobile-nav-actions {
      opacity: 0;
      transform: translateY(0.85rem);
      transition:
        opacity 380ms ease,
        transform 520ms cubic-bezier(0.16, 1, 0.3, 1);
      transition-delay: calc(70ms + (var(--nav-item-index, 0) * 54ms));
    }

    .site-header.is-menu-open .site-mobile-nav-primary a,
    .site-header.is-menu-open .site-mobile-nav-group,
    .site-header.is-menu-open .site-mobile-nav-actions {
      opacity: 1;
      transform: translateY(0);
    }

    .site-mobile-nav-primary a:hover,
    .site-mobile-nav-primary a:focus-visible,
    .site-mobile-nav-primary a.is-active,
    .site-mobile-nav-group a:hover,
    .site-mobile-nav-group a:focus-visible {
      color: var(--ds-text, #e7ebf2);
      outline: none;
    }

    .site-mobile-nav-primary a:focus-visible,
    .site-mobile-nav-group a:focus-visible {
      text-decoration: underline;
      text-decoration-thickness: var(--size-border-thin);
      text-underline-offset: 0.24em;
    }

    .site-mobile-nav-action:hover,
    .site-mobile-nav-action:focus-visible {
      color: rgba(6, 7, 10, 0.96);
      background: rgba(255, 255, 255, 0.98);
      outline: none;
    }

    @media (max-height: 42rem) {
      .site-mobile-nav {
        padding-top: calc(var(--ds-mobile-page-gutter, 1.25rem) + 2.85rem);
      }

      .site-mobile-nav-panel {
        gap: 1.2rem;
        overflow-y: auto;
      }

      .site-mobile-nav-primary a {
        min-height: 3.15rem;
        font-size: clamp(2.2rem, 12vw, 3.2rem);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header-nav,
    .site-header-brand,
    .site-header-nav-links a,
    .site-mobile-nav,
    .site-mobile-nav-panel,
    .site-mobile-nav-primary a,
    .site-mobile-nav-group,
    .site-mobile-nav-actions,
    .site-header-menu-toggle-icon::before,
    .site-header-menu-toggle-icon::after {
      animation: none;


---
interface Props {
    title?: string;
}

const baseUrl = Astro.url.pathname.startsWith('/astro-portfolio') ? '/astro-portfolio/' : '/';
const normalizePath = (value: string) => {
    const normalized = value.endsWith('/') && value !== '/' ? value.slice(0, -1) : value;
    return normalized || '/';
};
const stripBasePath = (path: string, base: string) => {
    const normalizedBase = base.endsWith('/') && base !== '/' ? base.slice(0, -1) : base;
    if (normalizedBase !== '/' && path.startsWith(normalizedBase)) {
        const stripped = path.slice(normalizedBase.length) || '/';
        return stripped.startsWith('/') ? stripped : `/${stripped}`;
    }
    return path;
};
const currentPath = normalizePath(stripBasePath(Astro.url.pathname, baseUrl));
const isPathActive = (target: string) => currentPath === target || currentPath.startsWith(`${target}/`);
const withBase = (path: string) => {
    const normalizedPath = path.startsWith('/') ? path.slice(1) : path;
    return baseUrl + normalizedPath;
};
---

<div class="header">
    <header>
        <nav class="header-nav-scroll" aria-label="Primary">
            <ul class="header-nav">
                <li>
                    <a href={withBase('/')} class={`header-nav--link ${currentPath === '/' ? 'active' : ''}`}>Home</a>
                </li>
                <li>
                    <a href={withBase('/work')} class={`header-nav--link ${(isPathActive('/work') || isPathActive('/work-with')) ? 'active' : ''}`}>Work</a>
                </li>
                <li>
                    <a href={withBase('/library')} class={`header-nav--link ${isPathActive('/library') ? 'active' : ''}`}>Library</a>
                </li>
                <li>
                    <a href={withBase('/about')} class={`header-nav--link ${isPathActive('/about') ? 'active' : ''}`}>About</a>
                </li>
                <li>
                    <a href={withBase('/writing')} class={`header-nav--link ${(isPathActive('/writing') || isPathActive('/blog')) ? 'active' : ''}`}>Writing</a>
                </li>
            </ul>
        </nav>
        <a href="mailto:hello@danmalarkey.com" class="header-nav--link header-nav--link--cta header-nav--link--cta-fixed"><span>Work with me</span></a>
    </header>
</div>

<style lang="scss">

    *, *:before, *:after {
        box-sizing: border-box;
    }

    .header {
        display: flex;
        position: relative;
        margin-top: var(--spacing-header-margin-top);
        justify-content: center;
        height: var(--size-header-shell-height);
        z-index: var(--z-index-floating-nav);

        header {
            display: inline-flex;
            align-self: center;
            align-items: center;
            justify-content: center;
            gap: calc(var(--spacing-xs) * 0.75);
            margin: var(--spacing-header-margin-top) auto 0 auto;
            background-color: var(--color-header-surface);
            padding: var(--spacing-header-panel-padding-block) var(--spacing-header-panel-padding-inline);
            color: var(--color-text-primary);
            border-radius: var(--radius-pill);
            position: fixed;
            z-index: var(--z-index-floating-nav);
            /* The blur magic */
            backdrop-filter: blur(var(--size-header-blur));
            -webkit-backdrop-filter: blur(var(--size-header-blur)); /* Safari support */

            /* Optional: Border to define edges */
            border: var(--size-border-thin) solid var(--color-border-on-dark-subtle);
            box-shadow: var(--shadow-header-floating);
        }

        @media (max-width: 62rem) {
            margin-top: var(--spacing-header-margin-top-mobile);
            height: var(--size-header-shell-height-mobile);

            header {
                width: calc(100% - var(--spacing-lg));
                justify-content: space-between;
                overflow: visible;
                padding: var(--spacing-header-panel-padding-block) var(--spacing-header-panel-padding-inline-mobile);
                background-color: var(--color-header-surface-mobile);
                box-shadow: var(--shadow-header-floating-mobile);
            }

        }

        @media (max-width: 48rem) {
            margin-top: var(--spacing-header-margin-top-mobile);
            height: var(--spacing-4xl);
        }
    }

    .header-nav {
		display: flex;
        margin-left: 0;
        padding-left: 0;
        white-space: nowrap;
        gap: var(--spacing-header-link-gap);

        .header-nav--link {
			color: var(--color-text-muted);
            text-decoration: none;
            padding: var(--spacing-xs) var(--spacing-header-link-padding-inline);
            background-color: transparent;
            border-radius: var(--radius-pill);
            transition:
                background-color var(--duration-transition-interactive-bg) var(--easing-standard),
                color var(--duration-transition-interactive-ui) var(--easing-standard);


            &:hover {
                background-color: var(--color-header-link-hover);
             }

            &.active {
                font-weight: var(--font-weight-medium);
                background-color: var(--color-surface-dark-base);
                color: var(--color-accent-primary);
                border: var(--size-border-thin) solid var(--color-border-on-dark-subtle);
                box-shadow: inset 0 0.0625rem 0 rgba(255, 255, 255, 0.05);
            }
        }

        li {
            list-style: none;
            scroll-snap-align: start;
        }

        @media (max-width: 48rem) {
            gap: var(--spacing-header-link-gap-mobile);

            .header-nav--link {
                padding: var(--spacing-header-link-padding-block-mobile) var(--spacing-header-link-padding-inline-mobile-tight);
                font-size: var(--size-label-sm);
                min-height: var(--size-touch-target-min);
                line-height: 1;
            }

        }
    }

    .header-nav--link--cta {
        text-decoration: none;
        position: relative;
        isolation: isolate;
        overflow: hidden;
        border-radius: var(--radius-pill);
        padding: var(--spacing-xs) var(--spacing-header-link-padding-inline);
        font-size: inherit;
        line-height: 1;
        color: var(--color-site-footer-cta-text);
        background: var(--gradient-site-footer-cta);
        background-size: 165% 100%;
        background-position: 100% 0;
        background-repeat: no-repeat;
        border: var(--size-border-thin) solid var(--color-site-footer-cta-border);
        box-shadow: var(--shadow-site-footer-cta-rest);
        font-weight: var(--font-weight-semibold);
        transition:
                border-color var(--duration-transition-interactive-ui) var(--easing-standard),
                color var(--duration-transition-interactive-ui) var(--easing-standard),
                box-shadow var(--duration-transition-interactive-ui) var(--easing-standard),
                transform var(--duration-transition-interactive-ui) var(--easing-standard),
                background-position var(--duration-transition-interactive-bg) var(--easing-standard);

        &::before {
            display: none;
        }

        @media (hover: hover) {
            &:hover {
                    color: var(--color-site-footer-cta-text);
                    border-color: var(--color-site-footer-cta-border-hover);
                    box-shadow: var(--shadow-site-footer-cta-hover);
                    transform: translateY(var(--motion-lift-subtle));
                    background-position: 0 0;
        }

        > * {
            position: relative;
            z-index: 1;
        }
    }

        &:focus-visible {
            color: var(--color-site-footer-cta-text);
            border-color: var(--color-site-footer-cta-border-hover);
            box-shadow: var(--shadow-site-footer-cta-hover), var(--shadow-site-footer-cta-focus);
            background-position: 0 0;
        }

        &.active {
            background: var(--gradient-site-footer-cta);
            color: var(--color-site-footer-cta-text);
            border-color: var(--color-site-footer-cta-border);
            font-weight: var(--font-weight-semibold);
        }
    }

    .header-nav-scroll {
        min-width: 0;

        @media (max-width: 62rem) {
            flex: 1 1 auto;
            overflow-x: auto;
            overflow-y: hidden;
            scrollbar-width: none;
            scroll-snap-type: x proximity;
            scroll-padding-inline: var(--spacing-xs);
            touch-action: pan-x;
            -webkit-overflow-scrolling: touch;
            mask-image: linear-gradient(
                to right,
                transparent 0,
                #000 var(--size-header-mobile-fade-width),
                #000 calc(100% - var(--size-header-mobile-fade-width)),
                transparent 100%
            );
            -webkit-mask-image: linear-gradient(
                to right,
                transparent 0,
                #000 var(--size-header-mobile-fade-width),
                #000 calc(100% - var(--size-header-mobile-fade-width)),
                transparent 100%
            );
        }

        &::-webkit-scrollbar {
            display: none;
        }
    }

    .header-nav--link--cta-fixed {
        flex: 0 0 auto;
        white-space: nowrap;
    }

    @media (max-width: 48rem) {
        .header-nav--link--cta {
            min-height: var(--size-touch-target-min);
            padding-right: var(--spacing-header-link-padding-inline-mobile-cta);
            padding-left: var(--spacing-header-link-padding-inline-mobile-cta);
            padding-top: var(--spacing-header-link-padding-block-mobile);
            padding-bottom: var(--spacing-header-link-padding-block-mobile);
            font-size: var(--size-label-sm);
            font-weight: var(--font-weight-semibold);
        }

        .header-nav--link--cta-fixed {
            margin-left: calc(var(--spacing-xs) * 0.25);
        }
    }
</style>

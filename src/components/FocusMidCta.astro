---
import Button from './Button.astro';

interface Props {
  eyebrow: string;
  title: string;
  body: string;
  primaryHref: string;
  primaryLabel?: string;
  secondaryHref: string;
  secondaryLabel: string;
  ariaLabel: string;
  className?: string;
}

const {
  eyebrow,
  title,
  body,
  primaryHref,
  primaryLabel = 'Start a conversation',
  secondaryHref,
  secondaryLabel,
  ariaLabel,
  className
} = Astro.props as Props;
---

<section class:list={['focus-mid-cta', className]} aria-labelledby="focus-mid-cta-title" data-motion-reveal>
  <div class="dm-grid-l dm-grid-l--grid-sys">
    <div class="focus-mid-cta-inner gc-start-2 gc-span-24" data-motion-item>
      <p class="focus-mid-cta-kicker">{eyebrow}</p>
      <h2 id="focus-mid-cta-title">{title}</h2>
      <p>{body}</p>
      <div class="focus-mid-cta-actions" aria-label={ariaLabel}>
        <Button href={primaryHref}>{primaryLabel}</Button>
        <Button href={secondaryHref} variant="ghost">{secondaryLabel}</Button>
      </div>
    </div>
  </div>
</section>

<style>
  .focus-mid-cta {
    padding: clamp(5rem, 9vw, 8rem) 0;
  }

  .focus-mid-cta-inner {
    position: relative;
    display: grid;
    gap: var(--spacing-md);
    align-content: start;
    overflow: hidden;
    padding: clamp(2rem, 5vw, 4.5rem);
    border: var(--size-border-thin) solid rgba(176, 204, 255, 0.22);
    border-radius: var(--radius-md);
    background:
      radial-gradient(ellipse at 84% 48%, rgba(111, 162, 232, 0.28), rgba(111, 162, 232, 0.1) 34%, transparent 66%),
      radial-gradient(ellipse at 104% 22%, rgba(191, 215, 255, 0.16), transparent 22rem),
      linear-gradient(135deg, rgba(5, 18, 38, 0.98), rgba(9, 31, 68, 0.94) 54%, rgba(6, 12, 24, 0.98));
  }

  .focus-mid-cta-inner::after {
    content: "";
    position: absolute;
    top: 80%;
    right: min(-24rem, -12vw);
    width: min(64rem, 52vw);
    aspect-ratio: 1;
    border-radius: var(--radius-pill);
    pointer-events: none;
    opacity: 0.22;
    background:
      radial-gradient(circle, transparent 0 26%, rgba(191, 215, 255, 0.28) 26.2% 26.45%, transparent 26.7%),
      radial-gradient(circle, transparent 0 44%, rgba(191, 215, 255, 0.2) 44.2% 44.42%, transparent 44.7%),
      radial-gradient(circle, transparent 0 62%, rgba(176, 204, 255, 0.16) 62.2% 62.38%, transparent 62.7%),
      radial-gradient(circle, transparent 0 79%, rgba(176, 204, 255, 0.12) 79.15% 79.32%, transparent 79.6%);
    transform: translateY(-50%);
    -webkit-mask-image:
      linear-gradient(90deg, transparent 0%, #000 22%, #000 82%, transparent 100%),
      linear-gradient(24deg, transparent 0 18%, #000 18% 72%, transparent 72% 100%);
    mask-image:
      linear-gradient(90deg, transparent 0%, #000 22%, #000 82%, transparent 100%),
      linear-gradient(24deg, transparent 0 18%, #000 18% 72%, transparent 72% 100%);
    -webkit-mask-composite: source-in, xor;
    mask-composite: intersect;
  }

  .focus-mid-cta-inner > * {
    position: relative;
    z-index: 1;
  }

  .focus-mid-cta-kicker {
    margin: 0;
    color: rgba(176, 204, 255, 0.76);
    font-size: var(--ds-type-label-compact);
    font-weight: var(--font-weight-medium);
    line-height: var(--ds-line-label);
    letter-spacing: var(--ds-tracking-label);
    text-transform: uppercase;
  }

  .focus-mid-cta h2 {
    max-width: 18ch;
    margin: 0;
    color: rgba(245, 248, 255, 0.98);
    font-family: var(--font-family-display);
    font-size: var(--ds-type-title-lg);
    font-weight: var(--font-weight-medium);
    line-height: var(--ds-line-card-title);
    letter-spacing: var(--ds-tracking-title);
    text-wrap: balance;
  }

  .focus-mid-cta-inner > p:not(.focus-mid-cta-kicker) {
    max-width: 58ch;
    margin: 0;
    color: rgba(210, 219, 236, 0.78);
    font-size: var(--ds-type-lead);
    line-height: var(--ds-line-lead);
    letter-spacing: var(--ds-tracking-text);
    text-wrap: pretty;
  }

  .focus-mid-cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
    margin-top: var(--spacing-sm);
  }

  .focus-mid-cta :global(.ds-button--ghost) {
    border-color: rgba(245, 248, 255, 0.18);
    background: rgba(255, 255, 255, 0.035);
    color: rgba(245, 248, 255, 0.92);
  }

  .focus-mid-cta :global(.ds-button--ghost:hover),
  .focus-mid-cta :global(.ds-button--ghost:focus-visible) {
    background: rgba(255, 255, 255, 0.06);
  }

  @media (max-width: 78rem) {
    .focus-mid-cta-inner {
      grid-column: 2 / span 24;
    }
  }

  @media (max-width: 48rem) {
    .focus-mid-cta {
      padding: clamp(4rem, 16vw, 6rem) 0;
    }

    .focus-mid-cta-inner {
      grid-column: 1 / -1;
      margin-inline: var(--ds-mobile-content-gutter);
      padding: var(--spacing-lg);
    }

    .focus-mid-cta h2 {
      font-size: var(--ds-mobile-type-title-md);
    }

    .focus-mid-cta-inner > p:not(.focus-mid-cta-kicker) {
      font-size: var(--ds-mobile-type-body);
    }
  }
</style>

---
interface MethodItem {
  title: string;
  text: string;
}

interface Props {
  items: MethodItem[];
  phases: [string, string];
  className?: string;
}

const { items, phases, className } = Astro.props as Props;
---

<div class:list={['focus-method-grid', className]} data-motion-item>
  {phases.map((phase, phaseIndex) => (
    <article class="focus-method-card">
      <p class="focus-method-phase">Phase {String(phaseIndex + 1).padStart(2, '0')}</p>
      <h3>{phase}</h3>
      <div class="focus-method-list" role="list">
        {items.slice(phaseIndex * 3, (phaseIndex * 3) + 3).map((item, itemIndex) => (
          <div class="focus-method-item" role="listitem">
            <span>{String((phaseIndex * 3) + itemIndex + 1).padStart(2, '0')}</span>
            <div>
              <h4>{item.title}</h4>
              <p>{item.text}</p>
            </div>
          </div>
        ))}
      </div>
    </article>
  ))}
</div>

<style>
  .focus-method-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--spacing-sm);
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .focus-method-card {
    position: relative;
    display: grid;
    align-content: start;
    min-height: clamp(29rem, 36vw, 35rem);
    padding: var(--focus-method-card-padding, clamp(1.5rem, 3vw, 2.25rem));
    overflow: hidden;
    border: var(--size-border-thin) solid var(--focus-pattern-border, var(--ds-border-soft));
    border-radius: var(--radius-panel);
    background:
      radial-gradient(ellipse at 100% 0%, rgba(var(--focus-pattern-glow, 111, 162, 232), 0.12), transparent 20rem),
      linear-gradient(180deg, rgba(255, 255, 255, 0.035), rgba(255, 255, 255, 0.01)),
      var(--focus-pattern-surface, var(--ds-surface));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.024),
      0 1.25rem 3rem rgba(0, 0, 0, 0.16);
  }

  .focus-method-card::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgba(255, 255, 255, 0.026) 0 0.0625rem, transparent 0.0625rem 100%) 0 0 / 50% 100%,
      radial-gradient(circle at 86% 18%, rgba(191, 215, 255, 0.08), transparent 16rem);
    opacity: var(--focus-method-field-opacity, 0.6);
  }

  .focus-method-card > * {
    position: relative;
    z-index: 1;
  }

  .focus-method-phase,
  .focus-method-item > span {
    color: var(--focus-pattern-accent, rgba(176, 204, 255, 0.88));
    font-size: var(--ds-type-label);
    font-weight: var(--font-weight-semibold);
    line-height: var(--ds-line-label);
    letter-spacing: var(--ds-tracking-label);
  }

  .focus-method-phase {
    margin: 0;
    text-transform: uppercase;
  }

  .focus-method-card > h3 {
    max-width: 14ch;
    margin: var(--focus-method-card-title-margin, var(--spacing-sm)) 0 0;
    color: var(--focus-pattern-text, var(--ds-text));
    font-size: var(--ds-type-title-sm);
    font-weight: var(--font-weight-regular);
    line-height: var(--ds-line-card-title);
    letter-spacing: var(--ds-tracking-card);
    text-wrap: balance;
  }

  .focus-method-list {
    display: grid;
    margin-top: var(--focus-method-list-margin, clamp(2rem, 4vw, 3rem));
    border-top: var(--size-border-thin) solid var(--focus-method-divider, rgba(231, 235, 242, 0.08));
  }

  .focus-method-item {
    display: grid;
    grid-template-columns: minmax(2.75rem, 0.16fr) minmax(0, 0.84fr);
    gap: clamp(0.85rem, 2vw, 1.25rem);
    align-items: start;
    padding: var(--focus-method-item-padding, clamp(1rem, 2vw, 1.35rem)) 0;
    border-bottom: var(--size-border-thin) solid var(--focus-method-divider, rgba(231, 235, 242, 0.08));
  }

  .focus-method-item h4 {
    margin: 0;
    color: var(--focus-pattern-text, var(--ds-text));
    font-size: var(--ds-type-card-title-compact);
    font-weight: var(--font-weight-regular);
    line-height: var(--ds-line-card-title);
    letter-spacing: var(--ds-tracking-card);
    text-wrap: balance;
  }

  .focus-method-item p {
    max-width: 48ch;
    margin: var(--spacing-xs) 0 0;
    color: var(--focus-pattern-text-muted, var(--ds-text-muted));
    font-size: var(--ds-type-body-xs);
    line-height: var(--ds-line-body-compact);
    letter-spacing: var(--ds-tracking-text);
    text-wrap: pretty;
  }

  @media (max-width: 78rem) {
    .focus-method-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 48rem) {
    .focus-method-item {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--spacing-sm);
    }

    .focus-method-item p {
      margin-top: 0;
    }
  }
</style>

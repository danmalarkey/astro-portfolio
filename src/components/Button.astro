---
interface Props {
  href: string;
  variant?: 'solid' | 'ghost';
  size?: 'default' | 'compact';
  className?: string;
  target?: string;
  rel?: string;
  ariaLabel?: string;
}

const {
  href,
  variant = 'solid',
  size = 'default',
  className = '',
  target,
  rel,
  ariaLabel
} = Astro.props as Props;
---

<a
  href={href}
  class={`ds-button ds-button--${variant} ds-button--${size} ${className}`.trim()}
  target={target}
  rel={rel}
  aria-label={ariaLabel}
>
  <slot />
</a>

<style lang="scss">
  .ds-button {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: inline-flex;
    min-height: var(--size-touch-target-min);
    align-items: center;
    justify-content: center;
    gap: var(--spacing-site-footer-cta-gap);
    padding: var(--ds-button-padding-y) var(--ds-button-padding-x);
    border: var(--size-border-thin) solid rgba(231, 235, 242, 0.13);
    border-radius: var(--ds-button-radius);
    background:
      linear-gradient(180deg, var(--ds-surface-strong), color-mix(in srgb, var(--ds-surface) 46%, transparent)),
      rgba(var(--ds-surface-panel-rgb), 0.82);
    box-shadow:
      inset 0 0.0625rem 0 rgba(255, 255, 255, 0.055),
      0 0.5rem 1rem rgba(var(--ds-background-rgb), 0.18);
    color: rgba(245, 248, 255, 0.9);
    font-size: var(--ds-type-body-sm);
    font-weight: var(--font-weight-medium);
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition:
      transform var(--duration-transition-interactive-ui) var(--easing-standard),
      border-color var(--duration-transition-interactive-ui) var(--easing-standard),
      background var(--duration-transition-interactive-ui) var(--easing-standard),
      box-shadow var(--duration-transition-interactive-ui) var(--easing-standard);
  }

  .ds-button::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    z-index: 1;
    width: min(7.5rem, calc(100% - 1.5rem));
    height: var(--size-border-thin);
    border-radius: 999px;
    opacity: 0;
    background: linear-gradient(90deg, transparent, rgba(121, 154, 255, 0.3) 18%, rgba(184, 207, 255, 0.72) 50%, rgba(121, 154, 255, 0.34) 74%, transparent);
    box-shadow:
      0 0.05rem 0.9rem rgba(121, 154, 255, 0.2),
      0 0 1.45rem rgba(105, 133, 255, 0.14);
    transform: translateX(-50%);
    transition:
      opacity var(--duration-transition-interactive-ui) var(--easing-standard),
      width var(--duration-transition-interactive-ui) var(--easing-standard);
  }

  .ds-button:hover,
  .ds-button:focus-visible {
    border-color: rgba(231, 235, 242, 0.22);
    background:
      linear-gradient(180deg, var(--ds-surface-strong), color-mix(in srgb, var(--ds-surface) 68%, transparent)),
      rgba(var(--ds-surface-panel-rgb), 0.9);
    box-shadow:
      inset 0 0.0625rem 0 rgba(255, 255, 255, 0.065),
      0 0.55rem 1.4rem rgba(var(--ds-background-rgb), 0.24);
    transform: translateY(var(--motion-lift-subtle));
  }

  .ds-button:hover::before,
  .ds-button:focus-visible::before {
    opacity: 1;
    width: min(9rem, calc(100% - 1rem));
  }

  .ds-button--solid {
    border-color: rgba(231, 235, 242, 0.38);
    background: linear-gradient(180deg, rgba(248, 250, 255, 0.98), rgba(233, 238, 246, 0.96));
    box-shadow:
      inset 0 0.0625rem 0 rgba(255, 255, 255, 0.88),
      0 0.6rem 1.2rem rgba(var(--ds-background-rgb), 0.16);
    color: rgba(var(--ds-background-rgb), 0.96);
  }

  .ds-button--ghost {
    background:
      linear-gradient(180deg, var(--ds-surface), color-mix(in srgb, var(--ds-surface) 32%, transparent)),
      rgba(var(--ds-surface-panel-rgb), 0.76);
  }

  .ds-button--ghost:hover,
  .ds-button--ghost:focus-visible {
    background:
      linear-gradient(180deg, var(--ds-surface-strong), color-mix(in srgb, var(--ds-surface) 58%, transparent)),
      rgba(var(--ds-surface-panel-rgb), 0.86);
  }

  .ds-button--compact {
    min-height: 2.15rem;
    padding: 0 0.66rem;
    border-radius: var(--radius-md);
    font-size: var(--ds-type-body-xs);
    line-height: 1.32;
  }
</style>

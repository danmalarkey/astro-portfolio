---
import { writingRoadmapEntries } from '../data/writing-roadmap';

interface WritingEntry {
  title: string;
  slug: string;
  type: 'Essay' | 'Note' | 'Field log';
  audience: string;
  status: 'Planned' | 'Drafting' | 'In progress';
  summary: string;
  whyItMatters: string;
  live?: boolean;
}

interface Props {
  aliasRoute?: boolean;
}

const { aliasRoute = false } = Astro.props as Props;
const baseUrl = Astro.url.pathname.startsWith('/astro-portfolio') ? '/astro-portfolio/' : '/';
const withBase = (path: string) => `${baseUrl}${path.startsWith('/') ? path.slice(1) : path}`;

const featuredTracks = [
  {
    title: 'Design leadership under pressure',
    text: 'How to create clarity, align teams, and improve decision quality when product work gets complex or politically expensive.'
  },
  {
    title: 'AI as a delivery multiplier',
    text: 'Practical systems for using AI to compress cycles, improve handoff quality, and accelerate execution without lowering standards.'
  },
  {
    title: 'Scaling product and design capability',
    text: 'Operating models, standards, and team patterns that help organizations grow without creating delivery chaos.'
  }
];

const entries: WritingEntry[] = writingRoadmapEntries;
---

<section class="section section-panel section-surface--dark writing-shell">
  <div class="dm-grid-l dm-grid-l--grid-sys">
    <div class="gc-start-2 gc-span-12 section-intro section-intro--page">
      <p class="section-intro-eyebrow">Writing</p>
      <h1 class="section-title text-white">Notes, essays, and field observations from the work.</h1>
      <p class="section-intro-body">
        I use writing to clarify what I believe about design leadership, product direction, systems, and the practical use of AI in delivery.
        This is where I publish frameworks, patterns, and lessons that help leaders make better decisions and teams execute with more confidence.
      </p>
      {aliasRoute && (
        <p class="section-intro-meta">
          You are viewing the legacy <code>/blog</code> route. <a href={withBase('/writing')}>Writing</a> is the canonical path going forward.
        </p>
      )}
    </div>

    <div class="gc-start-15 gc-span-5 writing-panel writing-panel--tracks">
      <h2 class="writing-panel-title">What you will find here</h2>
      <ul class="writing-track-list">
        {featuredTracks.map((track) => (
          <li class="writing-track-item">
            <p class="writing-track-item-title">{track.title}</p>
            <p class="writing-track-item-text">{track.text}</p>
          </li>
        ))}
      </ul>
    </div>

    <div class="gc-start-20 gc-span-6 writing-panel writing-panel--meta">
      <h2 class="writing-panel-title">Publishing approach</h2>
      <ul class="writing-meta-list">
        <li>Outcome-first thinking, not abstract design hot takes</li>
        <li>Exec, delivery, and design-leadership lenses in every post</li>
        <li>Client-safe framing for active work and ongoing transformations</li>
        <li>Short notes and longer essays in the same system</li>
      </ul>
      <p class="writing-panel-footnote">Work in progress now, but the information architecture and content model are in place.</p>
    </div>
  </div>
</section>

<section class="section section-panel section-surface--warm writing-list-shell">
  <div class="dm-grid-l dm-grid-l--grid-sys">
    <div class="gc-start-2 gc-span-18 section-intro section-intro--compact">
      <p class="section-intro-eyebrow">Queue</p>
      <h2 class="section-title">Publishing roadmap</h2>
      <p class="section-intro-body">
        These are the first pieces I plan to publish as the Writing section comes online. Each one is selected to support leaders looking for clearer direction, stronger systems, and faster product delivery.
      </p>
    </div>

    <div class="gc-start-2 gc-span-18 writing-entry-list" role="list">
      {entries.map((entry) => (
        <article class="writing-entry" role="listitem">
          <div class="writing-entry-header">
            <p class="writing-entry-meta">{entry.type} <span aria-hidden="true">•</span> {entry.audience}</p>
            <p class={`writing-entry-status writing-entry-status--${entry.status.toLowerCase().replace(/\s+/g, '-')}`}>{entry.status}</p>
          </div>
          <h3 class="writing-entry-title">
            {entry.live ? <a href={withBase(`/writing/${entry.slug}`)}>{entry.title}</a> : entry.title}
          </h3>
          <p class="writing-entry-summary">{entry.summary}</p>
          <p class="writing-entry-why"><span>Why this matters:</span> {entry.whyItMatters}</p>
          <p class="writing-entry-slug">{entry.live ? <>Live route: <code>/writing/{entry.slug}</code></> : <>Planned route: <code>/writing/{entry.slug}</code></>}</p>
        </article>
      ))}
    </div>
  </div>
</section>

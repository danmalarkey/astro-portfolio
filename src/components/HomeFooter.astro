---
import ButtonLink from './ButtonLink.astro';
interface Props {
  eyebrow?: string;
  title?: string;
  body?: string;
  fitItems?: string[];
  ctaLabel?: string;
  email?: string;
  linkedinUrl?: string;
  locationLabel?: string;
}

const {
  eyebrow = 'Work with me',
  title = 'Advisory and fractional design leadership for high-stakes product work.',
  body = 'If you need experienced design leadership to clarify direction, align teams, and improve product outcomes, I am available for select advisory and fractional engagements.',
  fitItems = [
    'Executives and product leaders navigating change',
    'Teams that need direction-setting and delivery alignment',
    'Organizations investing in design capability and systems'
  ],
  ctaLabel = 'Work with me',
  email = 'hello@danmalarkey.com',
  linkedinUrl = 'https://www.linkedin.com/in/danmalarkey/',
  locationLabel = 'Jacksonville, Florida'
} = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="site-footer-home" data-star-density="0.88" data-star-brightness="0.88">
  <div class="dm-grid-l dm-grid-l--grid-sys">
    <div class="cta-panel site-footer-panel">
      <div class="dm-grid-l dm-grid-l--grid-sys site-footer-layout">
        <div class="site-footer-main gc-start-2 gc-span-14">
          <p class="cta-eyebrow">{eyebrow}</p>
          <h2 class="site-footer-title">{title}</h2>
          <p>{body}</p>
        </div>
        <aside class="site-footer-side gc-start-17 gc-span-9" aria-label="Engagement fit">
          <p class="site-footer-side-title">Best fit for</p>
          <ul class="site-footer-side-list">
            {fitItems.map((item) => <li>{item}</li>)}
          </ul>
          <ButtonLink href={`mailto:${email}`} variant="primary" className="cta-link--footer" showArrow={true}>
            {ctaLabel}
          </ButtonLink>
          <p class="cta-meta">Email: {email}</p>
        </aside>
      </div>
      <div class="dm-grid-l dm-grid-l--grid-sys site-footer-utility-row" aria-label="Footer details">
        <div class="site-footer-utility-copy gc-start-2 gc-span-18">
          <p class="site-footer-legal">© {currentYear} Dan Malarkey. All rights reserved.</p>
          <p class="site-footer-location">Located in {locationLabel}.</p>
        </div>
        <div class="site-footer-utility-link-wrap gc-start-21 gc-span-4">
          <a href={linkedinUrl} class="site-footer-link" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        </div>
      </div>
    </div>
  </div>
</footer>
